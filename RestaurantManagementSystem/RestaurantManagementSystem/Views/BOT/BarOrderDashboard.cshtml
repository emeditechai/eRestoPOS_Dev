@model OrderDashboardViewModel
@inject RestaurantManagementSystem.Services.UrlEncryptionService EncryptionService
@{
    ViewData["Title"] = "Bar Order Dashboard";
}

<div class="container-fluid p-3" style="background: linear-gradient(135deg, #f5f3ff 60%, #ede9fe 100%); min-height:100vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 style="color: #7c3aed;">
            <i class="fas fa-cocktail me-2"></i>@ViewData["Title"]
        </h1>
        <div class="d-flex align-items-center gap-2">
            <div class="bar-refresh-tools me-1">
                <small id="refreshCountdown" class="text-muted">Refresh in 120s</small>
                <button type="button" id="toggleAutoRefreshBtn" class="btn btn-sm btn-outline-secondary">Pause Auto Refresh</button>
                <button type="button" id="refreshNowBtn" class="btn btn-sm btn-outline-primary"><i class="fas fa-rotate-right me-1"></i>Refresh</button>
            </div>
            <a href="@Url.Action("Form", "Feedback")" class="btn btn-light" style="border-radius: 50%; width: 48px; height: 48px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(124,58,237,.25); color: #7c3aed;" target="_blank" rel="noopener noreferrer" title="Open Feedback Form">
                <i class="fas fa-comment-dots"></i>
            </a>
            <a asp-controller="BOT" asp-action="BarOrderCreate" class="btn text-white" style="background: linear-gradient(90deg, #9333ea 60%, #a855f7 100%);" target="_blank" rel="noopener noreferrer">
                <i class="fas fa-plus-circle"></i> New Bar Order
                <span class="badge bg-white text-dark ms-2" style="font-size: 0.7rem; font-weight: 500;">Shift+B</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Compact styling with purple theme *@
    <style>
        .bar-refresh-tools {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            flex-wrap: wrap;
            padding: .4rem .55rem;
            border: 1px solid #ddd6fe;
            border-radius: 8px;
            background: rgba(255,255,255,.9);
        }
        .card { border-radius: 8px; }
        .card-header { padding: .5rem .75rem; }
        .card-body { padding: .75rem; }
        table.table { font-size: .9rem; }
        table.table td, table.table th { padding: .4rem .5rem; vertical-align: middle; }
        thead.sticky th { position: sticky; top: 0; z-index: 2; }
        .metric-card .card-body { padding: .6rem .8rem; }
        .metric-card h5 { font-size: .95rem; margin-bottom: .25rem; }
        .metric-card h2 { font-size: 1.6rem; margin: 0; }
        .badge { font-size: .75rem; }
        .btn-group .btn { padding: .2rem .4rem; }
        .table-container { max-height: 28vh; overflow: auto; }
        .bar-metric-card { border-left: 4px solid #7c3aed; }

        @@media (max-width: 767.98px) {
            .bar-refresh-tools {
                width: 100%;
                justify-content: flex-start;
            }
        }
    </style>

    @* Metrics row with purple theme *@
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-white metric-card bar-metric-card" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                <div class="card-body">
                    <h5>Open Orders</h5>
                    <h2 id="kpiOpenCount">@Model.OpenOrdersCount</h2>
                    <small id="kpiOpenMeta" style="opacity:.9;">Filtered @Model.OpenOrdersCount / Total @Model.OpenOrdersCount</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white metric-card bar-metric-card" style="background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%);">
                <div class="card-body">
                    <h5>In Progress</h5>
                    <h2 id="kpiProgressCount">@Model.InProgressOrdersCount</h2>
                    <small id="kpiProgressMeta" style="opacity:.9;">Filtered @Model.InProgressOrdersCount / Total @Model.InProgressOrdersCount</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white metric-card bar-metric-card" style="background: linear-gradient(135deg, #a855f7 0%, #c084fc 100%);">
                <div class="card-body">
                    <h5>Ready</h5>
                    <h2 id="kpiReadyCount">@Model.ReadyOrdersCount</h2>
                    <small id="kpiReadyMeta" style="opacity:.9;">Filtered @Model.ReadyOrdersCount / Total @Model.ReadyOrdersCount</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white metric-card bar-metric-card" style="background: linear-gradient(135deg, #c084fc 0%, #d8b4fe 100%);">
                <div class="card-body">
                    <h5>Today's Bar Sales</h5>
                    <h2 id="kpiSalesAmount">₹@Model.TotalSales.ToString("F2")</h2>
                    <small id="kpiSalesMeta" style="opacity:.9;">Filtered ₹@Model.TotalSales.ToString("F2") / Total ₹@Model.TotalSales.ToString("F2")</small>
                </div>
            </div>
        </div>
    </div>

    @* Active Bar Orders *@
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #9333ea 60%, #a855f7 100%); color: white;">
                    <h5 class="mb-0"><i class="fas fa-wine-glass-alt me-2"></i>Active Bar Orders</h5>
                    <div class="d-flex align-items-center" style="gap:.5rem">
                        <small>Bar items only</small>
                        <span class="badge bg-white text-purple rounded-pill px-3" style="color: #7c3aed;" title="Active bar orders">@((Model.ActiveOrders?.Count() ?? 0).ToString()) Records</span>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.ActiveOrders.Any())
                    {
                        <div class="table-responsive table-container">
                            <table class="table table-striped table-hover" id="activeOrders">
                                <thead class="sticky" style="background: linear-gradient(90deg, #7c3aed 60%, #9333ea 100%); color: white;">
                                    <tr class="text-center">
                                        <th>Order #</th>
                                        <th>Type</th>
                                        <th>Table/Customer</th>
                                        <th>Server</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Duration</th>
                                        <th>Bar Items</th>
                                        <th>Total</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.ActiveOrders)
                                    {
                                        <tr class="align-middle text-center">
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td>@order.OrderTypeDisplay</td>
                                            <td>
                                                @if (order.OrderType == 0)
                                                {
                                                    @(order.TableName ?? "No Table")
                                                }
                                                else
                                                {
                                                    @(order.GuestName ?? "No Name")
                                                }
                                            </td>
                                            <td>@(order.ServerName ?? "Unassigned")</td>
                                            <td>
                                                @{
                                                    var badgeClass = order.Status switch
                                                    {
                                                        0 => "bg-primary",
                                                        1 => "bg-warning text-dark",
                                                        2 => "bg-success",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@order.StatusDisplay</span>
                                            </td>
                                            <td>@order.CreatedAt.ToString("dd/MM HH:mm")</td>
                                            <td>@order.Duration.ToString(@"hh\:mm")</td>
                                            <td><span class="badge bg-purple-100" style="background-color: #e9d5ff; color: #7c3aed;">@order.ItemCount</span></td>
                                            <td><strong>₹@order.TotalAmount.ToString("F2")</strong></td>
                                            <td>
                                                <div class="btn-group">
                                                    @{
                                                        var encryptedOrderUrl = "/Order/Details?token=" + Uri.EscapeDataString(EncryptionService.EncryptParameters(new Dictionary<string, string> { ["id"] = order.Id.ToString(), ["fromBar"] = "true" }));
                                                    }
                                                    <a href="@encryptedOrderUrl" class="btn btn-sm btn-outline-primary" title="View Order" target="_blank" rel="noopener noreferrer">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Payment/Index/@order.Id?fromBar=true" class="btn btn-sm btn-outline-success" title="Process Payment" target="_blank" rel="noopener noreferrer">
                                                        <i class="fas fa-credit-card"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-danger cancel-order-trigger"
                                                            data-order-id="@order.Id" data-order-number="@order.OrderNumber" title="Cancel Order">
                                                        <i class="fas fa-times-circle"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>No active bar orders at the moment.
                        </div>
                    }
                </div>
            </div>

            <!-- Completed Bar Orders Section -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #9333ea 60%, #a855f7 100%); color: white;">
                    <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Completed Bar Orders</h5>
                    <form class="d-flex align-items-center" method="get" asp-controller="BOT" asp-action="BarOrderDashboard" style="gap:.5rem">
                        @{
                            var qFrom = ViewContext.HttpContext.Request.Query["fromDate"].ToString();
                            var qTo = ViewContext.HttpContext.Request.Query["toDate"].ToString();
                            var today = DateTime.Today;
                            var yesterday = DateTime.Today.AddDays(-1);
                            var last7Start = DateTime.Today.AddDays(-6);
                            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                        }
                        <div class="btn-group btn-group-sm me-2" role="group" aria-label="Quick date filters">
                            <a class="btn btn-light" href="@Url.Action("BarOrderDashboard", "BOT", new { fromDate = today.ToString("yyyy-MM-dd"), toDate = today.ToString("yyyy-MM-dd") })">Today</a>
                            <a class="btn btn-light" href="@Url.Action("BarOrderDashboard", "BOT", new { fromDate = yesterday.ToString("yyyy-MM-dd"), toDate = yesterday.ToString("yyyy-MM-dd") })">Yesterday</a>
                            <a class="btn btn-light" href="@Url.Action("BarOrderDashboard", "BOT", new { fromDate = last7Start.ToString("yyyy-MM-dd"), toDate = today.ToString("yyyy-MM-dd") })">Last 7 Days</a>
                            <a class="btn btn-light" href="@Url.Action("BarOrderDashboard", "BOT", new { fromDate = monthStart.ToString("yyyy-MM-dd"), toDate = today.ToString("yyyy-MM-dd") })">This Month</a>
                        </div>
                        <label class="small mb-0">From</label>
                        <input type="date" name="fromDate" class="form-control form-control-sm" value="@qFrom" />
                        <label class="small mb-0">To</label>
                        <input type="date" name="toDate" class="form-control form-control-sm" value="@qTo" />
                        <button type="submit" class="btn btn-sm btn-light" title="Filter"><i class="fas fa-filter"></i></button>
                        <a asp-controller="BOT" asp-action="BarOrderDashboard" class="btn btn-sm btn-outline-light" title="Reset"><i class="fas fa-undo"></i></a>
                    </form>
                </div>
                <div class="card-body">
                    @if (Model.CompletedOrders.Any())
                    {
                        <div class="table-responsive table-container">
                            <table class="table table-sm table-striped table-hover" id="completedOrders">
                                <thead class="sticky" style="background: linear-gradient(90deg, #7c3aed 60%, #9333ea 100%); color: white;">
                                    <tr class="text-center">
                                        <th>Order #</th>
                                        <th>Type</th>
                                        <th>Table/Customer</th>
                                        <th>Bar Items</th>
                                        <th>Total</th>
                                        <th>Duration</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.CompletedOrders)
                                    {
                                        <tr class="align-middle text-center">
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td>@order.OrderTypeDisplay</td>
                                            <td>
                                                @if (order.OrderType == 0) { @(order.TableName ?? "No Table") }
                                                else { @(order.GuestName ?? "No Name") }
                                            </td>
                                            <td><span class="badge bg-purple-100" style="background-color: #e9d5ff; color: #7c3aed;">@order.ItemCount</span></td>
                                            <td><strong>₹@order.TotalAmount.ToString("F2")</strong></td>
                                            <td>@order.Duration.ToString(@"hh\:mm")</td>
                                            <td>
                                                <div class="btn-group">
                                                    @{
                                                        var encryptedCompletedOrderUrl = "/Order/Details?token=" + Uri.EscapeDataString(EncryptionService.EncryptParameters(new Dictionary<string, string> { ["id"] = order.Id.ToString(), ["fromBar"] = "true" }));
                                                    }
                                                    <a href="@encryptedCompletedOrderUrl" class="btn btn-sm btn-outline-secondary" title="View Order" target="_blank" rel="noopener noreferrer">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Payment/Index/@order.Id?fromBar=true" class="btn btn-sm btn-outline-success" title="Payment" target="_blank" rel="noopener noreferrer">
                                                        <i class="fas fa-credit-card"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="alert mt-2 mb-0 py-2" style="background-color: #ede9fe; border-color: #7c3aed; color: #5b21b6;">
                            <strong>Total Completed:</strong> @Model.CompletedOrdersCount
                            <span class="mx-2">|</span>
                            <strong>Total Bar Sales:</strong> ₹@Model.TotalSales.ToString("F2")
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>No completed bar orders today.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Cancelled Bar Orders *@
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #dc2626 60%, #ef4444 100%); color: white;">
                    <h5 class="mb-0"><i class="fas fa-ban me-2"></i>Cancelled Bar Orders</h5>
                    <div class="d-flex align-items-center" style="gap:.5rem">
                        <small>Today's cancelled orders</small>
                        <span class="badge bg-white rounded-pill px-3" style="color: #dc2626;" title="Cancelled bar orders">@((Model.CancelledOrders?.Count() ?? 0).ToString()) Records</span>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.CancelledOrders.Any())
                    {
                        <div class="table-responsive table-container">
                            <table class="table table-sm table-striped table-hover" id="cancelledOrders">
                                <thead class="sticky" style="background: linear-gradient(90deg, #dc2626 60%, #ef4444 100%); color: white;">
                                    <tr class="text-center">
                                        <th>Order #</th>
                                        <th>Type</th>
                                        <th>Table/Customer</th>
                                        <th>Bar Items</th>
                                        <th>Total</th>
                                        <th>Duration</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.CancelledOrders)
                                    {
                                        <tr class="align-middle text-center">
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td>@order.OrderTypeDisplay</td>
                                            <td>
                                                @if (order.OrderType == 0) { @(order.TableName ?? "No Table") }
                                                else { @(order.GuestName ?? "No Name") }
                                            </td>
                                            <td><span class="badge bg-danger-subtle text-danger">@order.ItemCount</span></td>
                                            <td><strong>₹@order.TotalAmount.ToString("F2")</strong></td>
                                            <td>@order.Duration.ToString(@"hh\:mm")</td>
                                            <td>
                                                <div class="btn-group">
                                                    @{
                                                        var encryptedCancelledOrderUrl = "/Order/Details?token=" + Uri.EscapeDataString(EncryptionService.EncryptParameters(new Dictionary<string, string> { ["id"] = order.Id.ToString(), ["fromBar"] = "true" }));
                                                    }
                                                    <a href="@encryptedCancelledOrderUrl" class="btn btn-sm btn-outline-secondary" title="View Order">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="alert mt-2 mb-0 py-2" style="background-color: #fee2e2; border-color: #dc2626; color: #991b1b;">
                            <strong>Total Cancelled Today:</strong> @Model.CancelledOrdersCount
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>No cancelled bar orders today.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const totalOpenOrders = @Model.OpenOrdersCount;
            const totalInProgressOrders = @Model.InProgressOrdersCount;
            const totalReadyOrders = @Model.ReadyOrdersCount;
            const totalSalesAmount = @Model.TotalSales.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

            function parseCurrency(val) {
                const n = parseFloat((val || '').toString().replace(/[^0-9.-]/g, ''));
                return isNaN(n) ? 0 : n;
            }

            var activeTable = $('#activeOrders').DataTable({
                order: [[5, 'desc']],
                paging: false,
                info: false,
                searching: true,
                scrollY: '28vh',
                scrollCollapse: true
            });
            var completedTable = $('#completedOrders').DataTable({
                order: [[0, 'desc']],
                paging: false,
                info: false,
                searching: true,
                scrollY: '28vh',
                scrollCollapse: true
            });
            var cancelledTable = $('#cancelledOrders').DataTable({
                order: [[0, 'desc']],
                paging: false,
                info: false,
                searching: true,
                scrollY: '28vh',
                scrollCollapse: true
            });

            function updateKpis() {
                let filteredOpen = 0;
                let filteredInProgress = 0;
                let filteredReady = 0;

                activeTable.rows({ search: 'applied' }).nodes().to$().each(function () {
                    filteredOpen++;
                    const statusText = ($(this).find('td').eq(4).text() || '').trim().toLowerCase();
                    if (statusText.includes('progress')) filteredInProgress++;
                    if (statusText.includes('ready')) filteredReady++;
                });

                let filteredSales = 0;
                completedTable.rows({ search: 'applied' }).nodes().to$().each(function () {
                    filteredSales += parseCurrency($(this).find('td').eq(4).text());
                });

                $('#kpiOpenCount').text(filteredOpen);
                $('#kpiOpenMeta').text('Filtered ' + filteredOpen + ' / Total ' + totalOpenOrders);

                $('#kpiProgressCount').text(filteredInProgress);
                $('#kpiProgressMeta').text('Filtered ' + filteredInProgress + ' / Total ' + totalInProgressOrders);

                $('#kpiReadyCount').text(filteredReady);
                $('#kpiReadyMeta').text('Filtered ' + filteredReady + ' / Total ' + totalReadyOrders);

                $('#kpiSalesAmount').text('₹' + filteredSales.toFixed(2));
                $('#kpiSalesMeta').text('Filtered ₹' + filteredSales.toFixed(2) + ' / Total ₹' + Number(totalSalesAmount).toFixed(2));
            }

            activeTable.on('draw', updateKpis);
            completedTable.on('draw', updateKpis);
            cancelledTable.on('draw', updateKpis);
            updateKpis();

            // Keep dashboard fresh with user controls.
            const refreshSecondsDefault = 120;
            let refreshRemaining = refreshSecondsDefault;
            let refreshPaused = false;
            let refreshTicker = null;

            function updateRefreshUi() {
                if (refreshPaused) {
                    $('#refreshCountdown').text('Auto refresh paused');
                    $('#toggleAutoRefreshBtn').text('Resume Auto Refresh');
                } else {
                    $('#refreshCountdown').text('Refresh in ' + refreshRemaining + 's');
                    $('#toggleAutoRefreshBtn').text('Pause Auto Refresh');
                }
            }

            function startRefreshTicker() {
                if (refreshTicker) clearInterval(refreshTicker);
                refreshTicker = setInterval(function () {
                    if (refreshPaused) return;
                    refreshRemaining--;
                    if (refreshRemaining <= 0) {
                        location.reload();
                        return;
                    }
                    updateRefreshUi();
                }, 1000);
            }

            $('#toggleAutoRefreshBtn').on('click', function () {
                refreshPaused = !refreshPaused;
                if (!refreshPaused && refreshRemaining <= 0) {
                    refreshRemaining = refreshSecondsDefault;
                }
                updateRefreshUi();
            });

            $('#refreshNowBtn').on('click', function () {
                location.reload();
            });

            updateRefreshUi();
            startRefreshTicker();
        });
    </script>

    @* Tooltips *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl) })
        });

        // Cancel order modal logic (same as Order Dashboard)
        document.addEventListener('DOMContentLoaded', function() {
            const modalEl = document.getElementById('cancelOrderModal');
            if (!modalEl) return; // safety
            const confirmBtn = document.getElementById('confirmCancelOrderBtn');
            const orderInfoSpan = document.getElementById('cancelOrderInfo');
            const hiddenOrderId = document.getElementById('cancelOrderId');
            const bsModal = new bootstrap.Modal(modalEl);

            document.querySelectorAll('.cancel-order-trigger').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.getAttribute('data-order-id');
                    const number = btn.getAttribute('data-order-number');
                    hiddenOrderId.value = id;
                    orderInfoSpan.textContent = number;
                    bsModal.show();
                });
            });

            if (confirmBtn) {
                confirmBtn.addEventListener('click', () => {
                    if (!hiddenOrderId.value) return;
                    // Build a safe local return URL back to current page (preserve filters)
                    const current = window.location.pathname + window.location.search;
                    const r = encodeURIComponent(current);
                    window.location.href = `/Order/CancelOrder/${hiddenOrderId.value}?returnUrl=${r}`;
                });
            }
        });
    </script>
}

<!-- Cancel Order Confirmation Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Cancellation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cancelOrderId" />
                <p class="mb-2">You are about to cancel order: <strong id="cancelOrderInfo"></strong></p>
                <div class="alert alert-warning mb-0 small"><i class="fas fa-info-circle me-1"></i>This action cannot be undone and items will be marked as cancelled.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Order</button>
                <button type="button" class="btn btn-danger" id="confirmCancelOrderBtn">Yes, Cancel Order</button>
            </div>
        </div>
    </div>
</div>
