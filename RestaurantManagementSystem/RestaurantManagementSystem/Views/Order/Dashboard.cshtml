@model OrderDashboardViewModel
@{
    ViewData["Title"] = "Order Dashboard";
}

<div class="container-fluid p-3 order-dashboard-shell">
    <div class="d-flex justify-content-between align-items-center mb-4 order-dashboard-topbar">
        <h1 class="order-dashboard-title">
            <i class="fas fa-utensils me-2"></i>@ViewData["Title"]
        </h1>
        <div class="d-flex align-items-center gap-2 order-dashboard-actions">
            <div class="order-refresh-tools me-1">
                <small id="refreshCountdown" class="text-muted">Refresh in 120s</small>
                <button type="button" id="toggleAutoRefreshBtn" class="btn btn-sm btn-outline-secondary">Pause Auto Refresh</button>
                <button type="button" id="refreshNowBtn" class="btn btn-sm btn-outline-primary"><i class="fas fa-rotate-right me-1"></i>Refresh</button>
            </div>
            <a href="@Url.Action("Form", "Feedback")" class="btn btn-outline-primary rounded-circle order-dashboard-feedback-btn" target="_blank" rel="noopener noreferrer" title="Open Feedback Form">
                <i class="fas fa-comment-dots"></i>
            </a>
            <a asp-action="Create" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                <i class="fas fa-plus-circle"></i> New Order
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Compact styling with uniform app theme *@
    <style>
        .order-dashboard-shell {
            overflow-x: hidden;
            min-height: calc(100vh - 120px);
            background:
                radial-gradient(circle at 8% 10%, rgba(56, 189, 248, 0.12), transparent 28%),
                radial-gradient(circle at 92% 12%, rgba(59, 130, 246, 0.10), transparent 26%),
                linear-gradient(180deg, #f8fbff 0%, #f3f7fc 100%);
            border-radius: 12px;
        }
        .order-dashboard-title { margin: 0; }
        .order-dashboard-actions { flex-wrap: wrap; }
        .order-kpi-row {
            --bs-gutter-y: .85rem;
        }
        .order-refresh-tools {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            flex-wrap: wrap;
            padding: .4rem .55rem;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #fff;
        }
        .order-dashboard-feedback-btn { width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; }
        .card { border-radius: 8px; }
        .card-header { padding: .5rem .75rem; }
        .card-body { padding: .75rem; }
        table.table { font-size: .9rem; }
        table.table td, table.table th { padding: .4rem .5rem; vertical-align: middle; }
        thead.sticky th { position: sticky; top: 0; z-index: 2; }
        .metric-card .card-body { padding: .6rem .8rem; }
        .metric-card h5 { font-size: .95rem; margin-bottom: .25rem; }
        .metric-card h2 { font-size: 1.6rem; margin: 0; }
        .badge { font-size: .75rem; }
        .btn-group .btn { padding: .2rem .4rem; }
        .table-container { max-height: 28vh; overflow: auto; }
        .order-dashboard-title { color: #0f172a; font-size: 2rem; font-weight: 700; }
        .order-metric-card {
            position: relative;
            border: 0;
            border-radius: 18px;
            box-shadow: 0 16px 32px rgba(15, 23, 42, 0.12);
            overflow: hidden;
        }
        .order-metric-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(255,255,255,.32), transparent 38%);
            pointer-events: none;
        }
        .order-metric-card .card-body {
            position: relative;
            min-height: 116px;
            padding: 1rem 1rem .9rem;
            color: #fff;
        }
        .order-metric-card h5 {
            color: rgba(255,255,255,.92);
            font-weight: 700;
            letter-spacing: .01em;
            margin-bottom: .35rem;
        }
        .order-metric-card h2 {
            color: #fff;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: .2rem;
        }
        .order-metric-card small {
            display: block;
            color: rgba(255,255,255,.84) !important;
            font-size: .78rem;
        }
        .order-metric-card .metric-icon {
            position: absolute;
            right: .95rem;
            top: .85rem;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.22);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.14);
            font-size: 1.15rem;
        }
        .order-metric-card.order-metric-card--open {
            background: linear-gradient(135deg, #2563eb 0%, #06b6d4 100%);
        }
        .order-metric-card.order-metric-card--progress {
            background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
        }
        .order-metric-card.order-metric-card--ready {
            background: linear-gradient(135deg, #059669 0%, #14b8a6 100%);
        }
        .order-metric-card.order-metric-card--sales {
            background: linear-gradient(135deg, #7c3aed 0%, #ec4899 100%);
        }

        .order-filter-card,
        .order-panel-card {
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
            background: #ffffff;
        }

        .order-panel-header {
            color: #fff;
            border-bottom: 0;
        }

        .order-panel-header--active {
            background: linear-gradient(90deg, #0ea5e9 0%, #0284c7 100%);
        }
        .order-panel-header--cancelled {
            background: linear-gradient(90deg, #ef4444 0%, #f97316 100%);
        }
        .order-panel-header--completed {
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 100%);
        }

        .order-table-head-active,
        .order-table-head-cancelled,
        .order-table-head-completed {
            color: #fff;
        }

        .order-table-head-active { background: linear-gradient(90deg, #0369a1 0%, #0284c7 100%); }
        .order-table-head-cancelled { background: linear-gradient(90deg, #b91c1c 0%, #ea580c 100%); }
        .order-table-head-completed { background: linear-gradient(90deg, #0f766e 0%, #0d9488 100%); }

        .order-record-badge {
            background: rgba(255,255,255,.2);
            color: #fff;
            border: 1px solid rgba(255,255,255,.3);
        }

        .order-filter-card {
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select { min-height: 36px; }

        @@media (max-width: 991.98px) {
            .order-dashboard-shell { padding: 1rem !important; }
            .order-dashboard-topbar { flex-direction: column; align-items: stretch !important; gap: 1rem; }
            .order-dashboard-actions { width: 100%; justify-content: flex-start; }
            .metric-card h5 { font-size: .85rem; }
            .metric-card h2 { font-size: 1.35rem; }
            .order-metric-card .metric-icon {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
            .table-container { max-height: 42vh; }
            #activeOrders, #cancelledOrders, #completedOrders { font-size: .84rem; }
            #activeOrders th:nth-child(3), #activeOrders td:nth-child(3),
            #activeOrders th:nth-child(5), #activeOrders td:nth-child(5),
            #activeOrders th:nth-child(8), #activeOrders td:nth-child(8),
            #cancelledOrders th:nth-child(3), #cancelledOrders td:nth-child(3),
            #cancelledOrders th:nth-child(5), #cancelledOrders td:nth-child(5),
            #completedOrders th:nth-child(3), #completedOrders td:nth-child(3) {
                display: none;
            }
        }

        @@media (max-width: 767.98px) {
            .order-dashboard-shell { padding: .75rem !important; }
            .order-dashboard-title { font-size: 1.8rem; line-height: 1.2; }
            .order-dashboard-actions { gap: .5rem !important; }
            .order-refresh-tools { width: 100%; justify-content: flex-start; }
            .order-dashboard-actions .btn { min-height: 44px; }
            .order-dashboard-actions a.btn:last-child { flex: 1 1 100%; justify-content: center; }
            .metric-card .card-body { padding: .75rem; }
            .metric-card h2 { font-size: 1.5rem; }
            .order-metric-card .card-body { min-height: 108px; }
            .card-header,
            .card-body,
            .card-body.d-flex { padding: .75rem !important; }
            .table-container { max-height: none; overflow: visible; }
            .card-header.d-flex,
            .card-header form,
            .card-body.d-flex {
                flex-direction: column;
                align-items: stretch !important;
            }
            #counterFilter {
                min-width: 0 !important;
                width: 100%;
            }

            .dataTables_wrapper .dataTables_filter,
            .dataTables_wrapper .dataTables_length {
                float: none !important;
                text-align: left !important;
                width: 100%;
                margin-bottom: .75rem;
            }

            .dataTables_wrapper .dataTables_filter label,
            .dataTables_wrapper .dataTables_length label {
                width: 100%;
                display: flex;
                flex-direction: column;
                gap: .35rem;
            }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                width: 100% !important;
                max-width: none;
                margin-left: 0 !important;
            }

            #activeOrders thead,
            #cancelledOrders thead,
            #completedOrders thead {
                display: none;
            }

            #activeOrders tbody,
            #cancelledOrders tbody,
            #completedOrders tbody {
                display: block;
            }

            #activeOrders tr,
            #cancelledOrders tr,
            #completedOrders tr {
                display: block;
                margin-bottom: .85rem;
                border: 1px solid rgba(15,23,42,.12);
                border-radius: .85rem;
                overflow: hidden;
                background: #fff;
                box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
            }

            #activeOrders td,
            #cancelledOrders td,
            #completedOrders td {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: .75rem;
                width: 100%;
                text-align: left !important;
                padding: .6rem .75rem !important;
                border: 0;
                border-top: 1px solid rgba(15,23,42,.06);
            }

            #activeOrders td:first-child,
            #cancelledOrders td:first-child,
            #completedOrders td:first-child {
                border-top: 0;
            }

            #activeOrders td::before,
            #cancelledOrders td::before,
            #completedOrders td::before {
                font-size: .72rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .05em;
                color: #64748b;
                flex: 0 0 96px;
                content: '';
            }

            #activeOrders td:nth-child(1)::before { content: 'Order #'; }
            #activeOrders td:nth-child(2)::before { content: 'Type'; }
            #activeOrders td:nth-child(3)::before { content: 'Counter'; }
            #activeOrders td:nth-child(4)::before { content: 'Table/Customer'; }
            #activeOrders td:nth-child(5)::before { content: 'Server'; }
            #activeOrders td:nth-child(6)::before { content: 'Status'; }
            #activeOrders td:nth-child(7)::before { content: 'Date'; }
            #activeOrders td:nth-child(8)::before { content: 'Duration'; }
            #activeOrders td:nth-child(9)::before { content: 'Items'; }
            #activeOrders td:nth-child(10)::before { content: 'Total'; }
            #activeOrders td:nth-child(11)::before { content: 'Actions'; }

            #cancelledOrders td:nth-child(1)::before { content: 'Order #'; }
            #cancelledOrders td:nth-child(2)::before { content: 'Type'; }
            #cancelledOrders td:nth-child(3)::before { content: 'Counter'; }
            #cancelledOrders td:nth-child(4)::before { content: 'Table/Customer'; }
            #cancelledOrders td:nth-child(5)::before { content: 'Server'; }
            #cancelledOrders td:nth-child(6)::before { content: 'Status'; }
            #cancelledOrders td:nth-child(7)::before { content: 'Time'; }
            #cancelledOrders td:nth-child(8)::before { content: 'Items'; }
            #cancelledOrders td:nth-child(9)::before { content: 'Total'; }
            #cancelledOrders td:nth-child(10)::before { content: 'Actions'; }

            #completedOrders td:nth-child(1)::before { content: 'Order #'; }
            #completedOrders td:nth-child(2)::before { content: 'Type'; }
            #completedOrders td:nth-child(3)::before { content: 'Counter'; }
            #completedOrders td:nth-child(4)::before { content: 'Total'; }
            #completedOrders td:nth-child(5)::before { content: 'Actions'; }

            #activeOrders td:last-child,
            #cancelledOrders td:last-child,
            #completedOrders td:last-child {
                align-items: center;
            }

            #activeOrders td .btn-group,
            #completedOrders td .btn-group {
                flex-wrap: wrap;
                gap: .35rem;
            }

            #activeOrdersTypeFilter > div {
                align-items: flex-start !important;
                flex-direction: column;
                gap: .45rem !important;
            }
        }
    </style>

    @* Metrics row *@
    <div class="row g-3 mb-3 order-kpi-row">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card metric-card order-metric-card order-metric-card--open">
                <div class="card-body">
                    <span class="metric-icon"><i class="fas fa-folder-open"></i></span>
                    <h5>Open Orders</h5>
                    <h2 id="kpiOpenCount">@Model.OpenOrdersCount</h2>
                    <small class="text-muted" id="kpiOpenMeta">Filtered @Model.OpenOrdersCount / Total @Model.OpenOrdersCount</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card metric-card order-metric-card order-metric-card--progress">
                <div class="card-body">
                    <span class="metric-icon"><i class="fas fa-bolt"></i></span>
                    <h5>In Progress</h5>
                    <h2 id="kpiProgressCount">@Model.InProgressOrdersCount</h2>
                    <small class="text-muted" id="kpiProgressMeta">Filtered @Model.InProgressOrdersCount / Total @Model.InProgressOrdersCount</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card metric-card order-metric-card order-metric-card--ready">
                <div class="card-body">
                    <span class="metric-icon"><i class="fas fa-circle-check"></i></span>
                    <h5>Ready</h5>
                    <h2 id="kpiReadyCount">@Model.ReadyOrdersCount</h2>
                    <small class="text-muted" id="kpiReadyMeta">Filtered @Model.ReadyOrdersCount / Total @Model.ReadyOrdersCount</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card metric-card order-metric-card order-metric-card--sales">
                <div class="card-body">
                    <span class="metric-icon"><i class="fas fa-indian-rupee-sign"></i></span>
                    <h5>Today's Sales</h5>
                    <h2 id="kpiSalesAmount">₹@Model.TotalSales.ToString("F2")</h2>
                    <small class="text-muted" id="kpiSalesMeta">Filtered ₹@Model.TotalSales.ToString("F2") / Total ₹@Model.TotalSales.ToString("F2")</small>
                </div>
            </div>
        </div>
    </div>

    @* Counter filter (client-side). Defaults to POS-selected counter for this session. *@
    @{
        var counterOptions = ViewBag.CounterOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
        var defaultCounterId = 0;
        try { defaultCounterId = (int)(ViewBag.DefaultCounterId ?? 0); } catch { defaultCounterId = 0; }
    }
    <div class="row mb-3">
        <div class="col-12">
            <div class="card order-filter-card">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap" style="gap: .75rem; padding: .75rem;">
                    <div class="d-flex align-items-center" style="gap:.5rem;">
                        <span class="small fw-semibold text-dark"><i class="fas fa-filter me-1"></i>Counter</span>
                        <select id="counterFilter" class="form-select form-select-sm" style="min-width: 220px;">
                            <option value="">All Counters</option>
                            @foreach (var c in counterOptions)
                            {
                                var isSelected = (!string.IsNullOrWhiteSpace(c.Value) && int.TryParse(c.Value, out var cid) && cid == defaultCounterId);
                                <option value="@c.Value" selected="@(isSelected ? "selected" : null)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <small class="text-muted">Client-side filter (does not change totals)</small>
                </div>
            </div>
        </div>
    </div>

    @* Active Orders *@
    <div class="row">
        <div class="col-12">
            <div class="card order-panel-card">
                <div class="card-header d-flex justify-content-between align-items-center order-panel-header order-panel-header--active">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Active Orders (All Pending Orders)</h5>
                    <div class="d-flex align-items-center" style="gap:.5rem">
                        <small>Food orders only</small>
                        <span class="badge rounded-pill px-3 order-record-badge" title="Active orders">@((Model.ActiveOrders?.Count() ?? 0).ToString()) Records</span>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.ActiveOrders.Any())
                    {
                        <div id="activeOrdersTypeFilter" class="mb-2"></div>
                        <div class="table-responsive table-container">
                            <table class="table table-striped table-hover" id="activeOrders">
                                <thead class="sticky order-table-head-active">
                                    <tr class="text-center">
                                        <th>Order #</th>
                                        <th>Type</th>
                                        <th>Counter</th>
                                        <th>Table/Customer</th>
                                        <th>Server</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Duration</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.ActiveOrders)
                                    {
                                        <tr class="align-middle text-center" data-counter-id="@(order.CounterId?.ToString() ?? "")">
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td>@order.OrderTypeDisplay</td>
                                            <td>@(string.IsNullOrWhiteSpace(order.CounterDisplay) ? "-" : order.CounterDisplay)</td>
                                            <td>
                                                @if (order.OrderType == 0) // Dine-In
                                                {
                                                    @(order.TableName ?? "No Table")
                                                }
                                                else if (order.OrderType == 4) // Room Service
                                                {
                                                    var roomNo = !string.IsNullOrWhiteSpace(order.RoomNo)
                                                        ? order.RoomNo
                                                        : (order.RoomId.HasValue ? order.RoomId.Value.ToString() : "N/A");
                                                    var guestName = order.GuestName ?? "No Name";
                                                    @($"{roomNo} - {guestName}")
                                                }
                                                else
                                                {
                                                    @(order.GuestName ?? "No Name")
                                                }
                                            </td>
                                            <td>@(order.ServerName ?? "Unassigned")</td>
                                            <td>
                                                @{
                                                    var badgeClass = order.Status switch
                                                    {
                                                        0 => "bg-info",
                                                        1 => "bg-warning text-dark",
                                                        2 => "bg-success",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@order.StatusDisplay</span>
                                            </td>
                                            <td data-order="@order.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">@order.CreatedAt.ToString("dd/MM HH:mm")</td>
                                            <td>@order.Duration.ToString(@"hh\:mm")</td>
                                            <td><span class="badge bg-teal-100" style="background-color: #ccfbf1; color: #0d9488;">@order.ItemCount</span></td>
                                            <td><strong>₹@order.TotalAmount.ToString("F2")</strong></td>
                                            <td>
                                                <div class="btn-group">
                                                    <a asp-action="Details" asp-route-id="@order.Id" asp-route-fromBar="false" class="btn btn-sm btn-outline-primary" title="View Order" target="_blank" rel="noopener noreferrer">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Payment/Index/@order.Id" class="btn btn-sm btn-outline-success" title="Process Payment" target="_blank" rel="noopener noreferrer">
                                                        <i class="fas fa-credit-card"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-danger cancel-order-trigger" 
                                                            data-order-id="@order.Id" data-order-number="@order.OrderNumber" title="Cancel Order">
                                                        <i class="fas fa-times-circle"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>No active orders at the moment.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Completed / Cancelled Tab Section *@
    @{
        var qFrom = ViewContext.HttpContext.Request.Query["fromDate"].ToString();
        var qTo   = ViewContext.HttpContext.Request.Query["toDate"].ToString();
        var today      = DateTime.Today;
        var yesterday  = DateTime.Today.AddDays(-1);
        var last7Start = DateTime.Today.AddDays(-6);
        var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    }
    <div class="row mt-3">
        <div class="col-12">
            <div class="card order-panel-card">
                <div class="card-header bg-white pt-3 pb-0" style="border-bottom:0">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
                        <ul class="nav nav-tabs border-0" id="historyTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-semibold px-3" id="completedTabBtn"
                                        data-bs-toggle="tab" data-bs-target="#completedTab" type="button" role="tab">
                                    <i class="fas fa-check-circle me-1 text-success"></i>Completed
                                    <span class="badge bg-success ms-1" style="font-size:.72rem">@(Model.CompletedOrders?.Count ?? 0)</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-semibold px-3" id="cancelledTabBtn"
                                        data-bs-toggle="tab" data-bs-target="#cancelledTab" type="button" role="tab">
                                    <i class="fas fa-ban me-1 text-danger"></i>Cancelled
                                    <span class="badge bg-danger ms-1" style="font-size:.72rem">@(Model.CancelledOrders?.Count ?? 0)</span>
                                </button>
                            </li>
                        </ul>
                        <form class="d-flex align-items-center flex-wrap gap-2 py-2 px-2 rounded" method="get" asp-action="Dashboard"
                              style="background:rgba(248,251,255,.9);border:1px solid #e2e8f0">
                            <div class="btn-group btn-group-sm" role="group">
                                <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard","Order",new{fromDate=today.ToString("yyyy-MM-dd"),toDate=today.ToString("yyyy-MM-dd")})">Today</a>
                                <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard","Order",new{fromDate=yesterday.ToString("yyyy-MM-dd"),toDate=yesterday.ToString("yyyy-MM-dd")})">Yesterday</a>
                                <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard","Order",new{fromDate=last7Start.ToString("yyyy-MM-dd"),toDate=today.ToString("yyyy-MM-dd")})">Last 7 Days</a>
                                <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard","Order",new{fromDate=monthStart.ToString("yyyy-MM-dd"),toDate=today.ToString("yyyy-MM-dd")})">This Month</a>
                            </div>
                            <label class="small mb-0 text-muted">From</label>
                            <input type="date" name="fromDate" class="form-control form-control-sm" value="@qFrom" style="max-width:140px" />
                            <label class="small mb-0 text-muted">To</label>
                            <input type="date" name="toDate" class="form-control form-control-sm" value="@qTo" style="max-width:140px" />
                            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-filter me-1"></i>Filter</button>
                            <a href="@Url.Action("Dashboard","Order")" class="btn btn-sm btn-outline-secondary" title="Reset"><i class="fas fa-undo"></i></a>
                        </form>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="tab-content" id="historyTabsContent">

                        @* ── Completed Tab ──────────────────────────────────────────── *@
                        <div class="tab-pane fade show active" id="completedTab" role="tabpanel">
                            @if (Model.CompletedOrders != null && Model.CompletedOrders.Any())
                            {
                                <div class="p-3">
                                    <div class="table-responsive table-container">
                                        <table class="table table-sm table-striped table-hover" id="completedOrders">
                                            <thead class="sticky order-table-head-completed">
                                                <tr class="text-center">
                                                    <th>Order #</th>
                                                    <th>Type</th>
                                                    <th>Counter</th>
                                                    <th>Total</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var order in Model.CompletedOrders)
                                                {
                                                    <tr class="align-middle text-center" data-counter-id="@(order.CounterId?.ToString() ?? "")">
                                                        <td><strong>@order.OrderNumber</strong></td>
                                                        <td>@order.OrderTypeDisplay</td>
                                                        <td>@(string.IsNullOrWhiteSpace(order.CounterDisplay) ? "-" : order.CounterDisplay)</td>
                                                        <td><strong>₹@order.TotalAmount.ToString("F2")</strong></td>
                                                        <td>
                                                            <div class="btn-group">
                                                                <a asp-action="Details" asp-route-id="@order.Id" asp-route-fromBar="false" class="btn btn-sm btn-outline-secondary" title="View Order" target="_blank" rel="noopener noreferrer">
                                                                    <i class="fas fa-eye"></i>
                                                                </a>
                                                                <a href="/Payment/Index/@order.Id" class="btn btn-sm btn-outline-success" title="Payment" target="_blank" rel="noopener noreferrer">
                                                                    <i class="fas fa-credit-card"></i>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="alert mt-2 mb-0 py-2" style="background-color:#ccfbf1;border-color:#0d9488;color:#134e4a">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <strong>Total Completed:</strong> @Model.CompletedOrdersCount
                                                <span class="mx-2">|</span>
                                                <strong>Total Sales:</strong> ₹@Model.TotalSales.ToString("F2")
                                            </div>
                                            <div class="d-flex gap-2 flex-wrap">
                                                @{
                                                    var dineInCount   = Model.CompletedOrders.Count(o => o.OrderType == 0);
                                                    var takeoutCount  = Model.CompletedOrders.Count(o => o.OrderType == 1);
                                                    var deliveryCount = Model.CompletedOrders.Count(o => o.OrderType == 2);
                                                }
                                                <span class="badge" style="background-color:#0d9488;font-size:.82rem"><i class="fas fa-utensils me-1"></i>Dine In: @dineInCount</span>
                                                <span class="badge" style="background-color:#059669;font-size:.82rem"><i class="fas fa-shopping-bag me-1"></i>Takeout: @takeoutCount</span>
                                                <span class="badge" style="background-color:#0891b2;font-size:.82rem"><i class="fas fa-motorcycle me-1"></i>Delivery: @deliveryCount</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3">
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i>No completed orders @(string.IsNullOrEmpty(qFrom) ? "today" : "for this range").
                                    </div>
                                </div>
                            }
                        </div>

                        @* ── Cancelled Tab ──────────────────────────────────────────── *@
                        <div class="tab-pane fade" id="cancelledTab" role="tabpanel">
                            @if (Model.CancelledOrders != null && Model.CancelledOrders.Any())
                            {
                                <div class="p-3">
                                    <div class="table-responsive table-container">
                                        <table class="table table-striped table-hover" id="cancelledOrders">
                                            <thead class="sticky order-table-head-cancelled">
                                                <tr class="text-center">
                                                    <th>Order #</th>
                                                    <th>Type</th>
                                                    <th>Counter</th>
                                                    <th>Table/Customer</th>
                                                    <th>Server</th>
                                                    <th>Status</th>
                                                    <th>Time</th>
                                                    <th>Items</th>
                                                    <th>Total</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var order in Model.CancelledOrders)
                                                {
                                                    <tr class="align-middle text-center" data-counter-id="@(order.CounterId?.ToString() ?? "")">
                                                        <td><strong>@order.OrderNumber</strong></td>
                                                        <td>@order.OrderTypeDisplay</td>
                                                        <td>@(string.IsNullOrWhiteSpace(order.CounterDisplay) ? "-" : order.CounterDisplay)</td>
                                                        <td>
                                                            @if (order.OrderType == 0) { @(order.TableName ?? "No Table") }
                                                            else { @(order.GuestName ?? "No Name") }
                                                        </td>
                                                        <td>@(order.ServerName ?? "Unassigned")</td>
                                                        <td><span class="badge bg-danger">Cancelled</span></td>
                                                        <td>@order.Duration.ToString(@"hh\:mm")</td>
                                                        <td><span class="badge bg-danger-subtle text-danger">@order.ItemCount</span></td>
                                                        <td><strong>₹@order.TotalAmount.ToString("F2")</strong></td>
                                                        <td>
                                                            <a asp-action="Details" asp-route-id="@order.Id" asp-route-fromBar="false" class="btn btn-sm btn-outline-secondary" title="View Order">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="alert mt-2 mb-0 py-2" style="background-color:#fee2e2;border-color:#dc2626;color:#991b1b">
                                        <strong>Total Cancelled Today:</strong> @Model.CancelledOrdersCount
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3">
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i>No cancelled orders today.
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const totalOpenOrders = @Model.OpenOrdersCount;
            const totalInProgressOrders = @Model.InProgressOrdersCount;
            const totalReadyOrders = @Model.ReadyOrdersCount;
            const totalSalesAmount = @Model.TotalSales.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

            var isMobileDashboard = window.matchMedia('(max-width: 767.98px)').matches;
            var isTabletDashboard = window.matchMedia('(max-width: 991.98px)').matches && !isMobileDashboard;
            var dashboardScrollY = isMobileDashboard ? '' : (isTabletDashboard ? '38vh' : '28vh');

            function escapeHtml(value) {
                return (value ?? '').toString().replace(/[&<>"']/g, function (c) {
                    return ({
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    })[c];
                });
            }

            function buildTypeFilter(table, containerSelector, columnIndex, idPrefix) {
                var $container = $(containerSelector);
                if (!$container.length) return;

                var raw = table.column(columnIndex).data().toArray();
                var types = raw
                    .map(function (x) { return (x ?? '').toString().trim(); })
                    .filter(function (x) { return x.length; });

                var unique = Array.from(new Set(types)).sort(function (a, b) { return a.localeCompare(b); });
                if (!unique.length) {
                    $container.hide();
                    return;
                }

                var html = '<div class="d-flex align-items-center flex-wrap" style="gap:.75rem;">'
                    + '<span class="small fw-semibold">Type:</span>'
                    + unique.map(function (t, i) {
                        var id = idPrefix + i;
                        return '<div class="form-check form-check-inline m-0">'
                            + '<input class="form-check-input active-type-filter" type="checkbox" id="' + escapeHtml(id) + '" value="' + escapeHtml(t) + '" checked>'
                            + '<label class="form-check-label small" for="' + escapeHtml(id) + '">' + escapeHtml(t) + '</label>'
                            + '</div>';
                    }).join('')
                    + '</div>';

                $container.html(html);

                function apply() {
                    var selected = $container.find('.active-type-filter:checked').map(function () { return $(this).val(); }).get();
                    if (!selected.length) {
                        table.column(columnIndex).search('', true, false).draw();
                        return;
                    }

                    var escaped = selected.map(function (v) { return $.fn.dataTable.util.escapeRegex(v); });
                    var pattern = '^(' + escaped.join('|') + ')$';
                    table.column(columnIndex).search(pattern, true, false).draw();
                }

                $container.on('change', '.active-type-filter', apply);
                apply();
            }

            function parseCurrency(val) {
                const n = parseFloat((val || '').toString().replace(/[^0-9.-]/g, ''));
                return isNaN(n) ? 0 : n;
            }

            function updateKpis() {
                let filteredOpen = 0;
                let filteredInProgress = 0;
                let filteredReady = 0;

                activeTable.rows({ search: 'applied' }).nodes().to$().each(function () {
                    filteredOpen++;
                    const statusText = ($(this).find('td').eq(5).text() || '').trim().toLowerCase();
                    if (statusText.includes('progress')) filteredInProgress++;
                    if (statusText.includes('ready')) filteredReady++;
                });

                let filteredSales = 0;
                completedTable.rows({ search: 'applied' }).nodes().to$().each(function () {
                    filteredSales += parseCurrency($(this).find('td').eq(3).text());
                });

                $('#kpiOpenCount').text(filteredOpen);
                $('#kpiOpenMeta').text('Filtered ' + filteredOpen + ' / Total ' + totalOpenOrders);

                $('#kpiProgressCount').text(filteredInProgress);
                $('#kpiProgressMeta').text('Filtered ' + filteredInProgress + ' / Total ' + totalInProgressOrders);

                $('#kpiReadyCount').text(filteredReady);
                $('#kpiReadyMeta').text('Filtered ' + filteredReady + ' / Total ' + totalReadyOrders);

                $('#kpiSalesAmount').text('₹' + filteredSales.toFixed(2));
                $('#kpiSalesMeta').text('Filtered ₹' + filteredSales.toFixed(2) + ' / Total ₹' + Number(totalSalesAmount).toFixed(2));
            }

            var activeTable = $('#activeOrders').DataTable({
                order: [[6, 'desc']],
                paging: false,
                info: false,
                searching: true,
                scrollY: dashboardScrollY,
                scrollCollapse: !isMobileDashboard,
                scrollX: isTabletDashboard,
                autoWidth: false,
                columnDefs: [
                    { targets: 10, orderable: false }
                ]
            });
            buildTypeFilter(activeTable, '#activeOrdersTypeFilter', 1, 'od_activeType_');
            var cancelledTable = $('#cancelledOrders').DataTable({
                order: [[5, 'desc']],
                paging: false,
                info: false,
                searching: true,
                scrollY: dashboardScrollY,
                scrollCollapse: !isMobileDashboard,
                scrollX: isTabletDashboard,
                autoWidth: false
            });
            var completedTable = $('#completedOrders').DataTable({
                order: [[0, 'desc']],
                paging: false,
                info: false,
                searching: true,
                scrollY: dashboardScrollY,
                scrollCollapse: !isMobileDashboard,
                scrollX: isTabletDashboard,
                autoWidth: false
            });

            // Client-side counter filter by CounterId (stored in data-counter-id per row)
            var selectedCounterId = ($('#counterFilter').val() ?? '').toString();

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var tableId = settings?.nTable?.getAttribute('id') || '';
                if (tableId !== 'activeOrders' && tableId !== 'cancelledOrders' && tableId !== 'completedOrders') return true;

                if (!selectedCounterId) return true; // All

                try {
                    var rowNode = settings.aoData[dataIndex].nTr;
                    var rowCounterId = (rowNode?.getAttribute('data-counter-id') || '').toString();
                    return rowCounterId === selectedCounterId;
                } catch {
                    return true;
                }
            });

            function applyCounterFilter() {
                selectedCounterId = ($('#counterFilter').val() ?? '').toString();
                activeTable.draw();
                cancelledTable.draw();
                completedTable.draw();
                updateKpis();
            }

            $('#counterFilter').on('change', applyCounterFilter);

            activeTable.on('draw', updateKpis);
            completedTable.on('draw', updateKpis);

            // Fix DataTables column widths when switching tabs
            document.querySelectorAll('#historyTabs button[data-bs-toggle="tab"]').forEach(function (btn) {
                btn.addEventListener('shown.bs.tab', function () {
                    cancelledTable.columns.adjust().draw();
                    completedTable.columns.adjust().draw();
                });
            });

            // Apply default selected counter on initial load
            applyCounterFilter();

            // Keep dashboard fresh with user controls.
            const refreshSecondsDefault = 120;
            let refreshRemaining = refreshSecondsDefault;
            let refreshPaused = false;
            let refreshTicker = null;

            function updateRefreshUi() {
                if (refreshPaused) {
                    $('#refreshCountdown').text('Auto refresh paused');
                    $('#toggleAutoRefreshBtn').text('Resume Auto Refresh');
                } else {
                    $('#refreshCountdown').text('Refresh in ' + refreshRemaining + 's');
                    $('#toggleAutoRefreshBtn').text('Pause Auto Refresh');
                }
            }

            function startRefreshTicker() {
                if (refreshTicker) clearInterval(refreshTicker);
                refreshTicker = setInterval(function () {
                    if (refreshPaused) return;
                    refreshRemaining--;
                    if (refreshRemaining <= 0) {
                        location.reload();
                        return;
                    }
                    updateRefreshUi();
                }, 1000);
            }

            $('#toggleAutoRefreshBtn').on('click', function () {
                refreshPaused = !refreshPaused;
                if (!refreshPaused && refreshRemaining <= 0) {
                    refreshRemaining = refreshSecondsDefault;
                }
                updateRefreshUi();
            });

            $('#refreshNowBtn').on('click', function () {
                location.reload();
            });

            updateRefreshUi();
            startRefreshTicker();
        });
    </script>

    @* Enhance Active Orders table header and details *@
    <script>
        // Tooltips
        document.addEventListener('DOMContentLoaded', function () {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl) })
        });
                // Cancel order modal logic
                document.addEventListener('DOMContentLoaded', function() {
                        const modalEl = document.getElementById('cancelOrderModal');
                        const confirmBtn = document.getElementById('confirmCancelOrderBtn');
                        const orderInfoSpan = document.getElementById('cancelOrderInfo');
                        const hiddenOrderId = document.getElementById('cancelOrderId');
                        const bsModal = new bootstrap.Modal(modalEl);
                        document.querySelectorAll('.cancel-order-trigger').forEach(btn => {
                                btn.addEventListener('click', () => {
                                        const id = btn.getAttribute('data-order-id');
                                        const number = btn.getAttribute('data-order-number');
                                        hiddenOrderId.value = id;
                                        orderInfoSpan.textContent = number;
                                        bsModal.show();
                                });
                        });
                        confirmBtn.addEventListener('click', () => {
                                if (!hiddenOrderId.value) return;
                                // navigate to cancel endpoint
                                window.location.href = `/Order/CancelOrder/${hiddenOrderId.value}?returnUrl=/Order/Dashboard`;
                        });
                });
    </script>
}

<!-- Cancel Order Confirmation Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Cancellation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cancelOrderId" />
                <p class="mb-2">You are about to cancel order: <strong id="cancelOrderInfo"></strong></p>
                <div class="alert alert-warning mb-0 small"><i class="fas fa-info-circle me-1"></i>This action cannot be undone and items will be marked as cancelled.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Order</button>
                <button type="button" class="btn btn-danger" id="confirmCancelOrderBtn">Yes, Cancel Order</button>
            </div>
        </div>
    </div>
</div>
