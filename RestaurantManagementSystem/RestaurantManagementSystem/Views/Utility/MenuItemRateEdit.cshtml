@model List<RestaurantManagementSystem.Controllers.MenuItemRateViewModel>
@{
    ViewData["Title"] = "Menu Item Rate Edit";
    bool isMainBranch     = (bool)(ViewBag.IsMainBranch ?? false);
    bool isReadOnly       = (bool)(ViewBag.ReadOnly ?? false);
    int  selectedBranchId = (int)(ViewBag.SelectedBranchId ?? 0);
    var  allBranches      = ViewBag.AllBranches as List<(int BranchId, string BranchName)>;
    int  total            = Model.Count;
}

@Html.AntiForgeryToken()

<style>
    .rate-header      { background: linear-gradient(135deg, #1a3c5b 0%, #2563a8 100%); }
    .stat-card        { border-radius: 12px; border: none; }
    .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .rate-table th    { background: #1a3c5b; color: #fff; font-size: .78rem;
        text-transform: uppercase; letter-spacing: .4px; border: none; white-space: nowrap; }
    .rate-table td    { vertical-align: middle; font-size: .87rem; padding: .45rem .6rem; }
    .rate-table tbody tr:hover  { background: #f0f7ff; }
    .rate-table tbody tr.dirty  { background: #fffbeb !important; }
    .rate-input       { width: 100px; text-align: right; font-size: .85rem;
        padding: .25rem .4rem; border: 1px solid #d1d5db; border-radius: 6px;
        transition: border-color .2s, box-shadow .2s; }
    .rate-input:focus { border-color: #2563a8; box-shadow: 0 0 0 3px rgba(37,99,168,.15); outline: none; }
    .rate-input.changed { border-color: #f59e0b; background: #fffbeb; }
    .rate-input:disabled { background: #f3f4f6; color: #6b7280; cursor: not-allowed; border-color: #e5e7eb; }
    .plu-badge        { font-size: .72rem; font-weight: 600; color: #fff;
        background: #1a3c5b; border-radius: 4px; padding: 1px 5px; margin-right: 4px;
        letter-spacing: .5px; }
    .btn-save-row     { font-size: .75rem; padding: .2rem .6rem; border-radius: 6px; white-space: nowrap; }
    .saved-tick       { color: #2563a8; font-size: .85rem; display: none; }
    .filter-bar input, .filter-bar select { font-size: .85rem; }
    .category-pill    { font-size: .72rem; background: #dbeafe; color: #1e40af;
        border-radius: 12px; padding: 2px 8px; white-space: nowrap; }
</style>

<!-- Page Header -->
<div class="rate-header text-white rounded-3 p-4 mb-4 shadow-sm">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="mb-1 fw-bold">
                <i class="fas fa-tags me-2"></i>Menu Item Rate Edit
            </h4>
            <p class="mb-0 opacity-75 small">
                View and update Base, Takeout, Delivery &amp; Room Service prices per branch.
                Changes are saved individually per row or all at once.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            @if (isMainBranch && allBranches != null)
            {
                <form method="get" class="d-flex align-items-center gap-2">
                    <label class="text-white small mb-0 fw-semibold">Branch:</label>
                    <select name="branchId" class="form-select form-select-sm" style="width:auto;min-width:200px;" onchange="this.form.submit()">
                        @foreach (var b in allBranches)
                        {
                            if (b.BranchId == selectedBranchId)
                            {
                                <option value="@b.BranchId" selected="selected">@b.BranchName</option>
                            }
                            else
                            {
                                <option value="@b.BranchId">@b.BranchName</option>
                            }
                        }
                    </select>
                </form>
            }
            else if (!isMainBranch)
            {
                <span class="badge bg-warning text-dark px-3 py-2" style="font-size:.82rem;">
                    <i class="fas fa-lock me-1"></i>View Only &mdash; Rate editing is restricted to the main branch.
                </span>
            }
            @if (!isReadOnly)
            {
                <button id="btnSaveAll" class="btn btn-warning fw-semibold btn-sm" title="Save all rows with pending changes" disabled>
                    <i class="fas fa-save me-1"></i>Save All Changes <span id="dirtyCount" class="badge bg-dark ms-1">0</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#dbeafe;">
                    <i class="fas fa-utensils text-primary"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@total</div>
                    <div class="text-muted small">Total Items</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#dbeafe;">
                    <i class="fas fa-shopping-bag text-primary"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.Count(x => x.TakeoutPrice.HasValue)</div>
                    <div class="text-muted small">Takeout Priced</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fef3c7;">
                    <i class="fas fa-motorcycle text-warning"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.Count(x => x.DeliveryPrice.HasValue)</div>
                    <div class="text-muted small">Delivery Priced</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#ede9fe;">
                    <i class="fas fa-concierge-bell text-purple"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.Count(x => x.RoomServicePrice.HasValue)</div>
                    <div class="text-muted small">Room Service</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <div class="d-flex gap-2 flex-wrap align-items-center filter-bar">
            <input type="search" id="searchBox" class="form-control form-control-sm" placeholder="Search by PLU or item name..." style="max-width:260px;">
            <select id="categoryFilter" class="form-select form-select-sm" style="max-width:200px;">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Select(x => x.CategoryName).Distinct().OrderBy(x => x))
                {
                    <option>@cat</option>
                }
            </select>
            <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                <i class="fas fa-times me-1"></i>Clear
            </button>
            <span class="ms-auto text-muted small" id="visibleCount">Showing @total of @total</span>
        </div>
    </div>
</div>

<!-- Rates Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover rate-table mb-0" id="rateTable">
                <thead>
                    <tr>
                        <th style="width:220px;">Menu Item</th>
                        <th style="width:120px;">Category</th>
                        <th style="width:110px;" class="text-end">Base (₹)</th>
                        <th style="width:110px;" class="text-end">Takeout (₹)</th>
                        <th style="width:110px;" class="text-end">Delivery (₹)</th>
                        <th style="width:120px;" class="text-end">Room Svc (₹)</th>
                        <th style="width:90px;" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="rateBody">
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.MenuItemId" data-name="@((item.PLUCode + " " + item.MenuItemName).ToLower())" data-cat="@item.CategoryName">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.PLUCode))
                                {
                                    <span class="plu-badge">@item.PLUCode</span>
                                }
                                <span class="fw-semibold">@item.MenuItemName</span>
                            </td>
                            <td><span class="category-pill">@item.CategoryName</span></td>
                            <td class="text-end">
                                <input type="number" class="rate-input ri-base" min="0" step="0.01"
                                       value="@item.BasePrice.ToString("F2")"
                                       data-original="@item.BasePrice.ToString("F2")"
                                       title="Base price"
                                       @(isReadOnly ? "disabled" : "") />
                            </td>
                            <td class="text-end">
                                <input type="number" class="rate-input ri-takeout" min="0" step="0.01"
                                       value="@(item.TakeoutPrice.HasValue ? item.TakeoutPrice.Value.ToString("F2") : "")"
                                       data-original="@(item.TakeoutPrice.HasValue ? item.TakeoutPrice.Value.ToString("F2") : "")"
                                       placeholder="—"
                                       title="Takeout price"
                                       @(isReadOnly ? "disabled" : "") />
                            </td>
                            <td class="text-end">
                                <input type="number" class="rate-input ri-delivery" min="0" step="0.01"
                                       value="@(item.DeliveryPrice.HasValue ? item.DeliveryPrice.Value.ToString("F2") : "")"
                                       data-original="@(item.DeliveryPrice.HasValue ? item.DeliveryPrice.Value.ToString("F2") : "")"
                                       placeholder="—"
                                       title="Delivery price"
                                       @(isReadOnly ? "disabled" : "") />
                            </td>
                            <td class="text-end">
                                <input type="number" class="rate-input ri-roomsvc" min="0" step="0.01"
                                       value="@(item.RoomServicePrice.HasValue ? item.RoomServicePrice.Value.ToString("F2") : "")"
                                       data-original="@(item.RoomServicePrice.HasValue ? item.RoomServicePrice.Value.ToString("F2") : "")"
                                       placeholder="—"
                                       title="Room service price"
                                       @(isReadOnly ? "disabled" : "") />
                            </td>
                            <td class="text-center">
                                @if (!isReadOnly)
                                {
                                    <button type="button" class="btn btn-primary btn-save-row" title="Save this row">
                                        <i class="fas fa-check me-1"></i>Save
                                    </button>
                                    <span class="saved-tick ms-1"><i class="fas fa-check-circle"></i></span>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="fas fa-lock"></i></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
@if (!isReadOnly)
{
<script>
document.addEventListener('DOMContentLoaded', function () {

    const token    = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const body     = document.getElementById('rateBody');
    const btnSaveAll    = document.getElementById('btnSaveAll');
    const dirtyCountEl  = document.getElementById('dirtyCount');

    // ── Dirty tracking ────────────────────────────────────────────
    function updateDirtyCount() {
        const count = body.querySelectorAll('tr.dirty').length;
        dirtyCountEl.textContent = count;
        btnSaveAll.disabled = count === 0;
    }

    body.addEventListener('input', function (e) {
        if (!e.target.classList.contains('rate-input')) return;
        const input = e.target;
        const row   = input.closest('tr');
        const isDiff = [...row.querySelectorAll('.rate-input')]
            .some(i => i.value !== i.dataset.original);
        row.classList.toggle('dirty', isDiff);
        input.classList.toggle('changed', input.value !== input.dataset.original);
        updateDirtyCount();
    });

    // ── Build save payload from a row ────────────────────────────
    function buildPayload(row) {
        const val = (sel) => {
            const v = row.querySelector(sel).value.trim();
            return v === '' ? null : parseFloat(v);
        };
        return {
            menuItemId:       parseInt(row.dataset.id),
            basePrice:        val('.ri-base') ?? 0,
            takeoutPrice:     val('.ri-takeout'),
            deliveryPrice:    val('.ri-delivery'),
            roomServicePrice: val('.ri-roomsvc')
        };
    }

    async function postJSON(url, payload) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload)
        });
        return res.json();
    }

    // ── Mark row saved ────────────────────────────────────────────
    function markSaved(row) {
        row.classList.remove('dirty');
        row.querySelectorAll('.rate-input').forEach(i => {
            i.dataset.original = i.value;
            i.classList.remove('changed');
        });
        const tick = row.querySelector('.saved-tick');
        tick.style.display = 'inline';
        setTimeout(() => tick.style.display = 'none', 2000);
        updateDirtyCount();
    }

    // ── Row-level save ────────────────────────────────────────────
    body.addEventListener('click', async function (e) {
        const btn = e.target.closest('.btn-save-row');
        if (!btn) return;
        const row = btn.closest('tr');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving…';
        try {
            const res = await postJSON('/Utility/SaveMenuItemRate', buildPayload(row));
            if (res.success) {
                markSaved(row);
                toastr.success(res.message, 'Saved');
            } else {
                Swal.fire({ icon: 'error', title: 'Save failed', text: res.message });
            }
        } catch {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check me-1"></i>Save';
        }
    });

    // ── Save All ─────────────────────────────────────────────────
    btnSaveAll.addEventListener('click', async function () {
        const dirtyRows = [...body.querySelectorAll('tr.dirty')];
        if (dirtyRows.length === 0) return;

        const confirm = await Swal.fire({
            icon: 'question',
            title: 'Save All Changes?',
            text: `${dirtyRows.length} item(s) with pending changes will be saved.`,
            showCancelButton: true,
            confirmButtonText: 'Yes, Save All',
            confirmButtonColor: '#1a3c5b'
        });
        if (!confirm.isConfirmed) return;

        btnSaveAll.disabled = true;
        btnSaveAll.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving…';

        try {
            const items = dirtyRows.map(r => buildPayload(r));
            const res   = await postJSON('/Utility/SaveAllMenuItemRates', { items });
            if (res.success) {
                dirtyRows.forEach(r => markSaved(r));
                toastr.success(res.message, 'Saved');
            } else {
                Swal.fire({ icon: 'warning', title: 'Partial Save', text: res.message });
                // Still mark successfully saved rows clean
                dirtyRows.forEach(r => markSaved(r));
            }
        } catch {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
        } finally {
            btnSaveAll.disabled = false;
            btnSaveAll.innerHTML = '<i class="fas fa-save me-1"></i>Save All Changes <span id="dirtyCount" class="badge bg-dark ms-1">0</span>';
            updateDirtyCount();
        }
    });
});
</script>
}
<script>
// Search + category filter — always active (read-only and edit modes)
document.addEventListener('DOMContentLoaded', function () {
    const searchBox      = document.getElementById('searchBox');
    const categoryFilter = document.getElementById('categoryFilter');
    const visibleCount   = document.getElementById('visibleCount');
    const allRows        = [...document.querySelectorAll('#rateBody tr')];

    function filterTable() {
        const term = searchBox.value.toLowerCase().trim();
        const cat  = categoryFilter.value;
        let shown  = 0;
        allRows.forEach(row => {
            const nameMatch = !term || row.dataset.name.includes(term);
            const catMatch  = !cat  || row.dataset.cat === cat;
            row.style.display = (nameMatch && catMatch) ? '' : 'none';
            if (nameMatch && catMatch) shown++;
        });
        visibleCount.textContent = `Showing ${shown} of ${allRows.length}`;
    }

    window.clearFilters = function () {
        searchBox.value = '';
        categoryFilter.value = '';
        filterTable();
    };

    searchBox.addEventListener('input', filterTable);
    categoryFilter.addEventListener('change', filterTable);
});
</script>
}
