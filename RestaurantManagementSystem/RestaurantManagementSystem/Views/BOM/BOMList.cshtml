@model List<RestaurantManagementSystem.Models.BOMListItemViewModel>
@{
    ViewData["Title"] = "BOM Configure";
    int configured = Model.Count(x => x.IsConfigured);
    int total      = Model.Count;
    int missing    = total - configured;
    decimal avgMargin = Model.Where(x => x.GrossMarginPct.HasValue).Any()
        ? Math.Round(Model.Where(x => x.GrossMarginPct.HasValue).Average(x => x.GrossMarginPct!.Value), 1)
        : 0;
    bool isMainBranch = (bool)(ViewBag.IsMainBranch ?? false);
}

<style>
    .bom-header { background: linear-gradient(135deg, #1a3c5b 0%, #2563a8 100%); }
    .stat-card   { border-radius: 12px; border: none; }
    .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .bom-table th  { background: #1a3c5b; color: #fff; font-size: .8rem;
        text-transform: uppercase; letter-spacing: .4px; border: none; }
    .bom-table td  { vertical-align: middle; font-size: .87rem; }
    .bom-table tbody tr:hover { background: #f0f7ff; }
    .badge-configured   { background: #dcfce7; color: #15803d; }
    .badge-notconfigured{ background: #fef3c7; color: #92400e; }
    .filter-bar input, .filter-bar select { font-size: .85rem; }
    .progress-configured { height: 6px; border-radius: 4px; background: #e2e8f0; }
    .progress-configured .bar { background: #22c55e; border-radius: 4px; }
</style>

<!-- Page Header -->
<div class="bom-header text-white rounded-3 p-4 mb-4 shadow-sm">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="mb-1 fw-bold">
                <i class="fas fa-layer-group me-2"></i>BOM Configure
            </h4>
            <p class="mb-0 text-white-50 small">
                Bill of Material &mdash; Link Menu Items to Ingredient Master with cost &amp; margin visibility.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("IngredientsList","Master")" class="btn btn-outline-light btn-sm">
                <i class="fas fa-flask me-1"></i>Ingredient Master
            </a>
            <a href="@Url.Action("Index","Uom")" class="btn btn-outline-light btn-sm">
                <i class="fas fa-ruler-combined me-1"></i>UOM Master
            </a>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#dbeafe;">
                    <i class="fas fa-utensils text-primary"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@total</div>
                    <div class="text-muted small">Total Menu Items</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#dcfce7;">
                    <i class="fas fa-check-circle text-success"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-success">@configured</div>
                    <div class="text-muted small">BOM Configured</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fef3c7;">
                    <i class="fas fa-exclamation-triangle" style="color:#d97706;"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold" style="color:#d97706;">@missing</div>
                    <div class="text-muted small">Pending Setup</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#f3e8ff;">
                    <i class="fas fa-percent" style="color:#7c3aed;"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold" style="color:#7c3aed;">@avgMargin%</div>
                    <div class="text-muted small">Avg Gross Margin</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Coverage Progress -->
@if (total > 0)
{
    int pct = (int)Math.Round((double)configured / total * 100);
    <div class="mb-4 p-3 bg-white rounded-3 shadow-sm border">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <small class="fw-semibold text-muted text-uppercase" style="letter-spacing:.4px;">BOM Coverage</small>
            <small class="fw-bold text-success">@pct%</small>
        </div>
        <div class="progress-configured">
            <div class="bar" style="width:@pct%;height:6px;"></div>
        </div>
    </div>
}

<!-- Filter Bar -->
<div class="card shadow-sm mb-3 border-0">
    <div class="card-body py-2">
        <div class="row g-2 filter-bar align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchBox" class="form-control border-start-0"
                           placeholder="Search menu item name…" oninput="filterTable()">
                </div>
            </div>
            <div class="col-md-3">
                <select id="categoryFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Select(x => x.CategoryName ?? "Uncategorised").Distinct().OrderBy(x => x))
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Items</option>
                    <option value="configured">BOM Configured</option>
                    <option value="pending">Pending Setup</option>
                </select>
            </div>
            <div class="col-md-1 text-end">
                <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()" title="Clear filters">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Main Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered mb-0 bom-table" id="bomTable">
                <thead>
                    <tr>
                        <th style="width:30px;">#</th>
                        <th>Menu Item</th>
                        <th>Category</th>
                        <th class="text-end">Selling Price</th>
                        <th class="text-center">Ingredients</th>
                        <th class="text-end">BOM Cost</th>
                        <th class="text-center">Gross Margin (All Prices)</th>
                        <th class="text-center">Status</th>
                        <th class="text-center" style="width:110px;">Action</th>
                    </tr>
                </thead>
                <tbody id="bomTableBody">
                    @{ int rowNum = 0; }
                    @foreach (var item in Model)
                    {
                        rowNum++;
                        <tr data-name="@((item.PLUCode ?? "") + " " + item.MenuItemName.ToLower())"
                            data-category="@(item.CategoryName ?? "Uncategorised")"
                            data-status="@(item.IsConfigured ? "configured" : "pending")">
                            <td class="text-muted">@rowNum</td>
                            <td class="fw-semibold">
                                @if (!string.IsNullOrEmpty(item.PLUCode))
                                {
                                    <span class="text-muted me-1" style="font-size:.75rem;">[<span class="fw-bold" style="color:#2563a8;">@item.PLUCode</span>]</span>
                                }
                                @item.MenuItemName
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CategoryName))
                                {
                                    <span class="badge rounded-pill text-bg-light border">
                                        @item.CategoryName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">
                                <div class="small"><span class="text-muted" style="font-size:.7rem;">Base:</span> ₹@item.SellingPrice.ToString("N2")</div>
                                @if (item.TakeoutPrice.HasValue)
                                {
                                    <div class="small text-primary" style="font-size:.8rem;"><span class="text-muted" style="font-size:.7rem;">Takeout:</span> ₹@item.TakeoutPrice.Value.ToString("N2")</div>
                                }
                                @if (item.DeliveryPrice.HasValue)
                                {
                                    <div class="small text-warning-emphasis" style="font-size:.8rem;"><span class="text-muted" style="font-size:.7rem;">Delivery:</span> ₹@item.DeliveryPrice.Value.ToString("N2")</div>
                                }
                                @if (item.RoomServicePrice.HasValue)
                                {
                                    <div class="small text-purple" style="font-size:.8rem;color:#7c3aed;"><span class="text-muted" style="font-size:.7rem;">Room:</span> ₹@item.RoomServicePrice.Value.ToString("N2")</div>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.LineCount > 0)
                                {
                                    <span class="badge text-bg-primary rounded-pill">@item.LineCount</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.BOMCost.HasValue)
                                {
                                    <span class="fw-semibold">₹@item.BOMCost.Value.ToString("N4")</span>
                                    if (item.LastCalculated.HasValue)
                                    {
                                        <br><small class="text-muted">@item.LastCalculated.Value.ToString("dd MMM HH:mm")</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Not calculated</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.BOMCost.HasValue)
                                {
                                    <div>
                                        <span class="badge @BOMListItemViewModel.GetMarginBadgeClass(item.GrossMarginPct) rounded-pill" style="font-size:.7rem;">
                                            <span class="text-white-50" style="font-size:.65rem;">Base </span>@(item.GrossMarginPct.HasValue ? item.GrossMarginPct.Value.ToString("N1")+"%" : "—")
                                        </span>
                                    </div>
                                    @if (item.TakeoutPrice.HasValue)
                                    {
                                        <div class="mt-1">
                                            <span class="badge @BOMListItemViewModel.GetMarginBadgeClass(item.TakeoutMarginPct) rounded-pill" style="font-size:.7rem;">
                                                <span class="text-white-50" style="font-size:.65rem;">Takeout </span>@(item.TakeoutMarginPct.HasValue ? item.TakeoutMarginPct.Value.ToString("N1")+"%" : "—")
                                            </span>
                                        </div>
                                    }
                                    @if (item.DeliveryPrice.HasValue)
                                    {
                                        <div class="mt-1">
                                            <span class="badge @BOMListItemViewModel.GetMarginBadgeClass(item.DeliveryMarginPct) rounded-pill" style="font-size:.7rem;">
                                                <span class="text-white-50" style="font-size:.65rem;">Delivery </span>@(item.DeliveryMarginPct.HasValue ? item.DeliveryMarginPct.Value.ToString("N1")+"%" : "—")
                                            </span>
                                        </div>
                                    }
                                    @if (item.RoomServicePrice.HasValue)
                                    {
                                        <div class="mt-1">
                                            <span class="badge @BOMListItemViewModel.GetMarginBadgeClass(item.RoomServiceMarginPct) rounded-pill" style="font-size:.7rem;">
                                                <span class="text-white-50" style="font-size:.65rem;">Room </span>@(item.RoomServiceMarginPct.HasValue ? item.RoomServiceMarginPct.Value.ToString("N1")+"%" : "—")
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsConfigured)
                                {
                                    <span class="badge badge-configured rounded-pill small">
                                        <i class="fas fa-check-circle me-1"></i>Configured
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-notconfigured rounded-pill small">
                                        <i class="fas fa-clock me-1"></i>Pending
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("BOMConfigure","BOM", new { id = item.MenuItemId })"
                                   class="btn btn-sm @(item.IsConfigured ? "btn-outline-primary" : "btn-warning") px-3"
                                   title="@(item.IsConfigured ? "Edit BOM" : "Configure BOM")">
                                    <i class="fas @(item.IsConfigured ? "fa-edit" : "fa-cog") me-1"></i>
                                    @(item.IsConfigured ? "Edit" : "Configure")
                                </a>
                                @if (isMainBranch && item.IsConfigured && !string.IsNullOrEmpty(item.PLUCode))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success ms-1 btn-copy-bom"
                                            data-menu-item-id="@item.MenuItemId"
                                            data-menu-item-name="@Html.Raw(item.MenuItemName.Replace("\"","&quot;"))"
                                            data-plu="@item.PLUCode"
                                            title="Copy BOM to other branches">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fas fa-utensils fa-2x mb-2 d-block"></i>
                                No menu items found. Please add menu items first.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-light d-flex justify-content-between align-items-center small text-muted py-2">
        <span id="rowCount">Showing @total items</span>
        <span>
            <i class="fas fa-info-circle me-1"></i>
            Gross Margin = (Selling Price − BOM Cost) ÷ Selling Price × 100
        </span>
    </div>
</div>

@if (isMainBranch)
{
    @Html.AntiForgeryToken()
<style>
.bom-ms-wrapper { position: relative; }
.bom-ms-trigger {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 12px; border: 1.5px solid #ced4da; border-radius: 8px;
    cursor: pointer; background: #fff; user-select: none; font-size: .9rem;
    transition: border-color .15s;
}
.bom-ms-trigger:hover { border-color: #2563a8; }
.bom-ms-wrapper.open .bom-ms-trigger { border-color: #2563a8; box-shadow: 0 0 0 3px rgba(37,99,168,.12); }
.bom-ms-arrow { transition: transform .2s; color: #6c757d; }
.bom-ms-wrapper.open .bom-ms-arrow { transform: rotate(180deg); }
.bom-ms-dropdown {
    position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 1060;
    background: #fff; border: 1.5px solid #ced4da; border-radius: 10px;
    box-shadow: 0 6px 24px rgba(0,0,0,.13); display: none; flex-direction: column;
    max-height: 260px; overflow: hidden;
}
.bom-ms-wrapper.open .bom-ms-dropdown { display: flex; }
.bom-ms-search { padding: 8px 10px; border-bottom: 1px solid #e9ecef; }
.bom-ms-search input {
    width: 100%; border: 1.5px solid #dee2e6; border-radius: 6px;
    padding: 6px 10px; font-size: .85rem; outline: none; background: #f8f9fa;
}
.bom-ms-search input:focus { border-color: #2563a8; background: #fff; }
.bom-ms-items { overflow-y: auto; flex: 1; }
.bom-ms-item {
    display: flex; align-items: center; gap: 10px; padding: 9px 14px;
    cursor: pointer; font-size: .9rem; transition: background .1s;
}
.bom-ms-item:hover { background: #f0f7ff; }
.bom-ms-item.all-item { border-bottom: 1px solid #e9ecef; font-weight: 600; }
.bom-ms-item input[type=checkbox] {
    width: 17px; height: 17px; accent-color: #2563a8;
    cursor: pointer; flex-shrink: 0;
}
.bom-ms-label-pill {
    display: inline-block; background: #e8f0fe; color: #2563a8;
    border-radius: 20px; padding: 2px 10px; font-size: .78rem; font-weight: 600;
}
</style>
    <!-- Copy BOM Modal -->
    <div class="modal fade" id="copyBOMModal" tabindex="-1" aria-labelledby="copyBOMModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(135deg,#1a7f37,#2dba4e);color:#fff;">
                    <h5 class="modal-title" id="copyBOMModalLabel">
                        <i class="fas fa-copy me-2"></i>Copy BOM to Branches
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Copying BOM configuration for:
                        <strong id="copyBOMItemName"></strong>
                        <span class="badge bg-secondary ms-1" id="copyBOMPLU"></span>
                    </p>
                    <label class="form-label fw-semibold small text-uppercase text-muted" style="letter-spacing:.4px;">Select Branches</label>
                    <div id="copyBOMBranchList">
                        <div class="text-center py-3">
                            <i class="fas fa-spinner fa-spin"></i> Loading branches…
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="btnDoCopy">
                        <i class="fas fa-copy me-1"></i>Copy BOM
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
function filterTable() {
    const q       = document.getElementById('searchBox').value.toLowerCase();
    const cat     = document.getElementById('categoryFilter').value;
    const status  = document.getElementById('statusFilter').value;
    const rows    = document.querySelectorAll('#bomTableBody tr[data-name]');
    let visible   = 0;

    rows.forEach(r => {
        const nameMatch   = r.dataset.name.includes(q);
        const catMatch    = !cat    || r.dataset.category === cat;
        const statusMatch = !status || r.dataset.status  === status;
        const show        = nameMatch && catMatch && statusMatch;
        r.style.display   = show ? '' : 'none';
        if (show) visible++;
    });
    document.getElementById('rowCount').textContent = `Showing ${visible} items`;
}

function clearFilters() {
    document.getElementById('searchBox').value = '';
    document.getElementById('categoryFilter').value = '';
    document.getElementById('statusFilter').value = '';
    filterTable();
}

@if (isMainBranch)
{
    <text>
document.addEventListener('DOMContentLoaded', function() {

// ── Copy BOM logic ────────────────────────────────────────
let _copyMenuItemId = 0;

document.querySelectorAll('.btn-copy-bom').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
        e.stopPropagation();
        _copyMenuItemId = parseInt(this.dataset.menuItemId);
        document.getElementById('copyBOMItemName').textContent = this.dataset.menuItemName;
        document.getElementById('copyBOMPLU').textContent = '[' + this.dataset.plu + ']';

        const listEl = document.getElementById('copyBOMBranchList');
        listEl.innerHTML = '<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Loading branches…</div>';

        const btnDo = document.getElementById('btnDoCopy');
        btnDo.style.display = '';
        btnDo.disabled = false;
        btnDo.innerHTML = '<i class="fas fa-copy me-1"></i>Copy BOM';

        var modalEl = document.getElementById('copyBOMModal');
        var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();

        fetch('@Url.Action("GetBranchesForBOMCopy","BOM")')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) {
                    listEl.innerHTML = '<div class="alert alert-danger mb-0">' + data.message + '</div>';
                    return;
                }
                if (!data.branches || data.branches.length === 0) {
                    listEl.innerHTML = '<div class="text-muted small">No other branches available.</div>';
                    return;
                }
                // Build searchable checkbox dropdown
                var itemsHtml = '<label class="bom-ms-item all-item">'
                    + '<input type="checkbox" id="chk_all"> All'
                    + '</label>';
                data.branches.forEach(function(b) {
                    itemsHtml += '<label class="bom-ms-item" data-name="' + b.branchName.toLowerCase() + '">'
                        + '<input type="checkbox" class="branch-chk" value="' + b.branchId + '"> ' + b.branchName
                        + '</label>';
                });
                listEl.innerHTML =
                    '<div class="bom-ms-wrapper" id="bmsWrapper">'
                    + '<div class="bom-ms-trigger" id="bmsTrigger">'
                    + '<span id="bmsLabel"><span class="text-muted">Select branches…</span></span>'
                    + '<i class="fas fa-chevron-down bom-ms-arrow"></i>'
                    + '</div>'
                    + '<div class="bom-ms-dropdown" id="bmsDropdown">'
                    + '<div class="bom-ms-search"><input type="text" id="bmsSearch" placeholder="Search…"></div>'
                    + '<div class="bom-ms-items" id="bmsItems">' + itemsHtml + '</div>'
                    + '</div></div>';

                // Wire up events on freshly created elements
                document.getElementById('bmsTrigger').addEventListener('click', function(ev) {
                    ev.stopPropagation();
                    document.getElementById('bmsWrapper').classList.toggle('open');
                });
                document.getElementById('bmsSearch').addEventListener('input', function() {
                    var lq = this.value.toLowerCase().trim();
                    document.querySelectorAll('#bmsItems .bom-ms-item:not(.all-item)').forEach(function(el) {
                        el.style.display = (!lq || el.dataset.name.includes(lq)) ? '' : 'none';
                    });
                });
                document.getElementById('chk_all').addEventListener('change', function() {
                    document.querySelectorAll('.branch-chk').forEach(function(c) { c.checked = this.checked; }.bind(this));
                    bmsUpdateLabel();
                });
                listEl.addEventListener('change', function(ev) {
                    if (ev.target.classList.contains('branch-chk')) bmsUpdateLabel();
                });
                // Close when clicking outside
                document.addEventListener('click', function outsideHandler(ev) {
                    var w = document.getElementById('bmsWrapper');
                    if (w && !w.contains(ev.target)) w.classList.remove('open');
                    if (!document.getElementById('copyBOMModal').classList.contains('show'))
                        document.removeEventListener('click', outsideHandler);
                });
            })
            .catch(function() {
                listEl.innerHTML = '<div class="alert alert-danger mb-0">Failed to load branches.</div>';
            });
    });
});

function bmsUpdateLabel() {
    var all     = document.querySelectorAll('.branch-chk');
    var checked = Array.from(all).filter(function(c) { return c.checked; });
    var allChk  = document.getElementById('chk_all');
    if (allChk) allChk.checked = (checked.length > 0 && checked.length === all.length);
    var lbl = document.getElementById('bmsLabel');
    if (!lbl) return;
    if (checked.length === 0) {
        lbl.innerHTML = '<span class="text-muted">Select branches…</span>';
    } else if (checked.length === all.length) {
        lbl.innerHTML = '<span class="bom-ms-label-pill">All branches selected</span>';
    } else {
        lbl.innerHTML = checked.map(function(c) {
            return '<span class="bom-ms-label-pill me-1">' + c.closest('label').textContent.trim() + '</span>';
        }).join('');
    }
}

document.getElementById('btnDoCopy').addEventListener('click', function() {
    var selected = Array.from(document.querySelectorAll('.branch-chk:checked')).map(function(c) { return parseInt(c.value); });
    if (selected.length === 0) {
        Swal.fire({ icon: 'warning', title: 'No Branch Selected', text: 'Please select at least one branch.', confirmButtonColor: '#2563a8' });
        return;
    }

    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Copying…';

    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    fetch('@Url.Action("CopyBOMToBranches","BOM")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ menuItemId: _copyMenuItemId, targetBranchIds: selected })
    })
    .then(function(r) {
        if (!r.ok) throw new Error('Server error ' + r.status + '. Please try again.');
        return r.json();
    })
    .then(function(data) {
        btn.style.display = 'none';
        var listEl = document.getElementById('copyBOMBranchList');
        var html = '<ul class="list-group mt-2">';
        (data.results || []).forEach(function(r) {
            var cls, icon;
            if (r.skipped) {
                cls  = 'list-group-item-secondary';
                icon = 'fa-minus-circle text-secondary';
            } else if (r.success) {
                cls  = 'list-group-item-success';
                icon = 'fa-check-circle text-success';
            } else {
                cls  = 'list-group-item-danger';
                icon = 'fa-times-circle text-danger';
            }
            html += '<li class="list-group-item ' + cls + ' d-flex align-items-center gap-2">'
                  + '<i class="fas ' + icon + '"></i>' + r.message + '</li>';
        });
        html += '</ul>';
        listEl.innerHTML = html;
    })
    .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-copy me-1"></i>Copy BOM';
        Swal.fire({ icon: 'error', title: 'Copy Failed', text: err.message || 'An unexpected error occurred.', confirmButtonColor: '#dc3545' });
    });
});

}); // end DOMContentLoaded
    </text>
}

</script>
}
