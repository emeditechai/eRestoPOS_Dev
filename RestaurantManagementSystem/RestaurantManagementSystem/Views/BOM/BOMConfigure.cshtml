@model RestaurantManagementSystem.Models.BOMConfigureViewModel
@{
    ViewData["Title"] = "BOM Configure – " + Model.MenuItemName;
    var ingredients = ViewBag.IngredientDropdown as List<dynamic> ?? new List<dynamic>();
    // Serialise for JS
    var ingredientJson = System.Text.Json.JsonSerializer.Serialize(
        ingredients.Select(i => new {
            id           = (int)i.id,
            name         = (string)i.name,
            category     = (string)i.category,
            uomCode      = (string)i.uomCode,
            convFactor   = (decimal)i.convFactor,
            standardCost = (decimal)i.standardCost,   // branch stock weighted avg only
            hasLiveCost  = (bool)i.hasLiveCost         // false = no stock in branch
        }));
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    .bom-header { background: linear-gradient(135deg, #1a3c5b 0%, #2563a8 100%); }
    .section-card { border-radius: 12px; border: none; }
    .section-title { font-size: .75rem; text-transform: uppercase;
        letter-spacing: .5px; color: #64748b; font-weight: 600; }
    .cost-panel { background: #f0f9ff; border: 1px solid #bae6fd;
        border-radius: 12px; }
    .cost-big   { font-size: 1.8rem; font-weight: 700; color: #0369a1; }
    .margin-big { font-size: 1.8rem; font-weight: 700; }
    .ingredient-line td { vertical-align: middle; font-size: .85rem; }
    .ingredient-line:hover { background: #f8fafc; }
    .add-line-row td { background: #f8faff; }
    #bomLinesTable thead th { vertical-align: middle; white-space: nowrap; }
    .formula-box { background: #fffbeb; border: 1px solid #fde68a;
        border-radius: 8px; font-size: .78rem; }
    .lbl { font-size: .75rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; }
    #addIngredientForm { display:none; }
    /* Select2 sizing to match Bootstrap form-control-sm */
    .select2-container .select2-selection--single { height: 31px; }
    .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 29px; font-size: .875rem; padding-left: 8px; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 29px; }
    .select2-dropdown { font-size: .875rem; }
    .select2-results__option { padding: 5px 8px; }
    .select2-search--dropdown .select2-search__field { padding: 4px 8px; font-size: .875rem; }
</style>

<!-- Info: live avg cost, no fallback -->
<div class="alert alert-warning alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
    <i class="fas fa-exclamation-triangle me-1"></i>
    <strong>Stock Cost Only:</strong> Ingredient costs are taken exclusively from the
    <strong>branch-wise weighted average stock cost</strong> (AverageCost from <em>CurrentStock</em>).
    Ingredients with <strong>no stock in this branch cannot be added to the BOM</strong>.
    Receive stock first to unlock them.
    <button type="button" class="btn-close py-1" data-bs-dismiss="alert"></button>
</div>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a href="@Url.Action("BOMList","BOM")">
                <i class="fas fa-layer-group me-1"></i>BOM Configure
            </a>
        </li>
        <li class="breadcrumb-item active">@Model.MenuItemName</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="bom-header text-white rounded-3 p-4 mb-4 shadow-sm">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="mb-1 fw-bold">
                <i class="fas fa-cogs me-2"></i>@Model.MenuItemName
                @if (!string.IsNullOrEmpty(Model.CategoryName))
                {
                    <span class="badge bg-white text-primary ms-2 fw-normal small">@Model.CategoryName</span>
                }
            </h4>
            <p class="mb-0 text-white-50 small">
                <span class="me-1">Base: <strong class="text-white">₹@Model.SellingPrice.ToString("N2")</strong></span>
                @if (Model.TakeoutPrice.HasValue)
                {
                    <span class="me-1">| Takeout: <strong class="text-white">₹@Model.TakeoutPrice.Value.ToString("N2")</strong></span>
                }
                @if (Model.DeliveryPrice.HasValue)
                {
                    <span class="me-1">| Delivery: <strong class="text-white">₹@Model.DeliveryPrice.Value.ToString("N2")</strong></span>
                }
                @if (Model.RoomServicePrice.HasValue)
                {
                    <span class="me-1">| Room Svc: <strong class="text-white">₹@Model.RoomServicePrice.Value.ToString("N2")</strong></span>
                }
                &nbsp;&mdash;&nbsp;Configure ingredients and quantities to build the Bill of Material.
            </p>
        </div>
        <a href="@Url.Action("BOMList","BOM")" class="btn btn-outline-light btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to BOM List
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- LEFT COLUMN: BOM Lines -->
    <div class="col-lg-8">

        <!-- BOM Lines List -->
        <div class="card section-card shadow-sm mb-4">
            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-3">
                <div>
                    <i class="fas fa-list-ul text-primary me-2"></i>
                    <strong>Ingredient Lines</strong>
                    <span class="badge text-bg-primary ms-2" id="lineCountBadge">@Model.Lines.Count</span>
                </div>
                <button class="btn btn-success btn-sm" id="btnShowAddForm">
                    <i class="fas fa-plus me-1"></i>Add Ingredient
                </button>
            </div>

            <!-- Add Ingredient Form (hidden by default) -->
            <div class="card-body border-bottom" id="addIngredientForm">
                <div class="section-title mb-3">
                    <i class="fas fa-plus-circle me-1"></i>Add New Ingredient to BOM
                </div>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Ingredient <span class="text-danger">*</span></label>
                        <select id="newIngredientId" class="form-select form-select-sm">
                            <option value="">-- Select Ingredient --</option>
                            @foreach (var ing in ingredients.OrderBy(i => (string)i.category).ThenBy(i => (string)i.name))
                            {
                                <option value="@((int)ing.id)"
                                        data-conv="@((decimal)ing.convFactor)"
                                        data-cost="@((decimal)ing.standardCost)"
                                        data-uom="@((string)ing.uomCode)">
                                    [@((string)(ing.category ?? "Other"))] @((string)ing.name) (@((string)ing.uomCode))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Quantity <span class="text-danger">*</span></label>
                        <input type="number" id="newQty" class="form-control form-control-sm"
                               min="0.001" step="0.001" placeholder="0.000" oninput="previewLineCost()">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">UOM</label>
                        <input type="text" id="newUOMDisplay" class="form-control form-control-sm bg-light" readonly placeholder="—">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Est. Line Cost
                            <span id="newCostSourceBadge" class="badge ms-1" style="font-size:.65rem;"></span>
                        </label>
                        <input type="text" id="newLineCostDisplay" class="form-control form-control-sm bg-light fw-bold" readonly placeholder="₹ 0.00">
                        <small id="newCostHint" class="text-muted"></small>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check mb-1" title="Optional Ingredient">
                            <input class="form-check-input" type="checkbox" id="newIsOptional">
                            <label class="form-check-label small" for="newIsOptional">Opt.</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Notes / Instructions (optional)</label>
                        <input type="text" id="newInstructions" class="form-control form-control-sm"
                               maxlength="200" placeholder="e.g., finely chopped, room temperature…">
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-success btn-sm" id="btnAddToBOM" onclick="submitAddLine()">
                        <i class="fas fa-plus me-1"></i>Add to BOM
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="hideAddForm()">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                </div>
            </div>

            <!-- Lines Table -->
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0" id="bomLinesTable" style="min-width:700px;">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th style="min-width:180px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle; padding-left:1rem;">Ingredient</th>
                            <th class="text-end" style="min-width:110px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">Qty</th>
                            <th class="text-center" style="min-width:70px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">UOM</th>
                            <th class="text-end" style="min-width:100px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">Conv. Factor</th>
                            <th class="text-end" style="min-width:110px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">Avg Cost
                                <span class="badge bg-info-subtle text-info border ms-1" 
                                      style="font-size:.65rem;font-weight:500;"
                                      title="Weighted average cost from branch stock (CurrentStock). Falls back to item master cost when no stock.">Live</span>
                            </th>
                            <th class="text-end" style="min-width:100px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">Line Cost</th>
                            <th class="text-center" style="min-width:55px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">Opt.</th>
                            <th class="text-center" style="min-width:70px; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#64748b; font-weight:600; vertical-align:middle;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="bomLinesBody">
                        @foreach (var line in Model.Lines)
                        {
                            <tr class="ingredient-line"
                                id="line-@line.Id"
                                data-lineid="@line.Id"
                                data-ingredientid="@line.IngredientId"
                                data-qty="@line.Quantity"
                                data-conv="@line.ConversionFactor"
                                data-cost="@line.StandardCost"
                                data-uom="@line.ConsumptionUOMCode"
                                data-optional="@line.IsOptional.ToString().ToLower()">
                                <td class="ps-3">
                                    <span class="fw-semibold">@line.IngredientName</span>
                                    @if (line.IsOptional)
                                    {
                                        <span class="badge text-bg-secondary ms-1 small">Optional</span>
                                    }
                                    @if (!string.IsNullOrEmpty(line.ItemCategory))
                                    {
                                        <br><small class="text-muted">@line.ItemCategory</small>
                                    }
                                    @if (!string.IsNullOrEmpty(line.Instructions))
                                    {
                                        <br><small class="text-muted fst-italic"><i class="fas fa-sticky-note me-1"></i>@line.Instructions</small>
                                    }
                                </td>
                                <!-- Qty cell – editable inline -->
                                <td class="text-end">
                                    <input type="number" class="form-control form-control-sm text-end line-qty-input"
                                           id="qty-@line.Id"
                                           value="@line.Quantity" min="0.001" step="0.001"
                                           style="min-width:80px;width:100%;"
                                           data-lineid="@line.Id"
                                           onchange="updateLineQty(@line.Id, @line.IngredientId)">
                                </td>
                                <td class="text-center">
                                    <span class="badge text-bg-light border">@(line.ConsumptionUOMCode ?? "—")</span>
                                </td>
                                <td class="text-end text-muted small">
                                    @(line.ConversionFactor.HasValue ? line.ConversionFactor.Value.ToString("N3") : "1.000")
                                </td>
                                <td class="text-end text-muted small">
                                    ₹@(line.StandardCost.HasValue ? line.StandardCost.Value.ToString("N4") : "0.0000")
                                    <br><small class="text-info" style="font-size:.65rem;">avg</small>
                                </td>
                                <td class="text-end fw-semibold line-cost" id="linecost-@line.Id">
                                    @if (line.LineCost.HasValue)
                                    {
                                        <text>₹@line.LineCost.Value.ToString("N4")</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (line.IsOptional)
                                    {
                                        <i class="fas fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-minus text-muted"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="deleteBOMLine(@line.Id, '@Html.Raw(line.IngredientName.Replace("'","\\\'"))')"
                                            title="Remove from BOM">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold" style="background:#f8fafc;">
                            <td class="ps-3 text-end pe-2" colspan="5">
                                <span class="section-title">Total Raw BOM Cost</span>
                            </td>
                            <td class="text-end" id="totalRawCostCell">
                                @{
                                    decimal rawTotal = Model.Lines.Sum(l => l.LineCost ?? 0);
                                }
                                <span id="totalRawCost">₹@rawTotal.ToString("N4")</span>
                            </td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
              </div><!-- /table-responsive -->

                @if (!Model.Lines.Any())
                {
                    <div class="text-center py-5 text-muted" id="emptyLinesMsg">
                        <i class="fas fa-box-open fa-2x mb-2 d-block"></i>
                        No ingredients added yet. Click <strong>Add Ingredient</strong> to start building the BOM.
                    </div>
                }
            </div>
        </div>

        <!-- Cost Formula Reference -->
        <div class="formula-box p-3 mb-3">
            <div class="fw-semibold mb-1 small">
                <i class="fas fa-calculator text-warning me-1"></i>
                BOM Cost Formula
            </div>
            <div class="text-muted">
                <strong>Line Cost</strong> = Qty (Consumption UOM) &divide; Conversion Factor &times; <strong>Avg Stock Cost</strong> (branch weighted avg per Purchase UOM)<br>
                <strong>Total BOM Cost</strong> = &Sigma; Line Costs &divide; (Yield % / 100)<br>
                <strong>Gross Margin %</strong> = (Selling Price &minus; BOM Cost) &divide; Selling Price &times; 100<br>
                <small class="text-info"><i class="fas fa-info-circle me-1"></i>Avg Stock Cost = SUM(BalanceQty &times; AverageCost) / SUM(BalanceQty) across all godowns of the active branch. Falls back to item-master cost when no stock.</small>
            </div>
        </div>

    </div>

    <!-- RIGHT COLUMN: Header + Cost Summary -->
    <div class="col-lg-4">

        <!-- BOM Header Card -->
        <div class="card section-card shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <i class="fas fa-sliders-h text-primary me-2"></i>
                <strong>BOM Header Settings</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="lbl">Portions Served (Yield)</label>
                    <input type="number" id="headerYield" class="form-control form-control-sm"
                           value="@Model.Yield" min="1" max="100">
                    <div class="form-text">How many portions this BOM produces per batch.</div>
                </div>
                <div class="mb-3">
                    <label class="lbl">Yield % <small class="text-muted">(usable output after waste)</small></label>
                    <div class="input-group input-group-sm">
                        <input type="number" id="headerYieldPct" class="form-control"
                               value="@Model.YieldPercentage" min="1" max="100" step="0.01">
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">
                        100% = no waste. 80% = 20% trimming/cooking loss.<br>
                        BOM cost is divided by this factor.
                    </div>
                </div>
                <div class="mb-3">
                    <label class="lbl">Preparation Time (minutes)</label>
                    <input type="number" id="headerPrepTime" class="form-control form-control-sm"
                           value="@(Model.PrepTimeMinutes.HasValue ? Model.PrepTimeMinutes.Value.ToString() : "")"
                           min="1" max="600" placeholder="Optional">
                </div>
                <button class="btn btn-primary btn-sm w-100" onclick="saveHeader()">
                    <i class="fas fa-save me-1"></i>Save Header
                </button>
            </div>
        </div>

        <!-- Cost Summary Card -->
        <div class="card section-card shadow-sm mb-4 cost-panel">
            <div class="card-header bg-transparent border-bottom py-3">
                <i class="fas fa-chart-pie text-info me-2"></i>
                <strong>Cost &amp; Margin Summary</strong>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="lbl mb-1">BOM Cost</div>
                        <div class="cost-big" id="summaryBOMCost">
                            @(Model.ComputedCost.HasValue ? "₹" + Model.ComputedCost.Value.ToString("N4") : "—")
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="lbl mb-1">Last Calculated</div>
                        <div class="fw-semibold small" id="summaryLastCalc">
                            @(Model.LastCalculated.HasValue
                                ? Model.LastCalculated.Value.ToString("dd MMM yyyy, HH:mm")
                                : "Not yet")
                        </div>
                    </div>
                </div>
                <hr class="my-2">
                <!-- Margin breakdown by all price types -->
                <div class="lbl mb-2">Gross Margin by Price Type</div>
                <table class="table table-sm mb-0 small" id="marginBreakdownTable">
                    <thead>
                        <tr>
                            <th class="text-muted" style="font-size:.7rem;">Type</th>
                            <th class="text-end text-muted" style="font-size:.7rem;">Price</th>
                            <th class="text-end text-muted" style="font-size:.7rem;">Margin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="marginRow_base">
                            <td class="fw-semibold">Base</td>
                            <td class="text-end">₹@Model.SellingPrice.ToString("N2")</td>
                            <td class="text-end">
                                @if (Model.GrossMarginPct.HasValue)
                                {
                                    <span class="badge @BOMConfigureViewModel.GetMarginBadgeClass(Model.GrossMarginPct) rounded-pill" id="marginBadge_base">@Model.GrossMarginPct.Value.ToString("N1")%</span>
                                }
                                else
                                {
                                    <span class="text-muted" id="marginBadge_base">—</span>
                                }
                            </td>
                        </tr>
                        @if (Model.TakeoutPrice.HasValue)
                        {
                            <tr id="marginRow_takeout">
                                <td class="text-primary">Takeout</td>
                                <td class="text-end">₹@Model.TakeoutPrice.Value.ToString("N2")</td>
                                <td class="text-end">
                                    @if (Model.TakeoutMarginPct.HasValue)
                                    {
                                        <span class="badge @BOMConfigureViewModel.GetMarginBadgeClass(Model.TakeoutMarginPct) rounded-pill" id="marginBadge_takeout">@Model.TakeoutMarginPct.Value.ToString("N1")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" id="marginBadge_takeout">—</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.DeliveryPrice.HasValue)
                        {
                            <tr id="marginRow_delivery">
                                <td style="color:#d97706;">Delivery</td>
                                <td class="text-end">₹@Model.DeliveryPrice.Value.ToString("N2")</td>
                                <td class="text-end">
                                    @if (Model.DeliveryMarginPct.HasValue)
                                    {
                                        <span class="badge @BOMConfigureViewModel.GetMarginBadgeClass(Model.DeliveryMarginPct) rounded-pill" id="marginBadge_delivery">@Model.DeliveryMarginPct.Value.ToString("N1")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" id="marginBadge_delivery">—</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.RoomServicePrice.HasValue)
                        {
                            <tr id="marginRow_roomsvc">
                                <td style="color:#7c3aed;">Room Svc</td>
                                <td class="text-end">₹@Model.RoomServicePrice.Value.ToString("N2")</td>
                                <td class="text-end">
                                    @if (Model.RoomServiceMarginPct.HasValue)
                                    {
                                        <span class="badge @BOMConfigureViewModel.GetMarginBadgeClass(Model.RoomServiceMarginPct) rounded-pill" id="marginBadge_roomsvc">@Model.RoomServiceMarginPct.Value.ToString("N1")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" id="marginBadge_roomsvc">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr class="my-2">
                <div class="row g-2 small">
                    <div class="col-6">
                        <div class="p-2 bg-white rounded-2 text-center border">
                            <div class="lbl">Yield %</div>
                            <div class="fw-semibold" id="summaryYieldPct">@Model.YieldPercentage.ToString("N0")%</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-white rounded-2 text-center border">
                            <div class="lbl">Portions</div>
                            <div class="fw-semibold" id="summaryYield">@Model.Yield</div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-outline-info btn-sm w-100 mt-3" onclick="recalcCost()">
                    <i class="fas fa-sync-alt me-1"></i>Recalculate Cost Now
                </button>
            </div>
        </div>

        <!-- Quick legend -->
        <div class="card section-card shadow-sm">
            <div class="card-body p-3">
                <div class="section-title mb-2">
                    <i class="fas fa-traffic-light me-1"></i>Margin Guide
                </div>
                <div class="d-flex flex-column gap-1 small">
                    <div><span class="badge bg-success me-2">≥ 60%</span>Excellent – standard F&amp;B target</div>
                    <div><span class="badge bg-warning text-dark me-2">40–60%</span>Acceptable – review ingredient costs</div>
                    <div><span class="badge bg-danger me-2">&lt; 40%</span>Low – consider repricing or reformulation</div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
// ─── State ────────────────────────────────────────────────────────────────────
const MENU_ITEM_ID     = @Model.MenuItemId;
const SELLING_PRICE    = @Model.SellingPrice;
const TAKEOUT_PRICE    = @(Model.TakeoutPrice.HasValue     ? Model.TakeoutPrice.Value.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)     : "null");
const DELIVERY_PRICE   = @(Model.DeliveryPrice.HasValue    ? Model.DeliveryPrice.Value.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)    : "null");
const ROOMSVC_PRICE    = @(Model.RoomServicePrice.HasValue ? Model.RoomServicePrice.Value.ToString("F2",System.Globalization.CultureInfo.InvariantCulture) : "null");
const TOKEN            = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

// Ingredient lookup map built from server-rendered JSON
const _ING_ARR = @Html.Raw(ingredientJson);
const INGREDIENT_MAP = _ING_ARR.reduce((acc, i) => { acc[i.id] = i; return acc; }, {});

// ─── Add Form toggle ──────────────────────────────────────────────────────────
document.getElementById('btnShowAddForm').addEventListener('click', () => {
    document.getElementById('addIngredientForm').style.display = 'block';
    document.getElementById('btnShowAddForm').style.display = 'none';
    setTimeout(() => $('#newIngredientId').select2('open'), 100);
});

function hideAddForm() {
    document.getElementById('addIngredientForm').style.display = 'none';
    document.getElementById('btnShowAddForm').style.display = '';
    resetAddForm();
}

function resetAddForm() {
    $('#newIngredientId').val(null).trigger('change');   // Select2 clear
    document.getElementById('newQty').value = '';
    document.getElementById('newUOMDisplay').value = '';
    document.getElementById('newLineCostDisplay').value = '';
    const badge = document.getElementById('newCostSourceBadge');
    const hint  = document.getElementById('newCostHint');
    if (badge) badge.textContent = '';
    if (hint)  hint.textContent  = '';
    document.getElementById('newIsOptional').checked = false;
    document.getElementById('newInstructions').value = '';
}

// ─── Ingredient selection – populate UOM + preview cost ──────────────────────
function onIngredientChange() {
    const sel   = document.getElementById('newIngredientId');
    const ingId = parseInt(sel.value);
    const info  = INGREDIENT_MAP[ingId];
    const badge = document.getElementById('newCostSourceBadge');
    const hint  = document.getElementById('newCostHint');
    if (info) {
        document.getElementById('newUOMDisplay').value = info.uomCode || '—';
        if (badge) {
            if (info.hasLiveCost) {
                badge.textContent   = 'Live Avg';
                badge.className     = 'badge bg-success-subtle text-success border ms-1';
                hint.textContent    = 'Using live stock avg cost ₹' + info.standardCost.toFixed(4);
            } else {
                badge.textContent   = 'Master';
                badge.className     = 'badge bg-secondary-subtle text-secondary border ms-1';
                hint.textContent    = info.standardCost > 0
                    ? 'No stock found. Using item-master cost ₹' + info.standardCost.toFixed(4)
                    : 'No stock & no master cost — cost will be ₹0';
            }
        }
    } else {
        document.getElementById('newUOMDisplay').value = '';
        if (badge) { badge.textContent = ''; hint.textContent = ''; }
    }
    previewLineCost();
}

function previewLineCost() {
    const sel   = document.getElementById('newIngredientId');
    const ingId = parseInt(sel.value);
    const qty   = parseFloat(document.getElementById('newQty').value) || 0;
    const info  = INGREDIENT_MAP[ingId];
    if (info && qty > 0 && info.convFactor > 0) {
        const cost = qty / info.convFactor * info.standardCost;
        document.getElementById('newLineCostDisplay').value = '₹' + cost.toFixed(4);
    } else {
        document.getElementById('newLineCostDisplay').value = '';
    }
}

// ─── Save BOM Header ──────────────────────────────────────────────────────────
async function saveHeader() {
    const yield_     = parseInt(document.getElementById('headerYield').value) || 1;
    const yieldPct   = parseFloat(document.getElementById('headerYieldPct').value) || 100;
    const prepTime   = parseInt(document.getElementById('headerPrepTime').value) || null;

    if (yield_ < 1 || yield_ > 100)        { showToast('Portions must be 1–100.', 'warning'); return; }
    if (yieldPct < 1 || yieldPct > 100)    { showToast('Yield % must be 1–100.', 'warning'); return; }

    const res = await postJSON('/BOM/SaveBOMHeader', {
        menuItemId: MENU_ITEM_ID, yield: yield_, yieldPercentage: yieldPct, prepTimeMinutes: prepTime
    });

    if (res.success) {
        updateSummaryPanel(res.computedCost, res.grossMarginPct, res.takeoutMarginPct, res.deliveryMarginPct, res.roomServiceMarginPct);
        document.getElementById('summaryYield').textContent    = yield_;
        document.getElementById('summaryYieldPct').textContent = yieldPct.toFixed(0) + '%';
        showToast('BOM header saved.', 'success');
    } else {
        showToast(res.message || 'Save failed.', 'danger');
    }
}

// ─── Add BOM Line ─────────────────────────────────────────────────────────────
async function submitAddLine() {
    // ── 1. Capture ALL form values upfront (before any async/reset) ──────────
    const ingId       = parseInt(document.getElementById('newIngredientId').value) || 0;
    const qty         = parseFloat(document.getElementById('newQty').value) || 0;
    const isOptional  = document.getElementById('newIsOptional')?.checked ?? false;
    const instructions= (document.getElementById('newInstructions')?.value ?? '').trim();

    if (!ingId)  { showToast('Please select an ingredient.', 'warning'); return; }
    if (qty <= 0){ showToast('Quantity must be greater than 0.', 'warning'); return; }

    // ── 2. Client-side stock guard ────────────────────────────────────────────
    const ingInfo = INGREDIENT_MAP[ingId];
    if (ingInfo && !ingInfo.hasLiveCost) {
        showToast(`\u201c${ingInfo.name}\u201d has no stock in this branch. Receive stock first.`, 'danger');
        return;
    }

    // ── 3. Save to server ─────────────────────────────────────────────────────
    const res = await postJSON('/BOM/SaveBOMLine', {
        lineId: 0,
        menuItemId:   MENU_ITEM_ID,
        ingredientId: ingId,
        quantity:     qty,
        isOptional:   isOptional,
        instructions: instructions || null
    });

    if (!res.success) {
        showToast(res.message || 'Failed to add ingredient.', 'danger');
        return;
    }

    // ── 4. Update summary panel ───────────────────────────────────────────────
    updateSummaryPanel(res.computedCost, res.grossMarginPct, res.takeoutMarginPct, res.deliveryMarginPct, res.roomServiceMarginPct);

    // ── 5. Inject new row into the table ─────────────────────────────────────
    const lineId   = res.lineId;
    const imap     = ingInfo || {};
    const conv     = parseFloat(imap.convFactor)   || 1;
    const avgCost  = parseFloat(imap.standardCost) || 0;
    const uomCode  = imap.uomCode   || '—';
    const ingName  = imap.name      || '';
    const category = imap.category  || '';
    const lineCost = conv > 0 ? (qty / conv * avgCost) : 0;

    // Remove "no ingredients" placeholder if showing
    document.getElementById('emptyLinesMsg')?.remove();

    const safeName = ingName.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    const optBadge = isOptional  ? '<span class="badge text-bg-secondary ms-1 small">Optional</span>' : '';
    const catTag   = category    ? `<br><small class="text-muted">${category}</small>` : '';
    const instrTag = instructions? `<br><small class="text-muted fst-italic"><i class="fas fa-sticky-note me-1"></i>${instructions}</small>` : '';
    const optIcon  = isOptional  ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-minus text-muted"></i>';

    const tr = document.createElement('tr');
    tr.className = 'ingredient-line';
    tr.id = 'line-' + lineId;
    tr.setAttribute('data-lineid',       lineId);
    tr.setAttribute('data-ingredientid', ingId);
    tr.setAttribute('data-qty',          qty);
    tr.setAttribute('data-conv',         conv);
    tr.setAttribute('data-cost',         avgCost);
    tr.setAttribute('data-uom',          uomCode);
    tr.setAttribute('data-optional',     isOptional ? 'true' : 'false');
    tr.innerHTML = `
        <td class="ps-3">
            <span class="fw-semibold">${ingName}</span>${optBadge}${catTag}${instrTag}
        </td>
        <td class="text-end">
            <input type="number" class="form-control form-control-sm text-end line-qty-input"
                   id="qty-${lineId}" value="${qty}" min="0.001" step="0.001"
                   style="min-width:80px;width:100%;"
                   data-lineid="${lineId}"
                   onchange="updateLineQty(${lineId}, ${ingId})">
        </td>
        <td class="text-center">
            <span class="badge text-bg-light border">${uomCode}</span>
        </td>
        <td class="text-end text-muted small">${conv.toFixed(3)}</td>
        <td class="text-end text-muted small">
            &#8377;${avgCost.toFixed(4)}<br><small class="text-info" style="font-size:.65rem;">avg</small>
        </td>
        <td class="text-end fw-semibold line-cost" id="linecost-${lineId}">&#8377;${lineCost.toFixed(4)}</td>
        <td class="text-center">${optIcon}</td>
        <td class="text-center">
            <button class="btn btn-sm btn-outline-danger"
                    onclick="deleteBOMLine(${lineId}, '${safeName}')"
                    title="Remove from BOM">
                <i class="fas fa-trash-alt"></i>
            </button>
        </td>`;

    document.getElementById('bomLinesBody').appendChild(tr);

    // ── 6. Update badge + footer total ───────────────────────────────────────
    const allRows = document.querySelectorAll('#bomLinesBody tr.ingredient-line');
    const badge = document.getElementById('lineCountBadge');
    if (badge) badge.textContent = allRows.length;

    let rawTotal = 0;
    allRows.forEach(row => {
        const cell = document.getElementById('linecost-' + row.getAttribute('data-lineid'));
        if (cell) rawTotal += parseFloat(cell.textContent.replace(/[₹\u20B9]/g, '')) || 0;
    });
    const rawCostEl = document.getElementById('totalRawCost');
    if (rawCostEl) rawCostEl.textContent = '₹' + rawTotal.toFixed(4);

    // ── 7. Reload page to reflect new ingredient line ────────────────────────
    showToast(res.message || 'Ingredient added to BOM.', 'success');
    setTimeout(() => location.reload(), 800);
}

// ─── Inline Qty Update ────────────────────────────────────────────────────────
async function updateLineQty(lineId, ingredientId) {
    const qty = parseFloat(document.getElementById('qty-' + lineId).value) || 0;
    if (qty <= 0) { showToast('Quantity must be > 0.', 'warning'); return; }

    const res = await postJSON('/BOM/SaveBOMLine', {
        lineId, menuItemId: MENU_ITEM_ID, ingredientId, quantity: qty,
        isOptional: false, instructions: null
    });

    if (res.success) {
        // Update line cost display
        const row  = document.getElementById('line-' + lineId);
        const conv = parseFloat(row?.dataset.conv) || 1;
        const cost = parseFloat(row?.dataset.cost) || 0;
        if (conv > 0) {
            const lineCost = qty / conv * cost;
            document.getElementById('linecost-' + lineId).textContent = '₹' + lineCost.toFixed(4);
        }
        updateSummaryPanel(res.computedCost, res.grossMarginPct, res.takeoutMarginPct, res.deliveryMarginPct, res.roomServiceMarginPct);
        showToast('Quantity updated.', 'success');
    } else {
        showToast(res.message || 'Update failed.', 'danger');
    }
}

// ─── Delete BOM Line ──────────────────────────────────────────────────────────
async function deleteBOMLine(lineId, name) {
    const result = await Swal.fire({
        title: 'Remove Ingredient?',
        html: `<span class="text-muted">Remove <strong>${name}</strong> from this BOM?</span>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="fas fa-trash-alt me-1"></i>Yes, Remove',
        cancelButtonText: 'Cancel',
        reverseButtons: true
    });
    if (!result.isConfirmed) return;

    const res = await postJSON('/BOM/DeleteBOMLine', { lineId });

    if (res.success) {
        document.getElementById('line-' + lineId)?.remove();
        const remaining = document.querySelectorAll('#bomLinesBody tr.ingredient-line').length;
        document.getElementById('lineCountBadge').textContent = remaining;
        updateSummaryPanel(res.computedCost, res.grossMarginPct, res.takeoutMarginPct, res.deliveryMarginPct, res.roomServiceMarginPct);
        showToast(res.message, 'success');
        if (remaining === 0) {
            document.getElementById('emptyLinesMsg')?.remove();
            const emptyDiv = document.createElement('div');
            emptyDiv.id = 'emptyLinesMsg';
            emptyDiv.className = 'text-center py-5 text-muted';
            emptyDiv.innerHTML = '<i class="fas fa-box-open fa-2x mb-2 d-block"></i>No ingredients added yet.';
            document.getElementById('bomLinesBody').closest('.card-body') || 
                document.getElementById('bomLinesTable').parentNode.appendChild(emptyDiv);
        }
    } else {
        showToast(res.message || 'Delete failed.', 'danger');
    }
}

// ─── Recalculate cost ─────────────────────────────────────────────────────────
async function recalcCost() {
    const res = await postJSON('/BOM/RecalculateCost', { menuItemId: MENU_ITEM_ID });
    if (res.success) {
        updateSummaryPanel(res.computedCost, res.grossMarginPct, res.takeoutMarginPct, res.deliveryMarginPct, res.roomServiceMarginPct);
        showToast('Cost recalculated.', 'success');
    } else {
        showToast(res.message || 'Recalculation failed.', 'danger');
    }
}

// ─── Summary panel update ─────────────────────────────────────────────────────
function updateSummaryPanel(cost, margin) {
    const costEl   = document.getElementById('summaryBOMCost');
    const marginEl = document.getElementById('summaryMargin');
    const guideEl  = document.getElementById('marginGuidance');
    const lastEl   = document.getElementById('summaryLastCalc');

    if (cost != null) {
        costEl.textContent = '₹' + parseFloat(cost).toFixed(4);
    } else {
        costEl.textContent = '—';
    }

    if (margin != null) {
        const m = parseFloat(margin);
        marginEl.textContent = m.toFixed(1) + '%';
        marginEl.className = 'margin-big ' +
            (m >= 60 ? 'text-success' : m >= 40 ? 'text-warning' : 'text-danger');
        guideEl.textContent = m >= 60 ? '✅ Excellent margin'
            : m >= 40 ? '⚠️ Acceptable – review costs'
            : '❌ Low margin – consider repricing';
    } else {
        marginEl.textContent = '—';
        marginEl.className = 'margin-big text-secondary';
        guideEl.textContent = '';
    }

    const now = new Date();
    lastEl.textContent = now.toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'})
        + ', ' + now.toLocaleTimeString('en-IN', {hour:'2-digit',minute:'2-digit',hour12:false});
}

// ─── Generic POST helper ──────────────────────────────────────────────────────
async function postJSON(url, data) {
    try {
        const resp = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': TOKEN
            },
            body: JSON.stringify(data)
        });
        return await resp.json();
    } catch (e) {
        return { success: false, message: 'Network error: ' + e.message };
    }
}

// ─── Toast helper ─────────────────────────────────────────────────────────────
function showToast(msg, type = 'info') {
    if (typeof toastr !== 'undefined') {
        if (type === 'success') toastr.success(msg);
        else if (type === 'danger') toastr.error(msg);
        else if (type === 'warning') toastr.warning(msg);
        else toastr.info(msg);
    } else {
        alert(msg);
    }
}

