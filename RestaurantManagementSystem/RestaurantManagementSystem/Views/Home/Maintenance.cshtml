@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service Unavailable - Maintenance</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css"
          integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #e2e8f0;
            overflow: hidden;
        }

        .maintenance-container {
            text-align: center;
            max-width: 600px;
            padding: 2.5rem;
            animation: fadeInUp 0.6s ease-out;
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .maintenance-icon {
            width: 120px;
            height: 120px;
            margin: 0 auto 2rem;
            border-radius: 50%;
            background: rgba(251, 191, 36, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.25); }
            50%       { box-shadow: 0 0 0 20px rgba(251, 191, 36, 0); }
        }

        .maintenance-icon i {
            font-size: 3.5rem;
            color: #fbbf24;
        }

        .maintenance-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            color: #f8fafc;
        }

        .maintenance-subtitle {
            font-size: 1.1rem;
            color: #94a3b8;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .status-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .status-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 0;
        }

        .status-row + .status-row {
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .status-label {
            font-size: 0.9rem;
            color: #94a3b8;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .status-badge {
            font-size: 0.8rem;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-weight: 600;
        }

        .status-badge.offline {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .status-badge.checking {
            background: rgba(251, 191, 36, 0.15);
            color: #fbbf24;
        }

        .status-badge.online {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
        }

        .retry-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.75rem 2rem;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
        }

        .retry-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);
        }

        .retry-btn:active {
            transform: translateY(0);
        }

        .retry-btn.loading i {
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        .countdown-text {
            margin-top: 1.25rem;
            font-size: 0.85rem;
            color: #64748b;
        }

        .countdown-text span {
            color: #fbbf24;
            font-weight: 600;
        }

        .footer-note {
            margin-top: 2.5rem;
            font-size: 0.8rem;
            color: #475569;
        }
    </style>
</head>
<body>
    <div class="maintenance-container">
        <div class="maintenance-icon">
            <i class="fas fa-tools"></i>
        </div>

        <h1 class="maintenance-title">Service Temporarily Unavailable</h1>
        <p class="maintenance-subtitle">
            We're unable to connect to the server right now. This could be due to scheduled maintenance
            or a temporary connection issue. The system will automatically retry.
        </p>

        <div class="status-card">
            <div class="status-row">
                <span class="status-label"><i class="fas fa-globe"></i> Web Server</span>
                <span class="status-badge online">Online</span>
            </div>
            <div class="status-row">
                <span class="status-label"><i class="fas fa-database"></i> Database Server</span>
                <span id="dbStatus" class="status-badge offline">Offline</span>
            </div>
        </div>

        <button class="retry-btn" id="retryBtn" onclick="retryConnection()">
            <i class="fas fa-redo-alt"></i> Retry Now
        </button>

        <p class="countdown-text">
            Auto-retry in <span id="countdown">30</span> seconds
        </p>

        <p class="footer-note">
            If this issue persists, please contact your system administrator.
        </p>
    </div>

    <script>
        var countdown = 30;
        var timer;

        function startCountdown() {
            countdown = 30;
            updateCountdownDisplay();
            clearInterval(timer);
            timer = setInterval(function () {
                countdown--;
                updateCountdownDisplay();
                if (countdown <= 0) {
                    clearInterval(timer);
                    retryConnection();
                }
            }, 1000);
        }

        function updateCountdownDisplay() {
            var el = document.getElementById('countdown');
            if (el) el.textContent = countdown;
        }

        function retryConnection() {
            var btn = document.getElementById('retryBtn');
            var dbStatus = document.getElementById('dbStatus');
            btn.classList.add('loading');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner"></i> Checking...';
            dbStatus.textContent = 'Checking';
            dbStatus.className = 'status-badge checking';
            clearInterval(timer);

            // Navigate to home — the middleware will either let through (DB is back)
            // or redirect back here (still down).
            setTimeout(function () {
                window.location.href = '/';
            }, 1500);
        }

        startCountdown();
    </script>
</body>
</html>
