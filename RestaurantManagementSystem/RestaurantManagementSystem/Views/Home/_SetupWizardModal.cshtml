@model RestaurantManagementSystem.ViewModels.SetupWizardViewModel

@if (Model != null)
{
    var steps = Model.Steps ?? new List<RestaurantManagementSystem.ViewModels.SetupWizardStep>();
    var readiness = Model.ReadinessPercentage;
    var completedCount = Model.CompletedStepsCount;
    var totalCount = Model.TotalStepsCount;
    var isAllDone = Model.IsAllCoreMastersCompleted;
    var userId = Model.UserId;

    <style>
        .setup-wizard-modal .modal-dialog {
            max-width: 960px;
            margin: 1.5rem auto;
        }

        .setup-wizard-modal .modal-content {
            border: none;
            border-radius: 24px;
            background: #ffffff;
            box-shadow: 0 25px 50px -12px rgba(42, 16, 109, 0.25), 0 0 0 1px rgba(124, 58, 237, 0.08);
            overflow: hidden;
        }

        .setup-wizard-header {
            background: linear-gradient(135deg, #1e0a4a 0%, #2a106d 45%, #6d28d9 100%);
            color: #ffffff;
            padding: 26px 30px 22px;
            position: relative;
            overflow: hidden;
        }

        .setup-wizard-header::before {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(167, 139, 250, 0.25) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .wizard-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            color: #fde047;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            margin-bottom: 8px;
        }

        .setup-wizard-title {
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin: 0 0 4px 0;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .setup-wizard-subtitle {
            font-size: 0.90rem;
            color: rgba(255, 255, 255, 0.88);
            margin: 0;
            max-width: 680px;
            line-height: 1.45;
        }

        .wizard-progress-wrap {
            margin-top: 18px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(6px);
            padding: 12px 18px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .wizard-progress-bar-bg {
            height: 10px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .wizard-progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #facc15 0%, #34d399 50%, #38bdf8 100%);
            border-radius: 10px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .wizard-steps-container {
            padding: 20px 28px;
            max-height: 490px;
            overflow-y: auto;
            background: #f8fafc;
        }

        .phase-header-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #475569;
            margin: 16px 0 10px 0;
            padding-bottom: 6px;
            border-bottom: 2px solid #e2e8f0;
        }

        .phase-header-badge:first-child {
            margin-top: 0;
        }

        .wizard-step-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1.5px solid #e2e8f0;
            padding: 16px 18px;
            margin-bottom: 12px;
            transition: all 0.25s ease;
            position: relative;
        }

        .wizard-step-card:hover {
            border-color: #c4b5fd;
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.08);
            transform: translateY(-1px);
        }

        .wizard-step-card.step-configured {
            border-color: #86efac;
            background: linear-gradient(to right, #f0fdf4 0%, #ffffff 100%);
        }

        .wizard-step-card.step-locked {
            opacity: 0.75;
            background: #f8fafc;
            border-style: dashed;
        }

        .step-num-bubble {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.95rem;
            flex-shrink: 0;
            color: #ffffff;
            background: #7c3aed;
            box-shadow: 0 4px 10px rgba(124, 58, 237, 0.25);
        }

        .step-configured .step-num-bubble {
            background: #10b981;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
        }

        .step-locked .step-num-bubble {
            background: #94a3b8;
            box-shadow: none;
        }

        .step-title-text {
            font-size: 1.02rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 3px 0;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .step-desc-text {
            font-size: 0.84rem;
            color: #475569;
            margin: 0 0 6px 0;
            line-height: 1.4;
        }

        .dependency-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.73rem;
            font-weight: 600;
            color: #b45309;
            background: #fef3c7;
            padding: 3px 10px;
            border-radius: 8px;
            border: 1px solid #fde68a;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.74rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 8px;
        }

        .status-pill.configured {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #86efac;
        }

        .status-pill.pending {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .status-pill.locked {
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #cbd5e1;
        }

        .btn-wizard-action {
            background: linear-gradient(135deg, #7c3aed 0%, #4a1fa8 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.82rem;
            padding: 8px 16px;
            border-radius: 10px;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
            white-space: nowrap;
        }

        .btn-wizard-action:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(124, 58, 237, 0.3);
        }

        .btn-wizard-action.btn-wizard-edit {
            background: #f0fdf4;
            color: #15803d;
            border: 1.5px solid #86efac;
            box-shadow: 0 2px 6px rgba(22, 163, 74, 0.12);
        }

        .btn-wizard-action.btn-wizard-edit:hover {
            background: #dcfce7;
            color: #166534;
            border-color: #4ade80;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(22, 163, 74, 0.2);
        }

        .btn-wizard-action.btn-locked {
            background: #e2e8f0;
            color: #94a3b8;
            box-shadow: none;
            cursor: not-allowed;
            pointer-events: none;
        }

        .setup-wizard-footer {
            background: #ffffff;
            padding: 16px 28px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .btn-wizard-skip {
            background: transparent;
            color: #64748b;
            border: 1px solid #cbd5e1;
            font-weight: 600;
            font-size: 0.84rem;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-wizard-skip:hover {
            background: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .btn-wizard-dismiss {
            background: #ede9fe;
            color: #6d28d9;
            border: 1px solid #c4b5fd;
            font-weight: 700;
            font-size: 0.84rem;
            padding: 8px 18px;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-wizard-dismiss:hover {
            background: #ddd6fe;
            color: #5b21b6;
        }
    </style>

    <!-- Master Setup Wizard Modal -->
    <div class="modal fade setup-wizard-modal" id="masterSetupWizardModal" tabindex="-1" aria-labelledby="masterSetupWizardModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                
                <!-- Modal Header -->
                <div class="setup-wizard-header">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="wizard-badge">
                                <i class="fas fa-rocket"></i> Setup Guide & Master Readiness
                            </div>
                            <h3 class="setup-wizard-title" id="masterSetupWizardModalLabel">
                                Restaurant Master Setup Roadmap
                            </h3>
                            <p class="setup-wizard-subtitle">
                                Welcome to <strong>eRestoPOS</strong>! Follow this dependency-guided roadmap to configure your restaurant's essential masters (Kitchen Stations $\rightarrow$ Table Sections $\rightarrow$ Dining Tables $\rightarrow$ Categories $\rightarrow$ Menu Items) to run your POS smoothly.
                            </p>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="opacity: 0.85;"></button>
                    </div>

                    <!-- Progress Bar -->
                    <div class="wizard-progress-wrap">
                        <div class="d-flex justify-content-between align-items-center mb-1 text-white" style="font-size: 0.82rem; font-weight: 700;">
                            <span>Master Readiness: <strong id="wizardReadinessTxt">@readiness% Ready</strong></span>
                            <span class="badge @(isAllDone ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1" style="font-size: 0.76rem;" id="wizardCompletedCountBadge">
                                <span id="wizardCompletedCount">@completedCount</span> of @totalCount Steps Configured
                            </span>
                        </div>
                        <div class="wizard-progress-bar-bg">
                            <div class="wizard-progress-bar-fill" id="wizardProgressBarFill" style="width: @readiness%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Modal Body: Step Cards -->
                <div class="wizard-steps-container" id="wizardStepsListContainer">
                    @{
                        string currentPhase = "";
                    }

                    @if (isAllDone)
                    {
                        <div class="p-3 text-center rounded-4 mb-3" style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border: 1.5px solid #86efac; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.1);" id="wizardAllDoneBanner">
                            <div style="font-size: 2rem; margin-bottom: 4px;">🎉</div>
                            <h5 style="font-weight: 800; color: #065f46; margin-bottom: 4px;">100% Ready! All Essential Masters Are Configured</h5>
                            <p style="font-size: 0.88rem; color: #047857; margin-bottom: 12px;">Your restaurant floor layout, kitchen stations, menu items, and payment settings are ready to take orders.</p>
                            <a href="/Order/Create" class="btn btn-success fw-bold px-4 py-2" style="border-radius: 12px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                                <i class="fas fa-cash-register me-1"></i> Launch Point of Sale (POS) →
                            </a>
                        </div>
                    }

                    @foreach (var step in steps)
                    {
                        if (step.Phase != currentPhase)
                        {
                            currentPhase = step.Phase;
                            <div class="phase-header-badge">
                                @if (currentPhase == "Foundation")
                                {
                                    <i class="fas fa-building text-primary"></i>
                                    <span>Phase 1: Foundation & Brand Masters</span>
                                }
                                else if (currentPhase == "Floor & Seating")
                                {
                                    <i class="fas fa-chair text-info"></i>
                                    <span>Phase 2: Floor Layout & Table Management</span>
                                }
                                else if (currentPhase == "Menu Catalog")
                                {
                                    <i class="fas fa-utensils text-warning"></i>
                                    <span>Phase 3: Food Catalog & Kitchen Routing</span>
                                }
                                else
                                {
                                    <i class="fas fa-cash-register text-success"></i>
                                    <span>Phase 4: Payment Setup & POS Launch</span>
                                }
                            </div>
                        }

                        var cardClass = step.IsConfigured ? "step-configured" : (!step.IsUnlocked ? "step-locked" : "");
                        <div class="wizard-step-card @cardClass" id="stepCard_@step.StepKey">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="d-flex align-items-start gap-3 flex-grow-1">
                                    <div class="step-num-bubble" id="stepBubble_@step.StepKey">
                                        @if (step.IsConfigured)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else if (!step.IsUnlocked)
                                        {
                                            <i class="fas fa-lock" style="font-size:0.8rem;"></i>
                                        }
                                        else
                                        {
                                            <span>@step.StepNumber</span>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="step-title-text">
                                            <span>@step.Title</span>
                                            <span id="stepPillWrap_@step.StepKey">
                                                @if (step.IsConfigured)
                                                {
                                                    <span class="status-pill configured">
                                                        <i class="fas fa-check-circle"></i> @step.CountBadgeText
                                                    </span>
                                                }
                                                else if (!step.IsUnlocked)
                                                {
                                                    <span class="status-pill locked">
                                                        <i class="fas fa-lock"></i> Locked (Dependencies Required)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill pending">
                                                        <i class="fas fa-exclamation-circle"></i> Needs Setup
                                                    </span>
                                                }
                                            </span>
                                        </div>
                                        <div class="step-desc-text">
                                            @step.Description
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(step.DependencyNote))
                                        {
                                            <div class="dependency-badge">
                                                <i class="fas fa-link"></i>
                                                <span>@step.DependencyNote</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="text-end flex-shrink-0" style="min-width: 140px;" id="stepActionWrap_@step.StepKey">
                                    @if (step.IsConfigured)
                                    {
                                        <a href="@step.TargetUrl" class="btn-wizard-action btn-wizard-edit" target="_blank" rel="noopener">
                                            <i class="fas fa-pen-to-square"></i> @step.ActionButtonText
                                        </a>
                                    }
                                    else if (step.IsUnlocked)
                                    {
                                        <a href="@step.TargetUrl" class="btn-wizard-action" target="_blank" rel="noopener">
                                            <i class="fas fa-plus"></i> @step.ActionButtonText
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn-wizard-action btn-locked" title="Complete required dependent steps first">
                                            <i class="fas fa-lock"></i> @step.ActionButtonText
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Modal Footer -->
                <div class="setup-wizard-footer">
                    <div>
                        <button type="button" class="btn-wizard-skip" data-bs-dismiss="modal" id="btnSkipWizardSession">
                            <i class="fas fa-xmark me-1"></i> Skip for Now
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRefreshWizardData" title="Refresh master counts">
                            <i class="fas fa-arrows-rotate me-1"></i> Refresh Status
                        </button>
                        <button type="button" class="btn-wizard-dismiss" id="btnDismissWizardPermanently">
                            <i class="fas fa-check-double me-1"></i> Done & Don't Show Again
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Client-side script for Setup Wizard modal interaction & AJAX dismiss -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const shouldAutoShow = @(Model.ShowWizard ? "true" : "false");
            const userId = @userId;
            const wizardModalEl = document.getElementById('masterSetupWizardModal');

            if (wizardModalEl) {
                const wizardModal = new bootstrap.Modal(wizardModalEl);

                // Check if user already skipped for this browser session
                const isSkippedForSession = sessionStorage.getItem('skip_setup_wizard_' + userId);

                if (shouldAutoShow && !isSkippedForSession) {
                    // Small delay to ensure smooth page render
                    setTimeout(() => {
                        wizardModal.show();
                    }, 500);
                }

                // Handle Skip for Now (persists in sessionStorage so it doesn't pop up on every refresh)
                const skipBtn = document.getElementById('btnSkipWizardSession');
                if (skipBtn) {
                    skipBtn.addEventListener('click', function () {
                        sessionStorage.setItem('skip_setup_wizard_' + userId, '1');
                    });
                }

                // Header Launcher Button click handler
                const launcherBtn = document.getElementById('btnLaunchSetupWizard');
                if (launcherBtn) {
                    launcherBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        wizardModal.show();
                    });
                }

                // Refresh Master Status via AJAX
                const refreshBtn = document.getElementById('btnRefreshWizardData');
                if (refreshBtn) {
                    refreshBtn.addEventListener('click', async function () {
                        refreshBtn.disabled = true;
                        refreshBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Checking...';
                        try {
                            const resp = await fetch('/Home/GetSetupWizardStatus');
                            if (resp.ok) {
                                const data = await resp.json();
                                updateWizardUI(data);
                            }
                        } catch (err) {
                            console.error('Error refreshing setup wizard', err);
                        } finally {
                            refreshBtn.disabled = false;
                            refreshBtn.innerHTML = '<i class="fas fa-arrows-rotate me-1"></i> Refresh Status';
                        }
                    });
                }

                // Done & Don't Show Again Handler
                const dismissBtn = document.getElementById('btnDismissWizardPermanently');
                if (dismissBtn) {
                    dismissBtn.addEventListener('click', async function () {
                        dismissBtn.disabled = true;
                        dismissBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
                        try {
                            const resp = await fetch('/Home/DismissSetupWizard', { method: 'POST' });
                            const data = await resp.json();
                            if (data.success) {
                                wizardModal.hide();
                                sessionStorage.setItem('skip_setup_wizard_' + userId, '1');
                                if (window.Swal) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Setup Guide Saved',
                                        text: 'You can re-open the Setup Guide anytime from the top bar.',
                                        timer: 2500,
                                        showConfirmButton: false
                                    });
                                }
                            }
                        } catch (err) {
                            console.error('Error dismissing setup wizard', err);
                        } finally {
                            dismissBtn.disabled = false;
                            dismissBtn.innerHTML = '<i class="fas fa-check-double me-1"></i> Done & Don\'t Show Again';
                        }
                    });
                }
            }

            function updateWizardUI(data) {
                if (!data) return;
                const readinessTxt = document.getElementById('wizardReadinessTxt');
                const completedCountTxt = document.getElementById('wizardCompletedCount');
                const progressFill = document.getElementById('wizardProgressBarFill');
                const headerPill = document.getElementById('headerWizardProgressPill');
                const badgeWrap = document.getElementById('wizardCompletedCountBadge');

                if (readinessTxt) readinessTxt.textContent = data.readinessPercentage + '% Ready';
                if (completedCountTxt) completedCountTxt.textContent = data.completedStepsCount;
                if (progressFill) progressFill.style.width = data.readinessPercentage + '%';
                if (headerPill) {
                    headerPill.textContent = data.readinessPercentage + '% Ready';
                    if (data.readinessPercentage >= 100) {
                        headerPill.className = 'wizard-launcher-pill bg-success text-white';
                        headerPill.style = 'background: #10b981 !important; color: #ffffff !important;';
                    }
                }
                if (badgeWrap) {
                    if (data.readinessPercentage >= 100) {
                        badgeWrap.className = 'badge bg-success text-white px-2 py-1';
                    } else {
                        badgeWrap.className = 'badge bg-warning text-dark px-2 py-1';
                    }
                }

                // If steps exist, update individual step cards
                if (data.steps && data.steps.length > 0) {
                    data.steps.forEach(step => {
                        const card = document.getElementById('stepCard_' + step.stepKey);
                        const bubble = document.getElementById('stepBubble_' + step.stepKey);
                        const pillWrap = document.getElementById('stepPillWrap_' + step.stepKey);
                        const actionWrap = document.getElementById('stepActionWrap_' + step.stepKey);

                        if (card) {
                            if (step.isConfigured) {
                                card.className = 'wizard-step-card step-configured';
                            } else if (!step.isUnlocked) {
                                card.className = 'wizard-step-card step-locked';
                            } else {
                                card.className = 'wizard-step-card';
                            }
                        }

                        if (bubble) {
                            if (step.isConfigured) {
                                bubble.innerHTML = '<i class="fas fa-check"></i>';
                            } else if (!step.isUnlocked) {
                                bubble.innerHTML = '<i class="fas fa-lock" style="font-size:0.8rem;"></i>';
                            } else {
                                bubble.innerHTML = '<span>' + step.stepNumber + '</span>';
                            }
                        }

                        if (pillWrap) {
                            if (step.isConfigured) {
                                pillWrap.innerHTML = '<span class="status-pill configured"><i class="fas fa-check-circle"></i> ' + step.countBadgeText + '</span>';
                            } else if (!step.isUnlocked) {
                                pillWrap.innerHTML = '<span class="status-pill locked"><i class="fas fa-lock"></i> Locked (Dependencies Required)</span>';
                            } else {
                                pillWrap.innerHTML = '<span class="status-pill pending"><i class="fas fa-exclamation-circle"></i> Needs Setup</span>';
                            }
                        }

                        if (actionWrap) {
                            if (step.isConfigured) {
                                actionWrap.innerHTML = '<a href="' + step.targetUrl + '" class="btn-wizard-action btn-wizard-edit" target="_blank" rel="noopener"><i class="fas fa-pen-to-square"></i> ' + step.actionButtonText + '</a>';
                            } else if (step.isUnlocked) {
                                actionWrap.innerHTML = '<a href="' + step.targetUrl + '" class="btn-wizard-action" target="_blank" rel="noopener"><i class="fas fa-plus"></i> ' + step.actionButtonText + '</a>';
                            } else {
                                actionWrap.innerHTML = '<button class="btn-wizard-action btn-locked" title="Complete required dependent steps first"><i class="fas fa-lock"></i> ' + step.actionButtonText + '</button>';
                            }
                        }
                    });
                }
            }
        });
    </script>
}
