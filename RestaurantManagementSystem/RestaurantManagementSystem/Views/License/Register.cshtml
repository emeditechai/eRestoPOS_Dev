@model RestaurantManagementSystem.ViewModels.LicenseRegistrationViewModel
@{
    ViewData["Title"] = "License Registration";
    Layout = "_AuthLayout";
}

<div class="license-page license-registration-container">
    <div class="license-card">
        <div class="license-header">
            <div class="license-logo-text">eRestoPOS</div>
            <h2>Application License Registration</h2>
            <p>Register this IIS host with the central licensing server before opening the login page.</p>
        </div>

        <form asp-action="Register" method="post" class="license-form" id="licenseRegistrationForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div id="connectionStatus" class="alert d-none" role="alert"></div>

            <div class="license-overview-banner">
                <div>
                    <div class="license-overview-eyebrow">Central Licensing Setup</div>
                    <div class="license-overview-title">Register this hosted server with verified machine identifiers</div>
                    <p class="license-overview-copy mb-0">Enter client details, review the live host snapshot, and confirm the expiry window. The central licensing server connection is handled internally and is not exposed in the browser.</p>
                </div>

                <div class="license-overview-points">
                    <span class="license-overview-pill"><i class="fas fa-database"></i> Remote + local sync</span>
                    <span class="license-overview-pill"><i class="fas fa-server"></i> Live host capture</span>
                    <span class="license-overview-pill"><i class="fas fa-shield-alt"></i> Daily validation ready</span>
                </div>
            </div>

            <div class="license-register-grid">
                <section class="license-section">
                    <div class="license-section-header">
                        <div>
                            <h4>Client Information</h4>
                            <p class="license-help-text mb-0">These details are saved in both the local application database and the remote licensing database.</p>
                        </div>
                        <span class="license-mini-badge">Required</span>
                    </div>

                    <div class="license-grid-two-up">
                        <div class="form-group">
                            <label asp-for="ClientName" class="control-label"></label>
                            <input asp-for="ClientName" class="form-control" placeholder="Enter client business name" required />
                            <span asp-validation-for="ClientName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ContactNumber" class="control-label"></label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="Enter contact number" required />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group license-grid-span-2">
                            <label asp-for="EmailID" class="control-label"></label>
                            <input asp-for="EmailID" type="email" class="form-control" placeholder="Enter client email address" required />
                            <div class="license-field-note">A welcome email with license details will be sent to this address after successful registration.</div>
                            <span asp-validation-for="EmailID" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="ClientCodePreview" class="control-label"></label>
                            <input asp-for="ClientCodePreview" class="form-control license-readonly" readonly />
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="LicenseKeyPreview" class="control-label"></label>
                            <input asp-for="LicenseKeyPreview" class="form-control license-readonly" readonly />
                        </div>
                    </div>
                </section>

                <section class="license-section">
                    <div class="license-section-header">
                        <div>
                            <h4>Central License Authority</h4>
                            <p class="license-help-text mb-0">The application uses the dedicated central licensing server automatically during registration and daily validation.</p>
                        </div>
                        <span class="license-mini-badge">Internal</span>
                    </div>

                    <div class="license-security-panel">
                        <div class="license-security-item">
                            <span class="license-security-label">Mode</span>
                            <strong>Dedicated central license channel</strong>
                        </div>

                        <div class="license-security-item">
                            <span class="license-security-label">Credential Handling</span>
                            <strong>Managed internally in server-side code</strong>
                        </div>
                    </div>

                    <div class="license-field-note mb-0">No remote server details or credentials are requested from the client during registration.</div>
                </section>

                <section class="license-section">
                    <div class="license-section-header">
                        <div>
                            <h4>Host Machine Snapshot</h4>
                            <p class="license-help-text mb-0">These identifiers are captured live from the current machine running the application.</p>
                        </div>
                        <span class="license-mini-badge">Live Capture</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ServerMacID" class="control-label"></label>
                        <input asp-for="ServerMacID" class="form-control license-readonly" readonly />
                        <div class="license-field-note">Captured from the preferred physical network interface.</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="HardDiskNumber" class="control-label"></label>
                        <input asp-for="HardDiskNumber" class="form-control license-readonly" readonly />
                        <div class="license-field-note">Captured from the primary storage serial or stable disk identifier.</div>
                    </div>

                    <div class="form-group mb-0">
                        <label asp-for="MotherboardNumber" class="control-label"></label>
                        <input asp-for="MotherboardNumber" class="form-control license-readonly" readonly />
                        <div class="license-field-note">Captured from the platform board UUID or system serial identifier.</div>
                    </div>
                </section>

                <section class="license-section">
                    <div class="license-section-header">
                        <div>
                            <h4>License Dates</h4>
                            <p class="license-help-text mb-0">Start date is captured at registration time. End date is the requested expiry.</p>
                        </div>
                        <span class="license-mini-badge">Timeline</span>
                    </div>

                    <div class="license-grid-two-up">
                        <div class="form-group mb-0">
                            <label asp-for="StartDate" class="control-label"></label>
                            <input value="@Model.StartDate.ToString("dd-MMM-yyyy HH:mm")" class="form-control license-readonly" readonly />
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="ExpiryDate" class="control-label"></label>
                            <input asp-for="ExpiryDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="AmcExpiryDate" class="control-label"></label>
                            <input asp-for="AmcExpiryDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <div class="license-field-note">Annual Maintenance Contract expiry. Leave blank if no AMC applies.</div>
                            <span asp-validation-for="AmcExpiryDate" class="text-danger"></span>
                        </div>
                    </div>
                </section>
            </div>

            <div class="license-action-bar">
                <div class="license-submit-note">Click Register License to send a 6-digit OTP to authorized approvers. After successful OTP verification, a welcome email with license details will be sent to the client&rsquo;s email address, and the license will be synced to both the local and central licensing databases.</div>

                <button type="button" class="btn btn-primary license-submit-button" id="startLicenseOtpButton">
                    <i class="fas fa-key me-2"></i>Register License
                </button>
            </div>
        </form>
    </div>
</div>

@* Modal is intentionally placed OUTSIDE .license-card and .license-page.
   Any ancestor with backdrop-filter, filter, transform, or overflow:hidden
   creates a new containing block for position:fixed in Chromium, which
   repositions the Bootstrap backdrop on top of the modal buttons and
   swallows mouse clicks. Keeping the modal at the top level avoids this. *@
<div class="modal fade license-otp-modal" id="licenseOtpModal" tabindex="-1" aria-labelledby="licenseOtpModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-sm-full">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <div class="license-otp-eyebrow">OTP Verification</div>
                            <h5 class="modal-title" id="licenseOtpModalLabel">Verify Registration OTP</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="license-otp-summary">
                            <div class="license-otp-summary-item license-otp-summary-item-full">
                                <span class="label">Approved Email</span>
                                <strong id="licenseOtpTargetEmail">-</strong>
                            </div>
                        </div>

                        <p class="license-otp-copy">Enter the 6-digit OTP sent to the approved email address. The OTP is valid for 120 seconds.</p>

                        <div id="licenseOtpStatus" class="alert d-none" role="alert"></div>

                        <div class="form-group mb-0">
                            <label class="control-label">6-Digit OTP</label>
                            <div class="license-otp-digit-row" id="licenseOtpDigitRow" role="group" aria-label="6 digit OTP input">
                                <input type="text" class="form-control license-otp-digit" data-index="0" inputmode="numeric" maxlength="1" autocomplete="one-time-code" tabindex="0" aria-label="OTP digit 1" />
                                <input type="text" class="form-control license-otp-digit" data-index="1" inputmode="numeric" maxlength="1" autocomplete="one-time-code" tabindex="0" aria-label="OTP digit 2" />
                                <input type="text" class="form-control license-otp-digit" data-index="2" inputmode="numeric" maxlength="1" autocomplete="one-time-code" tabindex="0" aria-label="OTP digit 3" />
                                <input type="text" class="form-control license-otp-digit" data-index="3" inputmode="numeric" maxlength="1" autocomplete="one-time-code" tabindex="0" aria-label="OTP digit 4" />
                                <input type="text" class="form-control license-otp-digit" data-index="4" inputmode="numeric" maxlength="1" autocomplete="one-time-code" tabindex="0" aria-label="OTP digit 5" />
                                <input type="text" class="form-control license-otp-digit" data-index="5" inputmode="numeric" maxlength="1" autocomplete="one-time-code" tabindex="0" aria-label="OTP digit 6" />
                            </div>
                            <input id="licenseOtpCode" type="hidden" />
                            <div class="license-field-note">Type each digit in sequence or paste the full OTP. Resend becomes active after the 120-second timer ends (3 resends allowed).</div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="license-otp-live-countdown" id="licenseOtpLiveCountdown">
                            <i class="far fa-clock"></i>
                            <span>OTP expires in <strong id="licenseOtpTimerValue">01:00</strong></span>
                        </div>
                        <div class="license-otp-action-row">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-outline-primary license-action-disabled" id="resendLicenseOtpButton" aria-disabled="true">Resend OTP</button>
                            <button type="button" class="btn btn-primary" id="verifyLicenseOtpButton">Verify OTP</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('licenseRegistrationForm');
            const registerButton = document.getElementById('startLicenseOtpButton');
            const resendOtpButton = document.getElementById('resendLicenseOtpButton');
            const verifyOtpButton = document.getElementById('verifyLicenseOtpButton');
            const otpInput = document.getElementById('licenseOtpCode');
            const otpDigitInputs = Array.from(document.querySelectorAll('.license-otp-digit'));
            const statusBanner = document.getElementById('connectionStatus');
            const otpStatus = document.getElementById('licenseOtpStatus');
            const otpTimerValue = document.getElementById('licenseOtpTimerValue');
            const otpTargetEmail = document.getElementById('licenseOtpTargetEmail');
            const otpModalElement = document.getElementById('licenseOtpModal');

            if (!form || !registerButton || !otpModalElement || !window.bootstrap || otpDigitInputs.length !== 6) {
                return;
            }

            // Move the modal to document.body before Bootstrap initialises it.
            // .auth-wrapper has position:relative + z-index:2 (needed so the form
            // sits above the fixed auth-bg layers). That creates a stacking context
            // whose z-index is 2 in the root context. Bootstrap appends .modal-backdrop
            // to <body> at z-index 1040 — that is a root-level z-index and therefore
            // paints ABOVE the entire .auth-wrapper stacking context (z-index 2),
            // covering the modal dialog and swallowing mouse clicks. Re-parenting the
            // modal element to <body> before init places both the dialog and the backdrop
            // in the same root stacking context, so Bootstrap's own z-index ordering
            // (backdrop 1040, dialog 1055) works exactly as intended.
            document.body.appendChild(otpModalElement);

            // focus:false  – we own focus entirely, Bootstrap must not race us
            // backdrop:'static' – prevents accidental close that would silently discard the OTP session
            // keyboard:false  – prevents Escape from closing and confusing the user
            const otpModal = new bootstrap.Modal(otpModalElement, { focus: false, backdrop: 'static', keyboard: false });
            const sendOtpUrl = '@Url.Action("StartRegistrationOtp", "License")';
            const verifyOtpUrl = '@Url.Action("VerifyRegistrationOtp", "License")';
            const antiForgeryToken = form.querySelector('input[name="__RequestVerificationToken"]');
            const defaultRegisterLabel = registerButton.innerHTML;
            const defaultVerifyLabel = verifyOtpButton ? verifyOtpButton.innerHTML : '';
            const defaultResendLabel = resendOtpButton ? resendOtpButton.innerHTML : '';
            let countdownHandle = null;
            let isResendAllowed = false;
            let isVerifyAllowed = true;
            let isSendingOtp = false;
            let isVerifyingOtp = false;
            const maxResendAttempts = 3;
            let resendAttemptsLeft = maxResendAttempts;

            function enableOtpInput() {
                otpDigitInputs.forEach(function (input) {
                    input.disabled = false;
                    input.readOnly = false;
                    input.removeAttribute('disabled');
                    input.removeAttribute('readonly');
                });
            }

            function syncOtpCode() {
                otpInput.value = otpDigitInputs.map(function (input) {
                    return input.value.trim();
                }).join('');
            }

            function clearOtpInput() {
                otpDigitInputs.forEach(function (input) {
                    input.value = '';
                });
                syncOtpCode();
            }

            function focusOtpInput(index) {
                const safeIndex = typeof index === 'number' ? Math.max(0, Math.min(index, otpDigitInputs.length - 1)) : 0;
                const targetInput = otpDigitInputs[safeIndex];
                // setTimeout(fn, 0) is more reliable than requestAnimationFrame across browsers
                window.setTimeout(function () {
                    targetInput.focus();
                    targetInput.select();
                }, 0);
            }

            function setAlert(element, type, message) {
                if (!element) {
                    return;
                }

                element.className = `alert alert-${type}`;
                element.textContent = message;
            }

            function clearAlert(element) {
                if (!element) {
                    return;
                }

                element.className = 'alert d-none';
                element.textContent = '';
            }

            function setButtonBusy(button, busy, busyText, defaultText) {
                if (!button) {
                    return;
                }

                // Never set the HTML disabled attribute on verifyOtpButton.
                // Bootstrap 5 applies pointer-events:none to button[disabled], which
                // can block clicks even after the attribute is removed in some browsers.
                // The isVerifyingOtp guard in verifyOtp() is sufficient to prevent re-entry.
                if (button !== verifyOtpButton) {
                    button.disabled = busy;
                }
                button.classList.toggle('license-action-disabled', busy);
                button.setAttribute('aria-disabled', busy ? 'true' : 'false');
                button.innerHTML = busy ? `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${busyText}` : defaultText;
            }

            function setButtonEnabled(button, enabled, defaultText) {
                if (!button) {
                    return;
                }

                // Only clear the disabled attribute on buttons that aren't verifyOtpButton
                // (verifyOtpButton never uses the disabled attribute — see setButtonBusy).
                if (button !== verifyOtpButton) {
                    button.disabled = false;
                }
                button.classList.toggle('license-action-disabled', !enabled);
                button.setAttribute('aria-disabled', enabled ? 'false' : 'true');
                if (defaultText) {
                    button.innerHTML = defaultText;
                }
            }

            function setVerifyAllowed(enabled, label) {
                isVerifyAllowed = enabled;
                setButtonEnabled(verifyOtpButton, enabled, label || defaultVerifyLabel);
            }

            function setResendAllowed(enabled) {
                isResendAllowed = enabled;
                if (enabled) {
                    if (resendAttemptsLeft <= 0) {
                        // No resends remaining — show permanently exhausted label
                        setButtonEnabled(resendOtpButton, false, 'No Resends Left');
                        isResendAllowed = false;
                    } else {
                        setButtonEnabled(resendOtpButton, true,
                            `Resend OTP (${resendAttemptsLeft} left)`);
                    }
                } else {
                    setButtonEnabled(resendOtpButton, false, defaultResendLabel);
                }
            }

            function formatTime(totalSeconds) {
                const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
                const seconds = Math.max(totalSeconds % 60, 0).toString().padStart(2, '0');
                return `${minutes}:${seconds}`;
            }

            function stopCountdown() {
                if (countdownHandle) {
                    window.clearInterval(countdownHandle);
                    countdownHandle = null;
                }
            }

            function startCountdown(totalSeconds) {
                stopCountdown();
                let remainingSeconds = totalSeconds;
                otpTimerValue.textContent = formatTime(remainingSeconds);
                enableOtpInput();
                setVerifyAllowed(true, defaultVerifyLabel);
                setResendAllowed(false);

                countdownHandle = window.setInterval(function () {
                    remainingSeconds -= 1;

                    if (remainingSeconds <= 0) {
                        stopCountdown();
                        otpTimerValue.textContent = '00:00';
                        setVerifyAllowed(false, 'Verify OTP Expired');
                        if (resendAttemptsLeft > 0) {
                            setResendAllowed(true);
                            var plural = resendAttemptsLeft === 1 ? 'time' : 'times';
                            setAlert(otpStatus, 'warning',
                                'OTP expired. Click Resend OTP to get a new code.' +
                                ' You can resend ' + resendAttemptsLeft + ' more ' + plural + '.');
                        } else {
                            setResendAllowed(false);
                            setAlert(otpStatus, 'danger',
                                'OTP expired and all resend attempts are used. Close this dialog and start registration again.');
                        }
                        return;
                    }

                    otpTimerValue.textContent = formatTime(remainingSeconds);
                }, 1000);
            }

            async function postForm(url, formBody) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formBody
                });

                return response.json();
            }

            async function requestOtp() {
                if (isSendingOtp) {
                    return;
                }

                clearAlert(statusBanner);
                clearAlert(otpStatus);

                if (!form.reportValidity()) {
                    return;
                }

                isSendingOtp = true;
                setButtonBusy(registerButton, true, 'Sending OTP...', defaultRegisterLabel);

                try {
                    const formBody = new URLSearchParams(new FormData(form));
                    const result = await postForm(sendOtpUrl, formBody);

                    if (result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                        return;
                    }

                    if (!result.success) {
                        setAlert(statusBanner, 'danger', result.message || 'Unable to send OTP.');
                        return;
                    }

                    // Consume a resend attempt when showing a fresh OTP
                    // (the very first send also counts — that uses the initial maxResendAttempts slot).
                    resendAttemptsLeft = Math.max(0, resendAttemptsLeft - 1);
                    clearOtpInput();
                    enableOtpInput();
                    otpTargetEmail.textContent = result.targetEmail || 'authorized approvers';
                    setAlert(statusBanner, 'success', result.message || 'OTP sent successfully.');
                    setAlert(otpStatus, 'info', 'Enter the 6-digit OTP sent to the approved email address. The countdown is running below.');
                    otpModal.show();
                    startCountdown(result.expiresInSeconds || 120);

                    window.setTimeout(function () {
                        focusOtpInput(0);
                    }, 250);
                } catch (error) {
                    setAlert(statusBanner, 'danger', 'Unable to send OTP right now. Please try again.');
                } finally {
                    isSendingOtp = false;
                    setButtonBusy(registerButton, false, 'Sending OTP...', defaultRegisterLabel);
                }
            }

            async function verifyOtp() {
                if (isVerifyingOtp) {
                    return;
                }

                if (!isVerifyAllowed) {
                    setAlert(otpStatus, 'warning', 'OTP expired. Click Resend OTP to generate a new code.');
                    return;
                }

                clearAlert(otpStatus);

                syncOtpCode();
                const otpCode = otpInput.value.trim();
                if (!/^\d{6}$/.test(otpCode)) {
                    setAlert(otpStatus, 'danger', 'Enter the 6-digit OTP sent to the approved email address.');
                    const firstEmptyIndex = otpDigitInputs.findIndex(function (input) {
                        return !input.value.trim();
                    });
                    focusOtpInput(firstEmptyIndex >= 0 ? firstEmptyIndex : 0);
                    return;
                }

                isVerifyingOtp = true;
                const formBody = new URLSearchParams();
                formBody.append('__RequestVerificationToken', antiForgeryToken ? antiForgeryToken.value : '');
                formBody.append('otpCode', otpCode);

                setButtonBusy(verifyOtpButton, true, 'Verifying OTP...', defaultVerifyLabel);

                try {
                    const result = await postForm(verifyOtpUrl, formBody);

                    if (result.redirectUrl && !result.success) {
                        setAlert(otpStatus, 'danger', result.message || 'License validation failed.');
                        window.setTimeout(function () {
                            window.location.href = result.redirectUrl;
                        }, 600);
                        return;
                    }

                    if (!result.success) {
                        setAlert(otpStatus, 'danger', result.message || 'OTP verification failed.');
                        return;
                    }

                    setAlert(otpStatus, 'success', result.message || 'OTP verified successfully. Redirecting...');
                    stopCountdown();

                    if (result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    }
                } catch (error) {
                    setAlert(otpStatus, 'danger', 'Unable to verify OTP right now. Please try again.');
                } finally {
                    isVerifyingOtp = false;
                    setButtonBusy(verifyOtpButton, false, 'Verifying OTP...', defaultVerifyLabel);
                }
            }

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                requestOtp();
            });

            registerButton.addEventListener('click', function () {
                requestOtp();
            });

            resendOtpButton.addEventListener('click', function () {
                if (!isResendAllowed) {
                    setAlert(otpStatus, 'info', 'Resend OTP becomes available after the 60-second timer ends.');
                    return;
                }

                requestOtp();
            });

            verifyOtpButton.addEventListener('click', function () {
                verifyOtp();
            });

            otpDigitInputs.forEach(function (input, index) {
                input.addEventListener('focus', function () {
                    input.select();
                });

                input.addEventListener('input', function () {
                    const digit = input.value.replace(/\D/g, '').slice(-1);
                    input.value = digit;
                    syncOtpCode();

                    if (digit && index < otpDigitInputs.length - 1) {
                        focusOtpInput(index + 1);
                    }
                });

                input.addEventListener('keydown', function (event) {
                    if (event.key === 'Backspace' && !input.value && index > 0) {
                        otpDigitInputs[index - 1].value = '';
                        syncOtpCode();
                        focusOtpInput(index - 1);
                        event.preventDefault();
                        return;
                    }

                    if (event.key === 'ArrowLeft' && index > 0) {
                        focusOtpInput(index - 1);
                        event.preventDefault();
                        return;
                    }

                    if (event.key === 'ArrowRight' && index < otpDigitInputs.length - 1) {
                        focusOtpInput(index + 1);
                        event.preventDefault();
                        return;
                    }

                    if (event.key === 'Enter') {
                        event.preventDefault();
                        verifyOtp();
                    }
                });

                input.addEventListener('paste', function (event) {
                    const pastedText = (event.clipboardData || window.clipboardData).getData('text') || '';
                    const digits = pastedText.replace(/\D/g, '').slice(0, otpDigitInputs.length).split('');
                    if (!digits.length) {
                        return;
                    }

                    otpDigitInputs.forEach(function (digitInput, digitIndex) {
                        digitInput.value = digits[digitIndex] || '';
                    });
                    syncOtpCode();

                    const nextIndex = Math.min(digits.length, otpDigitInputs.length - 1);
                    focusOtpInput(nextIndex);
                    event.preventDefault();
                });
            });

            otpModalElement.addEventListener('shown.bs.modal', function () {
                // Ensure inputs are never disabled when the modal is fully visible
                enableOtpInput();
                // Delay focus slightly so it fires after Bootstrap finishes its own modal setup
                window.setTimeout(function () {
                    focusOtpInput(0);
                }, 80);
            });

            otpModalElement.addEventListener('hidden.bs.modal', function () {
                stopCountdown();
                clearAlert(otpStatus);
                clearOtpInput();
                // Reset attempt counter so a fresh Register License click starts with 3 resends again
                resendAttemptsLeft = maxResendAttempts;
                setVerifyAllowed(true, defaultVerifyLabel);
                setResendAllowed(false);
            });

            // Clicking anywhere on the digit row (but not a box itself) focuses the first empty box
            var otpDigitRow = document.getElementById('licenseOtpDigitRow');
            if (otpDigitRow) {
                otpDigitRow.addEventListener('click', function (event) {
                    if (!otpDigitInputs.includes(event.target)) {
                        var firstEmpty = otpDigitInputs.findIndex(function (inp) { return !inp.value.trim(); });
                        focusOtpInput(firstEmpty >= 0 ? firstEmpty : otpDigitInputs.length - 1);
                    }
                });
            }
        });
    </script>
}