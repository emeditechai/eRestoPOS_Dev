@model TableServiceDashboardViewModel
@{
    ViewData["Title"] = "Table Service Dashboard";
}

<style>
    .hourly-collapse-btn .label-collapse { display: none; }
    .hourly-collapse-btn.collapsed .label-expand { display: inline; }
    .hourly-collapse-btn.collapsed .label-collapse { display: none; }
    .hourly-collapse-btn:not(.collapsed) .label-expand { display: none; }
    .hourly-collapse-btn:not(.collapsed) .label-collapse { display: inline; }
    .hourly-collapse-btn .chevron { transition: transform .2s ease; }
    .hourly-collapse-btn:not(.collapsed) .chevron { transform: rotate(180deg); }
</style>

<div class="container-fluid px-2 px-md-3 pt-0 pb-3">
    <!-- Page Header -->
    <div class="tsd-page-header rounded-3 mb-3 px-3 px-md-4 py-3 d-flex align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3 me-auto">
            <div class="tsd-header-icon">
                <i class="fas fa-th-large"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-white">Table Service Dashboard</h5>
                <small class="text-white-50">Live table status, revenue and performance</small>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="SeatGuest" class="btn btn-warning btn-sm fw-semibold text-dark">
                <i class="fas fa-chair me-1"></i><span class="d-none d-sm-inline">Seat New Guest</span><span class="d-sm-none">Seat</span>
            </a>
            <a asp-action="ActiveTables" class="btn btn-light btn-sm fw-semibold">
                <i class="fas fa-list me-1"></i><span class="d-none d-md-inline">View All Active Tables</span><span class="d-md-none">Active</span>
            </a>
            <a href="@Url.Action("CleanupStaleTurnovers", "TableService")" class="btn btn-sm fw-semibold swal-confirm-link"
               style="background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3)"
               data-swal-title="Cleanup Stale Tables"
               data-swal-text="This will clean up old table turnovers and reset available tables. Continue?"
               data-swal-icon="warning">
                <i class="fas fa-broom me-1"></i><span class="d-none d-md-inline">Cleanup Stale Tables</span><span class="d-md-none">Cleanup</span>
            </a>
            <a href="@Url.Action("ForceResetAllTables", "TableService")" class="btn btn-danger btn-sm fw-semibold swal-confirm-link"
               data-swal-title="Force Reset All Tables"
               data-swal-text="This will FORCE RESET all tables to available, cancel all active orders, and clear all turnovers. Are you sure?"
               data-swal-icon="warning">
                <i class="fas fa-power-off me-1"></i><span class="d-none d-md-inline">Force Reset</span><span class="d-md-none">Reset</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Row 1: Table Status -->
    <div class="row mb-3 g-2">
        <div class="col-6 col-lg-3">
            <div class="tsd-kpi-card" style="--kpi-c1:#22c55e;--kpi-c2:#16a34a;--kpi-border:#16a34a">
                <div class="tsd-kpi-icon" style="background:#16a34a"><i class="fas fa-check-circle"></i></div>
                <div>
                    <div class="tsd-kpi-label">Available Tables</div>
                    <div class="tsd-kpi-value" style="color:#16a34a">@Model.AvailableTables</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="tsd-kpi-card" style="--kpi-c1:#3b82f6;--kpi-c2:#2563eb;--kpi-border:#2563eb">
                <div class="tsd-kpi-icon" style="background:#2563eb"><i class="fas fa-user-clock"></i></div>
                <div>
                    <div class="tsd-kpi-label">Occupied Tables</div>
                    <div class="tsd-kpi-value" style="color:#2563eb">@Model.OccupiedTables</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="tsd-kpi-card" style="--kpi-c1:#f59e0b;--kpi-c2:#d97706;--kpi-border:#d97706">
                <div class="tsd-kpi-icon" style="background:#d97706"><i class="fas fa-broom"></i></div>
                <div>
                    <div class="tsd-kpi-label">Dirty Tables</div>
                    <div class="tsd-kpi-value" style="color:#d97706">@Model.DirtyTables</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="tsd-kpi-card" style="--kpi-c1:#06b6d4;--kpi-c2:#0891b2;--kpi-border:#0891b2">
                <div class="tsd-kpi-icon" style="background:#0891b2"><i class="fas fa-clipboard-list"></i></div>
                <div>
                    <div class="tsd-kpi-label">Waitlist / Reservations</div>
                    <div class="tsd-kpi-value" style="color:#0891b2">@Model.WaitlistCount / @Model.ReservationCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics Row 2 -->
    <div class="row mb-3 g-2">
        <!-- Average Turnover Time Card -->
        <div class="col-6 col-lg-3">
            <div class="tsd-metric-card" style="background:linear-gradient(135deg,#8b5cf6,#6366f1)">
                <div class="tsd-metric-icon"><i class="fas fa-clock"></i></div>
                <div class="tsd-metric-label">Avg. Turnover Time</div>
                <div class="tsd-metric-value">@Model.AverageTurnoverTime.ToString("0") <small>min</small></div>
                <div class="tsd-metric-sub"><i class="fas fa-info-circle me-1"></i>Completed tables today</div>
            </div>
        </div>

        <!-- Today's Revenue Card -->
        <div class="col-6 col-lg-3">
            <div class="tsd-metric-card" style="background:linear-gradient(135deg,#10b981,#059669)">
                <div class="tsd-metric-icon"><i class="fas fa-dollar-sign"></i></div>
                <div class="tsd-metric-label">Today's Revenue</div>
                <div class="tsd-metric-value">₹@Model.TodayRevenue.ToString("N0")</div>
                <div class="tsd-metric-sub"><i class="fas fa-chart-line me-1"></i>All orders today</div>
            </div>
        </div>

        <!-- Revenue Per Table Card -->
        <div class="col-6 col-lg-3">
            <div class="tsd-metric-card" style="background:linear-gradient(135deg,#f59e0b,#d97706)">
                <div class="tsd-metric-icon"><i class="fas fa-chart-pie"></i></div>
                <div class="tsd-metric-label">Avg. Revenue/Table</div>
                <div class="tsd-metric-value">₹@Model.AverageRevenuePerTable.ToString("N0")</div>
                <div class="tsd-metric-sub"><i class="fas fa-utensils me-1"></i>Per table performance</div>
            </div>
        </div>

        <!-- Peak Hours Card -->
        <div class="col-6 col-lg-3">
            <div class="tsd-metric-card" style="background:linear-gradient(135deg,#ec4899,#db2777)">
                <div class="tsd-metric-icon"><i class="fas fa-fire"></i></div>
                <div class="tsd-metric-label">Peak Hours</div>
                <div class="tsd-metric-value">
                    @if (Model.PeakHours.Any(p => p.IsPeakHour))
                    {
                        var peakHours = Model.PeakHours.Where(p => p.IsPeakHour).Take(2);
                        @string.Join(", ", peakHours.Select(p => p.Hour.ToString()))
                    }
                    else
                    {
                        <text>N/A</text>
                    }
                </div>
                <div class="tsd-metric-sub"><i class="fas fa-users me-1"></i>Busiest hours today</div>
            </div>
        </div>
    </div>

    <!-- Server Performance & Peak Hours Details -->
    <div class="row mb-3 g-2">
        <!-- Server Performance Section -->
        @if (Model.ServerPerformance.Any())
        {
            <div class="col-lg-8">
                <div class="tsd-section-card">
                    <div class="tsd-section-header">
                        <span><i class="fas fa-user-tie me-2"></i>Server Performance</span>
                        <span class="badge ms-2" style="background:#7c3aed22;color:#7c3aed;font-size:10px">Live</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4 py-3">Server</th>
                                        <th class="px-4 py-3 text-center">Active Tables</th>
                                        <th class="px-4 py-3 text-center">Orders Today</th>
                                        <th class="px-4 py-3 text-end">Revenue Today</th>
                                        <th class="px-4 py-3 text-center">Workload</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var server in Model.ServerPerformance)
                                    {
                                        <tr>
                                            <td class="px-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-weight: bold;">
                                                        @server.ServerName.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <span class="fw-semibold">@server.ServerName</span>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="badge bg-info rounded-pill px-3 py-2">@server.ActiveTables</span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-muted fw-semibold">@server.TotalOrders</span>
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                <span class="fw-bold text-success">₹@server.TotalRevenue.ToString("N0")</span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="badge bg-@server.WorkloadColor rounded-pill px-3 py-2">
                                                    @server.WorkloadLevel.ToUpper()
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Peak Hours Chart Section -->
        @if (Model.PeakHours.Any())
        {
            <div class="col-lg-4">
                <div class="tsd-section-card h-100">
                    <div class="tsd-section-header">
                        <span><i class="fas fa-chart-bar me-2"></i>Hourly Activity</span>
                        <button class="btn btn-sm ms-auto hourly-collapse-btn collapsed"
                                style="background:rgba(124,58,237,.1);color:#7c3aed;border:none;font-size:12px"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#hourlyActivityCollapse"
                                aria-expanded="false"
                                aria-controls="hourlyActivityCollapse">
                            <span class="label-expand">Expand</span>
                            <span class="label-collapse">Collapse</span>
                            <i class="fas fa-chevron-down ms-1 chevron"></i>
                        </button>
                    </div>
                    <div id="hourlyActivityCollapse" class="collapse">
                        <div class="card-body px-4 py-3">
                            <div class="peak-hours-list" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var hour in Model.PeakHours.OrderByDescending(p => p.OrderCount))
                            {
                                var percentage = Model.PeakHours.Max(p => p.OrderCount) > 0 
                                    ? (hour.OrderCount * 100.0 / Model.PeakHours.Max(p => p.OrderCount)) 
                                    : 0;
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-semibold text-dark">@hour.HourDisplay</span>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (hour.IsPeakHour)
                                            {
                                                <i class="fas fa-fire text-danger" title="Peak Hour"></i>
                                            }
                                            <span class="badge bg-secondary rounded-pill">@hour.OrderCount</span>
                                        </div>
                                    </div>
                                    <div class="progress" style="height: 8px; background-color: #f0f0f0; border-radius: 10px;">
                                        <div class="progress-bar @(hour.IsPeakHour ? "bg-danger" : "bg-primary")" 
                                             role="progressbar" 
                                             style="width: @percentage%; border-radius: 10px;" 
                                             aria-valuenow="@hour.OrderCount" 
                                             aria-valuemin="0" 
                                             aria-valuemax="@Model.PeakHours.Max(p => p.OrderCount)">
                                        </div>
                                    </div>
                                    <small class="text-muted">₹@hour.Revenue.ToString("N0")</small>
                                </div>
                            }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- All Tables -->
    <div class="row">
        <div class="col-12">
            <div class="tsd-section-card">
                <div class="tsd-section-header" style="flex-wrap:wrap;gap:6px">
                    <span><i class="fas fa-th-large me-2"></i>All Tables</span>
                    <div class="d-flex flex-wrap gap-2 ms-auto">
                        <span class="tsd-legend"><i class="fas fa-circle" style="color:#22c55e"></i> Available</span>
                        <span class="tsd-legend"><i class="fas fa-circle" style="color:#3b82f6"></i> Reserved</span>
                        <span class="tsd-legend"><i class="fas fa-circle" style="color:#ef4444"></i> Occupied</span>
                        <span class="tsd-legend"><i class="fas fa-circle" style="color:#f59e0b"></i> Dirty</span>
                    </div>
                </div>
                <div class="card-body p-3" style="background:#f9fafb;max-height:calc(100vh - 280px);overflow-y:auto">
                    @if (Model.UnoccupiedTables.Any())
                    {
                        var tableCount = Model.UnoccupiedTables.Count;
                        // Auto-resize cards based on table count to fit all on one screen
                        var colClass = tableCount <= 6 ? "col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6" : 
                                      tableCount <= 10 ? "col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-4 col-6" : 
                                      tableCount <= 15 ? "col-xxl-1 col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6" :
                                      tableCount <= 20 ? "col-xxl-1 col-xl-1 col-lg-1 col-md-2 col-sm-3 col-4" :
                                      "col-1";
                        var rowGap = tableCount <= 10 ? "g-2" : tableCount <= 15 ? "g-1" : "g-1";
                        // Fully dynamic sizing based on table count
                        var iconSize = tableCount <= 6 ? "38px" : 
                                      tableCount <= 10 ? "36px" : 
                                      tableCount <= 15 ? "32px" : 
                                      tableCount <= 20 ? "28px" : "24px";
                        var iconFontSize = tableCount <= 6 ? "1rem" : 
                                          tableCount <= 10 ? "0.95rem" : 
                                          tableCount <= 15 ? "0.85rem" : 
                                          tableCount <= 20 ? "0.75rem" : "0.7rem";
                        var tableNameSize = tableCount <= 6 ? "1.1rem" : 
                                           tableCount <= 10 ? "1rem" : 
                                           tableCount <= 15 ? "0.9rem" : 
                                           tableCount <= 20 ? "0.8rem" : "0.75rem";
                        var cardPadding = tableCount <= 6 ? "0.6rem" : 
                                         tableCount <= 10 ? "0.5rem" : 
                                         tableCount <= 15 ? "0.45rem" : 
                                         tableCount <= 20 ? "0.4rem" : "0.35rem";
                        var badgeFontSize = tableCount <= 6 ? "0.7rem" : 
                                           tableCount <= 10 ? "0.65rem" : 
                                           tableCount <= 15 ? "0.6rem" : 
                                           tableCount <= 20 ? "0.55rem" : "0.5rem";
                        var buttonFontSize = tableCount <= 6 ? "0.75rem" : 
                                            tableCount <= 10 ? "0.7rem" : 
                                            tableCount <= 15 ? "0.65rem" : 
                                            tableCount <= 20 ? "0.6rem" : "0.55rem";
                        var buttonPadding = tableCount <= 10 ? "0.5rem 0.75rem" : 
                                           tableCount <= 15 ? "0.45rem 0.65rem" : 
                                           tableCount <= 20 ? "0.4rem 0.6rem" : "0.35rem 0.5rem";
                        var sectionFontSize = tableCount <= 10 ? "0.65rem" : 
                                             tableCount <= 15 ? "0.6rem" : "0.55rem";
                        var capacityIconSize = tableCount <= 10 ? "0.7rem" : 
                                              tableCount <= 15 ? "0.65rem" : "0.6rem";
                        
                        <div class="row @rowGap">
                            @foreach (var table in Model.UnoccupiedTables)
                            {
                                var isAvailable = table.Status == 0;
                                var isReserved = table.Status == 1;
                                var isOccupied = table.Status == 2;
                                var isDirty = table.Status == 3;
                                var canOrder = isAvailable || isReserved;

                                string reservedForText = null;
                                if (isReserved && table.NextReservationAt.HasValue)
                                {
                                    var at = table.NextReservationAt.Value;
                                    reservedForText = at.Date == DateTime.Today
                                        ? $"Today {at:hh:mm tt}"
                                        : at.Date == DateTime.Today.AddDays(1)
                                            ? $"Tomorrow {at:hh:mm tt}"
                                            : $"{at:dd MMM yyyy hh:mm tt}";
                                }
                                
                                var bgGradient = isAvailable ? "linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%)" : 
                                                (isReserved ? "linear-gradient(145deg, #ffffff 0%, #dbeafe 100%)" : 
                                                (isOccupied ? "linear-gradient(145deg, #ffffff 0%, #fee2e2 100%)" : "linear-gradient(145deg, #ffffff 0%, #fef3c7 100%)"));
                                var borderColor = isAvailable ? "#22c55e" : (isReserved ? "#3b82f6" : (isOccupied ? "#ef4444" : "#f59e0b"));
                                var iconColor = isAvailable ? "#16a34a" : (isReserved ? "#2563eb" : (isOccupied ? "#dc2626" : "#d97706"));
                                var badgeGradient = isAvailable ? "linear-gradient(135deg, #22c55e 0%, #10b981 100%)" : 
                                                   (isReserved ? "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)" : 
                                                   (isOccupied ? "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)" : "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)"));
                                var statusIcon = isAvailable ? "fa-check-circle" : (isReserved ? "fa-bookmark" : (isOccupied ? "fa-user-clock" : "fa-broom"));
                                var statusText = table.StatusDisplay.ToUpper();
                                
                                <div class="@colClass">
                                    <div class="card table-card border-0 position-relative @(canOrder ? "" : "table-disabled")" style="background: @bgGradient; border: 2px solid @borderColor !important; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 16px; box-shadow: 0 6px 20px rgba(0,0,0,0.1), 0 2px 6px rgba(0,0,0,0.06); @(canOrder ? "cursor: pointer;" : "opacity: 0.7; cursor: not-allowed;") overflow: hidden; aspect-ratio: 1/1;">
                                        <!-- Decorative corner accent -->
                                        <div class="position-absolute" style="top: 0; right: 0; width: 60px; height: 60px; background: @badgeGradient; opacity: 0.12; clip-path: polygon(100% 0, 100% 100%, 0 0); z-index: 1;"></div>
                                        
                                        <div class="card-body text-center d-flex flex-column justify-content-between" style="position: relative; z-index: 2; padding: @cardPadding; height: 100%;">
                                            <!-- Top Section: Icon & Table Name -->
                                            <div class="mb-1">
                                                <div class="table-icon-wrapper d-inline-flex align-items-center justify-content-center mb-1" style="width: @iconSize; height: @iconSize; background: @badgeGradient; border-radius: 12px; box-shadow: 0 3px 12px rgba(0,0,0,0.12); transform: rotate(-4deg); transition: all 0.3s ease;">
                                                    <i class="fas fa-utensils" style="font-size: @iconFontSize; color: #ffffff; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2)); transform: rotate(4deg);"></i>
                                                </div>
                                                <h3 class="table-name fw-bold mb-0" style="color: #1a1a1a; font-size: @tableNameSize; letter-spacing: 0.3px; font-family: 'Segoe UI', system-ui, sans-serif; text-shadow: 0 1px 3px rgba(0,0,0,0.05);">@table.TableName</h3>
                                                @if (!string.IsNullOrEmpty(table.Section))
                                                {
                                                    <div class="d-inline-block px-2 py-1 mb-1" style="background: rgba(0,0,0,0.05); border-radius: 6px; font-size: @sectionFontSize; color: #666; font-weight: 600;">
                                                        <i class="fas fa-map-marker-alt me-1" style="font-size: @sectionFontSize;"></i>@table.Section
                                                    </div>
                                                }
                                            </div>
                                            
                                            <!-- Middle Section: Capacity -->
                                            <div class="mb-1">
                                                <div class="d-inline-flex align-items-center gap-1 px-2 py-1" style="background: rgba(0,0,0,0.04); border-radius: 8px; font-size: @badgeFontSize; color: #495057; font-weight: 600;">
                                                    <i class="fas fa-users" style="color: @iconColor; font-size: @capacityIconSize;"></i>
                                                    <span>@table.Capacity</span>
                                                </div>
                                            </div>
                                            
                                            <!-- Status Badge -->
                                            <div class="mb-1">
                                                <span class="badge text-white fw-bold px-2 py-1 w-100" style="font-size: @badgeFontSize; border-radius: 8px; background: @badgeGradient; box-shadow: 0 2px 8px rgba(0,0,0,0.15); border: 1.5px solid rgba(255,255,255,0.3); letter-spacing: 0.2px;">
                                                    <i class="fas @statusIcon me-1" style="font-size: @badgeFontSize;"></i>@statusText
                                                </span>
                                                @if (!string.IsNullOrEmpty(reservedForText))
                                                {
                                                    <div class="mt-1" style="font-size: @badgeFontSize; color: #374151; font-weight: 700;">
                                                        <i class="fas fa-calendar-alt me-1" style="color: @iconColor; font-size: @badgeFontSize;"></i>
                                                        @reservedForText
                                                    </div>
                                                }
                                            </div>
                                            
                                            <!-- Bottom Section: Action Button -->
                                            <div>
                                                @if (canOrder)
                                                {
                                                    <a href="@Url.Action("Create", "Order", new { tableId = table.Id })" 
                                                       class="btn fw-bold text-white create-order-btn w-100" style="background: @badgeGradient; font-size: @buttonFontSize; padding: @buttonPadding; border-radius: 8px; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.2); text-transform: uppercase; letter-spacing: 0.3px; font-weight: 700; transition: all 0.3s ease;">
                                                        <i class="fas fa-plus me-1" style="font-size: @badgeFontSize;"></i>Order
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button disabled class="btn fw-bold text-white w-100" style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); font-size: @buttonFontSize; padding: @buttonPadding; border-radius: 8px; border: none; text-transform: uppercase; letter-spacing: 0.3px; font-weight: 700; cursor: not-allowed; opacity: 0.5;">
                                                        <i class="fas fa-lock me-1" style="font-size: @badgeFontSize;"></i>@table.StatusDisplay
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        
                                        <!-- Status Indicator Badge -->
                                        <div class="position-absolute" style="top: 5px; right: 5px; z-index: 10;">
                                            <div class="d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; background: @badgeGradient; border-radius: 7px; box-shadow: 0 2px 8px rgba(0,0,0,0.25); border: 1.5px solid rgba(255,255,255,0.95);">
                                                <i class="fas @statusIcon text-white" style="font-size: 0.7rem;"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-chair fa-4x text-muted opacity-50"></i>
                            </div>
                            <h5 class="text-muted">No Tables Found</h5>
                            <p class="text-muted mb-0">No tables are configured in the system.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ---- Page Header ---- */
        .tsd-page-header {
            background: linear-gradient(135deg, #1e0a4a 0%, #2a106d 60%, #4a1fa8 100%);
            box-shadow: 0 4px 18px rgba(42,16,109,.35);
        }
        .tsd-header-icon {
            width: 40px; height: 40px;
            background: rgba(255,255,255,.15);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1.1rem;
            flex-shrink: 0;
        }

        /* ---- KPI Status Cards (Row 1) ---- */
        .tsd-kpi-card {
            background: #fff;
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            border-left: 4px solid var(--kpi-border, #7c3aed);
        }
        .tsd-kpi-icon {
            width: 40px; height: 40px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1rem;
            flex-shrink: 0;
        }
        .tsd-kpi-label { font-size: 0.72rem; color: #6b7280; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; }
        .tsd-kpi-value { font-size: 1.6rem; font-weight: 800; line-height: 1.1; }

        /* ---- Metric Cards (Row 2 - Analytics) ---- */
        .tsd-metric-card {
            border-radius: 12px;
            padding: 14px 16px;
            color: #fff;
            box-shadow: 0 4px 14px rgba(0,0,0,.15);
            min-height: 95px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .tsd-metric-icon { font-size: 1.25rem; opacity: .85; margin-bottom: 4px; }
        .tsd-metric-label { font-size: 0.7rem; font-weight: 600; opacity: .9; text-transform: uppercase; letter-spacing: .4px; }
        .tsd-metric-value { font-size: 1.4rem; font-weight: 800; line-height: 1.2; }
        .tsd-metric-value small { font-size: 0.9rem; font-weight: 600; }
        .tsd-metric-sub { font-size: 0.65rem; opacity: .8; margin-top: 2px; }

        /* ---- Section Cards ---- */
        .tsd-section-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            overflow: hidden;
            height: 100%;
        }
        .tsd-section-header {
            background: linear-gradient(135deg, #f5f3ff 0%, #fff 100%);
            border-bottom: 1px solid #ede9fe;
            padding: 10px 16px;
            font-size: 0.82rem;
            font-weight: 700;
            color: #2a106d;
            display: flex;
            align-items: center;
        }

        /* ---- Legend pills ---- */
        .tsd-legend {
            font-size: 0.72rem;
            font-weight: 600;
            color: #374151;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* ---- Table Cards ---- */
        .table-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px !important;
            overflow: hidden;
        }
        .table-card:not(.table-disabled):hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 16px 40px rgba(0,0,0,.18), 0 6px 14px rgba(0,0,0,.08) !important;
        }
        .table-card:not(.table-disabled):hover .table-icon-wrapper {
            transform: rotate(0deg) scale(1.1);
            box-shadow: 0 6px 22px rgba(0,0,0,.22);
        }
        .table-card.table-disabled { pointer-events: none; }
        .table-card:not(.table-disabled):hover .create-order-btn {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0,0,0,.3) !important;
        }

        .create-order-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none !important;
            font-weight: 700 !important;
        }

        @@keyframes slideInUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .table-card { animation: slideInUp 0.45s ease-out; }

        @@keyframes ripple { to { transform: scale(4); opacity: 0; } }
    </style>
    
    <script>
        $(document).ready(function () {
            // Auto-refresh the page every 2 minutes
            setTimeout(function() {
                location.reload();
            }, 120000);
            
            // Add click event to table cards for better UX
            $('.table-card').click(function(e) {
                if (!$(e.target).hasClass('create-order-btn') && !$(e.target).closest('.create-order-btn').length) {
                    $(this).find('.create-order-btn')[0].click();
                }
            });
            
            // Add ripple effect on card click
            $('.table-card').on('click', function(e) {
                var $this = $(this);
                var $ripple = $('<div class="ripple"></div>');
                var size = Math.max($this.outerWidth(), $this.outerHeight());
                var x = e.pageX - $this.offset().left - size / 2;
                var y = e.pageY - $this.offset().top - size / 2;
                
                $ripple.css({
                    width: size,
                    height: size,
                    top: y,
                    left: x,
                    background: 'rgba(255,255,255,0.3)',
                    borderRadius: '50%',
                    position: 'absolute',
                    transform: 'scale(0)',
                    animation: 'ripple 0.6s linear',
                    pointerEvents: 'none'
                });
                
                $this.append($ripple);
                
                setTimeout(function() {
                    $ripple.remove();
                }, 600);
            });
        });
        
        // Auto-refresh dashboard every 60 seconds
        let refreshInterval;
        let countdown = 60;
        
        function startAutoRefresh() {
            refreshInterval = setInterval(function() {
                countdown--;
                if (countdown <= 0) {
                    location.reload();
                }
            }, 1000);
        }
        
        function resetCountdown() {
            countdown = 60;
        }
        
        // Start auto-refresh
        startAutoRefresh();
        
        // Reset countdown on user interaction
        $(document).on('click keypress scroll', function() {
            resetCountdown();
        });
        
        // Add live indicator pulse animation  
        var pulseStyle = document.createElement('style');
        pulseStyle.innerHTML = '@@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } } .badge.bg-primary { animation: pulse 2s ease-in-out infinite; }';
        document.head.appendChild(pulseStyle);

        // SweetAlert2 confirmation for action links
        document.querySelectorAll('.swal-confirm-link').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                var url = this.getAttribute('href');
                var title = this.getAttribute('data-swal-title') || 'Are you sure?';
                var text = this.getAttribute('data-swal-text') || 'This action cannot be undone.';
                var icon = this.getAttribute('data-swal-icon') || 'warning';

                Swal.fire({
                    title: title,
                    text: text,
                    icon: icon,
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, proceed',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then(function(result) {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}
