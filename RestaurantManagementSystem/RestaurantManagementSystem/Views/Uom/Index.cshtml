@model IEnumerable<RestaurantManagementSystem.Models.UomMaster>
@{
    ViewData["Title"] = "UOM Master";
    var uomTypes = (string[])ViewBag.UOMTypes;
    // Only the user with username 'Admin' can Add / Edit / Delete UOMs.
    bool isAdminUser = User?.Identity?.IsAuthenticated == true
        && string.Equals(User.Identity!.Name, "Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fas fa-ruler-combined me-2 text-primary"></i>UOM Master
            </h4>
            <small class="text-muted">Unit of Measurement master used in BOM, purchase &amp; recipes</small>
        </div>
        @if (isAdminUser)
        {
            <a asp-action="Form" asp-controller="Uom" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Add New UOM
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters + Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-2 d-flex align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-muted me-auto">
                <i class="fas fa-list me-1"></i>All UOMs
                <span class="badge bg-primary ms-1">@Model.Count()</span>
                <span class="badge bg-success ms-1">Active: @Model.Count(u => u.IsActive)</span>
            </span>

            <!-- Type Filter -->
            <select class="form-select form-select-sm" id="filterType" style="width:140px;">
                <option value="">All Types</option>
                @foreach (var t in uomTypes)
                {
                    <option value="@t">@t</option>
                }
            </select>

            <!-- Status Filter -->
            <select class="form-select form-select-sm" id="filterStatus" style="width:120px;">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblUom" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">Code</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Base UOM</th>
                            <th class="text-end">Conv. Factor</th>
                            <th class="text-end">Pack Size</th>
                            <th class="text-center">Decimals</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace">@u.UOMCode</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@u.UOMName</div>
                                    @if (!string.IsNullOrEmpty(u.Description))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width:240px"
                                               title="@u.Description">@u.Description</small>
                                    }
                                </td>
                                <td>
                                    @{
                                        var (typeBg, typeIcon) = u.UOMType switch
                                        {
                                            "Weight" => ("bg-warning-subtle text-warning",   "fa-weight-hanging"),
                                            "Volume" => ("bg-info-subtle text-info",         "fa-tint"),
                                            "Count"  => ("bg-success-subtle text-success",   "fa-hashtag"),
                                            _        => ("bg-secondary-subtle text-secondary", "fa-question-circle")
                                        };
                                    }
                                    <span class="badge @typeBg">
                                        <i class="fas @typeIcon me-1"></i>@u.UOMType
                                    </span>
                                </td>
                                <td>
                                    @if (u.BaseUOMId.HasValue)
                                    {
                                        <span class="fw-bold text-primary">@u.BaseUOMCode</span>
                                        <small class="text-muted d-block">@u.BaseUOMName</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary small">Base unit</span>
                                    }
                                </td>
                                <td class="text-end font-monospace small">@u.ConversionFactor.ToString("G10")</td>
                                <td class="text-end font-monospace small">
                                    @if (u.PackSize.HasValue)
                                    { @u.PackSize.Value.ToString("G6") }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-center small">@u.DecimalPlaces</td>
                                <td class="text-center">
                                    @if (u.IsActive)
                                    { <span class="badge bg-success-subtle text-success">Active</span> }
                                    else
                                    { <span class="badge bg-secondary-subtle text-secondary">Inactive</span> }
                                </td>
                                <td class="text-center pe-3">
                                    <a asp-action="Form" asp-controller="Uom"
                                       asp-route-id="@u.UOMId" asp-route-isView="true"
                                       class="btn btn-outline-info btn-sm py-0 px-2" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (isAdminUser)
                                    {
                                        <a asp-action="Form" asp-controller="Uom" asp-route-id="@u.UOMId"
                                           class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-controller="Uom" class="d-inline"
                                              onsubmit="return confirm('Delete UOM @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.UOMCode))? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.UOMId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-ruler-combined fa-3x mb-3 d-block opacity-25"></i>
                <p class="mb-2">No UOM records found.</p>
                @if (isAdminUser)
                {
                    <a asp-action="Form" asp-controller="Uom" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-1"></i>Add First UOM
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        var table = $('#tblUom').DataTable({
            paging: true,
            pageLength: 25,
            searching: true,
            ordering: true,
            order: [[2, 'asc'], [0, 'asc']],
            columnDefs: [{ orderable: false, targets: [8] }],
            language: { search: 'Search UOM:' }
        });

        $('#filterType').on('change', function () {
            table.column(2).search(this.value).draw();
        });
        $('#filterStatus').on('change', function () {
            table.column(7).search(this.value).draw();
        });
    });
</script>
}
