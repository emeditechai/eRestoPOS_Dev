@model RestaurantManagementSystem.Models.User
@using System.Text.Json
@{
    ViewData["Title"] = Model.Id == 0 ? "Create User" : ((ViewBag.IsView ?? false) ? "View User" : "Edit User");
    bool isView = ViewBag.IsView ?? false;
    bool canAssignMultipleBranches = (ViewBag.CanAssignMultipleBranches as bool?) ?? true;
    int? activeBranchId = ViewBag.ActiveBranchId as int?;
    string selectedBranchRolesJson = ViewBag.SelectedBranchRoles as string ?? "{}";
}

<div class="container-fluid py-3" style="background: #f0f2f5; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-xl-7 col-lg-9 col-md-10">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Header -->
                <div class="card-header text-white py-3 px-4 border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h4 class="mb-0 fw-bold">@ViewData["Title"]</h4>
                            <small class="opacity-75">@(Model.Id == 0 ? "Create a new user account" : "Update user information")</small>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4" style="background: #ffffff;">
                    @if (TempData["ResultMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["ResultMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Please correct the following errors:</strong>
                            <ul class="mb-0 mt-2 small">
                                @foreach (var entry in ViewData.ModelState)
                                {
                                    foreach (var error in entry.Value.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="SaveUser" method="post" id="userForm" autocomplete="off" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" id="branchRoleAssignmentsJson" name="branchRoleAssignmentsJson" value='@Html.Raw(selectedBranchRolesJson)' />

                        <!-- Account Information Section -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2 px-3">
                                <h6 class="mb-0 text-primary fw-semibold">
                                    <i class="bi bi-person-badge me-2"></i>Account Information
                                </h6>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="Username" class="form-label small fw-semibold mb-1">
                                            Username <span class="text-danger">*</span>
                                        </label>
                                        @if (isView)
                                        {
                                            <input asp-for="Username" class="form-control" disabled />
                                            <input type="hidden" name="Username" value="@Model.Username" />
                                        }
                                        else
                                        {
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                                <input asp-for="Username" class="form-control" placeholder="Enter username" required maxlength="50" />
                                            </div>
                                            <span asp-validation-for="Username" class="text-danger small"></span>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label small fw-semibold mb-1">
                                            Email
                                        </label>
                                        @if (isView)
                                        {
                                            <input asp-for="Email" class="form-control" type="email" disabled />
                                            <input type="hidden" name="Email" value="@Model.Email" />
                                        }
                                        else
                                        {
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                                <input asp-for="Email" class="form-control" type="email" placeholder="user@example.com" maxlength="100" />
                                            </div>
                                            <span asp-validation-for="Email" class="text-danger small"></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Personal Information Section -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2 px-3">
                                <h6 class="mb-0 text-primary fw-semibold">
                                    <i class="bi bi-person-lines-fill me-2"></i>Personal Information
                                </h6>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="FirstName" class="form-label small fw-semibold mb-1">
                                            First Name <span class="text-danger">*</span>
                                        </label>
                                        @if (isView)
                                        {
                                            <input asp-for="FirstName" class="form-control" disabled />
                                            <input type="hidden" name="FirstName" value="@Model.FirstName" />
                                        }
                                        else
                                        {
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="bi bi-card-text"></i></span>
                                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" required maxlength="50" />
                                            </div>
                                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="LastName" class="form-label small fw-semibold mb-1">
                                            Last Name
                                        </label>
                                        @if (isView)
                                        {
                                            <input asp-for="LastName" class="form-control" disabled />
                                            <input type="hidden" name="LastName" value="@Model.LastName" />
                                        }
                                        else
                                        {
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="bi bi-card-text"></i></span>
                                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" maxlength="50" />
                                            </div>
                                            <span asp-validation-for="LastName" class="text-danger small"></span>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="form-label small fw-semibold mb-1">
                                            Phone Number
                                        </label>
                                        @if (isView)
                                        {
                                            <input asp-for="Phone" class="form-control" disabled />
                                            <input type="hidden" name="Phone" value="@Model.Phone" />
                                        }
                                        else
                                        {
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                                <input asp-for="Phone" class="form-control" placeholder="Enter phone number" maxlength="20" />
                                            </div>
                                            <span asp-validation-for="Phone" class="text-danger small"></span>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="SelectedBranchIds" class="form-label small fw-semibold mb-1">
                                            Branch Access
                                        </label>
                                        @if (isView)
                                        {
                                            <select id="selectedBranches" class="form-select" multiple disabled style="height: 100px;">
                                                @foreach (var branch in ViewBag.AllBranches)
                                                {
                                                    <option value="@branch.BranchId" data-branch-label="@(string.IsNullOrWhiteSpace(branch.BranchCode) ? branch.BranchName : $"{branch.BranchCode} - {branch.BranchName}")" selected="@(Model.SelectedBranchIds?.Contains(branch.BranchId) ?? false)">@(string.IsNullOrWhiteSpace(branch.BranchCode) ? branch.BranchName : $"{branch.BranchCode} - {branch.BranchName}")</option>
                                                }
                                            </select>
                                            @if (Model.SelectedBranchIds != null)
                                            {
                                                foreach (var branchId in Model.SelectedBranchIds)
                                                {
                                                    <input type="hidden" name="selectedBranches" value="@branchId" />
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <div class="dropdown" data-bs-auto-close="outside">
                                                <button class="btn btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center" type="button" id="selectedBranchesDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span id="selectedBranchesSummary">Select branch access</span>
                                                    <i class="bi bi-chevron-down"></i>
                                                </button>
                                                <div class="dropdown-menu w-100 p-2 multi-select-dropdown-menu" id="selectedBranchesDropdownMenu">
                                                    @foreach (var branch in ViewBag.AllBranches)
                                                    {
                                                        var branchLabel = string.IsNullOrWhiteSpace(branch.BranchCode) ? branch.BranchName : $"{branch.BranchCode} - {branch.BranchName}";
                                                        var isChecked = Model.SelectedBranchIds?.Contains(branch.BranchId) ?? false;
                                                        var isNonMainCreateLocked = !canAssignMultipleBranches && Model.Id == 0;
                                                        var isAllowedForNonMainCreate = activeBranchId.HasValue && activeBranchId.Value == branch.BranchId;
                                                        <div class="form-check mb-1">
                                                            <input class="form-check-input branch-checkbox" type="checkbox" id="branch_@branch.BranchId" value="@branch.BranchId" data-branch-label="@branchLabel" checked="@isChecked" disabled="@(isNonMainCreateLocked && !isAllowedForNonMainCreate)">
                                                            <label class="form-check-label small" for="branch_@branch.BranchId">@branchLabel</label>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div id="selectedBranchesHiddenContainer"></div>
                                            <small class="text-muted">@(canAssignMultipleBranches ? "Select one or more branches from the dropdown" : "Non-main branch can create user only for active branch")</small>
                                        }
                                        <span asp-validation-for="SelectedBranchIds" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="SelectedRoleIds" class="form-label small fw-semibold mb-1">
                                            Branch-wise Roles
                                        </label>
                                        @if (isView)
                                        {
                                            <select id="branchRoleMulti" class="form-select" multiple style="height: 160px;" disabled>
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="dropdown" data-bs-auto-close="outside">
                                                <button class="btn btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center" type="button" id="branchRolesDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span id="branchRolesSummary">Select branch access first</span>
                                                    <i class="bi bi-chevron-down"></i>
                                                </button>
                                                <div class="dropdown-menu w-100 p-2 multi-select-dropdown-menu" id="branchRolesDropdownMenu"></div>
                                            </div>
                                        }
                                        <small class="text-muted">Select role(s) for each selected branch</small>
                                        @if (isView && Model.SelectedRoleIds != null)
                                        {
                                            foreach (var roleId in Model.SelectedRoleIds)
                                            {
                                                <input type="hidden" name="selectedRoles" value="@roleId" />
                                            }
                                        }
                                        <span asp-validation-for="SelectedRoleIds" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Security Section -->
                        @if (!isView)
                        {
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white border-bottom py-2 px-3">
                                    <h6 class="mb-0 text-primary fw-semibold">
                                        <i class="bi bi-shield-lock me-2"></i>Security
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label for="password" class="form-label small fw-semibold mb-1">
                                                Password @if (Model.Id == 0) { <span class="text-danger">*</span> }
                                            </label>
                                            @if (Model.Id == 0)
                                            {
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                                    <input asp-for="Password" id="password" name="password" class="form-control" type="password" placeholder="Enter password" maxlength="100" required />
                                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                                    </button>
                                                </div>
                                                <div class="mt-1">
                                                    <div class="progress" style="height: 4px;">
                                                        <div class="progress-bar" id="passwordStrength" role="progressbar" style="width: 0%"></div>
                                                    </div>
                                                    <small class="text-muted" id="passwordStrengthText">Min 8 characters</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                                    <input asp-for="Password" id="password" name="password" class="form-control" type="password" placeholder="Leave blank to keep current" maxlength="100" disabled />
                                                    <button type="button" class="btn btn-outline-primary" id="enablePasswordBtn">
                                                        <i class="bi bi-pencil"></i> Change
                                                    </button>
                                                </div>
                                                <small class="form-text text-muted">Leave blank to keep current password</small>
                                            }
                                            <span asp-validation-for="Password" class="text-danger small"></span>
                                            <div class="invalid-feedback" id="passwordFeedback"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold mb-1">
                                                Confirm Password @if (Model.Id == 0) { <span class="text-danger">*</span> }
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                                                @if (Model.Id == 0)
                                                {
                                                    <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control" type="password" placeholder="Re-enter password" maxlength="100" required />
                                                }
                                                else
                                                {
                                                    <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control" type="password" placeholder="Re-enter password" maxlength="100" />
                                                }
                                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                                    <i class="bi bi-eye" id="toggleConfirmPasswordIcon"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                            <div class="invalid-feedback" id="confirmPasswordFeedback"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Status Section -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2 px-3">
                                <h6 class="mb-0 text-primary fw-semibold">
                                    <i class="bi bi-toggles me-2"></i>Status
                                </h6>
                            </div>
                            <div class="card-body p-3">
                                <div class="form-check form-switch">
                                    @if (isView)
                                    {
                                        <input asp-for="IsActive" class="form-check-input" style="width: 2.5rem; height: 1.25rem; cursor: pointer;" disabled />
                                        <input type="hidden" name="IsActive" value="@(Model.IsActive ? "true" : "false")" />
                                    }
                                    else
                                    {
                                        <input asp-for="IsActive" class="form-check-input" style="width: 2.5rem; height: 1.25rem; cursor: pointer;" />
                                    }
                                    <label asp-for="IsActive" class="form-check-label ms-2 fw-semibold">
                                        Account Active
                                        <small class="text-muted d-block fw-normal">Enable or disable user access</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a asp-action="UserList" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </a>
                            @if (!isView)
                            {
                                <button type="submit" class="btn btn-primary rounded-pill px-5 shadow" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                                    <i class="bi bi-check-circle me-1"></i>Save User
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            border-color: #667eea;
        }
        
        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }
        
        .form-switch-lg .form-check-input {
            cursor: pointer;
        }
        
        .is-invalid {
            border-color: #dc3545 !important;
        }
        
        .is-valid {
            border-color: #28a745 !important;
        }

        .multi-select-dropdown-menu {
            max-height: 260px;
            overflow-y: auto;
        }

        .multi-select-dropdown-menu .form-check {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-left: 0;
        }

        .multi-select-dropdown-menu .form-check-input {
            float: none;
            margin: 0;
            position: static;
            flex-shrink: 0;
        }

        .multi-select-dropdown-menu .form-check-label {
            margin-bottom: 0;
            cursor: pointer;
        }

        .btn.is-invalid {
            border-color: #dc3545 !important;
        }
        
        .invalid-feedback {
            display: block;
        }
    </style>

    <script>
        $(document).ready(function() {
            const passwordInput = $('#password');
            const confirmPasswordInput = $('#confirmPassword');
            const form = $('#userForm');
            const isEditMode = @(Model.Id != 0 ? "true" : "false");
            const isViewMode = @(isView ? "true" : "false");
            const canAssignMultipleBranches = @(canAssignMultipleBranches ? "true" : "false");
            const activeBranchId = @((activeBranchId.HasValue ? activeBranchId.Value.ToString() : "null"));
            const allRoles = [
                @foreach (var role in ViewBag.AllRoles)
                {
                    @:{ id: @role.Id, name: @Html.Raw(JsonSerializer.Serialize(role.Name)) },
                }
            ];
            let selectedBranchRoles = @Html.Raw(selectedBranchRolesJson);

            function getSelectedBranchIds() {
                if (!isViewMode) {
                    return $('.branch-checkbox:checked').map(function() {
                        return parseInt($(this).val(), 10);
                    }).get().filter(v => !isNaN(v));
                }

                return ($('#selectedBranches').val() || []).map(v => parseInt(v, 10)).filter(v => !isNaN(v));
            }

            function getBranchLabel(branchId) {
                if (!isViewMode) {
                    const checkbox = $('.branch-checkbox[value="' + branchId + '"]');
                    return checkbox.data('branch-label') || ('Branch ' + branchId);
                }

                const option = $('#selectedBranches option[value="' + branchId + '"]');
                return option.data('branch-label') || option.text() || ('Branch ' + branchId);
            }

            function syncSelectedBranchesHidden() {
                if (isViewMode) {
                    return;
                }

                const container = $('#selectedBranchesHiddenContainer');
                container.empty();

                getSelectedBranchIds().forEach(function(branchId) {
                    container.append('<input type="hidden" name="selectedBranches" value="' + branchId + '">');
                });
            }

            function updateSelectedBranchesSummary() {
                if (isViewMode) {
                    return;
                }

                const selectedBranchIds = getSelectedBranchIds();
                const summary = $('#selectedBranchesSummary');

                if (selectedBranchIds.length === 0) {
                    summary.text('Select branch access');
                    return;
                }

                if (selectedBranchIds.length <= 2) {
                    summary.text(selectedBranchIds.map(getBranchLabel).join(', '));
                    return;
                }

                summary.text(selectedBranchIds.length + ' branches selected');
            }

            function ensureBranchRoleDefaults(selectedBranchIds) {
                selectedBranchIds.forEach(function(branchId) {
                    if (!selectedBranchRoles[branchId]) {
                        selectedBranchRoles[branchId] = [];
                    }
                });

                Object.keys(selectedBranchRoles).forEach(function(key) {
                    const id = parseInt(key, 10);
                    if (!selectedBranchIds.includes(id)) {
                        delete selectedBranchRoles[key];
                    }
                });
            }

            function renderBranchRoleAssignments() {
                const selectedBranchIds = getSelectedBranchIds();
                ensureBranchRoleDefaults(selectedBranchIds);

                if (isViewMode) {
                    const roleMulti = $('#branchRoleMulti');
                    roleMulti.empty();

                    if (selectedBranchIds.length === 0) {
                        roleMulti.append('<option value="" disabled>No branch assignments</option>');
                        roleMulti.prop('disabled', true);
                        return;
                    }

                    selectedBranchIds.forEach(function(branchId) {
                        const branchLabel = getBranchLabel(branchId);
                        const selectedRolesForBranch = (selectedBranchRoles[branchId] || []).map(x => parseInt(x, 10));
                        const optgroup = $('<optgroup></optgroup>').attr('label', branchLabel);

                        allRoles.forEach(function(role) {
                            if (selectedRolesForBranch.includes(parseInt(role.id, 10))) {
                                optgroup.append($('<option></option>').val(branchId + '|' + role.id).text(role.name).attr('selected', 'selected'));
                            }
                        });

                        roleMulti.append(optgroup);
                    });

                    roleMulti.prop('disabled', true);
                    return;
                }

                const roleMenu = $('#branchRolesDropdownMenu');
                const roleSummary = $('#branchRolesSummary');
                const roleButton = $('#branchRolesDropdownBtn');
                roleMenu.empty();

                if (selectedBranchIds.length === 0) {
                    roleMenu.append('<div class="dropdown-item-text text-muted small">Select one or more branches first</div>');
                    roleSummary.text('Select branch access first');
                    roleButton.addClass('disabled').attr('aria-disabled', 'true');
                    return;
                }

                roleButton.removeClass('disabled').removeAttr('aria-disabled');
                let totalSelectedRoles = 0;

                selectedBranchIds.forEach(function(branchId, index) {
                    const branchLabel = getBranchLabel(branchId);
                    const selectedRolesForBranch = (selectedBranchRoles[branchId] || []).map(x => parseInt(x, 10));
                    totalSelectedRoles += selectedRolesForBranch.length;

                    roleMenu.append('<div class="dropdown-header text-primary fw-semibold small px-2">' + branchLabel + '</div>');

                    allRoles.forEach(function(role) {
                        const roleId = parseInt(role.id, 10);
                        const checkboxId = 'role_' + branchId + '_' + roleId;
                        const checked = selectedRolesForBranch.includes(roleId) ? 'checked' : '';
                        const itemHtml =
                            '<div class="form-check mb-1 px-2">' +
                                '<input class="form-check-input role-checkbox" type="checkbox" id="' + checkboxId + '" data-branch-id="' + branchId + '" data-role-id="' + roleId + '" ' + checked + '>' +
                                '<label class="form-check-label small" for="' + checkboxId + '">' + role.name + '</label>' +
                            '</div>';
                        roleMenu.append(itemHtml);
                    });

                    if (index < selectedBranchIds.length - 1) {
                        roleMenu.append('<hr class="dropdown-divider my-1">');
                    }
                });

                if (totalSelectedRoles === 0) {
                    roleSummary.text('Select branch-wise roles');
                } else {
                    roleSummary.text(totalSelectedRoles + ' role assignments selected');
                }
            }

            function syncBranchRoleAssignmentsToHidden() {
                const selectedBranchIds = getSelectedBranchIds();
                const finalMap = {};

                let selectedRolePairs = [];
                if (isViewMode) {
                    selectedRolePairs = ($('#branchRoleMulti').val() || []).map(function(v) {
                        return String(v);
                    });
                } else {
                    selectedRolePairs = $('.role-checkbox:checked').map(function() {
                        const branchId = parseInt($(this).data('branch-id'), 10);
                        const roleId = parseInt($(this).data('role-id'), 10);
                        return branchId + '|' + roleId;
                    }).get();
                }

                selectedBranchIds.forEach(function(branchId) {
                    const rolesForBranch = selectedRolePairs
                        .filter(function(pair) { return pair.startsWith(branchId + '|'); })
                        .map(function(pair) { return parseInt(pair.split('|')[1], 10); })
                        .filter(function(roleId) { return !isNaN(roleId); });

                    finalMap[branchId] = rolesForBranch;
                });

                selectedBranchRoles = finalMap;
                $('#branchRoleAssignmentsJson').val(JSON.stringify(finalMap));
            }

            if (!isViewMode) {
                if (!canAssignMultipleBranches && !isEditMode && activeBranchId !== null) {
                    $('.branch-checkbox').each(function() {
                        const branchId = parseInt($(this).val(), 10);
                        const isActiveBranch = branchId === activeBranchId;
                        $(this).prop('checked', isActiveBranch);
                        $(this).prop('disabled', !isActiveBranch);
                    });
                    $('#selectedBranchesDropdownBtn').prop('disabled', true);
                }

                $('.branch-checkbox').on('change', function() {
                    updateSelectedBranchesSummary();
                    syncSelectedBranchesHidden();
                    renderBranchRoleAssignments();
                    syncBranchRoleAssignmentsToHidden();
                    $('#selectedBranchesDropdownBtn').removeClass('is-invalid');
                });

                $(document).on('change', '.role-checkbox', function() {
                    syncBranchRoleAssignmentsToHidden();
                    renderBranchRoleAssignments();
                    $('#branchRolesDropdownBtn').removeClass('is-invalid');
                });
            }

            $('#selectedBranches').on('change', function() {
                renderBranchRoleAssignments();
                syncBranchRoleAssignmentsToHidden();
            });

            $('#branchRoleMulti').on('change', function() {
                syncBranchRoleAssignmentsToHidden();
            });

            updateSelectedBranchesSummary();
            syncSelectedBranchesHidden();
            renderBranchRoleAssignments();
            syncBranchRoleAssignmentsToHidden();
            
            // Toggle password visibility
            $('#togglePassword').on('click', function() {
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                $('#togglePasswordIcon').toggleClass('bi-eye bi-eye-slash');
            });
            
            $('#toggleConfirmPassword').on('click', function() {
                const type = confirmPasswordInput.attr('type') === 'password' ? 'text' : 'password';
                confirmPasswordInput.attr('type', type);
                $('#toggleConfirmPasswordIcon').toggleClass('bi-eye bi-eye-slash');
            });
            
            // Enable password change for edit mode
            $('#enablePasswordBtn').on('click', function() {
                passwordInput.prop('disabled', false);
                passwordInput.focus();
                passwordInput.attr('required', 'required');
                confirmPasswordInput.attr('required', 'required');
                $(this).html('<i class="bi bi-lock"></i> Lock').removeClass('btn-outline-primary').addClass('btn-outline-danger');
                $(this).off('click').on('click', function() {
                    passwordInput.prop('disabled', true);
                    passwordInput.val('');
                    confirmPasswordInput.val('');
                    passwordInput.removeAttr('required');
                    confirmPasswordInput.removeAttr('required');
                    $(this).html('<i class="bi bi-pencil"></i> Change').removeClass('btn-outline-danger').addClass('btn-outline-primary');
                    passwordInput.removeClass('is-invalid is-valid');
                    confirmPasswordInput.removeClass('is-invalid is-valid');
                    $('#passwordFeedback').text('');
                    $('#confirmPasswordFeedback').text('');
                    $('#passwordStrength').css('width', '0%').removeClass('bg-danger bg-warning bg-info bg-success');
                    $('#passwordStrengthText').text('');
                });
            });
            
            // Password strength indicator
            function updatePasswordStrength(password) {
                if (!password) {
                    $('#passwordStrength').css('width', '0%').removeClass('bg-danger bg-warning bg-info bg-success');
                    $('#passwordStrengthText').text('Password must be at least 8 characters');
                    return;
                }
                
                let strength = 0;
                if (password.length >= 8) strength++;
                if (password.length >= 12) strength++;
                if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
                if (/\d/.test(password)) strength++;
                if (/[^a-zA-Z0-9]/.test(password)) strength++;
                
                const strengthBar = $('#passwordStrength');
                const strengthText = $('#passwordStrengthText');
                
                strengthBar.removeClass('bg-danger bg-warning bg-info bg-success');
                
                if (strength <= 1) {
                    strengthBar.css('width', '20%').addClass('bg-danger');
                    strengthText.text('Weak password').css('color', '#dc3545');
                } else if (strength === 2) {
                    strengthBar.css('width', '40%').addClass('bg-warning');
                    strengthText.text('Fair password').css('color', '#ffc107');
                } else if (strength === 3) {
                    strengthBar.css('width', '60%').addClass('bg-info');
                    strengthText.text('Good password').css('color', '#17a2b8');
                } else if (strength === 4) {
                    strengthBar.css('width', '80%').addClass('bg-success');
                    strengthText.text('Strong password').css('color', '#28a745');
                } else {
                    strengthBar.css('width', '100%').addClass('bg-success');
                    strengthText.text('Very strong password').css('color', '#28a745');
                }
            }
            
            // Real-time password validation
            passwordInput.on('input', function() {
                const password = $(this).val();
                const confirmPassword = confirmPasswordInput.val();
                
                updatePasswordStrength(password);
                
                // Validate password length
                if (password.length > 0 && password.length < 8) {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                    $('#passwordFeedback').text('Password must be at least 8 characters long');
                } else if (password.length >= 8) {
                    $(this).addClass('is-valid').removeClass('is-invalid');
                    $('#passwordFeedback').text('');
                } else {
                    $(this).removeClass('is-invalid is-valid');
                    $('#passwordFeedback').text('');
                }
                
                // Check confirm password match
                if (confirmPassword && password !== confirmPassword) {
                    confirmPasswordInput.addClass('is-invalid').removeClass('is-valid');
                    $('#confirmPasswordFeedback').text('Passwords do not match');
                } else if (confirmPassword && password === confirmPassword) {
                    confirmPasswordInput.addClass('is-valid').removeClass('is-invalid');
                    $('#confirmPasswordFeedback').text('');
                }
            });
            
            // Real-time confirm password validation
            confirmPasswordInput.on('input', function() {
                const password = passwordInput.val();
                const confirmPassword = $(this).val();
                
                if (confirmPassword === '') {
                    $(this).removeClass('is-invalid is-valid');
                    $('#confirmPasswordFeedback').text('');
                } else if (password !== confirmPassword) {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                    $('#confirmPasswordFeedback').text('Passwords do not match');
                } else {
                    $(this).addClass('is-valid').removeClass('is-invalid');
                    $('#confirmPasswordFeedback').text('');
                }
            });
            
            // Form submission validation
            form.on('submit', function(e) {
                let isValid = true;
                
                // Check required fields
                const username = $('#Username').val().trim();
                const firstName = $('#FirstName').val().trim();
                
                if (!username) {
                    $('#Username').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#Username').removeClass('is-invalid');
                }
                
                if (!firstName) {
                    $('#FirstName').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#FirstName').removeClass('is-invalid');
                }

                const selectedBranches = getSelectedBranchIds();
                if (selectedBranches.length === 0) {
                    if (isViewMode) {
                        $('#selectedBranches').addClass('is-invalid');
                    } else {
                        $('#selectedBranchesDropdownBtn').addClass('is-invalid');
                    }
                    isValid = false;
                } else {
                    if (isViewMode) {
                        $('#selectedBranches').removeClass('is-invalid');
                    } else {
                        $('#selectedBranchesDropdownBtn').removeClass('is-invalid');
                    }
                }

                syncBranchRoleAssignmentsToHidden();
                if (isViewMode) {
                    $('#branchRoleMulti').removeClass('is-invalid');
                } else {
                    $('#branchRolesDropdownBtn').removeClass('is-invalid');
                }
                selectedBranches.forEach(function(branchId) {
                    const roles = selectedBranchRoles[branchId] || [];
                    if (roles.length === 0) {
                        isValid = false;
                        if (isViewMode) {
                            $('#branchRoleMulti').addClass('is-invalid');
                        } else {
                            $('#branchRolesDropdownBtn').addClass('is-invalid');
                        }
                    }
                });
                
                // Password validation for new users or when changing password
                if (!passwordInput.prop('disabled')) {
                    const password = passwordInput.val();
                    const confirmPassword = confirmPasswordInput.val();
                    
                    if (!isEditMode || password) {
                        // For new users or editing password
                        if (!password || password.length < 8) {
                            passwordInput.addClass('is-invalid');
                            $('#passwordFeedback').text('Password is required and must be at least 8 characters');
                            isValid = false;
                        }
                        
                        if (!confirmPassword) {
                            confirmPasswordInput.addClass('is-invalid');
                            $('#confirmPasswordFeedback').text('Please confirm your password');
                            isValid = false;
                        } else if (password !== confirmPassword) {
                            confirmPasswordInput.addClass('is-invalid');
                            $('#confirmPasswordFeedback').text('Passwords do not match');
                            isValid = false;
                        }
                    }
                }
                
                if (!isValid) {
                    e.preventDefault();
                    
                    // Scroll to first error
                    $('html, body').animate({
                        scrollTop: $('.is-invalid').first().offset().top - 100
                    }, 500);
                    
                    // Show alert
                    if ($('.alert-danger').length === 0) {
                        const alertHtml = `
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Please correct the validation errors before submitting.</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `;
                        $(alertHtml).insertAfter('.card-header');
                    }
                    
                    return false;
                }
            });
            
            // Clear invalid state on input
            $('.form-control').on('input', function() {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid');
                }
            });

            $('#branchRoleMulti').on('change', function() {
                if (($(this).val() || []).length > 0) {
                    $(this).removeClass('is-invalid');
                }
            });

            $('#selectedBranchesDropdownBtn, #branchRolesDropdownBtn').on('click', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}
