@model RestaurantManagementSystem.Models.GRNHeader
@{
    ViewData["Title"] = "GRN Details";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 mx-0">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3 mx-0">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center">
            <a asp-action="Index" asp-controller="GRN" class="btn btn-link text-muted ps-0 me-2">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h4 class="mb-0 fw-bold"><i class="fas fa-truck-loading me-2 text-primary"></i>GRN Details</h4>
                <small class="text-muted">GRN# <strong>@Model.GRNNumber</strong></small>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == "Posted")
            {
                <span class="badge bg-success fs-6"><i class="fas fa-check-double me-1"></i>Posted to Stock</span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6"><i class="fas fa-clock me-1"></i>Draft</span>
                <a asp-action="Form" asp-controller="GRN" asp-route-id="@Model.GRNId"
                   class="btn btn-outline-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
                <form method="post" asp-action="Post" asp-controller="GRN" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.GRNId" />
                    <button type="button" class="btn btn-success btn-sm"
                            data-swal-confirm="This will post the GRN to the stock ledger and update inventory. This cannot be undone."
                            data-swal-title="Post to Stock?"
                            data-swal-icon="warning"
                            data-swal-ok="Yes, Post it"
                            data-swal-color="#198754">
                        <i class="fas fa-check-double me-1"></i>Post to Stock
                    </button>
                </form>
            }
            <a href="@Url.Action("PrintGRN", "GRN", new { id = Model.GRNId })" target="_blank"
               class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-print me-1"></i>Print
            </a>
        </div>
    </div>

    <div class="row g-3">
        <!-- GRN Info -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-info-circle me-1"></i>GRN Information</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 small">
                        <div class="col-md-2"><label class="text-muted d-block">GRN Number</label><span class="fw-semibold">@Model.GRNNumber</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">GRN Date</label><span class="fw-semibold">@Model.GRNDate.ToString("dd MMM yyyy")</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">PO Number</label><span class="fw-semibold text-primary">@Model.PONumber</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Supplier</label><span class="fw-semibold">@Model.SupplierName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Godown</label><span class="badge bg-info-subtle text-info">@Model.GodownName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Supplier Invoice</label><span class="fw-semibold">@(Model.InvoiceNo ?? "—")</span></div>
                        @if (Model.InvoiceDate.HasValue)
                        {
                            <div class="col-md-2"><label class="text-muted d-block">Invoice Date</label><span>@Model.InvoiceDate!.Value.ToString("dd MMM yyyy")</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Remarks))
                        {
                            <div class="col-12"><label class="text-muted d-block">Remarks</label><span>@Model.Remarks</span></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-list me-1"></i>Received Items</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">#</th>
                                    <th>Item</th>
                                    <th class="text-end">Ordered Qty</th>
                                    <th class="text-end">Received Qty</th>
                                    <th class="text-end">Rejected Qty</th>
                                    <th>UOM</th>
                                    <th class="text-end">Unit Rate</th>
                                    <th class="text-end">GST%</th>
                                    <th class="text-end">Taxable Amt</th>
                                    <th class="text-end pe-3">Net Amt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var sn = 1; }
                                @foreach (var line in Model.Lines ?? new List<RestaurantManagementSystem.Models.GRNLine>())
                                {
                                    var taxable = line.ReceivedQty * line.UnitRate;
                                    var gstAmt  = taxable * line.GSTPercent / 100;
                                    <tr>
                                        <td class="ps-3 text-muted small">@sn</td>
                                        <td class="fw-semibold">@line.ItemName</td>
                                        <td class="text-end text-muted">@line.OrderedQty.ToString("N3")</td>
                                        <td class="text-end text-success fw-semibold">@line.ReceivedQty.ToString("N3")</td>
                                        <td class="text-end @(line.RejectedQty > 0 ? "text-danger" : "text-muted")">@line.RejectedQty.ToString("N3")</td>
                                        <td class="text-muted small">@line.UOMCode</td>
                                        <td class="text-end">₹@line.UnitRate.ToString("N2")</td>
                                        <td class="text-end text-muted small">@line.GSTPercent.ToString("N1")%</td>
                                        <td class="text-end">₹@taxable.ToString("N2")</td>
                                        <td class="text-end pe-3 fw-semibold">₹@((taxable + gstAmt).ToString("N2"))</td>
                                    </tr>
                                    sn++;
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td colspan="8" class="text-end ps-3">Total Received Value:</td>
                                    <td class="text-end">₹@((Model.Lines?.Sum(l => l.ReceivedQty * l.UnitRate) ?? 0).ToString("N2"))</td>
                                    <td class="text-end pe-3 text-primary">₹@Model.TotalAmount.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
