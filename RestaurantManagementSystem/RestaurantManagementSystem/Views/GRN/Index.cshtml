@model IEnumerable<RestaurantManagementSystem.Models.GRNHeader>
@{
    ViewData["Title"] = "Goods Receipt Notes";
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-truck-loading me-2 text-primary"></i>Goods Receipt Notes</h4>
            <small class="text-muted">Record goods received against purchase orders</small>
        </div>
        <a asp-action="Form" asp-controller="GRN" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New GRN
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-2 d-flex align-items-center">
            <span class="fw-semibold text-muted me-auto">
                <i class="fas fa-list me-1"></i>GRN List
                <span class="badge bg-primary ms-1">@Model.Count()</span>
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblGRN" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">GRN Number</th>
                            <th>GRN Date</th>
                            <th>PO Number</th>
                            <th>Supplier</th>
                            <th>Godown</th>
                            <th>Invoice No.</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-primary">@g.GRNNumber</td>
                                <td class="text-muted small">@g.GRNDate.ToString("dd MMM yyyy")</td>
                                <td class="text-muted small">@g.PONumber</td>
                                <td>@g.SupplierName</td>
                                <td><span class="badge bg-info-subtle text-info">@g.GodownName</span></td>
                                <td class="text-muted small">@g.InvoiceNo</td>
                                <td class="text-end fw-semibold">₹@g.TotalAmount.ToString("N2")</td>
                                <td class="text-center">
                                    @if (g.Status == "Posted")
                                    { <span class="badge bg-success"><i class="fas fa-check-double me-1"></i>Posted</span> }
                                    else
                                    { <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Draft</span> }
                                </td>
                                <td class="text-center pe-3">
                                    <a asp-action="Details" asp-controller="GRN" asp-route-id="@g.GRNId"
                                       class="btn btn-outline-info btn-sm py-0 px-2" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (g.Status != "Posted")
                                    {
                                        <a asp-action="Form" asp-controller="GRN" asp-route-id="@g.GRNId"
                                           class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" asp-action="Post" asp-controller="GRN" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@g.GRNId" />
                                            <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" title="Post to Stock"
                                                    data-swal-confirm="This will post the GRN to the stock ledger. This action cannot be undone."
                                                    data-swal-title="Post to Stock?"
                                                    data-swal-icon="warning"
                                                    data-swal-ok="Yes, Post it"
                                                    data-swal-color="#198754">
                                                <i class="fas fa-check-double"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-truck-loading fa-3x mb-3 d-block opacity-25"></i>
                <p>No GRNs found.</p>
                <a asp-action="Form" asp-controller="GRN" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Create First GRN
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#tblGRN').DataTable({ paging: true, pageLength: 25, searching: true, ordering: true,
            order: [[0,'desc']], columnDefs: [{ orderable: false, targets: [8] }] });
    });
</script>
}
