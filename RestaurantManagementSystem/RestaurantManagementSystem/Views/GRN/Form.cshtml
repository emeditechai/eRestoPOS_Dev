@model RestaurantManagementSystem.Models.GRNHeader
@{
    ViewData["Title"] = Model.GRNId == 0 ? "New GRN" : "Edit GRN";
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" asp-controller="GRN" class="btn btn-link text-muted ps-0 me-2">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-truck-loading me-2 text-primary"></i>@ViewData["Title"]</h4>
            <small class="text-muted">GRN# <strong>@(string.IsNullOrEmpty(Model.GRNNumber) ? "[Auto-generated]" : Model.GRNNumber)</strong></small>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <i class="fas fa-exclamation-circle me-2"></i>
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <div>@e.ErrorMessage</div> }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" asp-action="Form" asp-controller="GRN" id="grnForm" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="GRNId" />
        <input type="hidden" asp-for="GRNNumber" />
        <input type="hidden" id="linesJson" name="linesJson" />

        <!-- Header -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-2">
                <span class="fw-semibold text-muted"><i class="fas fa-file-alt me-1"></i>GRN Header</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="GRNDate" class="form-label small fw-semibold">GRN Date <span class="text-danger">*</span></label>
                        <input asp-for="GRNDate" type="date" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Purchase Order <span class="text-danger">*</span>
                            <span id="poBadgeLocked" class="badge bg-secondary ms-1" style="display:none"><i class="fas fa-lock me-1"></i>Locked</span>
                        </label>
                        <select id="selPO" name="POId" class="form-select form-select-sm" required>
                            <option value="">-- Select PO --</option>
                        </select>
                        <input type="hidden" id="hidPOId" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Godown</label>
                        <input type="text" id="godownDisplay" class="form-control form-control-sm bg-light" readonly placeholder="Auto from PO" />
                        <input type="hidden" asp-for="GodownId" id="hidGodownId" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Supplier</label>
                        <input type="text" id="supplierDisplay" class="form-control form-control-sm bg-light" readonly placeholder="Auto from PO" />
                        <input type="hidden" asp-for="SupplierId" id="hidSupplierId" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="InvoiceNo" class="form-label small fw-semibold">Supplier Invoice No.</label>
                        <input asp-for="InvoiceNo" type="text" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="InvoiceDate" class="form-label small fw-semibold">Supplier Invoice Date</label>
                        <input asp-for="InvoiceDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Remarks" class="form-label small fw-semibold">Remarks</label>
                        <input asp-for="Remarks" type="text" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-2 d-flex align-items-center">
                <span class="fw-semibold text-muted me-auto"><i class="fas fa-list me-1"></i>Received Items</span>
                <span class="badge bg-info text-white" id="lineCount">0 items</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle" id="lineTable">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-3">Item</th>
                                <th class="text-end">Ordered Qty</th>
                                <th class="text-end">Pending Qty</th>
                                <th class="text-end">Received Qty</th>
                                <th class="text-end">Rejected Qty</th>
                                <th>UOM</th>
                                <th class="text-end">Unit Rate (₹)</th>
                                <th class="text-end">GST%</th>
                                <th class="text-end">Net Amt</th>
                            </tr>
                        </thead>
                        <tbody id="lineBody">
                        </tbody>
                        <tfoot class="table-light fw-semibold" id="lineFoot" style="display:none">
                            <tr>
                                <td colspan="8" class="text-end ps-3">Total Amount:</td>
                                <td class="text-end pe-3" id="totAmt">₹0.00</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div id="emptyLines" class="text-center text-muted py-4">
                    <i class="fas fa-truck fa-2x mb-2 d-block opacity-25"></i>
                    <p>Select a Purchase Order above to load line items.</p>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" id="btnSave">
                <i class="fas fa-save me-1"></i>Save GRN
            </button>
            <a asp-action="Index" asp-controller="GRN" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    // ── Inline data from server — ZERO AJAX calls on initial page load ─────────
    var existingLines  = @Html.Raw(ViewBag.ExistingLinesJson  ?? "[]");
    var preloadedLines = @Html.Raw(ViewBag.PreloadedLinesJson ?? "[]");
    var poList         = @Html.Raw(ViewBag.POListJson         ?? "[]");

    $(document).ready(function () {

        // ── 1. Build PO dropdown synchronously from inline data ───────────────
        var preselect = @(Model.POId);
        poList.forEach(function (p) {
            var sel = (p.id == preselect) ? ' selected' : '';
            $('#selPO').append(
                '<option value="' + p.id + '"'
                + ' data-godown="'     + escAttr(p.godownName)   + '"'
                + ' data-godownid="'   + p.godownId              + '"'
                + ' data-supplier="'   + escAttr(p.supplierName) + '"'
                + ' data-supplierid="' + p.supplierId            + '"'
                + sel + '>'
                + escHtml(p.poNumber) + ' – ' + escHtml(p.supplierName)
                + '</option>'
            );
        });

        // ── 2. Render lines immediately from inline data (no round-trip) ──────
        if (existingLines.length > 0) {
            // Edit GRN — fill header fields and render saved lines
            setHeaderFields($('#selPO option:selected'));
            renderGrnLines(existingLines, true);
            lockPOSelection();   // PO cannot change on an existing GRN

        } else if (preloadedLines.length > 0) {
            // New GRN pre-loaded from a PO — header fields already in model
            setHeaderFields($('#selPO option:selected'));
            renderGrnLines(preloadedLines, false);
            lockPOSelection();
        }

        // ── 3. On manual PO change → show skeleton then fetch via AJAX ────────
        $('#selPO').on('change', function () {
            var opt = $(this).find('option:selected');
            setHeaderFields(opt);
            var selPoId = $(this).val();
            if (!selPoId) { clearLines(); return; }
            showLinesSkeleton();
            $.get('/GRN/GetPODetails?poId=' + selPoId, function (lines) {
                renderGrnLines(lines, false);
            }).fail(function () { clearLines(); });
        });

        // ── 4. Recalc on input ────────────────────────────────────────────────
        $(document).on('input', '.line-received, .line-rejected, .line-rate, .line-gst', function () {
            recalcGrnRow($(this).closest('tr'));
        });

        // ── 5. Submit — build JSON payload ────────────────────────────────────
        $('#grnForm').on('submit', function () {
            var lines = [];
            $('#lineBody .grn-line').each(function () {
                var r = $(this);
                lines.push({
                    poDetailId  : parseInt(r.data('pod-id'))        || 0,
                    itemId      : parseInt(r.data('item-id'))       || 0,
                    uomId       : parseInt(r.data('uom-id'))        || 0,
                    orderedQty  : parseFloat(r.data('ordered-qty')) || 0,
                    receivedQty : parseFloat(r.find('.line-received').val()) || 0,
                    rejectedQty : parseFloat(r.find('.line-rejected').val()) || 0,
                    unitRate    : parseFloat(r.find('.line-rate').val())     || 0,
                    gstPercent  : parseFloat(r.find('.line-gst').val())      || 0
                });
            });
            if (lines.length === 0) {
                Swal.fire({ icon: 'warning', title: 'No Items', text: 'Please select a Purchase Order to load items first.', confirmButtonColor: '#0d6efd' });
                return false;
            }
            if (lines.every(function (l) { return l.receivedQty <= 0; })) {
                Swal.fire({ icon: 'warning', title: 'Received Qty Required', text: 'Enter a received quantity for at least one item.', confirmButtonColor: '#0d6efd' });
                return false;
            }
            $('#linesJson').val(JSON.stringify(lines));
        });
    });

    // ── Helpers ───────────────────────────────────────────────────────────────

    function setHeaderFields(opt) {
        $('#godownDisplay').val(opt.data('godown')     || '');
        $('#hidGodownId').val(opt.data('godownid')     || '');
        $('#supplierDisplay').val(opt.data('supplier') || '');
        $('#hidSupplierId').val(opt.data('supplierid') || '');
    }

    function lockPOSelection() {
        var sel = $('#selPO');
        var val = sel.val();
        // Disable the visible select so user cannot change it
        sel.prop('disabled', true).addClass('bg-light');
        // Copy the value to a hidden input so it still submits with the form
        $('#hidPOId').attr('name', 'POId').val(val);
        sel.removeAttr('name');   // prevent duplicate POId in POST body
        // Show locked badge next to label
        $('#poBadgeLocked').show();
    }

    function showLinesSkeleton() {
        $('#lineBody').empty();
        for (var i = 0; i < 3; i++) {
            $('#lineBody').append(
                '<tr class="placeholder-glow">'
                + '<td class="ps-3"><span class="placeholder col-8 rounded"></span></td>'
                + '<td><span class="placeholder col-6 rounded"></span></td>'
                + '<td><span class="placeholder col-6 rounded"></span></td>'
                + '<td><span class="placeholder col-10 rounded"></span></td>'
                + '<td><span class="placeholder col-8 rounded"></span></td>'
                + '<td><span class="placeholder col-4 rounded"></span></td>'
                + '<td><span class="placeholder col-8 rounded"></span></td>'
                + '<td><span class="placeholder col-5 rounded"></span></td>'
                + '<td><span class="placeholder col-7 rounded"></span></td>'
                + '</tr>'
            );
        }
        toggleEmpty(false);
        $('#lineCount').html('<span class="spinner-border spinner-border-sm me-1"></span>Loading…');
    }

    function renderGrnLines(lines, isEdit) {
        $('#lineBody').empty();
        if (!lines || lines.length === 0) { clearLines(); return; }
        lines.forEach(function (l) {
            var receivedVal = isEdit ? (l.receivedQty || 0) : (l.acceptedQty != null ? l.acceptedQty : (l.pendingQty || 0));
            var rejectedVal = isEdit ? (l.rejectedQty || 0) : 0;
            var pendingDisp = (l.acceptedQty != null ? l.acceptedQty : (l.pendingQty || 0));
            var row = $('<tr class="grn-line">')
                .attr('data-pod-id',      l.poDetailId  || l.grnDetailId || 0)
                .attr('data-item-id',     l.itemId)
                .attr('data-uom-id',      l.uomId)
                .attr('data-ordered-qty', l.orderedQty  || 0)
                .html(
                    '<td class="ps-3 fw-semibold">' + escHtml(l.itemName) + '</td>'
                    + '<td class="text-end text-muted">'  + (+l.orderedQty  || 0).toFixed(3) + '</td>'
                    + '<td class="text-end text-info">'   + (+pendingDisp   || 0).toFixed(3) + '</td>'
                    + '<td class="text-end"><input type="number" class="form-control form-control-sm text-end line-received" min="0" step="0.001" value="' + (+receivedVal).toFixed(3) + '" style="width:90px"></td>'
                    + '<td class="text-end"><input type="number" class="form-control form-control-sm text-end line-rejected" min="0" step="0.001" value="' + (+rejectedVal).toFixed(3) + '" style="width:80px"></td>'
                    + '<td class="text-muted small">' + escHtml(l.uomCode || '') + '</td>'
                    + '<td class="text-end"><input type="number" class="form-control form-control-sm text-end line-rate" min="0" step="0.01" value="' + (+l.unitRate   || 0).toFixed(4) + '" style="width:90px"></td>'
                    + '<td class="text-end"><input type="number" class="form-control form-control-sm text-end line-gst"  min="0" max="100" step="0.01" value="' + (+l.gstPercent || l.gstPct || 0).toFixed(2) + '" style="width:70px"></td>'
                    + '<td class="text-end pe-3 fw-semibold line-net">₹0.00</td>'
                );
            $('#lineBody').append(row);
            recalcGrnRow(row);
        });
        toggleEmpty(false);
        $('#lineCount').text(lines.length + ' item' + (lines.length !== 1 ? 's' : ''));
    }

    function recalcGrnRow(row) {
        var qty     = parseFloat(row.find('.line-received').val()) || 0;
        var rate    = parseFloat(row.find('.line-rate').val())     || 0;
        var gst     = parseFloat(row.find('.line-gst').val())      || 0;
        var taxable = qty * rate;
        row.find('.line-net').text('₹' + (taxable + taxable * gst / 100).toFixed(2));
        recalcTotals();
    }

    function recalcTotals() {
        var tot = 0;
        $('#lineBody .grn-line').each(function () {
            var qty  = parseFloat($(this).find('.line-received').val()) || 0;
            var rate = parseFloat($(this).find('.line-rate').val())     || 0;
            var gst  = parseFloat($(this).find('.line-gst').val())      || 0;
            var t    = qty * rate;
            tot += t + t * gst / 100;
        });
        $('#totAmt').text('₹' + tot.toFixed(2));
    }

    function clearLines() {
        $('#lineBody').empty();
        toggleEmpty(true);
        $('#lineCount').text('0 items');
    }

    function toggleEmpty(show) {
        $('#emptyLines').toggle(show);
        $('#lineFoot').toggle(!show);
    }

    function escAttr(s) { return (s || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
    function escHtml(s)  { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
</script>
}
