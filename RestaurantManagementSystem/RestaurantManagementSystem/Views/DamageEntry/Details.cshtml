@model RestaurantManagementSystem.Models.DamageEntryHeader
@{
    ViewData["Title"] = "Damage Entry Details";
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center">
            <a asp-action="Index" asp-controller="DamageEntry" class="btn btn-link text-muted ps-0 me-2">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h4 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2 text-danger"></i>Damage Entry Details</h4>
                <small class="text-muted">Entry# <strong>@Model.DamageNumber</strong></small>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == "Posted")
            {
                <span class="badge bg-success fs-6"><i class="fas fa-check-double me-1"></i>Posted to Stock</span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6"><i class="fas fa-clock me-1"></i>Draft</span>
                <a asp-action="Form" asp-controller="DamageEntry" asp-route-id="@Model.DamageId"
                   class="btn btn-outline-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
                <form method="post" asp-action="Post" asp-controller="DamageEntry" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.DamageId" />
                    <button type="button" class="btn btn-danger btn-sm" id="btnPostDamage">
                        <i class="fas fa-check-double me-1"></i>Post to Stock
                    </button>
                </form>
            }
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-1"></i>Print</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-info-circle me-1"></i>Entry Information</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 small">
                        <div class="col-md-2"><label class="text-muted d-block">Entry No.</label><span class="fw-semibold text-danger">@Model.DamageNumber</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Date</label><span class="fw-semibold">@Model.DamageDate.ToString("dd MMM yyyy")</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Godown</label><span class="badge bg-info-subtle text-info">@Model.GodownName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Total Damage Value</label><span class="fw-bold fs-6 text-danger">₹@Model.TotalValue.ToString("N2")</span></div>
                        @if (!string.IsNullOrEmpty(Model.Remarks))
                        { <div class="col-12"><label class="text-muted d-block">Remarks</label><span>@Model.Remarks</span></div> }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-list me-1"></i>Damaged Items</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">#</th>
                                    <th>Item</th>
                                    <th class="text-end">Qty</th>
                                    <th>UOM</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end">Damage Value</th>
                                    <th class="pe-3">Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var sn = 1; }
                                @foreach (var line in Model.Lines ?? new List<RestaurantManagementSystem.Models.DamageEntryLine>())
                                {
                                    <tr>
                                        <td class="ps-3 text-muted small">@sn</td>
                                        <td class="fw-semibold">@line.ItemName</td>
                                        <td class="text-end text-danger fw-semibold">@line.Quantity.ToString("N3")</td>
                                        <td class="text-muted small">@line.UOMCode</td>
                                        <td class="text-end">₹@line.UnitCost.ToString("N2")</td>
                                        <td class="text-end fw-semibold text-danger">₹@((line.Quantity * line.UnitCost).ToString("N2"))</td>
                                        <td class="pe-3 text-muted small">@line.Reason</td>
                                    </tr>
                                    sn++;
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td colspan="5" class="text-end ps-3">Total Damage Value:</td>
                                    <td class="text-end text-danger">₹@Model.TotalValue.ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('btnPostDamage')?.addEventListener('click', function () {
        Swal.fire({
            title: 'Post to Stock?',
            html:  '<p class="mb-0">This damage entry will be posted to the stock ledger.<br><small class="text-muted">This action cannot be undone.</small></p>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-check-double me-1"></i> Yes, Post It',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            reverseButtons: true
        }).then(function (result) {
            if (result.isConfirmed) document.querySelector('form[action*="Post"]').submit();
        });
    });
</script>
}