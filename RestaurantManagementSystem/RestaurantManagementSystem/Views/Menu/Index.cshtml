@model IEnumerable<RestaurantManagementSystem.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Items";
    var canCopyMenuItems = ViewBag.CanCopyMenuItems is bool allowed && allowed;
    var showCopyDebug = (Context?.Request?.Query["debugCopy"].ToString() ?? "") == "1";
    var copyFeatureDebug = ViewBag.CopyFeatureDebug as string ?? "Debug data unavailable.";
    // true = allow Add/Edit/Delete; false = read-only (non-main branch + restriction enabled)
    var menuEditAllowed = !(ViewBag.MenuEditAllowed is bool mea) || mea;
}

<div class="container-fluid px-0 px-md-2">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 px-3">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="me-auto">
                            <h5 class="mb-0 fw-bold"><i class="fas fa-utensils me-2 text-primary"></i>Menu Items</h5>
                        </div>
                        @if (canCopyMenuItems)
                        {
                            <button type="button" id="openCopyMenuModal" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-copy"></i> <span class="d-none d-sm-inline">Copy to Branch</span>
                            </button>
                        }
                        @if (menuEditAllowed)
                        {
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fa fa-plus"></i> <span class="d-none d-sm-inline">Create New</span><span class="d-inline d-sm-none">New</span>
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" disabled title="Menu creation is restricted to the main branch.">
                                <i class="fa fa-plus"></i> <span class="d-none d-sm-inline">Create New</span><span class="d-inline d-sm-none">New</span>
                            </button>
                        }
                        <a asp-action="ExportCsv" class="btn btn-outline-secondary btn-sm" title="Export CSV">
                            <i class="fas fa-file-csv"></i>
                        </a>
                        <a asp-action="Print" target="_blank" class="btn btn-outline-secondary btn-sm" title="Print / PDF">
                            <i class="fas fa-print"></i>
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (!menuEditAllowed)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-3" role="alert">
                            <i class="fas fa-lock me-1"></i>
                            <strong>Read-only:</strong> Menu item add, edit and delete are restricted to the <strong>main branch</strong> by the administrator. Switch to the main branch to make changes.
                        </div>
                    }

                    @if (showCopyDebug)
                    {
                        <div class="alert alert-secondary py-2 small">
                            <strong>Copy visibility debug:</strong> @copyFeatureDebug
                        </div>
                    }

                    <div class="table-responsive">
                    <table id="menuItemsTable" class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                @if (canCopyMenuItems)
                                {
                                    <th style="width:40px; text-align:center;">
                                        <input type="checkbox" id="selectAllMenuItems" title="Select all" />
                                    </th>
                                }
                                <th>PLU Code</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Item Group</th>
                                <th>Sub Category</th>
                                <th>Price</th>
                                <th>Prep Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @if (canCopyMenuItems)
                                    {
                                        <td class="text-center">
                                            <input type="checkbox" class="menu-copy-item" value="@item.Id" />
                                        </td>
                                    }
                                    <td>@item.PLUCode</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath" alt="@item.Name" style="max-width:50px; max-height:50px;" />
                                        }
                                        else
                                        {
                                            <i class="fa fa-image text-muted"></i>
                                        }
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Category?.Name</td>
                                    <td>@(item.MenuItemGroup?.ItemGroup ?? "-")</td>
                                    <td>@(item.SubCategory?.Name ?? "-")</td>
                                    <td>
                                        <div class="small">
                                            <strong class="text-dark">Base:</strong> <strong class="text-success"><text>₹</text>@item.Price.ToString("N2")</strong>
                                            @if (item.TakeoutPrice.HasValue)
                                            {
                                                <br/><strong class="text-primary">Takeout:</strong> <strong class="text-info"><text>₹</text>@item.TakeoutPrice.Value.ToString("N2")</strong>
                                            }
                                            @if (item.DeliveryPrice.HasValue)
                                            {
                                                <br/><strong class="text-warning">Delivery:</strong> <strong class="text-danger"><text>₹</text>@item.DeliveryPrice.Value.ToString("N2")</strong>
                                            }
                                            @if (item.RoomServicePrice.HasValue)
                                            {
                                                <br/><strong class="text-secondary">Room Service:</strong> <strong class="text-dark"><text>₹</text>@item.RoomServicePrice.Value.ToString("N2")</strong>
                                            }
                                        </div>
                                    </td>
                                    <td>@item.PreparationTimeMinutes min</td>
                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge badge-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Unavailable</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                                <i class="fa fa-info-circle"></i>
                                            </a>
                                            @if (menuEditAllowed)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-primary" disabled title="Restricted to main branch only."><i class="fa fa-edit"></i></button>
                                            }
                                            <a asp-controller="Recipe" asp-action="Create" asp-route-menuItemId="@item.Id" class="btn btn-sm btn-secondary recipe-link" data-menu-id="@item.Id">
                                                <i class="fa fa-book"></i> Recipe
                                            </a>
                                            @if (menuEditAllowed)
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-danger" disabled title="Restricted to main branch only."><i class="fa fa-trash"></i></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div><!-- /table-responsive -->
                </div>
            </div>
        </div>
    </div>
</div>

@if (canCopyMenuItems)
{
    <div class="modal fade" id="copyMenuItemsModal" tabindex="-1" aria-labelledby="copyMenuItemsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="copyMenuItemsModalLabel">Copy Menu Items to Branch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2">
                        Source branch is your currently logged-in active branch.
                    </div>
                    <div class="mb-3">
                        <label for="targetBranchSelect" class="form-label">Target Branch</label>
                        <select id="targetBranchSelect" class="form-select">
                            <option value="">-- Select target branch --</option>
                        </select>
                    </div>
                    <div class="small text-muted">
                        Selected items: <span id="copySelectedCount">0</span>
                    </div>
                    <div id="copyMenuError" class="alert alert-danger mt-3 d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmCopyMenuItems">
                        <span class="copy-text">Copy</span>
                        <span class="spinner-border spinner-border-sm ms-2 d-none copy-spinner" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.dataTables.min.css" />
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.min.js"></script>
    <style>
    /* ── Menu Items Table Mobile Fixes ── */
    .menu-actions-wrap { display:flex; gap:4px; flex-wrap:wrap; }
    @@media (max-width:575px) {
        #menuItemsTable thead th, #menuItemsTable tbody td { font-size:12px; padding:6px 4px; }
        .menu-actions-wrap .btn { padding:3px 6px; font-size:11px; }
    }
    </style>
    <script>
        $(document).ready(function() {
            const canCopyMenuItems = @(canCopyMenuItems ? "true" : "false");

            // Responsive column priorities (lower = shown first on narrow screens)
            const baseColumnDefs = [
                { responsivePriority: 1,  targets: canCopyMenuItems ? 3 : 2  }, // Name
                { responsivePriority: 2,  targets: canCopyMenuItems ? 10 : 9 }, // Actions
                { responsivePriority: 3,  targets: canCopyMenuItems ? 7 : 6  }, // Price
                { responsivePriority: 4,  targets: canCopyMenuItems ? 9 : 8  }, // Status
                { responsivePriority: 5,  targets: canCopyMenuItems ? 4 : 3  }, // Category
                { responsivePriority: 6,  targets: canCopyMenuItems ? 1 : 0  }, // PLU Code
                { responsivePriority: 7,  targets: canCopyMenuItems ? 5 : 4  }, // Item Group
                { responsivePriority: 8,  targets: canCopyMenuItems ? 6 : 5  }, // Sub Category
                { responsivePriority: 9,  targets: canCopyMenuItems ? 8 : 7  }, // Prep Time
                { responsivePriority: 10, targets: canCopyMenuItems ? 2 : 1, orderable: false }, // Image
            ];
            if (canCopyMenuItems) {
                baseColumnDefs.push({ responsivePriority: 11, targets: 0, orderable: false }); // Select
            }

            const table = $('#menuItemsTable').DataTable({
                "responsive": { details: { type: 'column', target: 'tr' } },
                "lengthChange": true,
                "autoWidth": false,
                "pageLength": 25,
                "columnDefs": baseColumnDefs
            });

            if (canCopyMenuItems) {
                const body = document.body;
                const activeBranchId = parseInt((body.dataset && body.dataset.activeBranchId) || '0', 10);
                const copyModalElement = document.getElementById('copyMenuItemsModal');
                const copyModal = copyModalElement ? new bootstrap.Modal(copyModalElement) : null;

                function getSelectedMenuItemIds() {
                    const ids = [];
                    table.$('.menu-copy-item:checked').each(function () {
                        const id = parseInt($(this).val(), 10);
                        if (!isNaN(id)) {
                            ids.push(id);
                        }
                    });

                    return [...new Set(ids)];
                }

                function updateSelectedCount() {
                    const selectedCount = getSelectedMenuItemIds().length;
                    $('#copySelectedCount').text(selectedCount);

                    const all = table.$('.menu-copy-item').length;
                    const checked = table.$('.menu-copy-item:checked').length;
                    $('#selectAllMenuItems').prop('checked', all > 0 && checked === all);
                }

                function setCopyBusy(isBusy) {
                    $('#confirmCopyMenuItems').prop('disabled', isBusy);
                    $('#confirmCopyMenuItems .copy-text').toggleClass('d-none', isBusy);
                    $('#confirmCopyMenuItems .copy-spinner').toggleClass('d-none', !isBusy);
                }

                function showCopyError(message) {
                    $('#copyMenuError').removeClass('d-none').text(message || 'Unable to copy selected menu items.');
                }

                function hideCopyError() {
                    $('#copyMenuError').addClass('d-none').text('');
                }

                async function loadTargetBranches() {
                    const response = await fetch('/Menu/CopyTargetBranches', {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });

                    if (!response.ok) {
                        throw new Error('Unable to load branch list.');
                    }

                    const branches = await response.json();
                    const targetSelect = $('#targetBranchSelect');
                    targetSelect.empty();
                    targetSelect.append('<option value="">-- Select target branch --</option>');

                    (Array.isArray(branches) ? branches : []).forEach(function (branch) {
                        const branchId = branch.branchId || branch.BranchId;
                        const branchCode = branch.branchCode || branch.BranchCode || '';
                        const branchName = branch.branchName || branch.BranchName || '';

                        if (!branchId || branchId === activeBranchId) {
                            return;
                        }

                        const label = branchCode ? (branchCode + ' - ' + branchName) : branchName;
                        targetSelect.append(`<option value="${branchId}">${label}</option>`);
                    });
                }

                $('#selectAllMenuItems').on('change', function () {
                    const checked = $(this).is(':checked');
                    table.$('.menu-copy-item').prop('checked', checked);
                    updateSelectedCount();
                });

                $('#menuItemsTable').on('change', '.menu-copy-item', function () {
                    updateSelectedCount();
                });

                table.on('draw', function () {
                    updateSelectedCount();
                });

                $('#openCopyMenuModal').on('click', async function () {
                    hideCopyError();
                    updateSelectedCount();

                    const selectedIds = getSelectedMenuItemIds();
                    if (selectedIds.length === 0) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'No Items Selected',
                            text: 'Select at least one menu item using the checkboxes before copying.'
                        });
                        return;
                    }

                    try {
                        await loadTargetBranches();
                        if (copyModal) {
                            copyModal.show();
                        }
                    } catch (error) {
                        showCopyError(error && error.message ? error.message : 'Unable to open copy dialog.');
                    }
                });

                $('#confirmCopyMenuItems').on('click', async function () {
                    hideCopyError();

                    const selectedIds = getSelectedMenuItemIds();
                    if (selectedIds.length === 0) {
                        showCopyError('Please select at least one menu item.');
                        return;
                    }

                    const targetBranchId = parseInt($('#targetBranchSelect').val(), 10);
                    if (!targetBranchId) {
                        showCopyError('Please select a target branch.');
                        return;
                    }

                    const token = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';

                    try {
                        setCopyBusy(true);
                        const response = await fetch('/Menu/CopyToBranch', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({
                                targetBranchId: targetBranchId,
                                menuItemIds: selectedIds
                            })
                        })

                        const payload = await response.json().catch(() => ({}));
                        if (!response.ok) {
                            throw new Error(payload.message || 'Copy failed.');
                        }

                        await Swal.fire({
                            icon: 'success',
                            title: 'Copy Completed',
                            text: payload.message || 'Menu items copied successfully.'
                        });
                        window.location.reload();
                    } catch (error) {
                        showCopyError(error && error.message ? error.message : 'Copy failed.');
                    } finally {
                        setCopyBusy(false);
                    }
                });
            }

            // Ensure DB objects exist before navigating to recipe page
            $(document).on('click', 'a.recipe-link', function (e) {
                e.preventDefault();
                const href = $(this).attr('href');
                fetch('/Recipe/SetupRecipeScripts')
                    .then(() => { window.location.href = href; })
                    .catch(() => { window.location.href = href; });
            });
        });
    </script>
}
