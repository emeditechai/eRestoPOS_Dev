                        <div class="selection-option-card__header">
                            <span class="selection-option-card__avatar" aria-hidden="true">
                                <i class="fa-solid fa-user-shield"></i>
                            </span>
                            <span class="selection-option-card__check" aria-hidden="true">
                                <i class="fa-solid fa-check"></i>
                            </span>
                        </div>
                        <div class="selection-option-card__bodycopy">
                            <p class="selection-option-card__title">${roleName}</p>
                            <p class="selection-option-card__subtitle">${detailText}</p>
                        </div>
                        <div class="selection-option-card__meta">
                            <span class="selection-chip"><i class="fa-solid fa-user-tag"></i>Access</span>
                            ${isActive ? '<span class="selection-chip selection-chip--success"><i class="fa-solid fa-circle-check"></i>Current</span>' : '<span class="selection-chip selection-chip--primary"><i class="fa-solid fa-hand-pointer"></i>Select</span>'}
                        </div>
                    `;

                    item.addEventListener('click', function () {
                        setSelectedRole(roleId, item);
                    });

                    controls.options.appendChild(item);

                    if (isActive && !state.selectedRoleId) {
                        setSelectedRole(roleId, item, true);
                    }
                });

                const buttons = getRoleButtons();
                if (buttons.length > 0 && state.focusedIndex < 0) {
                    state.focusedIndex = Math.max(0, buttons.findIndex(btn => String(btn.dataset.roleId) === String(state.selectedRoleId)));
                }
            }

            function setSelectedRole(roleId, button, silent) {
                state.selectedRoleId = roleId;
                if (controls.options) {
                    controls.options.querySelectorAll('.selection-option-card').forEach(function (item) {
                        item.classList.remove('is-selected');
                        item.setAttribute('aria-pressed', 'false');
                    });
                }
                if (button) {
                    button.classList.add('is-selected');
                    button.setAttribute('aria-pressed', 'true');
                    const buttons = getRoleButtons();
                    state.focusedIndex = buttons.findIndex(item => item === button);
                }
                if (!silent) {
                    hideError();
                }
                if (controls.confirmBtn) {
                    controls.confirmBtn.disabled = !state.selectedRoleId;
                }
            }

            function moveRoleSelection(step) {
                const buttons = getRoleButtons();
                if (!buttons.length) {
                    return;
                }

                if (state.focusedIndex < 0) {
                    state.focusedIndex = 0;
                } else {
                    state.focusedIndex = (state.focusedIndex + step + buttons.length) % buttons.length;
                }

                const target = buttons[state.focusedIndex];
                if (target) {
                    setSelectedRole(target.dataset.roleId, target);
                    target.focus();
                }
            }

            async function submitRoleSelection() {
                if (!state.selectedRoleId) {
                    return;
                }

                setConfirmBusy(true);
                hideError();

                try {
                    const response = await fetch('/Account/SwitchRole', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: JSON.stringify({ roleId: state.selectedRoleId })
                    });

                    if (!response.ok) {
                        const payload = await response.json().catch(function () { return null; });
                        const message = payload && payload.message ? payload.message : 'Unable to switch roles right now. Please try again.';
                        throw new Error(message);
                    }

                    window.location.reload();
                } catch (error) {
                    setConfirmBusy(false);
                    const message = error && error.message ? error.message : 'Unable to switch roles right now.';
                    showError(message);
                }
            }

            if (controls.confirmBtn) {
                controls.confirmBtn.addEventListener('click', submitRoleSelection);
            }

            modalEl.addEventListener('keydown', function (event) {
                if (!modalEl.classList.contains('show')) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    moveRoleSelection(1);
                    return;
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    moveRoleSelection(-1);
                    return;
                }

                if (event.key === 'Enter') {
                    event.preventDefault();
                    submitRoleSelection();
                }
            });

            function openRoleModal(forceSelection) {
                ensureModalInstance(forceSelection);
                state.modal.show();
                loadRoles();

                modalEl.addEventListener('shown.bs.modal', function onShown() {
                    modalEl.removeEventListener('shown.bs.modal', onShown);
                    const buttons = getRoleButtons();
                    if (buttons.length > 0) {
                        const current = buttons.find(btn => btn.classList.contains('is-selected')) || buttons[0];
                        current.focus();
                    }
                });
            }

            window.addEventListener('open-role-selection-modal', function (event) {
                if (!hasMultipleRoles) {
                    return;
                }

                const forceSelection = event && event.detail && typeof event.detail.forceSelection === 'boolean'
                    ? event.detail.forceSelection
                    : true;

                openRoleModal(forceSelection);
            });

            if (requiresRoleSelection && hasMultipleRoles && !requiresBranchSelection) {
                openRoleModal(true);
            }
        });
    </script>
    <script>
        // Global handler for data-swal-confirm buttons (replaces native confirm)
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-swal-confirm]');
            if (!btn) return;
            e.preventDefault();
            var msg   = btn.getAttribute('data-swal-confirm');
            var title = btn.getAttribute('data-swal-title') || 'Are you sure?';
            var icon  = btn.getAttribute('data-swal-icon') || 'question';
            var confirmText = btn.getAttribute('data-swal-ok') || 'Yes, proceed';
            var confirmColor = btn.getAttribute('data-swal-color') || '#0d6efd';
            var form  = btn.closest('form');
            Swal.fire({
                title: title,
                text: msg,
                icon: icon,
                showCancelButton: true,
                confirmButtonColor: confirmColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: confirmText,
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(function (result) {
                if (result.isConfirmed && form) form.submit();
            });
        });
    </script>
