    <script>
        // SweetAlert-backed toastr compatibility layer.
        // Existing toastr.* calls across pages will continue to work,
        // but notifications are rendered using SweetAlert only.
        window.toastr = window.toastr || {};
        toastr.options = toastr.options || {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "5000",
            "extendedTimeOut": "2000",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        (function () {
            function parseMs(value, fallback) {
                var n = parseInt(value, 10);
                return isNaN(n) ? fallback : n;
            }

            function toSwalPosition(positionClass) {
                if (!positionClass) return 'top-end';
                if (positionClass.indexOf('top-left') >= 0) return 'top-start';
                if (positionClass.indexOf('top-center') >= 0) return 'top';
                if (positionClass.indexOf('top-right') >= 0) return 'top-end';
                if (positionClass.indexOf('bottom-left') >= 0) return 'bottom-start';
                if (positionClass.indexOf('bottom-center') >= 0) return 'bottom';
                if (positionClass.indexOf('bottom-right') >= 0) return 'bottom-end';
                return 'top-end';
            }

            function show(icon, message, title) {
                var opts = toastr.options || {};
                var hasHtml = /<[^>]+>/.test(message || '');
                var swalConfig = {
                    icon: icon,
                    title: title || '',
                    showConfirmButton: false,
                    showCloseButton: !!opts.closeButton,
                    timer: parseMs(opts.timeOut, 5000),
                    timerProgressBar: !!opts.progressBar,
                    position: toSwalPosition(opts.positionClass),
                    toast: true
                };

                if (hasHtml) {
                    swalConfig.html = message || '';
                } else {
                    swalConfig.text = message || '';
                }

                Swal.fire(swalConfig);
                return { close: function () { Swal.close(); } };
            }

            toastr.success = function (message, title) { return show('success', message, title || 'Success'); };
            toastr.error = function (message, title) { return show('error', message, title || 'Error'); };
            toastr.warning = function (message, title) { return show('warning', message, title || 'Warning'); };
            toastr.info = function (message, title) { return show('info', message, title || 'Information'); };
            toastr.clear = function () { Swal.close(); };
        })();

        // Auto-display TempData messages as SweetAlert popups
        $(document).ready(function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? string.Empty)),
                    confirmButtonColor: '#198754'
                });
                </text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString() ?? string.Empty)),
                    confirmButtonColor: '#dc3545'
                });
                </text>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["WarningMessage"]?.ToString() ?? string.Empty)),
                    confirmButtonColor: '#f0ad4e'
                });
                </text>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'info',
                    title: 'Information',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["InfoMessage"]?.ToString() ?? string.Empty)),
                    confirmButtonColor: '#0d6efd'
                });
                </text>
            }
        });
    </script>
    <script>
        (function () {
            function getFullscreenElement() {
                return document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
            }

            function requestFullscreen(el) {
                const fn = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
                return fn ? fn.call(el) : null;
            }

            function exitFullscreen() {
                const fn = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
                return fn ? fn.call(document) : null;
            }

            function updateFullscreenIcon(btn) {
                const isFs = !!getFullscreenElement();
                const icon = btn ? btn.querySelector('i') : null;
                if (icon) {
                    icon.classList.remove('fa-expand', 'fa-compress');
                    icon.classList.add(isFs ? 'fa-compress' : 'fa-expand');
                }
                if (btn) {
                    btn.title = isFs ? 'Exit full screen' : 'Full screen';
                    btn.setAttribute('aria-label', btn.title);
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                const btn = document.getElementById('appFullscreenToggle');
                if (!btn) return;

                updateFullscreenIcon(btn);

                btn.addEventListener('click', function (e) {
                    e.preventDefault();

                    if (getFullscreenElement()) {
                        exitFullscreen();
                    } else {
                        requestFullscreen(document.documentElement);
                    }
                });

                document.addEventListener('fullscreenchange', function () { updateFullscreenIcon(btn); });
                document.addEventListener('webkitfullscreenchange', function () { updateFullscreenIcon(btn); });
            });
        })();
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const modalEl = document.getElementById('branchSelectionModal');
            if (!body || !modalEl || typeof bootstrap === 'undefined') {
                return;
            }

            const dataset = body.dataset || {};
            const hasMultipleBranches = dataset.hasMultipleBranches === 'true';
            const requiresBranchSelection = dataset.requiresBranchSelection === 'true';
            const antiforgeryMeta = document.querySelector('meta[name="request-verification-token"]');
            const antiforgeryToken = antiforgeryMeta ? antiforgeryMeta.getAttribute('content') : '';

            const controls = {
                options: modalEl.querySelector('[data-branch-options]'),
                loading: modalEl.querySelector('[data-branch-loading]'),
                error: modalEl.querySelector('[data-branch-error]'),
                confirmBtn: modalEl.querySelector('[data-branch-confirm]'),
                confirmText: modalEl.querySelector('[data-branch-confirm-text]'),
                confirmSpinner: modalEl.querySelector('[data-branch-confirm-spinner]'),
                closeButtons: modalEl.querySelectorAll('[data-branch-close]'),
                title: modalEl.querySelector('[data-branch-modal-title]'),
                description: modalEl.querySelector('[data-branch-modal-description]')
            };

            const state = {
                selectedBranchId: null,
                modal: null,
                forceSelection: false,
                focusedIndex: -1
            };

            function getBranchButtons() {
                if (!controls.options) {
                    return [];
                }
                return Array.from(controls.options.querySelectorAll('.selection-option-card'));
            }

            function wireSwitchBranchTriggers() {
                document.querySelectorAll('[data-branch-switch-trigger]').forEach(function (trigger) {
                    trigger.addEventListener('click', function (event) {
                        event.preventDefault();
                        if (!hasMultipleBranches) {
                            return;
                        }
                        openBranchModal(false);
                    });
                });
            }

            wireSwitchBranchTriggers();

            function ensureModalInstance(forceSelection) {
                if (state.modal) {
                    state.modal.dispose();
                }
                state.modal = new bootstrap.Modal(modalEl, {
                    backdrop: forceSelection ? 'static' : true,
                    keyboard: !forceSelection
                });
                state.forceSelection = forceSelection;

                controls.closeButtons.forEach(function (btn) {
                    btn.classList.toggle('d-none', forceSelection);
                });

                if (controls.title) {
                    controls.title.textContent = forceSelection
                        ? 'Choose your branch to continue'
                        : 'Switch your active branch';
                }

                if (controls.description) {
                    controls.description.textContent = forceSelection
                        ? 'Please pick a branch to continue working. The application will reload after confirmation.'
                        : 'Select the branch you want to work in. You can switch again at any time from the profile menu.';
                }
            }

            function resetState() {
                state.selectedBranchId = null;
                state.focusedIndex = -1;
                if (controls.options) {
                    controls.options.innerHTML = '';
                    controls.options.classList.add('d-none');
                }
                if (controls.loading) {
                    controls.loading.classList.remove('d-none');
                }
                hideError();
                setConfirmBusy(false);
                if (controls.confirmBtn) {
                    controls.confirmBtn.disabled = true;
                }
            }

            function hideError() {
                if (controls.error) {
                    controls.error.classList.add('d-none');
                    controls.error.textContent = '';
                }
            }

            function showError(message) {
                if (controls.loading) {
                    controls.loading.classList.add('d-none');
                }
                if (controls.options) {
                    controls.options.classList.add('d-none');
                }
                if (controls.error) {
                    controls.error.textContent = message;
                    controls.error.classList.remove('d-none');
                }
                if (controls.confirmBtn) {
                    controls.confirmBtn.disabled = true;
                }
            }

            function setConfirmBusy(isBusy) {
                if (!controls.confirmBtn) {
                    return;
                }
                controls.confirmBtn.disabled = isBusy || !state.selectedBranchId;
                if (controls.confirmSpinner) {
                    controls.confirmSpinner.classList.toggle('d-none', !isBusy);
                }
                if (controls.confirmText) {
                    controls.confirmText.classList.toggle('d-none', isBusy);
                }
            }

            async function loadBranches() {
                resetState();
                try {
                    const response = await fetch('/Account/UserBranches', {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('Unable to load branches. Please try again.');
                    }

                    const payload = await response.json();
                    const branches = Array.isArray(payload) ? payload : [];
                    renderBranches(branches);
                } catch (error) {
                    const message = error && error.message ? error.message : 'Unable to load your branches right now.';
                    showError(message);
                }
            }

            function resolveBranchField(branch, camelKey, pascalKey) {
                if (Object.prototype.hasOwnProperty.call(branch, camelKey) && branch[camelKey] !== undefined && branch[camelKey] !== null) {
                    return branch[camelKey];
                }
                return branch[pascalKey];
            }

            function renderBranches(branches) {
                if (controls.loading) {
                    controls.loading.classList.add('d-none');
                }

                if (!branches.length) {
                    showError('No branches are assigned to this account. Please contact an administrator.');
                    return;
                }

                if (controls.options) {
                    controls.options.classList.remove('d-none');
                }

                branches.forEach(function (branch) {
                    if (!controls.options) {
                        return;
                    }

                    const branchId = resolveBranchField(branch, 'branchId', 'BranchId');
                    const branchCode = resolveBranchField(branch, 'branchCode', 'BranchCode') || '';
                    const branchName = resolveBranchField(branch, 'branchName', 'BranchName') || 'Branch';
                    const locationName = resolveBranchField(branch, 'locationName', 'LocationName') || '';
                    const isMainBranch = Boolean(resolveBranchField(branch, 'isMainBranch', 'IsMainBranch'));
                    const isActive = Boolean(resolveBranchField(branch, 'isActive', 'IsActive'));
                    const fullName = locationName ? `${locationName} - ${branchName}` : branchName;
                    const displayName = branchCode ? `${branchCode} - ${fullName}` : fullName;
                    const locationLabel = locationName || 'Branch location';

                    const item = document.createElement('button');
                    item.type = 'button';
                    item.setAttribute('tabindex', '0');
                    item.className = `selection-option-card${isActive ? ' is-current' : ''}`;
                    item.dataset.branchId = branchId;
                    item.dataset.branchDisplayName = displayName;
                    item.dataset.branchIsMain = isMainBranch ? 'true' : 'false';
                    item.setAttribute('aria-pressed', 'false');
                    item.innerHTML = `
                        <div class="selection-option-card__header">
                            <span class="selection-option-card__avatar" aria-hidden="true">
                                <i class="fa-solid fa-store"></i>
                            </span>
                            <span class="selection-option-card__check" aria-hidden="true">
                                <i class="fa-solid fa-check"></i>
                            </span>
                        </div>
                        <div class="selection-option-card__bodycopy">
                            <p class="selection-option-card__title">${displayName}</p>
                            <p class="selection-option-card__subtitle">${locationLabel}</p>
                        </div>
                        <div class="selection-option-card__meta">
                            ${branchCode ? `<span class="selection-chip"><i class="fa-solid fa-hashtag"></i>${branchCode}</span>` : ''}
                            ${isMainBranch ? '<span class="selection-chip selection-chip--accent"><i class="fa-solid fa-star"></i>Main</span>' : ''}
                            ${isActive ? '<span class="selection-chip selection-chip--success"><i class="fa-solid fa-circle-check"></i>Current</span>' : '<span class="selection-chip selection-chip--primary"><i class="fa-solid fa-hand-pointer"></i>Select</span>'}
                        </div>
                    `;

                    item.addEventListener('click', function () {
                        setSelectedBranch(branchId, item);
                    });

                    controls.options.appendChild(item);

                    if (isActive && !state.selectedBranchId) {
                        setSelectedBranch(branchId, item, true);
                    }
                });

                const buttons = getBranchButtons();
                if (buttons.length > 0 && state.focusedIndex < 0) {
                    state.focusedIndex = Math.max(0, buttons.findIndex(btn => String(btn.dataset.branchId) === String(state.selectedBranchId)));
                }
            }

            function setSelectedBranch(branchId, button, silent) {
                state.selectedBranchId = branchId;
                if (controls.options) {
                    controls.options.querySelectorAll('.selection-option-card').forEach(function (item) {
                        item.classList.remove('is-selected');
                        item.setAttribute('aria-pressed', 'false');
                    });
                }
                if (button) {
                    button.classList.add('is-selected');
                    button.setAttribute('aria-pressed', 'true');
                    const buttons = getBranchButtons();
                    state.focusedIndex = buttons.findIndex(item => item === button);
                }
                if (!silent) {
                    hideError();
                }
                if (controls.confirmBtn) {
                    controls.confirmBtn.disabled = !state.selectedBranchId;
                }
            }

            function moveBranchSelection(step) {
                const buttons = getBranchButtons();
                if (!buttons.length) {
                    return;
                }

                if (state.focusedIndex < 0) {
                    state.focusedIndex = 0;
                } else {
                    state.focusedIndex = (state.focusedIndex + step + buttons.length) % buttons.length;
                }

                const target = buttons[state.focusedIndex];
                if (target) {
                    setSelectedBranch(target.dataset.branchId, target);
                    target.focus();
                }
            }

            async function submitBranchSelection() {
                if (!state.selectedBranchId) {
                    return;
                }

                setConfirmBusy(true);
                hideError();

                try {
                    const response = await fetch('/Account/SwitchBranch', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: JSON.stringify({ branchId: state.selectedBranchId })
                    });

                    if (!response.ok) {
                        const payload = await response.json().catch(function () { return null; });
                        const message = payload && payload.message ? payload.message : 'Unable to switch branch right now. Please try again.';
                        throw new Error(message);
                    }

                    const activeBranchButton = controls.options
                        ? controls.options.querySelector(`[data-branch-id="${state.selectedBranchId}"]`)
                        : null;
                    const selectedBranchText = activeBranchButton
                        ? (activeBranchButton.dataset.branchDisplayName || '').trim()
                        : '';
                    const selectedBranchIsMain = activeBranchButton
                        ? activeBranchButton.dataset.branchIsMain === 'true'
                        : false;
                    if (selectedBranchText) {
                        document.querySelectorAll('[data-active-branch-label]').forEach(function (label) {
                            label.textContent = selectedBranchText;
                        });
                        document.querySelectorAll('[data-active-branch-main-badge]').forEach(function (badge) {
                            badge.classList.toggle('d-none', !selectedBranchIsMain);
                        });
                        body.dataset.activeBranchId = String(state.selectedBranchId);
                    }

                    const shouldOpenRoleModal = dataset.hasMultipleRoles === 'true';

                    if (shouldOpenRoleModal && state.modal) {
                        const onHidden = function () {
                            modalEl.removeEventListener('hidden.bs.modal', onHidden);
                            window.dispatchEvent(new CustomEvent('open-role-selection-modal', {
                                detail: { forceSelection: true }
                            }));
                        };

                        modalEl.addEventListener('hidden.bs.modal', onHidden);
                        state.modal.hide();
                        return;
                    }

                    window.location.reload();
                } catch (error) {
                    setConfirmBusy(false);
                    const message = error && error.message ? error.message : 'Unable to switch branch right now.';
                    showError(message);
                }
            }

            if (controls.confirmBtn) {
                controls.confirmBtn.addEventListener('click', submitBranchSelection);
            }

            modalEl.addEventListener('keydown', function (event) {
                if (!modalEl.classList.contains('show')) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    moveBranchSelection(1);
                    return;
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    moveBranchSelection(-1);
                    return;
                }

                if (event.key === 'Enter') {
                    event.preventDefault();
                    submitBranchSelection();
                }
            });

            function openBranchModal(forceSelection) {
                ensureModalInstance(forceSelection);
                state.modal.show();
                loadBranches();

                modalEl.addEventListener('shown.bs.modal', function onShown() {
                    modalEl.removeEventListener('shown.bs.modal', onShown);
                    const buttons = getBranchButtons();
                    if (buttons.length > 0) {
                        const current = buttons.find(btn => btn.classList.contains('is-selected')) || buttons[0];
                        current.focus();
                    }
                });
            }

            if (requiresBranchSelection && hasMultipleBranches) {
                openBranchModal(true);
            }
        });
    </script>
