<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-bg.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="auth-body">
    <div class="auth-bg-hero" aria-hidden="true">
        <div class="auth-bg-slide"></div>
        <div class="auth-bg-slide"></div>
        <div class="auth-bg-slide"></div>
    </div>
    <div class="auth-bg-overlay" aria-hidden="true"></div>
    <div class="auth-wrapper">
           @RenderBody()
    </div>

    <footer class="auth-footer">
        <div class="container">
            &copy; @DateTime.Now.Year - Emeditech Plus LLP - <a href="#" class="text-light">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            /* Up to 3 background images — only ones that successfully load are used */
            var candidates = [
                '/images/login-bg-restaurant.png',
                '/images/login-bg-restaurant_2.png',
                '/images/login-bg-restaurant_1.png'
            ];

            var slideDivs = Array.from(document.querySelectorAll('.auth-bg-slide'));
            var validUrls = [];
            var checked = 0;

            function initSlideshow() {
                /* Hide unused slide divs */
                slideDivs.forEach(function (div, i) {
                    if (i < validUrls.length) {
                        div.style.backgroundImage = "url('" + validUrls[i] + "')";
                    } else {
                        div.style.display = 'none';
                    }
                });

                var slides = slideDivs.slice(0, validUrls.length);
                if (slides.length < 2) return; /* Nothing to slide if only 1 image */

                var current = 0;

                /* Set initial positions */
                slides.forEach(function (s, i) {
                    s.style.transition = 'none';
                    s.style.transform = i === 0 ? 'translateX(0)' : 'translateX(100%)';
                    s.style.zIndex = i === 0 ? '2' : '1';
                });

                function goNext() {
                    var next = (current + 1) % slides.length;

                    slides[next].style.transition = 'none';
                    slides[next].style.transform = 'translateX(100%)';
                    slides[next].style.zIndex = '2';

                    void slides[next].offsetWidth; /* force reflow */

                    slides[next].style.transition = 'transform 1s ease-in-out';
                    slides[next].style.transform = 'translateX(0)';

                    slides[current].style.transition = 'transform 1s ease-in-out';
                    slides[current].style.transform = 'translateX(-100%)';
                    slides[current].style.zIndex = '1';

                    current = next;
                }

                setInterval(goNext, 9000);
            }

            /* Preload each candidate — only keep images that load successfully */
            candidates.slice(0, 3).forEach(function (url) {
                var img = new Image();
                img.onload = function () {
                    validUrls.push(url);
                    if (++checked === candidates.length) initSlideshow();
                };
                img.onerror = function () {
                    if (++checked === candidates.length) initSlideshow();
                };
                img.src = url;
            });
        })();
    </script>
</body>
</html>
