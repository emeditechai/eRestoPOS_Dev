<script>
/* ── Help Modal Scripts ──────────────────────────────────────────────── */
(function () {
  // Search highlight
  window.helpSearch = function (val) {
    var target = document.getElementById('helpSearchTarget');
    if (!target) return;
    var items = target.querySelectorAll('td, li, p, .accordion-body, .sop-step, .faq-a, .faq-q');
    var q = (val || '').trim().toLowerCase();
    items.forEach(function (el) {
      var html = el.getAttribute('data-original') || el.innerHTML;
      if (!el.getAttribute('data-original')) el.setAttribute('data-original', html);
      if (!q) { el.innerHTML = html; return; }
      var highlighted = html.replace(new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi'), '<mark class="help-search-hl">$1</mark>');
      el.innerHTML = highlighted;
    });
    // Auto-switch to first tab that has a match
    if (q.length >= 2) {
      var tabs = document.querySelectorAll('#helpTabs .nav-link');
      for (var i = 0; i < tabs.length; i++) {
        var paneId = tabs[i].getAttribute('data-bs-target');
        var pane = document.querySelector(paneId);
        if (pane && pane.innerHTML.toLowerCase().indexOf(q) !== -1) {
          bootstrap.Tab.getOrCreateInstance(tabs[i]).show();
          break;
        }
      }
    }
  };

  // Clear search highlights when modal closes
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('appHelpModal');
    if (!modal) return;
    modal.addEventListener('hidden.bs.modal', function () {
      var box = document.getElementById('helpSearchBox');
      if (box) { box.value = ''; window.helpSearch(''); }
    });
    // Show current tab name in footer
    modal.addEventListener('shown.bs.tab', function (e) {
      var label = document.getElementById('helpCurrentTab');
      if (label && e.target) label.textContent = (e.target.textContent.trim() || '') + ' — ';
    });
  });
})();
</script>
