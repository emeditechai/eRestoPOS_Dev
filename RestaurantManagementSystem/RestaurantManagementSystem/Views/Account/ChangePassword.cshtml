@model RestaurantManagementSystem.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Change Password</li>
                </ol>
            </nav>

            <!-- Change Password Card -->
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden; background: #ffffff; box-shadow: 0 10px 30px rgba(42, 16, 109, 0.08) !important;">
                
                <!-- Card Header -->
                <div class="p-4" style="background: linear-gradient(135deg, #1e0a4a 0%, #2a106d 45%, #6d28d9 100%); color: #ffffff;">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 48px; height: 48px; border-radius: 14px; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; border: 1px solid rgba(255, 255, 255, 0.2);">
                            <i class="fas fa-key text-warning"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold text-white" style="letter-spacing: -0.02em;">Change Password</h4>
                            <p class="mb-0 text-white-50" style="font-size: 0.88rem;">Update your account password securely</p>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
                            <i class="fas fa-check-circle fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
                            <i class="fas fa-triangle-exclamation fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-triangle-exclamation"></i>
                                <strong style="font-size: 0.9rem;">Please correct the errors below:</strong>
                            </div>
                            <div asp-validation-summary="All" class="text-danger mb-0" style="font-size: 0.86rem;"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ChangePassword" method="post" id="changePasswordForm" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <!-- Current Password -->
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold text-dark" style="font-size: 0.88rem;">
                                Current Password <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px; color: #64748b;">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="CurrentPassword" type="password" class="form-control border-start-0 border-end-0" placeholder="Enter current password" id="currentPasswordInput" required autocomplete="current-password" style="font-size: 0.92rem;" />
                                <button class="btn btn-outline-secondary border-start-0 toggle-password-btn" type="button" data-target="currentPasswordInput" style="border-radius: 0 12px 12px 0; border-color: #dee2e6;" tabindex="-1">
                                    <i class="fas fa-eye text-muted"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <!-- New Password -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold text-dark" style="font-size: 0.88rem;">
                                New Password <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px; color: #64748b;">
                                    <i class="fas fa-key"></i>
                                </span>
                                <input asp-for="NewPassword" type="password" class="form-control border-start-0 border-end-0" placeholder="Enter new password" id="newPasswordInput" required autocomplete="new-password" style="font-size: 0.92rem;" />
                                <button class="btn btn-outline-secondary border-start-0 toggle-password-btn" type="button" data-target="newPasswordInput" style="border-radius: 0 12px 12px 0; border-color: #dee2e6;" tabindex="-1">
                                    <i class="fas fa-eye text-muted"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.8rem;"></span>

                            <!-- Password Requirement Pills -->
                            <div class="p-3 mt-2 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fw-semibold text-muted mb-2" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em;">Password Requirements:</div>
                                <div class="d-flex flex-wrap gap-2" style="font-size: 0.76rem;">
                                    <span class="badge bg-light text-muted border req-badge" id="req-length"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i> At least 8 characters</span>
                                    <span class="badge bg-light text-muted border req-badge" id="req-upper"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i> Uppercase letter (A-Z)</span>
                                    <span class="badge bg-light text-muted border req-badge" id="req-lower"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i> Lowercase letter (a-z)</span>
                                    <span class="badge bg-light text-muted border req-badge" id="req-number"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i> Number (0-9)</span>
                                    <span class="badge bg-light text-muted border req-badge" id="req-special"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i> Special character (!@@#$%)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark" style="font-size: 0.88rem;">
                                Confirm New Password <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px; color: #64748b;">
                                    <i class="fas fa-check-double"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 border-end-0" placeholder="Re-enter new password" id="confirmPasswordInput" required autocomplete="new-password" style="font-size: 0.92rem;" />
                                <button class="btn btn-outline-secondary border-start-0 toggle-password-btn" type="button" data-target="confirmPasswordInput" style="border-radius: 0 12px 12px 0; border-color: #dee2e6;" tabindex="-1">
                                    <i class="fas fa-eye text-muted"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                            <div id="match-status" class="mt-1" style="font-size: 0.78rem;"></div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex align-items-center justify-content-between gap-3 pt-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light px-4 py-2 text-secondary fw-semibold" style="border-radius: 12px; border: 1px solid #cbd5e1;">
                                <i class="fas fa-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn px-4 py-2 text-white fw-bold" style="border-radius: 12px; background: linear-gradient(135deg, #7c3aed 0%, #4a1fa8 100%); box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);">
                                <i class="fas fa-shield-halved me-1"></i> Update Password
                            </button>
                        </div>
                    </form>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Password toggle visibility
            document.querySelectorAll('.toggle-password-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    if (input) {
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    }
                });
            });

            // Live password requirement checking
            const newPasswordInput = document.getElementById('newPasswordInput');
            const confirmPasswordInput = document.getElementById('confirmPasswordInput');
            const matchStatus = document.getElementById('match-status');

            const reqLength = document.getElementById('req-length');
            const reqUpper = document.getElementById('req-upper');
            const reqLower = document.getElementById('req-lower');
            const reqNumber = document.getElementById('req-number');
            const reqSpecial = document.getElementById('req-special');

            function updateRequirementBadge(el, isValid) {
                if (isValid) {
                    el.className = 'badge bg-success text-white border-0 req-badge';
                    el.querySelector('i').className = 'fas fa-check me-1';
                } else {
                    el.className = 'badge bg-light text-muted border req-badge';
                    el.querySelector('i').className = 'fas fa-circle me-1';
                }
            }

            if (newPasswordInput) {
                newPasswordInput.addEventListener('input', function () {
                    const val = this.value;
                    updateRequirementBadge(reqLength, val.length >= 8);
                    updateRequirementBadge(reqUpper, /[A-Z]/.test(val));
                    updateRequirementBadge(reqLower, /[a-z]/.test(val));
                    updateRequirementBadge(reqNumber, /[0-9]/.test(val));
                    updateRequirementBadge(reqSpecial, /[^A-Za-z0-9]/.test(val));

                    checkMatch();
                });
            }

            function checkMatch() {
                if (!confirmPasswordInput || !newPasswordInput) return;
                const newPass = newPasswordInput.value;
                const confPass = confirmPasswordInput.value;

                if (confPass.length > 0) {
                    if (newPass === confPass) {
                        matchStatus.innerHTML = '<span class="text-success fw-semibold"><i class="fas fa-check-circle me-1"></i> Passwords match</span>';
                    } else {
                        matchStatus.innerHTML = '<span class="text-danger fw-semibold"><i class="fas fa-times-circle me-1"></i> Passwords do not match</span>';
                    }
                } else {
                    matchStatus.innerHTML = '';
                }
            }

            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', checkMatch);
            }
        });
    </script>
}
