@{
	ViewData["Title"] = "Session Timed Out";
	Layout = "_AuthLayout";
}

<div class="login-container">
	<div class="login-card text-center">
		<div class="login-header">
			<div class="login-logo-text">eRestoPOS</div>
			<h2>Session Timed Out</h2>
			<p>Your session has expired. Please login again to continue.</p>
		</div>

		<div class="mt-3">
			<a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-block">Login Again</a>
		</div>
	</div>
</div>
