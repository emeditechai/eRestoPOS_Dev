@model RestaurantManagementSystem.Models.StockTransferHeader
@{
    ViewData["Title"] = "Transfer Details";
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center">
            <a asp-action="Index" asp-controller="StockTransfer" class="btn btn-link text-muted ps-0 me-2">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h4 class="mb-0 fw-bold"><i class="fas fa-exchange-alt me-2 text-primary"></i>Transfer Details</h4>
                <small class="text-muted">Transfer# <strong>@Model.TransferNumber</strong></small>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == "Posted")
            {
                <span class="badge bg-success fs-6"><i class="fas fa-check-double me-1"></i>Posted to Stock</span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6"><i class="fas fa-clock me-1"></i>Draft</span>
                <a asp-action="Form" asp-controller="StockTransfer" asp-route-id="@Model.TransferId"
                   class="btn btn-outline-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
                <form method="post" asp-action="Post" asp-controller="StockTransfer" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.TransferId" />
                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Post this transfer to stock ledger? This cannot be undone.')">
                        <i class="fas fa-check-double me-1"></i>Post to Stock
                    </button>
                </form>
            }
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-1"></i>Print</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-info-circle me-1"></i>Transfer Information</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 small">
                        <div class="col-md-2"><label class="text-muted d-block">Transfer No.</label><span class="fw-semibold text-primary">@Model.TransferNumber</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Date</label><span class="fw-semibold">@Model.TransferDate.ToString("dd MMM yyyy")</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">From Godown</label><span class="badge bg-danger-subtle text-danger fs-6">@Model.FromGodownName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">To Godown</label><span class="badge bg-success-subtle text-success fs-6">@Model.ToGodownName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Total Value</label><span class="fw-bold fs-6">₹@Model.TotalValue.ToString("N2")</span></div>
                        @if (!string.IsNullOrEmpty(Model.Remarks))
                        { <div class="col-12"><label class="text-muted d-block">Remarks</label><span>@Model.Remarks</span></div> }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-list me-1"></i>Transferred Items</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">#</th>
                                    <th>Item</th>
                                    <th class="text-end">Qty</th>
                                    <th>UOM</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end pe-3">Transfer Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var sn = 1; }
                                @foreach (var line in Model.Lines ?? new List<RestaurantManagementSystem.Models.StockTransferLine>())
                                {
                                    <tr>
                                        <td class="ps-3 text-muted small">@sn</td>
                                        <td class="fw-semibold">@line.ItemName</td>
                                        <td class="text-end">@line.Quantity.ToString("N3")</td>
                                        <td class="text-muted small">@line.UOMCode</td>
                                        <td class="text-end">₹@line.UnitCost.ToString("N2")</td>
                                        <td class="text-end pe-3 fw-semibold">₹@(line.Quantity * line.UnitCost).ToString("N2")</td>
                                    </tr>
                                    sn++;
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td colspan="5" class="text-end ps-3">Total Transfer Value:</td>
                                    <td class="text-end pe-3 text-primary">₹@Model.TotalValue.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
