@model RestaurantManagementSystem.Models.InventoryDashboardViewModel
@{
    ViewData["Title"] = "Inventory Dashboard";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fas fa-boxes-stacked me-2 text-success"></i>Inventory Dashboard
            </h4>
            <small class="text-muted">Stock overview, alerts and activity summary</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="StockSummary" asp-controller="Inventory" class="btn btn-outline-success btn-sm">
                <i class="fas fa-table me-1"></i>Stock Summary
            </a>
            <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-success text-white btn-sm">
                <i class="fas fa-file-invoice me-1"></i>New PO
            </a>
        </div>
    </div>

    @if (ViewBag.DashboardError != null)
    {
        <div class="alert alert-warning py-2">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Dashboard stats unavailable – please run <code>inventory_complete_setup.sql</code> on your database first.
            <br /><small class="text-muted">@ViewBag.DashboardError</small>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Stock Value -->
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 fs-4 text-success">
                        <i class="fas fa-boxes-stacked"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Stock Value</div>
                        <div class="fw-bold fs-5 text-success">₹@Model.TotalStockValue.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Low Stock -->
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 p-3 fs-4 text-danger">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Low Stock Items</div>
                        <div class="fw-bold fs-5 text-danger">@Model.LowStockItems</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending GRN -->
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-3 fs-4 text-warning">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pending GRN</div>
                        <div class="fw-bold fs-5 text-warning">@Model.PendingGRN</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Today's Purchase -->
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 fs-4 text-primary">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Today's Purchase</div>
                        <div class="fw-bold fs-5 text-primary">₹@Model.TodayPurchase.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Module Shortcuts -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
                    <i class="fas fa-th-large me-2 text-success"></i>Quick Access
                </div>
                <div class="card-body py-3">
                    <div class="row g-2">
                        @{
                            var modules = new[] {
                                ("Purchase Orders", "fa-file-invoice", "PurchaseOrder", "Index", "primary"),
                                ("Goods Receipt (GRN)", "fa-clipboard-check", "GRN", "Index", "success"),
                                ("Stock Transfer", "fa-exchange-alt", "StockTransfer", "Index", "info"),
                                ("Damage Entry", "fa-trash-alt", "DamageEntry", "Index", "danger"),
                                ("Stock Ledger", "fa-book", "Inventory", "StockLedger", "dark"),
                                ("Opening Stock", "fa-layer-group", "Inventory", "OpeningStock", "secondary"),
                                ("Stock Valuation", "fa-balance-scale", "Inventory", "StockValuation", "warning"),
                                ("Suppliers", "fa-truck", "Inventory", "Suppliers", "info"),
                            };
                        }
                        @foreach (var (title, icon, ctrl, action, color) in modules)
                        {
                            <div class="col-6 col-md-3">
                                <a asp-controller="@ctrl" asp-action="@action"
                                   class="d-flex align-items-center gap-2 p-3 rounded-3 bg-@color bg-opacity-10 text-@color text-decoration-none h-100 border border-@color border-opacity-25 hover-lift">
                                    <i class="fas @icon fa-lg"></i>
                                    <span class="fw-semibold small">@title</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Top Consumed + Low Stock Alerts -->
    <div class="row g-3">
        <!-- Top Consumed Items -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
                    <i class="fas fa-fire me-2 text-danger"></i>Top Consumed Items (Today)
                    <span class="float-end badge bg-primary-subtle text-primary fw-normal" style="font-size:10px">POS &amp; All Orders</span>
                </div>
                <div class="card-body p-3">
                    @if (Model.TopConsumedItems.Any())
                    {
                        var maxConsumed = Model.TopConsumedItems.Max(x => x.TotalConsumed);
                        int rank = 0;
                        string[] rankColors = { "text-warning", "text-secondary", "text-danger", "text-muted", "text-muted" };
                        string[] rankIcons  = { "fa-trophy", "fa-medal", "fa-award", "fa-star", "fa-star" };
                        @foreach (var item in Model.TopConsumedItems)
                        {
                            var pct = maxConsumed > 0 ? (int)Math.Round(item.TotalConsumed / maxConsumed * 100) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas @rankIcons[rank] small @rankColors[rank]"></i>
                                        <span class="fw-semibold small">@item.ItemName</span>
                                        @if (!string.IsNullOrEmpty(item.ItemCode))
                                        {
                                            <span class="text-muted" style="font-size:10px">[@item.ItemCode]</span>
                                        }
                                    </div>
                                    <span class="badge bg-danger-subtle text-danger">@item.TotalConsumed.ToString("N3") @item.UOMCode</span>
                                </div>
                                <div class="progress" style="height:5px;border-radius:3px">
                                    <div class="progress-bar bg-danger" style="width:@pct%"></div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4 px-3">
                            <i class="fas fa-fire fa-2x mb-2 d-block opacity-25"></i>
                            <p class="mb-1 small fw-semibold">No consumption data for today.</p>
                            <p class="mb-0" style="font-size:11px">Consumption is recorded when orders are placed (POS &amp; Create Order).<br>Data will appear here once any order is completed today.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
                    <i class="fas fa-bell me-2 text-warning"></i>Low Stock Alerts
                    @if (Model.LowStockAlerts.Any())
                    {
                        <span class="badge bg-danger ms-2">@Model.LowStockAlerts.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.LowStockAlerts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light small text-uppercase text-muted">
                                    <tr>
                                        <th class="ps-3">Item</th>
                                        <th class="text-end">Balance</th>
                                        <th class="text-end pe-3">Reorder</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.LowStockAlerts)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-semibold text-danger small">@a.ItemName</div>
                                                <div class="text-muted" style="font-size:.72rem">@a.GodownName</div>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-danger">@a.BalanceQty.ToString("N2") @a.UOMCode</span>
                                            </td>
                                            <td class="text-end pe-3 text-muted small">
                                                @(a.ReorderLevel?.ToString("N2") ?? "—")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-check-circle fa-2x mb-2 d-block text-success opacity-50"></i>
                            No low-stock alerts.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .hover-lift { transition: transform .2s, box-shadow .2s; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,.1) !important; }
</style>
}
