@model RestaurantManagementSystem.Models.InventoryDashboardViewModel
@{
    ViewData["Title"] = "Inventory Dashboard";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fas fa-boxes-stacked me-2 text-success"></i>Inventory Dashboard
            </h4>
            <small class="text-muted">Stock overview, alerts and activity summary</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="StockSummary" asp-controller="Inventory" class="btn btn-outline-success btn-sm">
                <i class="fas fa-table me-1"></i>Stock Summary
            </a>
            <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-success text-white btn-sm">
                <i class="fas fa-file-invoice me-1"></i>New PO
            </a>
        </div>
    </div>

    @if (ViewBag.DashboardError != null)
    {
        <div class="alert alert-warning py-2">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Dashboard stats unavailable – please run <code>inventory_complete_setup.sql</code> on your database first.
            <br /><small class="text-muted">@ViewBag.DashboardError</small>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Cards Row -->
    <div class="row g-3 mb-3">
        <!-- Total Stock Value -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 fs-4 text-success">
                        <i class="fas fa-boxes-stacked"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Stock Value</div>
                        <div class="fw-bold fs-5 text-success">₹@Model.TotalStockValue.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Low Stock -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 p-3 fs-4 text-danger">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Low Stock Items</div>
                        <div class="fw-bold fs-5 @(Model.LowStockItems > 0 ? "text-danger" : "text-success")">@Model.LowStockItems</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending GRN -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-3 fs-4 text-warning">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pending GRN</div>
                        <div class="fw-bold fs-5 text-warning">@Model.PendingGRN</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Today's Purchase -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 fs-4 text-primary">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Today's Purchase</div>
                        <div class="fw-bold fs-5 text-primary">₹@Model.TodayPurchase.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Today's Consumption -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 p-3 fs-4 text-danger">
                        <i class="fas fa-fire-flame-curved"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Today's Consumption</div>
                        <div class="fw-bold fs-5 text-danger">₹@Model.TodayConsumption.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Purchase vs Consumption Bar -->
    @{
        var purchaseVal    = (double)Model.TodayPurchase;
        var consumptionVal = (double)Model.TodayConsumption;
        var maxBarVal      = Math.Max(purchaseVal, consumptionVal);
        var purchasePct    = maxBarVal > 0 ? (int)Math.Round(purchaseVal    / maxBarVal * 100) : 0;
        var consumptionPct = maxBarVal > 0 ? (int)Math.Round(consumptionVal / maxBarVal * 100) : 0;
    }
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-semibold small text-muted"><i class="fas fa-balance-scale me-1 text-info"></i>Today: Purchase vs Consumption</span>
                <span style="font-size:11px">
                    @if (purchaseVal > consumptionVal && purchaseVal > 0)
                    { <span class="text-success fw-semibold"><i class="fas fa-arrow-up me-1"></i>Purchased more than consumed</span> }
                    else if (consumptionVal > 0 && consumptionVal > purchaseVal)
                    { <span class="text-warning fw-semibold"><i class="fas fa-fire me-1"></i>Consumption exceeds today's purchase</span> }
                    else
                    { <span class="text-muted">No activity today</span> }
                </span>
            </div>
            <div class="row g-2 align-items-center">
                <div class="col-auto text-end" style="width:140px">
                    <div class="small fw-semibold text-primary">Purchase</div>
                    <div class="fw-bold text-primary">₹@Model.TodayPurchase.ToString("N0")</div>
                </div>
                <div class="col">
                    <div class="progress mb-1" style="height:12px;border-radius:6px">
                        <div class="progress-bar bg-primary" style="width:@purchasePct%"
                             title="₹@Model.TodayPurchase.ToString("N0")"></div>
                    </div>
                    <div class="progress" style="height:12px;border-radius:6px">
                        <div class="progress-bar bg-danger" style="width:@consumptionPct%"
                             title="₹@Model.TodayConsumption.ToString("N0")"></div>
                    </div>
                </div>
                <div class="col-auto" style="width:140px">
                    <div class="small fw-semibold text-danger">Consumption</div>
                    <div class="fw-bold text-danger">₹@Model.TodayConsumption.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: Quick Stock Check -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
            <i class="fas fa-magnifying-glass me-2 text-info"></i>Quick Stock Check
            <span class="float-end fw-normal text-muted" style="font-size:11px">Search any ingredient instantly</span>
        </div>
        <div class="card-body py-3 px-4">
            <div class="row g-2 align-items-start">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="qsInput" class="form-control" placeholder="Type ingredient name…" autocomplete="off">
                    </div>
                </div>
                <div class="col-md-9" id="quickStockResult">
                    <div class="text-muted small pt-1"><i class="fas fa-info-circle me-1"></i>Type at least 2 characters to search.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 4: Module Shortcuts -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
                    <i class="fas fa-th-large me-2 text-success"></i>Quick Access
                </div>
                <div class="card-body py-3">
                    <div class="row g-2">
                        @{
                            var modules = new[] {
                                ("Purchase Orders", "fa-file-invoice", "PurchaseOrder", "Index", "primary"),
                                ("Goods Receipt (GRN)", "fa-clipboard-check", "GRN", "Index", "success"),
                                ("Stock Transfer", "fa-exchange-alt", "StockTransfer", "Index", "info"),
                                ("Damage Entry", "fa-trash-alt", "DamageEntry", "Index", "danger"),
                                ("Stock Ledger", "fa-book", "Inventory", "StockLedger", "dark"),
                                ("Opening Stock", "fa-layer-group", "Inventory", "OpeningStock", "secondary"),
                                ("Stock Valuation", "fa-balance-scale", "Inventory", "StockValuation", "warning"),
                                ("Suppliers", "fa-truck", "Inventory", "Suppliers", "info"),
                            };
                        }
                        @foreach (var (title, icon, ctrl, action, color) in modules)
                        {
                            <div class="col-6 col-md-3">
                                <a asp-controller="@ctrl" asp-action="@action"
                                   class="d-flex align-items-center gap-2 p-3 rounded-3 bg-@color bg-opacity-10 text-@color text-decoration-none h-100 border border-@color border-opacity-25 hover-lift">
                                    <i class="fas @icon fa-lg"></i>
                                    <span class="fw-semibold small">@title</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Top Consumed + Low Stock Alerts -->
    <div class="row g-3 mb-3">
        <!-- Top Consumed Items -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
                    <i class="fas fa-fire me-2 text-danger"></i>Top Consumed Items (Today)
                    <span class="float-end badge bg-primary-subtle text-primary fw-normal" style="font-size:10px">POS &amp; All Orders</span>
                </div>
                <div class="card-body p-3">
                    @if (Model.TopConsumedItems.Any())
                    {
                        var maxConsumed = Model.TopConsumedItems.Max(x => x.TotalConsumed);
                        int rank = 0;
                        string[] rankColors = { "text-warning", "text-secondary", "text-danger", "text-muted", "text-muted" };
                        string[] rankIcons  = { "fa-trophy", "fa-medal", "fa-award", "fa-star", "fa-star" };
                        @foreach (var item in Model.TopConsumedItems)
                        {
                            var pct = maxConsumed > 0 ? (int)Math.Round(item.TotalConsumed / maxConsumed * 100) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas @rankIcons[rank] small @rankColors[rank]"></i>
                                        <span class="fw-semibold small">@item.ItemName</span>
                                        @if (!string.IsNullOrEmpty(item.ItemCode))
                                        {
                                            <span class="text-muted" style="font-size:10px">[@item.ItemCode]</span>
                                        }
                                    </div>
                                    <span class="badge bg-danger-subtle text-danger">@item.TotalConsumed.ToString("N3") @item.UOMCode</span>
                                </div>
                                <div class="progress" style="height:5px;border-radius:3px">
                                    <div class="progress-bar bg-danger" style="width:@pct%"></div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4 px-3">
                            <i class="fas fa-fire fa-2x mb-2 d-block opacity-25"></i>
                            <p class="mb-1 small fw-semibold">No consumption data for today.</p>
                            <p class="mb-0" style="font-size:11px">Consumption is recorded when orders are placed (POS &amp; Create Order).<br>Data will appear here once any order is completed today.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted">
                    <i class="fas fa-bell me-2 text-warning"></i>Low Stock Alerts
                    @if (Model.LowStockAlerts.Any())
                    {
                        <span class="badge bg-danger ms-2">@Model.LowStockAlerts.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.LowStockAlerts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light small text-uppercase text-muted">
                                    <tr>
                                        <th class="ps-3">Item</th>
                                        <th class="text-end">Balance</th>
                                        <th class="text-end">Reorder</th>
                                        <th class="text-end pe-3">Days Left</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.LowStockAlerts)
                                    {
                                        var daysClass = a.DaysRemaining == 999 ? "badge bg-secondary-subtle text-secondary"
                                                      : a.DaysRemaining <= 3   ? "badge bg-danger text-white"
                                                      : a.DaysRemaining <= 7   ? "badge bg-warning text-dark"
                                                      : "badge bg-success-subtle text-success";
                                        var daysLabel = a.DaysRemaining == 999 ? "N/A" : $"{a.DaysRemaining}d";
                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-semibold text-danger small">@a.ItemName</div>
                                                <div class="text-muted" style="font-size:.72rem">@a.GodownName</div>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-danger">@a.BalanceQty.ToString("N2") @a.UOMCode</span>
                                            </td>
                                            <td class="text-end text-muted small">@(a.ReorderLevel?.ToString("N2") ?? "—")</td>
                                            <td class="text-end pe-3">
                                                <span class="@daysClass px-2">@daysLabel</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-check-circle fa-2x mb-2 d-block text-success opacity-50"></i>
                            No low-stock alerts.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Reorder Suggestions -->
    @if (Model.ReorderSuggestions.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-2 fw-semibold text-muted d-flex align-items-center">
                <i class="fas fa-cart-plus me-2 text-warning"></i>Reorder Suggestions
                <span class="badge bg-warning text-dark ms-2">@Model.ReorderSuggestions.Count</span>
                <span class="ms-auto text-muted fw-normal" style="font-size:11px">
                    <i class="fas fa-info-circle me-1"></i>Items at/below reorder level or running out within 7 days · Suggested qty = 14-day cover
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-3">Item</th>
                                <th class="text-end">Current Qty</th>
                                <th class="text-end">Avg / Day</th>
                                <th class="text-end">Days Left</th>
                                <th class="text-end">Suggested Order</th>
                                <th class="text-end pe-3">Last Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.ReorderSuggestions)
                            {
                                var rowClass   = s.DaysRemaining == 0   ? "table-danger"
                                              : s.DaysRemaining <= 3   ? "table-danger bg-opacity-25"
                                              : s.DaysRemaining <= 7   ? "table-warning bg-opacity-25"
                                              : "";
                                var daysColor  = s.DaysRemaining == 999 ? "text-muted"
                                              : s.DaysRemaining == 0   ? "text-danger fw-bold"
                                              : s.DaysRemaining <= 3   ? "text-danger fw-semibold"
                                              : s.DaysRemaining <= 7   ? "text-warning fw-semibold"
                                              : "text-success";
                                var daysLabel  = s.DaysRemaining == 999 ? "N/A" : s.DaysRemaining == 0 ? "Out!" : $"{s.DaysRemaining}d";
                                <tr class="@rowClass">
                                    <td class="ps-3">
                                        <div class="fw-semibold small">@s.ItemName</div>
                                        <div class="text-muted" style="font-size:.72rem">@s.GodownName</div>
                                    </td>
                                    <td class="text-end">
                                        <span class="@(s.BalanceQty <= 0 ? "text-danger fw-bold" : "")">@s.BalanceQty.ToString("N3") @s.UOMCode</span>
                                    </td>
                                    <td class="text-end text-muted small">
                                        @(s.AvgDailyConsumption > 0 ? s.AvgDailyConsumption.ToString("N3") + " " + s.UOMCode : "—")
                                    </td>
                                    <td class="text-end @daysColor">@daysLabel</td>
                                    <td class="text-end">
                                        @if (s.SuggestedOrderQty > 0)
                                        { <span class="badge bg-warning text-dark">@s.SuggestedOrderQty.ToString("N0") @s.UOMCode</span> }
                                        else
                                        { <span class="text-muted small">Sufficient</span> }
                                    </td>
                                    <td class="text-end pe-3 text-muted small">
                                        @(s.LastPurchasePrice > 0 ? "₹" + s.LastPurchasePrice.ToString("N2") : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white border-top py-2 px-3 d-flex gap-2">
                <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-warning btn-sm text-dark">
                    <i class="fas fa-file-invoice me-1"></i>Create Purchase Order
                </a>
                <a asp-action="Index" asp-controller="GRN" class="btn btn-outline-success btn-sm">
                    <i class="fas fa-clipboard-check me-1"></i>Receive GRN
                </a>
            </div>
        </div>
    }

</div>

@section Scripts {
<style>
    .hover-lift { transition: transform .18s, box-shadow .18s; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,.1) !important; }
</style>
<script>
// ── Quick Stock Check ────────────────────────────────────────────────────
let qsTimer = null;
$('#qsInput').on('input', function () {
    clearTimeout(qsTimer);
    const q = $(this).val().trim();
    if (q.length < 2) {
        $('#quickStockResult').html('<div class="text-muted small pt-1"><i class="fas fa-info-circle me-1"></i>Type at least 2 characters to search.</div>');
        return;
    }
    $('#quickStockResult').html('<div class="text-muted small pt-1"><i class="fas fa-spinner fa-spin me-1"></i>Searching…</div>');
    qsTimer = setTimeout(function () {
        $.getJSON('/Inventory/QuickStockCheck', { q: q }, function (data) {
            if (!data || data.length === 0) {
                $('#quickStockResult').html('<div class="alert alert-light py-2 mb-0 small"><i class="fas fa-search me-1"></i>No items found for "' + q + '".</div>');
                return;
            }
            let html = '<div class="d-flex flex-wrap gap-2">';
            data.forEach(function (item) {
                const isLow  = item.reorderLevel > 0 && item.balanceQty <= item.reorderLevel;
                const isOut  = item.balanceQty <= 0;
                const color  = isOut ? 'danger' : isLow ? 'warning' : 'success';
                const icon   = isOut ? 'fa-times-circle' : isLow ? 'fa-exclamation-circle' : 'fa-check-circle';
                let daysHtml = '';
                if (item.daysRemaining !== null) {
                    const dc = item.daysRemaining <= 3 ? 'danger' : item.daysRemaining <= 7 ? 'warning' : 'success';
                    daysHtml = ' <span class="badge bg-' + dc + '-subtle text-' + dc + '">' + item.daysRemaining + 'd left</span>';
                }
                html += '<div class="card border shadow-none p-2" style="min-width:190px;max-width:230px;">' +
                    '<div class="fw-semibold small">' + item.itemName +
                    (item.itemCode ? ' <span class="text-muted" style="font-size:10px">[' + item.itemCode + ']</span>' : '') + '</div>' +
                    '<div class="d-flex align-items-center gap-1 mt-1">' +
                    '<i class="fas ' + icon + ' text-' + color + ' small"></i>' +
                    '<span class="fw-bold text-' + color + ' small">' + parseFloat(item.balanceQty).toFixed(3) + ' ' + item.uomCode + '</span>' +
                    daysHtml + '</div>' +
                    '<div class="text-muted mt-1" style="font-size:10px">' +
                    '<i class="fas fa-warehouse me-1"></i>' + item.godownName +
                    ' | <i class="fas fa-tag me-1"></i>Avg: ₹' + parseFloat(item.averageCost).toFixed(2) +
                    (item.lastPurchaseDate ? ' | Last GRN: ' + item.lastPurchaseDate : '') +
                    '</div></div>';
            });
            html += '</div>';
            $('#quickStockResult').html(html);
        });
    }, 350);
});
</script>
}
