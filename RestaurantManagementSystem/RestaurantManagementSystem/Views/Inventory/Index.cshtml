@model RestaurantManagementSystem.Models.InventoryDashboardViewModel
@{
    ViewData["Title"] = "Inventory Dashboard";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="inv-page-header rounded-3 mb-4 px-4 py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="inv-header-icon">
                <i class="fas fa-boxes-stacked fa-lg"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-white">Inventory Dashboard</h5>
                <small class="text-white-50">Stock overview, alerts and activity summary</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="StockSummary" asp-controller="Inventory" class="btn btn-light btn-sm fw-semibold">
                <i class="fas fa-table me-1"></i>Stock Summary
            </a>
            <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-warning btn-sm fw-semibold text-dark">
                <i class="fas fa-file-invoice me-1"></i>New PO
            </a>
        </div>
    </div>

    @if (ViewBag.DashboardError != null)
    {
        <div class="alert alert-warning py-2 mb-3 rounded-3 border-0" style="background:#fef3c7;color:#92400e">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Dashboard stats unavailable – please run <code>inventory_complete_setup.sql</code> on your database first.
            <br /><small class="text-muted">@ViewBag.DashboardError</small>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 rounded-3 border-0 mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 rounded-3 border-0 mb-3" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Stock Value -->
        <div class="col-6 col-md-4 col-xl">
            <div class="inv-kpi-card inv-kpi-green h-100">
                <div class="inv-kpi-icon"><i class="fas fa-boxes-stacked"></i></div>
                <div class="inv-kpi-body">
                    <div class="inv-kpi-label">Total Stock Value</div>
                    <div class="inv-kpi-value text-success">₹@Model.TotalStockValue.ToString("N0")</div>
                </div>
            </div>
        </div>
        <!-- Low Stock -->
        <div class="col-6 col-md-4 col-xl">
            <div class="inv-kpi-card inv-kpi-red h-100">
                <div class="inv-kpi-icon @(Model.LowStockItems > 0 ? "inv-kpi-icon-pulse" : "")"><i class="fas fa-triangle-exclamation"></i></div>
                <div class="inv-kpi-body">
                    <div class="inv-kpi-label">Low Stock Items</div>
                    <div class="inv-kpi-value @(Model.LowStockItems > 0 ? "text-danger" : "text-success")">@Model.LowStockItems</div>
                </div>
            </div>
        </div>
        <!-- Pending GRN -->
        <div class="col-6 col-md-4 col-xl">
            <div class="inv-kpi-card inv-kpi-yellow h-100">
                <div class="inv-kpi-icon"><i class="fas fa-clipboard-check"></i></div>
                <div class="inv-kpi-body">
                    <div class="inv-kpi-label">Pending GRN</div>
                    <div class="inv-kpi-value text-warning">@Model.PendingGRN</div>
                </div>
            </div>
        </div>
        <!-- Today's Purchase -->
        <div class="col-6 col-md-4 col-xl">
            <div class="inv-kpi-card inv-kpi-violet h-100">
                <div class="inv-kpi-icon"><i class="fas fa-shopping-cart"></i></div>
                <div class="inv-kpi-body">
                    <div class="inv-kpi-label">Today's Purchase</div>
                    <div class="inv-kpi-value" style="color:#7c3aed">₹@Model.TodayPurchase.ToString("N0")</div>
                </div>
            </div>
        </div>
        <!-- Today's Consumption -->
        <div class="col-6 col-md-4 col-xl">
            <div class="inv-kpi-card inv-kpi-orange h-100">
                <div class="inv-kpi-icon"><i class="fas fa-fire-flame-curved"></i></div>
                <div class="inv-kpi-body">
                    <div class="inv-kpi-label">Today's Consumption</div>
                    <div class="inv-kpi-value text-danger">₹@Model.TodayConsumption.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Purchase vs Consumption Bar -->
    @{
        var purchaseVal    = (double)Model.TodayPurchase;
        var consumptionVal = (double)Model.TodayConsumption;
        var maxBarVal      = Math.Max(purchaseVal, consumptionVal);
        var purchasePct    = maxBarVal > 0 ? (int)Math.Round(purchaseVal    / maxBarVal * 100) : 0;
        var consumptionPct = maxBarVal > 0 ? (int)Math.Round(consumptionVal / maxBarVal * 100) : 0;
    }
    <div class="inv-section-card mb-4">
        <div class="inv-section-header">
            <span><i class="fas fa-balance-scale me-2"></i>Today: Purchase vs Consumption</span>
            <span class="inv-section-badge">
                @if (purchaseVal > consumptionVal && purchaseVal > 0)
                { <span class="text-success fw-semibold"><i class="fas fa-arrow-up me-1"></i>Purchased more than consumed</span> }
                else if (consumptionVal > 0 && consumptionVal > purchaseVal)
                { <span class="text-warning fw-semibold"><i class="fas fa-fire me-1"></i>Consumption exceeds purchase</span> }
                else
                { <span class="text-muted">No activity today</span> }
            </span>
        </div>
        <div class="card-body py-3 px-4">
            <div class="row g-3 align-items-center">
                <div class="col-auto text-end" style="width:150px">
                    <div class="inv-bar-label" style="color:#7c3aed"><i class="fas fa-shopping-cart me-1"></i>Purchase</div>
                    <div class="inv-bar-value" style="color:#7c3aed">₹@Model.TodayPurchase.ToString("N0")</div>
                </div>
                <div class="col">
                    <div class="inv-progress-wrap mb-2">
                        <div class="inv-progress-bar" style="width:@purchasePct%;background:linear-gradient(90deg,#7c3aed,#a855f7)" title="₹@Model.TodayPurchase.ToString("N0")"></div>
                    </div>
                    <div class="inv-progress-wrap">
                        <div class="inv-progress-bar" style="width:@consumptionPct%;background:linear-gradient(90deg,#ef4444,#f97316)" title="₹@Model.TodayConsumption.ToString("N0")"></div>
                    </div>
                </div>
                <div class="col-auto" style="width:150px">
                    <div class="inv-bar-label text-danger"><i class="fas fa-fire me-1"></i>Consumption</div>
                    <div class="inv-bar-value text-danger">₹@Model.TodayConsumption.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: Quick Stock Check -->
    <div class="inv-section-card mb-4">
        <div class="inv-section-header">
            <span><i class="fas fa-magnifying-glass me-2"></i>Quick Stock Check</span>
            <span class="inv-section-badge text-muted">Search any ingredient instantly</span>
        </div>
        <div class="card-body py-3 px-4">
            <div class="row g-2 align-items-start">
                <div class="col-md-3">
                    <div class="input-group input-group-sm inv-search-group">
                        <span class="input-group-text"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="qsInput" class="form-control" placeholder="Type ingredient name…" autocomplete="off">
                    </div>
                </div>
                <div class="col-md-9" id="quickStockResult">
                    <div class="text-muted small pt-1"><i class="fas fa-info-circle me-1"></i>Type at least 2 characters to search.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 4: Module Shortcuts -->
    <div class="inv-section-card mb-4">
        <div class="inv-section-header">
            <span><i class="fas fa-th-large me-2"></i>Quick Access</span>
        </div>
        <div class="card-body py-3 px-3">
            <div class="row g-2">
                @{
                    var modules = new[] {
                        ("Purchase Orders",    "fa-file-invoice",   "PurchaseOrder", "Index",        "#7c3aed", "#ede9fe"),
                        ("Goods Receipt (GRN)","fa-clipboard-check","GRN",           "Index",        "#16a34a", "#dcfce7"),
                        ("Stock Transfer",     "fa-exchange-alt",   "StockTransfer", "Index",        "#0891b2", "#e0f2fe"),
                        ("Damage Entry",       "fa-trash-alt",      "DamageEntry",   "Index",        "#dc2626", "#fee2e2"),
                        ("Stock Ledger",       "fa-book",           "Inventory",     "StockLedger",  "#374151", "#f3f4f6"),
                        ("Opening Stock",      "fa-layer-group",    "Inventory",     "OpeningStock", "#6b7280", "#f9fafb"),
                        ("Stock Valuation",    "fa-balance-scale",  "Inventory",     "StockValuation","#d97706","#fef3c7"),
                        ("Suppliers",          "fa-truck",          "Inventory",     "Suppliers",    "#0284c7", "#e0f2fe"),
                    };
                }
                @foreach (var (title, icon, ctrl, action, fgColor, bgColor) in modules)
                {
                    <div class="col-6 col-md-3">
                        <a asp-controller="@ctrl" asp-action="@action" class="inv-module-btn text-decoration-none d-flex align-items-center gap-3 p-3 rounded-3 h-100"
                           style="background:@bgColor">
                            <span class="inv-module-icon rounded-2 d-flex align-items-center justify-content-center" style="background:@fgColor;width:36px;height:36px;min-width:36px">
                                <i class="fas @icon text-white"></i>
                            </span>
                            <span class="fw-semibold small" style="color:@fgColor">@title</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bottom Row: Top Consumed + Low Stock Alerts -->
    <div class="row g-3 mb-4">
        <!-- Top Consumed Items -->
        <div class="col-md-6">
            <div class="inv-section-card h-100">
                <div class="inv-section-header">
                    <span><i class="fas fa-fire me-2 text-danger"></i>Top Consumed Items <span class="text-muted fw-normal">(Today)</span></span>
                    <span class="inv-section-badge"><span class="badge" style="background:#7c3aed22;color:#7c3aed;font-size:10px;font-weight:600">POS &amp; All Orders</span></span>
                </div>
                <div class="card-body p-3">
                    @if (Model.TopConsumedItems.Any())
                    {
                        var maxConsumed = Model.TopConsumedItems.Max(x => x.TotalConsumed);
                        int rank = 0;
                        string[] rankColors = { "#f59e0b", "#9ca3af", "#ef4444", "#6b7280", "#6b7280" };
                        string[] rankIcons  = { "fa-trophy", "fa-medal", "fa-award", "fa-star", "fa-star" };
                        @foreach (var item in Model.TopConsumedItems)
                        {
                            var pct = maxConsumed > 0 ? (int)Math.Round(item.TotalConsumed / maxConsumed * 100) : 0;
                            <div class="inv-consumed-row mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas @rankIcons[rank] small" style="color:@rankColors[rank]"></i>
                                        <span class="fw-semibold small">@item.ItemName</span>
                                        @if (!string.IsNullOrEmpty(item.ItemCode))
                                        {
                                            <span class="text-muted" style="font-size:10px">[@item.ItemCode]</span>
                                        }
                                    </div>
                                    <span class="badge" style="background:#fee2e2;color:#dc2626;font-size:11px">@item.TotalConsumed.ToString("N3") @item.UOMCode</span>
                                </div>
                                <div class="inv-mini-progress">
                                    <div class="inv-mini-bar" style="width:@pct%;background:linear-gradient(90deg,#ef4444,#f97316)"></div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <div class="inv-empty-state py-4">
                            <i class="fas fa-fire fa-2x mb-2 d-block opacity-25"></i>
                            <p class="mb-1 small fw-semibold">No consumption data for today.</p>
                            <p class="mb-0" style="font-size:11px">Data will appear once any order is completed today.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="col-md-6">
            <div class="inv-section-card h-100">
                <div class="inv-section-header">
                    <span><i class="fas fa-bell me-2 text-warning"></i>Low Stock Alerts</span>
                    @if (Model.LowStockAlerts.Any())
                    {
                        <span class="badge bg-danger ms-1">@Model.LowStockAlerts.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.LowStockAlerts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle inv-table">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Item</th>
                                        <th class="text-end">Balance</th>
                                        <th class="text-end">Reorder</th>
                                        <th class="text-end pe-3">Days Left</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.LowStockAlerts)
                                    {
                                        var daysClass = a.DaysRemaining == 999 ? "inv-badge-neutral"
                                                      : a.DaysRemaining <= 3   ? "inv-badge-danger"
                                                      : a.DaysRemaining <= 7   ? "inv-badge-warn"
                                                      : "inv-badge-ok";
                                        var daysLabel = a.DaysRemaining == 999 ? "N/A" : $"{a.DaysRemaining}d";
                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-semibold text-danger small">@a.ItemName</div>
                                                <div class="text-muted" style="font-size:.72rem">@a.GodownName</div>
                                            </td>
                                            <td class="text-end">
                                                <span class="inv-badge-danger">@a.BalanceQty.ToString("0.######") @a.UOMCode</span>
                                            </td>
                                            <td class="text-end text-muted small">@(a.ReorderLevel?.ToString("N2") ?? "—")</td>
                                            <td class="text-end pe-3">
                                                <span class="@daysClass px-2">@daysLabel</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="inv-empty-state py-4">
                            <i class="fas fa-check-circle fa-2x mb-2 d-block text-success opacity-50"></i>
                            <p class="mb-0 small">All stock levels are healthy.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Reorder Suggestions -->
    @if (Model.ReorderSuggestions.Any())
    {
        <div class="inv-section-card mb-4">
            <div class="inv-section-header">
                <span><i class="fas fa-cart-plus me-2"></i>Reorder Suggestions <span class="badge bg-warning text-dark ms-1">@Model.ReorderSuggestions.Count</span></span>
                <span class="inv-section-badge text-muted"><i class="fas fa-info-circle me-1"></i>Items at/below reorder level or running out within 7 days · Suggested qty = 14-day cover</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0 align-middle inv-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Item</th>
                                <th class="text-end">Current Qty</th>
                                <th class="text-end">Avg / Day</th>
                                <th class="text-end">Days Left</th>
                                <th class="text-end">Suggested Order</th>
                                <th class="text-end pe-3">Last Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.ReorderSuggestions)
                            {
                                var rowClass   = s.DaysRemaining == 0   ? "inv-row-critical"
                                              : s.DaysRemaining <= 3   ? "inv-row-danger"
                                              : s.DaysRemaining <= 7   ? "inv-row-warn"
                                              : "";
                                var daysColor  = s.DaysRemaining == 999 ? "text-muted"
                                              : s.DaysRemaining == 0   ? "text-danger fw-bold"
                                              : s.DaysRemaining <= 3   ? "text-danger fw-semibold"
                                              : s.DaysRemaining <= 7   ? "text-warning fw-semibold"
                                              : "text-success";
                                var daysLabel  = s.DaysRemaining == 999 ? "N/A" : s.DaysRemaining == 0 ? "Out!" : $"{s.DaysRemaining}d";
                                <tr class="@rowClass">
                                    <td class="ps-3">
                                        <div class="fw-semibold small">@s.ItemName</div>
                                        <div class="text-muted" style="font-size:.72rem">@s.GodownName</div>
                                    </td>
                                    <td class="text-end">
                                        <span class="@(s.BalanceQty <= 0 ? "text-danger fw-bold" : "text-dark small")">@s.BalanceQty.ToString("0.######") @s.UOMCode</span>
                                    </td>
                                    <td class="text-end text-muted small">
                                        @(s.AvgDailyConsumption > 0 ? s.AvgDailyConsumption.ToString("0.######") + " " + s.UOMCode : "—")
                                    </td>
                                    <td class="text-end @daysColor small">@daysLabel</td>
                                    <td class="text-end">
                                        @if (s.SuggestedOrderQty > 0)
                                        { <span class="badge bg-warning text-dark">@s.SuggestedOrderQty.ToString("N0") @s.UOMCode</span> }
                                        else
                                        { <span class="text-muted small">Sufficient</span> }
                                    </td>
                                    <td class="text-end pe-3 text-muted small">
                                        @(s.LastPurchasePrice > 0 ? "₹" + s.LastPurchasePrice.ToString("N2") : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="inv-section-footer d-flex gap-2 px-3 py-2">
                <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-sm fw-semibold text-white" style="background:#7c3aed">
                    <i class="fas fa-file-invoice me-1"></i>Create Purchase Order
                </a>
                <a asp-action="Index" asp-controller="GRN" class="btn btn-sm btn-outline-success fw-semibold">
                    <i class="fas fa-clipboard-check me-1"></i>Receive GRN
                </a>
            </div>
        </div>
    }

</div>

@section Scripts {
<style>
/* ── Page Header ──────────────────────────────────────────── */
.inv-page-header {
    background: linear-gradient(135deg, #1e0a4a 0%, #2a106d 60%, #4a1fa8 100%);
    box-shadow: 0 4px 20px rgba(42,16,109,.35);
}
.inv-header-icon {
    width: 46px; height: 46px; min-width: 46px;
    border-radius: 12px;
    background: rgba(255,255,255,.15);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    backdrop-filter: blur(4px);
}

/* ── KPI Cards ────────────────────────────────────────────── */
.inv-kpi-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,.07);
    display: flex; align-items: center; gap: 16px;
    padding: 16px 18px;
    border-top: 3.5px solid transparent;
    transition: transform .18s, box-shadow .18s;
}
.inv-kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.12); }
.inv-kpi-green  { border-top-color: #16a34a; }
.inv-kpi-red    { border-top-color: #dc2626; }
.inv-kpi-yellow { border-top-color: #d97706; }
.inv-kpi-violet { border-top-color: #7c3aed; }
.inv-kpi-orange { border-top-color: #ea580c; }

.inv-kpi-icon {
    width: 48px; height: 48px; min-width: 48px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
}
.inv-kpi-green  .inv-kpi-icon { background: #dcfce7; color: #16a34a; }
.inv-kpi-red    .inv-kpi-icon { background: #fee2e2; color: #dc2626; }
.inv-kpi-yellow .inv-kpi-icon { background: #fef3c7; color: #d97706; }
.inv-kpi-violet .inv-kpi-icon { background: #ede9fe; color: #7c3aed; }
.inv-kpi-orange .inv-kpi-icon { background: #ffedd5; color: #ea580c; }

.inv-kpi-icon-pulse { animation: inv-pulse 1.6s infinite; }
@@keyframes inv-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,.35); }
    50%       { box-shadow: 0 0 0 8px rgba(220,38,38,0); }
}
.inv-kpi-label { font-size: 12px; color: #6b7280; font-weight: 500; }
.inv-kpi-value { font-size: 22px; font-weight: 700; line-height: 1.2; margin-top: 2px; }

/* ── Uniform Section Cards ────────────────────────────────── */
.inv-section-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,.07);
    border: none;
    overflow: hidden;
}
.inv-section-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 18px;
    background: linear-gradient(90deg, #f5f3ff 0%, #fff 100%);
    border-bottom: 1.5px solid #ede9fe;
    font-weight: 600; font-size: 13.5px; color: #2a106d;
    flex-wrap: wrap; gap: 6px;
}
.inv-section-badge { font-size: 11px; font-weight: 400; }
.inv-section-footer {
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
}

/* ── Bar Chart ────────────────────────────────────────────── */
.inv-bar-label { font-size: 12px; font-weight: 600; }
.inv-bar-value { font-size: 18px; font-weight: 700; }
.inv-progress-wrap {
    height: 13px; border-radius: 8px;
    background: #f3f4f6;
    overflow: hidden;
    margin-bottom: 6px;
}
.inv-progress-bar {
    height: 100%; border-radius: 8px;
    transition: width .6s cubic-bezier(.4,0,.2,1);
}

/* ── Quick Search ─────────────────────────────────────────── */
.inv-search-group .input-group-text {
    background: #fff;
    border-right: 0;
    border-color: #d1d5db;
}
.inv-search-group .form-control {
    border-left: 0;
    border-color: #d1d5db;
    box-shadow: none;
}
.inv-search-group .form-control:focus { border-color: #7c3aed; }

/* ── Module Buttons ───────────────────────────────────────── */
.inv-module-btn {
    transition: transform .18s, box-shadow .18s;
    border: 1.5px solid transparent !important;
}
.inv-module-btn:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,.1); }

/* ── Tables ───────────────────────────────────────────────── */
.inv-table thead th {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; color: #6b7280;
    background: #f9fafb; border-bottom: 2px solid #e5e7eb;
    padding: 10px 8px;
}
.inv-table tbody tr { border-bottom: 1px solid #f3f4f6; }
.inv-table tbody tr:hover { background: #faf5ff; }
.inv-row-critical { background: #fef2f2 !important; }
.inv-row-danger   { background: #fff7f7 !important; }
.inv-row-warn     { background: #fffbeb !important; }

/* ── Badges ───────────────────────────────────────────────── */
.inv-badge-danger  { display:inline-block; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600; background:#fee2e2; color:#dc2626; }
.inv-badge-warn    { display:inline-block; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600; background:#fef3c7; color:#d97706; }
.inv-badge-ok      { display:inline-block; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600; background:#dcfce7; color:#16a34a; }
.inv-badge-neutral { display:inline-block; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600; background:#f3f4f6; color:#6b7280; }

/* ── Mini Progress ────────────────────────────────────────── */
.inv-mini-progress { height: 5px; border-radius: 4px; background: #f3f4f6; overflow: hidden; }
.inv-mini-bar      { height: 100%; border-radius: 4px; }

/* ── Empty State ──────────────────────────────────────────── */
.inv-empty-state { text-align: center; color: #9ca3af; padding: 24px 16px; }
</style>
<script>
// ── Quick Stock Check ────────────────────────────────────────────────────
let qsTimer = null;
$('#qsInput').on('input', function () {
    clearTimeout(qsTimer);
    const q = $(this).val().trim();
    if (q.length < 2) {
        $('#quickStockResult').html('<div class="text-muted small pt-1"><i class="fas fa-info-circle me-1"></i>Type at least 2 characters to search.</div>');
        return;
    }
    $('#quickStockResult').html('<div class="text-muted small pt-1"><i class="fas fa-spinner fa-spin me-1"></i>Searching…</div>');
    qsTimer = setTimeout(function () {
        $.getJSON('/Inventory/QuickStockCheck', { q: q }, function (data) {
            if (!data || data.length === 0) {
                $('#quickStockResult').html('<div class="alert alert-light py-2 mb-0 small"><i class="fas fa-search me-1"></i>No items found for "' + q + '".</div>');
                return;
            }
            let html = '<div class="d-flex flex-wrap gap-2">';
            data.forEach(function (item) {
                const isLow  = item.reorderLevel > 0 && item.balanceQty <= item.reorderLevel;
                const isOut  = item.balanceQty <= 0;
                const fg     = isOut ? '#dc2626' : isLow ? '#d97706' : '#16a34a';
                const bg     = isOut ? '#fee2e2' : isLow ? '#fef3c7' : '#dcfce7';
                const icon   = isOut ? 'fa-times-circle' : isLow ? 'fa-exclamation-circle' : 'fa-check-circle';
                let daysHtml = '';
                if (item.daysRemaining !== null) {
                    const dc = item.daysRemaining <= 3 ? '#dc2626' : item.daysRemaining <= 7 ? '#d97706' : '#16a34a';
                    daysHtml = ' <span style="background:' + dc + '22;color:' + dc + ';padding:1px 7px;border-radius:20px;font-size:10px;font-weight:600">' + item.daysRemaining + 'd left</span>';
                }
                html += '<div class="inv-section-card p-2" style="min-width:190px;max-width:230px;border-radius:10px">' +
                    '<div class="fw-semibold small">' + item.itemName +
                    (item.itemCode ? ' <span class="text-muted" style="font-size:10px">[' + item.itemCode + ']</span>' : '') + '</div>' +
                    '<div class="d-flex align-items-center gap-1 mt-1">' +
                    '<i class="fas ' + icon + ' small" style="color:' + fg + '"></i>' +
                    '<span class="fw-bold small" style="color:' + fg + '">' + parseFloat(item.balanceQty).toFixed(3) + ' ' + item.uomCode + '</span>' +
                    daysHtml + '</div>' +
                    '<div class="text-muted mt-1" style="font-size:10px">' +
                    '<i class="fas fa-warehouse me-1"></i>' + item.godownName +
                    ' | <i class="fas fa-tag me-1"></i>Avg: ₹' + parseFloat(item.averageCost).toFixed(2) +
                    (item.lastPurchaseDate ? ' | Last GRN: ' + item.lastPurchaseDate : '') +
                    '</div></div>';
            });
            html += '</div>';
            $('#quickStockResult').html(html);
        });
    }, 350);
});
</script>
}
