@model IEnumerable<RestaurantManagementSystem.Models.PurchaseRegisterItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Purchase Register";
    var dateFrom          = ViewBag.FromDate   as string ?? DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    var dateTo            = ViewBag.ToDate     as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var selSupplier       = (int?)(ViewBag.SupplierId) ?? 0;
    var suppliers         = ViewBag.Suppliers as List<SelectListItem> ?? new List<SelectListItem>();
    bool isMainBranchAdmin = (bool)(ViewBag.IsMainBranchAdmin ?? false);
    var allBranches        = ViewBag.AllBranches as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedBranchIds  = ViewBag.SelectedBranchIds as List<int> ?? new List<int>();
    var totalAmt   = Model.Sum(x => x.SubTotal);
    var totalGst   = Model.Sum(x => x.TotalGSTAmount);
    var totalNet   = Model.Sum(x => x.TotalAmount);
}

<style>
    .purchase-register-page .pr-topbar {
        gap: 1rem;
    }
    .purchase-register-page .pr-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        justify-content: flex-end;
    }
    .purchase-register-page .pr-actions .btn,
    .purchase-register-page .pr-filter .btn,
    .purchase-register-page .pr-filter .form-select,
    .purchase-register-page .pr-filter .form-control {
        min-height: 38px;
    }
    .purchase-register-page .pr-summary-card .card-body {
        min-height: 100%;
    }
    .purchase-register-page .table-responsive {
        -webkit-overflow-scrolling: touch;
    }
    .purchase-register-page .dataTables_wrapper .dataTables_filter input,
    .purchase-register-page .dataTables_wrapper .dataTables_length select {
        min-height: 38px;
    }

    @@media (max-width: 991.98px) {
        .purchase-register-page .pr-topbar {
            flex-direction: column;
            align-items: stretch !important;
        }
        .purchase-register-page .pr-actions {
            justify-content: flex-start;
        }
        .purchase-register-page .pr-filter .col-auto {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }
        .purchase-register-page .pr-filter .col-auto .btn {
            flex: 1 1 auto;
        }
    }

    @@media (max-width: 767.98px) {
        .purchase-register-page .pr-actions > * {
            flex: 1 1 calc(50% - .5rem);
            justify-content: center;
        }
        .purchase-register-page .pr-filter .col-auto {
            width: 100%;
        }
        .purchase-register-page .pr-filter .col-auto .btn {
            flex: 1 1 0;
        }
        .purchase-register-page .dataTables_wrapper .dataTables_length,
        .purchase-register-page .dataTables_wrapper .dataTables_filter {
            float: none !important;
            text-align: left !important;
            width: 100%;
            margin-bottom: .75rem;
        }
        .purchase-register-page .dataTables_wrapper .dataTables_length label,
        .purchase-register-page .dataTables_wrapper .dataTables_filter label {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }
        .purchase-register-page .dataTables_wrapper .dataTables_filter input,
        .purchase-register-page .dataTables_wrapper .dataTables_length select {
            width: 100% !important;
            max-width: none;
            margin-left: 0 !important;
        }
        .purchase-register-page .table-responsive {
            overflow: visible;
        }
        .purchase-register-page #tblPR thead {
            display: none;
        }
        .purchase-register-page #tblPR tbody {
            display: block;
        }
        .purchase-register-page #tblPR tr {
            display: block;
            margin: .85rem;
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: .85rem;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
        }
        .purchase-register-page #tblPR td {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: .75rem;
            width: 100%;
            text-align: left !important;
            padding: .6rem .75rem !important;
            border: 0;
            border-top: 1px solid rgba(15, 23, 42, .06);
        }
        .purchase-register-page #tblPR td:first-child {
            border-top: 0;
        }
        .purchase-register-page #tblPR td::before {
            content: attr(data-label);
            flex: 0 0 96px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
        }
        .purchase-register-page #tblPR td[data-label="Details"] {
            align-items: center;
        }
    }
</style>

<div class="container-fluid px-0 purchase-register-page">
    <div class="d-flex align-items-center justify-content-between mb-3 pr-topbar">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-receipt me-2 text-primary"></i>Purchase Register</h4>
            <small class="text-muted">All GRN-based purchase transactions</small>
        </div>
        <div class="pr-actions">
            <a asp-action="PurchaseRegisterDetails" asp-controller="Inventory"
               asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-supplierId="@(selSupplier > 0 ? selSupplier.ToString() : "")"
               class="btn btn-outline-info btn-sm"><i class="fas fa-list-ul me-1"></i>Detailed Report</a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-1"></i>Print</button>
            <button id="btnExportExcel" class="btn btn-success btn-sm" title="Export to Excel"><i class="fas fa-file-excel me-1"></i>Excel</button>
            <button id="btnExportPdf" class="btn btn-danger btn-sm" title="Export to PDF"><i class="fas fa-file-pdf me-1"></i>PDF</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="get" asp-action="PurchaseRegister" asp-controller="Inventory" class="row g-2 align-items-end pr-filter">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold mb-1">Supplier</label>
                    <select name="supplierId" class="form-select form-select-sm">
                        <option value="0">All Suppliers</option>
                        @foreach (var s in suppliers)
                        {
                            if (s.Value == selSupplier.ToString())
                            { <option value="@s.Value" selected="selected">@s.Text</option> }
                            else
                            { <option value="@s.Value">@s.Text</option> }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1">From Date</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@dateFrom" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1">To Date</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@dateTo" />
                </div>
                @if (isMainBranchAdmin)
                {
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold mb-1">Branches</label>
                        <div class="dropdown" id="branchSelectorDropdown">
                            <button class="btn btn-outline-info btn-sm dropdown-toggle w-100 text-start" type="button"
                                    data-bs-auto-close="outside" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-code-branch me-1"></i>
                                <span id="branchDropdownLabel">All Branches</span>
                            </button>
                            <div class="dropdown-menu p-2" style="min-width:240px" id="branchDropdownMenu">
                                <div class="d-flex gap-2 mb-1">
                                    <button type="button" class="btn btn-sm btn-link p-0 small" onclick="selectAllBranches(true)">All</button>
                                    <span>&middot;</span>
                                    <button type="button" class="btn btn-sm btn-link p-0 small" onclick="selectAllBranches(false)">None</button>
                                </div>
                                <hr class="my-1">
                                @foreach (var b in allBranches)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input branch-chk" type="checkbox" name="branchIds"
                                               value="@b.Value" id="bchk_@b.Value"
                                               @(selectedBranchIds.Contains(int.Parse(b.Value)) ? "checked" : "")>
                                        <label class="form-check-label" for="bchk_@b.Value">@b.Text</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="col-12 col-md-auto">
                    <button type="submit" class="btn btn-primary btn-sm px-3"><i class="fas fa-filter me-1"></i>Apply</button>
                    <a asp-action="PurchaseRegister" asp-controller="Inventory" class="btn btn-outline-secondary btn-sm ms-1"><i class="fas fa-sync me-1"></i>Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-primary border-3 pr-summary-card"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Total Transactions</small>
                <span class="fs-4 fw-bold text-primary">@Model.Count()</span>
            </div></div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-info border-3 pr-summary-card"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Taxable Amount</small>
                <span class="fs-5 fw-bold text-info">₹@totalAmt.ToString("N2")</span>
            </div></div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-warning border-3 pr-summary-card"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Total GST</small>
                <span class="fs-5 fw-bold text-warning">₹@totalGst.ToString("N2")</span>
            </div></div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-success border-3 pr-summary-card"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Net Purchase Amount</small>
                <span class="fs-5 fw-bold text-success">₹@totalNet.ToString("N2")</span>
            </div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblPR" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">GRN No.</th>
                            <th>Date</th>
                            <th>Invoice No</th>
                            <th>PO No</th>
                            <th>Supplier</th>
                            <th>Godown</th>
                            @if (isMainBranchAdmin)
                            {
                                <th>Branch</th>
                            }
                            <th class="text-end">Sub Total</th>
                            <th class="text-end">GST Amt</th>
                            <th class="text-end pe-3">Net Amt</th>
                            <th class="text-center">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold small" data-label="GRN No.">@r.GRNNumber</td>
                                <td class="text-muted small" data-label="Date" data-order="@r.GRNDate.ToString("yyyy-MM-dd")">@r.GRNDate.ToString("dd MMM yyyy")</td>
                                <td class="text-muted small" data-label="Invoice No">@(r.InvoiceNo ?? "—")</td>
                                <td class="text-muted small" data-label="PO No">@(r.PONumber ?? "—")</td>
                                <td data-label="Supplier">@r.SupplierName</td>
                                <td data-label="Godown"><span class="badge bg-info-subtle text-info small">@r.GodownName</span></td>
                                @if (isMainBranchAdmin)
                                {
                                    <td class="text-nowrap small" data-label="Branch">@r.BranchName</td>
                                }
                                <td class="text-end" data-label="Sub Total">₹@r.SubTotal.ToString("N2")</td>
                                <td class="text-end text-warning" data-label="GST Amt">₹@r.TotalGSTAmount.ToString("N2")</td>
                                <td class="text-end pe-3 fw-semibold" data-label="Net Amt">₹@r.TotalAmount.ToString("N2")</td>
                                <td class="text-center" data-label="Details">
                                    <a asp-action="PurchaseRegisterDetails" asp-controller="Inventory"
                                       asp-route-grnId="@r.GRNId"
                                       asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-supplierId="@(selSupplier > 0 ? selSupplier.ToString() : "")"
                                       class="btn btn-outline-primary btn-sm py-0 px-2" title="View Line Items">
                                        <i class="fas fa-list-ul me-1"></i>Items
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-receipt fa-3x mb-3 d-block opacity-25"></i>
                <p>No purchase transactions found for the selected filters.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        var table = $('#tblPR').DataTable({
            paging: true, pageLength: 50, searching: true, ordering: true,
            order: [[1,'desc']],
            autoWidth: false,
            buttons: [
                { extend: 'excelHtml5', title: 'Purchase Register', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', title: 'Purchase Register', orientation: 'landscape', pageSize: 'A4', exportOptions: { columns: ':visible' } }
            ]
        });
        $('#btnExportExcel').on('click', function () { table.button(0).trigger(); });
        $('#btnExportPdf').on('click', function () { table.button(1).trigger(); });
    });

    function selectAllBranches(checked) {
        document.querySelectorAll('.branch-chk').forEach(cb => cb.checked = checked);
        updateBranchLabel();
    }

    function updateBranchLabel() {
        const total   = document.querySelectorAll('.branch-chk').length;
        const checked = document.querySelectorAll('.branch-chk:checked').length;
        const label   = document.getElementById('branchDropdownLabel');
        if (!label) return;
        label.textContent = checked === 0 || checked === total ? 'All Branches' : checked + ' Branch(es) Selected';
    }

    document.querySelectorAll('.branch-chk').forEach(cb => cb.addEventListener('change', updateBranchLabel));
    updateBranchLabel();
</script>
}
