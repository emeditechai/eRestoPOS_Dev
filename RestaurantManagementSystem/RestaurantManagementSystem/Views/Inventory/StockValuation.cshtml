@model IEnumerable<RestaurantManagementSystem.Models.StockValuationItem>
@{
    ViewData["Title"] = "Stock Valuation Report";
    var godownId  = (int)(ViewBag.GodownId ?? 0);
    var godowns   = ViewBag.Godowns as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;

    var list      = Model.ToList();
    var totalVal  = list.Sum(x => x.StockValue ?? 0);
    var posCount  = list.Count(x => x.BalanceQty > 0);
    var zeroCount = list.Count(x => x.BalanceQty <= 0);
    var catCount  = list.Select(x => string.IsNullOrWhiteSpace(x.ItemCategory) ? "Uncategorised" : x.ItemCategory).Distinct().Count();

    var grouped = list
        .OrderBy(x => x.ItemCategory ?? "Uncategorised")
        .ThenBy(x => x.ItemName)
        .GroupBy(x => string.IsNullOrWhiteSpace(x.ItemCategory) ? "Uncategorised" : x.ItemCategory)
        .ToList();
}

<style>
    .val-table { width: 100%; border-collapse: collapse; font-size: 0.83rem; }
    .val-table thead tr.hdr-main th {
        background: #1e3a5f; color: #fff; font-weight: 700;
        font-size: 0.72rem; text-transform: uppercase; letter-spacing: .03em;
        padding: 9px 10px; border: none; white-space: nowrap;
    }
    .val-table tbody tr.row-cat-header {
        background: #eff6ff; border-top: 2px solid #93c5fd;
        cursor: pointer; user-select: none;
    }
    .val-table tbody tr.row-cat-header td {
        padding: 8px 10px; font-weight: 700; font-size: 0.82rem;
        color: #1e3a5f; border-bottom: 1px solid #bfdbfe;
    }
    .val-table tbody tr.row-item td {
        padding: 7px 10px; border-bottom: 1px solid #f0f0f0; vertical-align: middle;
    }
    .val-table tbody tr.row-item:nth-child(even) { background: #f9fafb; }
    .val-table tbody tr.row-item:nth-child(odd)  { background: #fff; }
    .val-table tbody tr.row-item.zero-stock { background: #fef9c3 !important; }
    .val-table tfoot td {
        background: #1e3a5f; color: #fff; font-weight: 700;
        font-size: 0.82rem; padding: 10px 10px; border-top: 2px solid #60a5fa;
    }
    .grp-chevron {
        display: inline-flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; border-radius: 50%;
        background: rgba(59,130,246,.15); color: #3b82f6;
        font-size: 0.65rem; margin-right: 8px; transition: transform .2s ease; flex-shrink: 0;
    }
    .row-cat-header.collapsed .grp-chevron { transform: rotate(-90deg); }
    .cat-value-pill {
        background: #dbeafe; color: #1d4ed8; border-radius: 12px;
        padding: 2px 10px; font-size: 0.76rem; font-weight: 700;
    }
    .stat-card { border: none; border-radius: 12px; }
    .stat-card .card-body { padding: 14px 16px; }
    .stat-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
    .uom-badge { color: #6b7280; font-size: 0.76rem; }
    @@media print {
        .no-print { display: none !important; }
        .val-table { font-size: 0.72rem; }
    }
</style>

<div class="container-fluid px-0">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 no-print">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-calculator me-2 text-primary"></i>Stock Valuation Report</h4>
            <small class="text-muted">Inventory value using Weighted Average Cost method</small>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-print me-1"></i>Print
            </button>
            <button id="btnExportExcel" class="btn btn-success btn-sm">
                <i class="fas fa-file-excel me-1"></i>Excel
            </button>
            <a class="btn btn-danger btn-sm"
               href="@Url.Action("StockValuationPdf", "Inventory", new { godownId = godownId > 0 ? godownId : (int?)null })">
                <i class="fas fa-file-pdf me-1"></i>PDF
            </a>
        </div>
    </div>

    <!-- Filter -->
    <div class="card border-0 shadow-sm mb-3 no-print" style="border-radius:12px">
        <div class="card-body py-2 px-3">
            <form method="get" asp-action="StockValuation" asp-controller="Inventory"
                  class="d-flex gap-3 align-items-end flex-wrap">
                <div>
                    <label class="form-label small fw-semibold mb-1">Godown</label>
                    <select name="godownId" class="form-select form-select-sm" style="min-width:200px">
                        <option value="0" selected="@(godownId == 0 ? "selected" : null)">All Godowns</option>
                        @if (godowns != null)
                        {
                            foreach (var g in godowns)
                            {
                                <option value="@g.Value"
                                        selected="@(g.Value == godownId.ToString() ? "selected" : null)">
                                    @g.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="fas fa-filter me-1"></i>Apply
                </button>
                <a asp-action="StockValuation" asp-controller="Inventory" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-sync me-1"></i>Reset
                </a>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-3 no-print">
        <div class="col-6 col-md-3">
            <div class="stat-card card shadow-sm h-100" style="border-left:4px solid #3b82f6">
                <div class="card-body">
                    <p class="stat-label text-primary mb-1">Total Items</p>
                    <p class="fs-4 fw-bold text-primary mb-0">@list.Count</p>
                    <small class="text-muted">@catCount @(catCount == 1 ? "category" : "categories")</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card card shadow-sm h-100" style="border-left:4px solid #22c55e">
                <div class="card-body">
                    <p class="stat-label text-success mb-1">Total Stock Value</p>
                    <p class="fs-5 fw-bold text-success mb-0">₹@totalVal.ToString("N2")</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card card shadow-sm h-100" style="border-left:4px solid #06b6d4">
                <div class="card-body">
                    <p class="stat-label text-info mb-1">Valuation Method</p>
                    <p class="fw-bold text-info mb-0">Weighted Average</p>
                    <small class="text-muted">WAC</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card card shadow-sm h-100" style="border-left:4px solid #f59e0b">
                <div class="card-body">
                    <p class="stat-label text-warning mb-1">Positive Stock</p>
                    <p class="fs-4 fw-bold text-warning mb-0">@posCount</p>
                    @if (zeroCount > 0)
                    {
                        <small class="text-muted">@zeroCount zero/empty</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm" style="border-radius:12px">
        <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-2 px-3">
            <span class="fw-semibold text-muted small">
                <i class="fas fa-layer-group me-1 text-primary"></i>Valuation Details
                <span class="ms-2 badge bg-primary-subtle text-primary">@list.Count items</span>
            </span>
            <div class="d-flex gap-2 align-items-center no-print">
                <input type="search" id="stockSearch" class="form-control form-control-sm"
                       placeholder="Search item, godown…" style="width:220px" />
                <button id="btnCollapseAll" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-compress-alt me-1"></i>Collapse All
                </button>
            </div>
        </div>

        @if (!list.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-calculator fa-3x mb-3 d-block opacity-25"></i>
                <p>No valuation data found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="val-table" id="valTable">
                    <thead>
                        <tr class="hdr-main">
                            <th class="ps-3" style="width:23%">Item</th>
                            <th style="width:12%">Godown</th>
                            <th class="text-end" style="width:11%">Current Qty</th>
                            <th class="text-center" style="width:7%">UOM</th>
                            <th class="text-end" style="width:13%">Wtd Avg Cost</th>
                            <th class="text-end pe-3" style="width:14%">Stock Value</th>
                            <th class="text-end" style="width:10%">Value %</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ int catIdx = 0; }
                    @foreach (var cat in grouped)
                    {
                        var catKey  = $"cat-{catIdx}";
                        var catVal  = cat.Sum(x => x.StockValue ?? 0);
                        var catCnt  = cat.Count();
                        var catPct  = totalVal > 0 ? (catVal / totalVal * 100) : 0;
                        catIdx++;

                        <tr class="row-cat-header" data-cat="@catKey">
                            <td colspan="4">
                                <span class="grp-chevron"><i class="fas fa-chevron-down"></i></span>
                                <span class="fw-bold">@cat.Key</span>
                                <span class="ms-2 text-muted fw-normal small">(@catCnt @(catCnt == 1 ? "item" : "items"))</span>
                            </td>
                            <td colspan="3" class="text-end pe-3">
                                <span class="cat-value-pill">₹@catVal.ToString("N2")</span>
                                <span class="ms-2 text-muted small">@catPct.ToString("0.0")%</span>
                            </td>
                        </tr>

                        @foreach (var r in cat.OrderBy(x => x.ItemName))
                        {
                            bool isZero = r.BalanceQty <= 0;
                            decimal sv  = r.StockValue ?? 0;
                            decimal pct = totalVal > 0 ? (sv / totalVal * 100) : 0;
                            string srchData = $"{r.ItemName} {r.ItemCode} {r.GodownName} {r.ItemCategory}".ToLower();

                            <tr class="row-item grp-row @(isZero ? "zero-stock" : "")"
                                data-cat="@catKey" data-search="@srchData">
                                <td class="ps-3">
                                    <span class="fw-semibold text-dark">@r.ItemName</span>
                                    @if (!string.IsNullOrEmpty(r.ItemCode))
                                    {
                                        <small class="text-muted d-block" style="font-size:.72rem">@r.ItemCode</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info fw-semibold">@r.GodownName</span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(isZero ? "text-danger" : "text-dark")">
                                        @r.BalanceQty.ToString("0.###")
                                    </span>
                                </td>
                                <td class="text-center uom-badge">@r.UOMCode</td>
                                <td class="text-end text-muted small">₹@r.AverageCost.ToString("N4")</td>
                                <td class="text-end pe-3 fw-semibold @(isZero ? "text-muted" : "")">
                                    ₹@sv.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @if (!isZero && totalVal > 0)
                                    {
                                        <div class="d-flex align-items-center gap-1 justify-content-end">
                                            <div style="width:50px;height:6px;background:#e5e7eb;border-radius:3px;overflow:hidden">
                                                <div style="width:@Math.Min(pct,100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:#3b82f6;border-radius:3px"></div>
                                            </div>
                                            <small class="text-muted" style="font-size:.7rem">@pct.ToString("0.0")%</small>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="ps-3">Grand Total — @list.Count items</td>
                            <td></td>
                            <td></td>
                            <td class="text-end">Inventory Value</td>
                            <td class="text-end pe-3" style="color:#86efac">₹@totalVal.ToString("N2")</td>
                            <td class="text-end" style="color:#86efac">100%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
$(function () {
    function collapseGroup($hdr, collapse) {
        var cat = $hdr.data('cat');
        $hdr.toggleClass('collapsed', collapse);
        $('[data-cat="' + cat + '"].grp-row').toggle(!collapse);
    }

    $(document).on('click', '.row-cat-header', function () {
        collapseGroup($(this), !$(this).hasClass('collapsed'));
    });

    var allCollapsed = false;
    $('#btnCollapseAll').on('click', function () {
        allCollapsed = !allCollapsed;
        $('.row-cat-header').each(function () { collapseGroup($(this), allCollapsed); });
        $(this).html(allCollapsed
            ? '<i class="fas fa-expand-alt me-1"></i>Expand All'
            : '<i class="fas fa-compress-alt me-1"></i>Collapse All');
    });

    $('#stockSearch').on('input', function () {
        var q = $(this).val().trim().toLowerCase();
        if (!q) {
            $('.row-item').show();
            $('.row-cat-header').each(function () { collapseGroup($(this), false); });
            return;
        }
        $('.row-item').each(function () {
            $(this).toggle(($(this).data('search') || '').indexOf(q) >= 0);
        });
        $('.row-cat-header').each(function () {
            var cat = $(this).data('cat');
            var hasVisible = $('[data-cat="' + cat + '"].grp-row:visible').length > 0;
            $(this).toggle(hasVisible);
            if (hasVisible) collapseGroup($(this), false);
        });
    });

    $('#btnExportExcel').on('click', function () {
        var wasColl = [];
        $('.row-cat-header.collapsed').each(function () {
            wasColl.push($(this).data('cat'));
            collapseGroup($(this), false);
        });
        var wb = XLSX.utils.book_new();
        var ws = XLSX.utils.table_to_sheet(document.getElementById('valTable'), { raw: false });
        XLSX.utils.book_append_sheet(wb, ws, 'StockValuation');
        XLSX.writeFile(wb, 'StockValuation_@(DateTime.Today.ToString("yyyyMMdd")).xlsx');
        wasColl.forEach(function (cat) {
            collapseGroup($('[data-cat="' + cat + '"].row-cat-header'), true);
        });
    });
});
</script>
}
