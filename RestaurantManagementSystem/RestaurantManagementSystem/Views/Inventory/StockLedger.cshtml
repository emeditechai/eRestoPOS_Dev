        "GRN"                    => "tbg-grn",
        "OPENING"                => "tbg-opening",
        "TRANSFER_IN"            => "tbg-tfin",
        "TRANSFER_OUT"           => "tbg-tfout",
        "DAMAGE"                 => "tbg-damage",
        "SaleConsumption"        => "tbg-sale",
        "PRODUCTION_CONSUMPTION" => "tbg-bom",
        _                        => "tbg-other"
    };

    string GetTxnLabel(string type) => type switch {
        "GRN"                    => "GRN / Purchase",
        "OPENING"                => "Opening Stock",
        "TRANSFER_IN"            => "Transfer In",
        "TRANSFER_OUT"           => "Transfer Out",
        "DAMAGE"                 => "Damage",
        "SaleConsumption"        => "Sale Consumption",
        "PRODUCTION_CONSUMPTION" => "BOM Consumption",
        _                        => type
    };
}

@section Scripts {
<script>
$(document).ready(function () {

    // ── Toggle a single date group ────────────────────────────────────────
    function collapseGroup($header, collapse) {
        var grp   = $header.data('grp');
        var $rows = $('[data-grp="' + grp + '"].grp-row');
        if (collapse) {
            $rows.hide();
            $header.addClass('collapsed');
        } else {
            $rows.show();
            $header.removeClass('collapsed');
        }
    }

    // Click date-header → toggle
    $(document).on('click', '.row-date-header', function () {
        var $hdr = $(this);
        collapseGroup($hdr, !$hdr.hasClass('collapsed'));
        syncCollapseBtn();
    });

    // ── Collapse All / Expand All button ─────────────────────────────────
    function syncCollapseBtn() {
        var total     = $('.row-date-header').length;
        var collapsed = $('.row-date-header.collapsed').length;
        if (collapsed === total && total > 0) {
            $('#btnCollapseAll').html('<i class="fas fa-expand-alt me-1"></i>Expand All');
        } else {
            $('#btnCollapseAll').html('<i class="fas fa-compress-alt me-1"></i>Collapse All');
        }
    }

    $('#btnCollapseAll').on('click', function () {
        var collapsed = $('.row-date-header.collapsed').length;
        var total     = $('.row-date-header').length;
        var doCollapse = collapsed < total;
        $('.row-date-header').each(function () { collapseGroup($(this), doCollapse); });
        syncCollapseBtn();
    });

    // ── Excel Export: expand all → export → re-collapse ──────────────────
    $('#btnExportExcel').on('click', function () {
        var tbl = document.getElementById('tblLedger');
        if (!tbl) return;
        var $wasCollapsed = $('.row-date-header.collapsed');
        $wasCollapsed.each(function () { collapseGroup($(this), false); });

        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" ' +
                   'xmlns:x="urn:schemas-microsoft-com:office:excel">' +
                   '<head><meta charset="utf-8"/></head><body>' + tbl.outerHTML + '</body></html>';
        var blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'StockLedger_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(link.href);

        $wasCollapsed.each(function () { collapseGroup($(this), true); });
    });

});
</script>
}
