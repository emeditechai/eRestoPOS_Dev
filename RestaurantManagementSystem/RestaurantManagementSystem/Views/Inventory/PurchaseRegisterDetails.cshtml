@model IEnumerable<RestaurantManagementSystem.Models.PurchaseRegisterDetailItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Purchase Register – Detailed";
    var dateFrom    = ViewBag.FromDate   as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo      = ViewBag.ToDate     as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var selSupplier = (int?)(ViewBag.SupplierId) ?? 0;
    var selGrnId    = (int?)(ViewBag.GrnId)      ?? 0;
    var suppliers   = ViewBag.Suppliers as List<SelectListItem> ?? new List<SelectListItem>();

    var totalTaxable = Model.Sum(x => x.TaxableAmount);
    var totalCGST    = Model.Sum(x => x.CGSTAmount);
    var totalSGST    = Model.Sum(x => x.SGSTAmount);
    var totalIGST    = Model.Sum(x => x.IGSTAmount);
    var totalGST     = Model.Sum(x => x.TotalGSTAmount);
    var totalNet     = Model.Sum(x => x.LineAmount);
    var isIGST       = Model.Any() && Model.First().GSTType == "IGST";
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-list-ul me-2 text-primary"></i>Purchase Register – Detailed</h4>
            <small class="text-muted">GRN-wise purchase line items with GST breakup</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PurchaseRegister" asp-controller="Inventory"
               asp-route-fromDate="@dateFrom" asp-route-toDate="@dateTo" asp-route-supplierId="@(selSupplier > 0 ? selSupplier.ToString() : "")"
               class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Register</a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-1"></i>Print</button>
            <button id="btnExportExcel" class="btn btn-success btn-sm"><i class="fas fa-file-excel me-1"></i>Excel</button>
            <button id="btnExportPdf" class="btn btn-danger btn-sm"><i class="fas fa-file-pdf me-1"></i>PDF</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="get" asp-action="PurchaseRegisterDetails" asp-controller="Inventory" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Supplier</label>
                    <select name="supplierId" class="form-select form-select-sm">
                        <option value="0">All Suppliers</option>
                        @foreach (var s in suppliers)
                        {
                            if (s.Value == selSupplier.ToString())
                            { <option value="@s.Value" selected="selected">@s.Text</option> }
                            else
                            { <option value="@s.Value">@s.Text</option> }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">From Date</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@dateFrom" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">To Date</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@dateTo" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm px-3"><i class="fas fa-filter me-1"></i>Apply</button>
                    <a asp-action="PurchaseRegisterDetails" asp-controller="Inventory" class="btn btn-outline-secondary btn-sm ms-1"><i class="fas fa-sync me-1"></i>Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-3">
        <div class="col-md-2">
            <div class="card border-0 shadow-sm border-start border-primary border-3"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Line Items</small>
                <span class="fs-5 fw-bold text-primary">@Model.Count()</span>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm border-start border-info border-3"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Taxable Amount</small>
                <span class="fs-6 fw-bold text-info">₹@totalTaxable.ToString("N2")</span>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm border-start border-secondary border-3"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">CGST</small>
                <span class="fs-6 fw-bold text-secondary">₹@totalCGST.ToString("N2")</span>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm border-start border-secondary border-3"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">SGST</small>
                <span class="fs-6 fw-bold text-secondary">₹@totalSGST.ToString("N2")</span>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm border-start border-warning border-3"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Total GST</small>
                <span class="fs-6 fw-bold text-warning">₹@totalGST.ToString("N2")</span>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm border-start border-success border-3"><div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold d-block">Net Amount</small>
                <span class="fs-6 fw-bold text-success">₹@totalNet.ToString("N2")</span>
            </div></div>
        </div>
    </div>

    <!-- Detail Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblPRD" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">GRN No.</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>Invoice No</th>
                            <th>PO No</th>
                            <th>Godown</th>
                            <th>Item</th>
                            <th>Code</th>
                            <th>UOM</th>
                            <th class="text-end">Recv Qty</th>
                            <th class="text-end">Unit Rate</th>
                            <th class="text-end">Taxable Amt</th>
                            <th class="text-end">GST%</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">Total GST</th>
                            <th class="text-end pe-3">Net Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold small">
                                    <a asp-action="PurchaseRegisterDetails" asp-controller="Inventory"
                                       asp-route-grnId="@r.GRNId" asp-route-fromDate="@dateFrom" asp-route-toDate="@dateTo"
                                       class="text-decoration-none">@r.GRNNumber</a>
                                </td>
                                <td class="text-muted small" data-order="@r.GRNDate.Ticks">@r.GRNDate.ToString("dd MMM yyyy")</td>
                                <td class="small">@r.SupplierName</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(r.InvoiceNo) ? "—" : r.InvoiceNo)</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(r.PONumber) ? "—" : r.PONumber)</td>
                                <td><span class="badge bg-info-subtle text-info small">@r.GodownName</span></td>
                                <td class="fw-semibold small">@r.ItemName</td>
                                <td class="text-muted small">@r.ItemCode</td>
                                <td class="text-muted small">@r.UOMCode</td>
                                <td class="text-end small">@r.ReceivedQty.ToString("N3")</td>
                                <td class="text-end small">₹@r.UnitRate.ToString("N2")</td>
                                <td class="text-end small">₹@r.TaxableAmount.ToString("N2")</td>
                                <td class="text-end small text-muted">@r.GSTPercent.ToString("N1")%</td>
                                <td class="text-end small @(r.CGSTAmount > 0 ? "text-warning" : "text-muted")">
                                    @(r.CGSTAmount > 0 ? "₹" + r.CGSTAmount.ToString("N2") : "—")
                                </td>
                                <td class="text-end small @(r.SGSTAmount > 0 ? "text-warning" : "text-muted")">
                                    @(r.SGSTAmount > 0 ? "₹" + r.SGSTAmount.ToString("N2") : "—")
                                </td>
                                <td class="text-end small @(r.IGSTAmount > 0 ? "text-warning" : "text-muted")">
                                    @(r.IGSTAmount > 0 ? "₹" + r.IGSTAmount.ToString("N2") : "—")
                                </td>
                                <td class="text-end small text-warning fw-semibold">₹@r.TotalGSTAmount.ToString("N2")</td>
                                <td class="text-end pe-3 fw-semibold">₹@r.LineAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Any())
                    {
                        <tfoot class="table-light fw-semibold small">
                            <tr>
                                <td colspan="11" class="ps-3 text-end">Totals</td>
                                <td class="text-end">₹@totalTaxable.ToString("N2")</td>
                                <td></td>
                                <td class="text-end">₹@totalCGST.ToString("N2")</td>
                                <td class="text-end">₹@totalSGST.ToString("N2")</td>
                                <td class="text-end">₹@totalIGST.ToString("N2")</td>
                                <td class="text-end text-warning">₹@totalGST.ToString("N2")</td>
                                <td class="text-end pe-3 text-success">₹@totalNet.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-list-ul fa-3x mb-3 d-block opacity-25"></i>
                <p>No purchase line items found for the selected filters.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        var table = $('#tblPRD').DataTable({
            paging: true, pageLength: 50, searching: true, ordering: true,
            order: [[1, 'desc']],
            columnDefs: [{ type: 'num', targets: [1] }],
            buttons: [
                { extend: 'excelHtml5', title: 'Purchase Register - Detailed', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', title: 'Purchase Register - Detailed', orientation: 'landscape', pageSize: 'A4', exportOptions: { columns: ':visible' } }
            ]
        });
        $('#btnExportExcel').on('click', function () { table.button(0).trigger(); });
        $('#btnExportPdf').on('click', function () { table.button(1).trigger(); });
    });
</script>
}
