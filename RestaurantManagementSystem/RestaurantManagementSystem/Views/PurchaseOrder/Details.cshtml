@model RestaurantManagementSystem.Models.PurchaseOrderHeader
@{
    ViewData["Title"] = "Purchase Order Details";
    bool allowDirect  = ViewBag.AllowDirectPurchase == true;
    bool grnMandatory = ViewBag.GRNMandatory != false;   // default true if not set
}

@* ── Alerts ───────────────────────────────────────────────────────────────── *@
@if (TempData["DirectPostedGRN"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-start gap-3">
            <div class="flex-shrink-0 bg-success bg-opacity-10 rounded-circle p-2">
                <i class="fas fa-check-double text-success fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="alert-heading mb-1 fw-bold">Stock Posted Successfully</h6>
                <p class="mb-1 small">
                    This Purchase Order was approved in <strong>Direct Purchase</strong> mode.
                    Auto-GRN <code class="fw-bold">@TempData["DirectPostedGRN"]</code> was created and posted to the stock ledger automatically.
                </p>
                <span class="badge bg-success me-1"><i class="fas fa-warehouse me-1"></i>Stock Updated</span>
                <span class="badge bg-primary"><i class="fas fa-file-alt me-1"></i>GRN Auto-Created</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["SuccessMessage"] != null && TempData["DirectPostedGRN"] == null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show py-2 mb-3">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid px-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center">
            <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-link text-muted ps-0 me-2">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h4 class="mb-0 fw-bold"><i class="fas fa-shopping-cart me-2 text-primary"></i>Purchase Order Details</h4>
                <small class="text-muted">PO# <strong>@Model.PONumber</strong></small>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @{
                var (badgeClass, badgeIcon) = Model.Status switch {
                    "Draft"      => ("bg-warning text-dark", "fa-pencil-alt"),
                    "Approved"   => ("bg-success",           "fa-check"),
                    "PartialGRN" => ("bg-info",              "fa-truck"),
                    "FullGRN"    => ("bg-primary",           "fa-check-double"),
                    "Cancelled"  => ("bg-danger",            "fa-times"),
                    _            => ("bg-secondary",         "fa-question")
                };
            }
            <span class="badge @badgeClass fs-6">
                <i class="fas @badgeIcon me-1"></i>@Model.Status
            </span>

            @if (Model.Status == "Draft")
            {
                <a asp-action="Form" asp-controller="PurchaseOrder" asp-route-id="@Model.POId"
                   class="btn btn-outline-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
                <form method="post" asp-action="Approve" asp-controller="PurchaseOrder" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.POId" />
                    @if (allowDirect && !grnMandatory)
                    {
                        <button type="button" class="btn btn-success btn-sm"
                                data-swal-confirm="Stock will be updated immediately — no GRN step required. This cannot be undone."
                                data-swal-title="Approve &amp; Post to Stock?"
                                data-swal-icon="question"
                                data-swal-ok="Yes, Approve &amp; Post"
                                data-swal-color="#198754">
                            <i class="fas fa-bolt me-1"></i>Approve &amp; Post Stock
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success btn-sm"
                                data-swal-confirm="The PO will be approved and sent for GRN processing."
                                data-swal-title="Approve Purchase Order?"
                                data-swal-icon="question"
                                data-swal-ok="Yes, Approve"
                                data-swal-color="#198754">
                            <i class="fas fa-check me-1"></i>Approve
                        </button>
                    }
                </form>
                <form method="post" asp-action="Cancel" asp-controller="PurchaseOrder" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.POId" />
                    <button type="button" class="btn btn-danger btn-sm"
                            data-swal-confirm="This PO will be cancelled and cannot be reactivated."
                            data-swal-title="Cancel Purchase Order?"
                            data-swal-icon="warning"
                            data-swal-ok="Yes, Cancel PO"
                            data-swal-color="#dc3545">
                        <i class="fas fa-times me-1"></i>Cancel PO
                    </button>
                </form>
            }
            @if (Model.Status == "Approved" || Model.Status == "PartialGRN")
            {
                @if (!allowDirect || grnMandatory)
                {
                    <a asp-action="Form" asp-controller="GRN" asp-route-poId="@Model.POId"
                       class="btn btn-warning btn-sm"><i class="fas fa-truck me-1"></i>Create GRN</a>
                }
                else
                {
                    <span class="badge bg-info text-white fs-6">
                        <i class="fas fa-bolt me-1"></i>Direct Purchase Mode
                    </span>
                }
            }
            <a href="@Url.Action("PrintPO", "PurchaseOrder", new { id = Model.POId })" target="_blank"
               class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-print me-1"></i>Print
            </a>
        </div>
    </div>

    <div class="row g-3">
        <!-- Header Info -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-info-circle me-1"></i>Order Information</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 small">
                        <div class="col-md-2"><label class="text-muted d-block">PO Number</label><span class="fw-semibold">@Model.PONumber</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">PO Date</label><span class="fw-semibold">@Model.PODate.ToString("dd MMM yyyy")</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Supplier</label><span class="fw-semibold">@Model.SupplierName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Delivery Godown</label><span class="badge bg-info-subtle text-info">@Model.GodownName</span></div>
                        <div class="col-md-2"><label class="text-muted d-block">Expected Delivery</label>
                            <span class="fw-semibold">@(Model.ExpectedDate?.ToString("dd MMM yyyy") ?? "—")</span>
                        </div>
                        <div class="col-md-2"><label class="text-muted d-block">Payment Terms</label><span>@(Model.PaymentTerms ?? "—")</span></div>
                        @if (!string.IsNullOrEmpty(Model.Remarks))
                        {
                            <div class="col-12"><label class="text-muted d-block">Remarks</label><span>@Model.Remarks</span></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-2">
                    <span class="fw-semibold text-muted"><i class="fas fa-list me-1"></i>Order Items</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">#</th>
                                    <th>Item</th>
                                    <th class="text-end">Ordered Qty</th>
                                    <th>UOM</th>
                                    <th class="text-end">Unit Rate</th>
                                    <th class="text-end">GST%</th>
                                    <th class="text-end">Taxable Amt</th>
                                    <th class="text-end">GST Amt</th>
                                    <th class="text-end">Received Qty</th>
                                    <th class="text-end pe-3">Net Amt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var sn = 1; }
                                @foreach (var line in Model.Lines ?? new List<RestaurantManagementSystem.Models.PurchaseOrderLine>())
                                {
                                    var taxable = line.OrderedQty * line.UnitRate;
                                    var gstAmt  = taxable * line.GSTPercent / 100;
                                    <tr>
                                        <td class="ps-3 text-muted small">@sn</td>
                                        <td class="fw-semibold">@line.ItemName</td>
                                        <td class="text-end">@line.OrderedQty.ToString("N3")</td>
                                        <td class="text-muted small">@line.UOMCode</td>
                                        <td class="text-end">₹@line.UnitRate.ToString("N2")</td>
                                        <td class="text-end text-muted small">@line.GSTPercent.ToString("N1")%</td>
                                        <td class="text-end">₹@taxable.ToString("N2")</td>
                                        <td class="text-end text-warning">₹@gstAmt.ToString("N2")</td>
                                        <td class="text-end @(line.ReceivedQty >= line.OrderedQty ? "text-success" : "text-info")">
                                            @line.ReceivedQty.ToString("N3")
                                        </td>
                                        <td class="text-end pe-3 fw-semibold">₹@((taxable + gstAmt).ToString("N2"))</td>
                                    </tr>
                                    sn++;
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td colspan="6" class="text-end ps-3">Totals:</td>
                                    <td class="text-end">₹@((Model.Lines?.Sum(l => l.OrderedQty * l.UnitRate) ?? 0).ToString("N2"))</td>
                                    <td class="text-end text-warning">₹@((Model.Lines?.Sum(l => l.OrderedQty * l.UnitRate * l.GSTPercent / 100) ?? 0).ToString("N2"))</td>
                                    <td></td>
                                    <td class="text-end pe-3 text-primary">₹@Model.TotalAmount.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
