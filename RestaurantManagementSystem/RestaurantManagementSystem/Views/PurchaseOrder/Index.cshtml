@model IEnumerable<RestaurantManagementSystem.Models.PurchaseOrderHeader>
@{
    ViewData["Title"] = "Purchase Orders";
    var selStatus  = ViewBag.SelStatus as string ?? "";
    var fromDate   = ViewBag.FromDate  as string ?? "";
    var toDate     = ViewBag.ToDate    as string ?? "";
}

<style>
    .purchase-order-index-page .poi-topbar {
        gap: 1rem;
    }
    .purchase-order-index-page .poi-topbar .btn,
    .purchase-order-index-page .poi-filter .btn,
    .purchase-order-index-page .poi-filter .form-control {
        min-height: 38px;
    }
    .purchase-order-index-page .poi-status-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }
    .purchase-order-index-page .poi-status-tabs .btn {
        margin-right: 0 !important;
    }
    .purchase-order-index-page .table-responsive {
        -webkit-overflow-scrolling: touch;
    }
    .purchase-order-index-page .dataTables_wrapper .dataTables_filter input,
    .purchase-order-index-page .dataTables_wrapper .dataTables_length select {
        min-height: 38px;
    }

    .purchase-order-index-page .po-action-wrap {
        margin-left: auto;
    }
    @@media (max-width: 991.98px) {
        .purchase-order-index-page .poi-topbar {
            flex-direction: column;
            align-items: stretch !important;
        }
        .purchase-order-index-page .poi-topbar > a.btn {
            align-self: flex-start;
        }
    }

    @@media (max-width: 767.98px) {
        .purchase-order-index-page .poi-topbar > a.btn {
            width: 100%;
            justify-content: center;
        }
        .purchase-order-index-page .poi-filter {
            flex-direction: column;
            align-items: stretch !important;
        }
        .purchase-order-index-page .poi-filter > div,
        .purchase-order-index-page .poi-filter > button,
        .purchase-order-index-page .poi-filter > a,
        .purchase-order-index-page .poi-filter > span {
            width: 100%;
        }
        .purchase-order-index-page .dataTables_wrapper .dataTables_length,
        .purchase-order-index-page .dataTables_wrapper .dataTables_filter {
            float: none !important;
            text-align: left !important;
            width: 100%;
            margin-bottom: .75rem;
        }
        .purchase-order-index-page .dataTables_wrapper .dataTables_length label,
        .purchase-order-index-page .dataTables_wrapper .dataTables_filter label {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }
        .purchase-order-index-page .dataTables_wrapper .dataTables_filter input,
        .purchase-order-index-page .dataTables_wrapper .dataTables_length select {
            width: 100% !important;
            max-width: none;
            margin-left: 0 !important;
        }
        .purchase-order-index-page .table-responsive {
            overflow: visible;
        }
        .purchase-order-index-page #tblPO thead {
            display: none;
        }
        .purchase-order-index-page #tblPO tbody {
            display: block;
        }
        .purchase-order-index-page #tblPO tr {
            display: block;
            margin: .85rem;
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: .85rem;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
        }
        .purchase-order-index-page #tblPO td {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: .75rem;
            width: 100%;
            text-align: left !important;
            padding: .6rem .75rem !important;
            border: 0;
            border-top: 1px solid rgba(15, 23, 42, .06);
        }
        .purchase-order-index-page #tblPO td:first-child {
            border-top: 0;
        }
        .purchase-order-index-page #tblPO td::before {
            content: attr(data-label);
            flex: 0 0 96px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
        }
        .purchase-order-index-page #tblPO td[data-label="Actions"] {
            align-items: center;
        }
        .purchase-order-index-page #tblPO td[data-label="Actions"] > * {
            margin-left: auto;
        }
    }
</style>

<div class="container-fluid px-0 purchase-order-index-page">
    <div class="d-flex align-items-center justify-content-between mb-3 poi-topbar">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-shopping-cart me-2 text-primary"></i>Purchase Orders</h4>
            <small class="text-muted">Create and manage purchase orders to suppliers</small>
        </div>
        <a asp-action="Form" asp-controller="PurchaseOrder" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New Purchase Order
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Status Tabs -->
    <div class="mb-3 poi-status-tabs">
        <a href="@Url.Action("Index","PurchaseOrder",new{fromDate,toDate})" class="btn btn-sm @(selStatus == "" ? "btn-primary" : "btn-outline-secondary")">All</a>
        <a href="@Url.Action("Index","PurchaseOrder",new{status="Draft",fromDate,toDate})" class="btn btn-sm @(selStatus == "Draft" ? "btn-warning" : "btn-outline-warning")">Draft</a>
        <a href="@Url.Action("Index","PurchaseOrder",new{status="Approved",fromDate,toDate})" class="btn btn-sm @(selStatus == "Approved" ? "btn-success" : "btn-outline-success")">Approved</a>
        <a href="@Url.Action("Index","PurchaseOrder",new{status="PartialGRN",fromDate,toDate})" class="btn btn-sm @(selStatus == "PartialGRN" ? "btn-info" : "btn-outline-info")">Partial GRN</a>
        <a href="@Url.Action("Index","PurchaseOrder",new{status="FullGRN",fromDate,toDate})" class="btn btn-sm @(selStatus == "FullGRN" ? "btn-dark" : "btn-outline-dark")">Fully Received</a>
        <a href="@Url.Action("Index","PurchaseOrder",new{status="Cancelled",fromDate,toDate})" class="btn btn-sm @(selStatus == "Cancelled" ? "btn-danger" : "btn-outline-danger")">Cancelled</a>
    </div>

    <!-- Date Range Filter -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="get" asp-action="Index" asp-controller="PurchaseOrder" class="d-flex gap-2 align-items-end flex-wrap poi-filter">
                @if (!string.IsNullOrEmpty(selStatus))
                {
                    <input type="hidden" name="status" value="@selStatus" />
                }
                <div>
                    <label class="form-label small fw-semibold mb-1">From Date</label>
                    <input type="date" name="fromDate" value="@fromDate"
                           class="form-control form-control-sm" style="min-width:150px;" />
                </div>
                <div>
                    <label class="form-label small fw-semibold mb-1">To Date</label>
                    <input type="date" name="toDate" value="@toDate"
                           class="form-control form-control-sm" style="min-width:150px;" />
                </div>
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="fas fa-filter me-1"></i>Apply
                </button>
                <a asp-action="Index" asp-controller="PurchaseOrder" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-sync me-1"></i>Reset
                </a>
                @if (!string.IsNullOrEmpty(fromDate) && !string.IsNullOrEmpty(toDate))
                {
                    <span class="badge bg-primary-subtle text-primary px-2 py-1 align-self-center" style="font-size:.8rem;">
                        <i class="fas fa-calendar-alt me-1"></i>
                        @DateTime.Parse(fromDate).ToString("dd MMM") &ndash; @DateTime.Parse(toDate).ToString("dd MMM yyyy")
                    </span>
                }
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-2 d-flex align-items-center">
            <span class="fw-semibold text-muted me-auto">
                <i class="fas fa-list me-1"></i>Purchase Orders
                <span class="badge bg-primary ms-1">@Model.Count()</span>
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblPO" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">PO Number</th>
                            <th>PO Date</th>
                            <th>Supplier</th>
                            <th>Godown</th>
                            <th>Delivery Date</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-primary" data-label="PO Number">@po.PONumber</td>
                                <td class="text-muted small" data-label="PO Date" data-order="@po.PODate.ToString("yyyy-MM-dd")">@po.PODate.ToString("dd MMM yyyy")</td>
                                <td data-label="Supplier">@po.SupplierName</td>
                                <td data-label="Godown"><span class="badge bg-info-subtle text-info">@po.GodownName</span></td>
                                <td class="text-muted small" data-label="Delivery Date" data-order="@(po.ExpectedDate.HasValue ? po.ExpectedDate.Value.ToString("yyyy-MM-dd") : "")">
                                    @if (po.ExpectedDate.HasValue)
                                    { @po.ExpectedDate.Value.ToString("dd MMM yyyy") }
                                </td>
                                <td class="text-end fw-semibold" data-label="Total Amount">₹@po.TotalAmount.ToString("N2")</td>
                                <td class="text-center" data-label="Status">@Html.Raw(GetStatusBadgeHtml(po.Status))</td>
                                <td class="text-center pe-3" data-label="Actions">
                                        <div class="d-inline-flex flex-wrap gap-1 justify-content-end po-action-wrap">
                                            <a asp-action="Details" asp-controller="PurchaseOrder" asp-route-id="@po.POId"
                                               class="btn btn-outline-info btn-sm py-0 px-2" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (po.Status == "Draft")
                                            {
                                                <a asp-action="Form" asp-controller="PurchaseOrder" asp-route-id="@po.POId"
                                                   class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form method="post" asp-action="Approve" asp-controller="PurchaseOrder" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@po.POId" />
                                                    <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" title="Approve"
                                                            data-swal-confirm="The PO will be approved and sent for GRN processing."
                                                            data-swal-title="Approve Purchase Order?"
                                                            data-swal-icon="question"
                                                            data-swal-ok="Yes, Approve"
                                                            data-swal-color="#198754">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <form method="post" asp-action="Cancel" asp-controller="PurchaseOrder" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@po.POId" />
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="Cancel"
                                                            data-swal-confirm="This PO will be cancelled and cannot be reactivated."
                                                            data-swal-title="Cancel Purchase Order?"
                                                            data-swal-icon="warning"
                                                            data-swal-ok="Yes, Cancel PO"
                                                            data-swal-color="#dc3545">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (po.Status == "Approved" || po.Status == "PartialGRN")
                                            {
                                                <a asp-action="Form" asp-controller="GRN" asp-route-poId="@po.POId"
                                                   class="btn btn-outline-warning btn-sm py-0 px-2" title="Create GRN">
                                                    <i class="fas fa-truck"></i>
                                                </a>
                                            }
                                        </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-shopping-cart fa-3x mb-3 d-block opacity-25"></i>
                <p>No purchase orders found.</p>
                <a asp-action="Form" asp-controller="PurchaseOrder" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Create First PO
                </a>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusBadgeHtml(string status) {
        var (cls, icon) = status switch {
            "Draft"      => ("bg-warning text-dark",  "fa-pencil-alt"),
            "Approved"   => ("bg-success",            "fa-check"),
            "PartialGRN" => ("bg-info",               "fa-truck"),
            "FullGRN"    => ("bg-primary",            "fa-check-double"),
            "Cancelled"  => ("bg-danger",             "fa-times"),
            _            => ("bg-secondary",          "fa-question")
        };
        return $"<span class=\"badge {cls}\"><i class=\"fas {icon} me-1\"></i>{status}</span>";
    }
}

@section Scripts {
<script>
    $(document).ready(function () {
        $('#tblPO').DataTable({ paging: true, pageLength: 25, searching: true, ordering: true,
            order: [[0,'desc']], autoWidth: false, columnDefs: [{ orderable: false, targets: [7] }] });
    });
</script>
}
