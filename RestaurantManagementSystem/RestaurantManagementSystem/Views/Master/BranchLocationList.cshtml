@model IEnumerable<RestaurantManagementSystem.Models.BranchLocation>
@{
    ViewData["Title"] = "Branch Location Master";
}

<h2 class="mb-4">Branch Location Master</h2>

<a class="btn btn-success mb-3" asp-controller="Master" asp-action="BranchLocationForm">
    <i class="bi bi-plus-circle"></i> Add New
</a>

@if (TempData["ResultMessage"] != null)
{
    <div class="alert alert-info">@TempData["ResultMessage"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Location Name</th>
            <th>Status</th>
            <th style="width: 280px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{int sr = 1;}
        @foreach (var item in Model)
        {
            <tr>
                <td>@sr</td>
                <td>@item.LocationName</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a class="btn btn-info btn-sm"
                       asp-controller="Master" asp-action="BranchLocationForm"
                       asp-route-locationId="@item.LocationId" asp-route-isView="true">View</a>
                    <a class="btn btn-primary btn-sm"
                       asp-controller="Master" asp-action="BranchLocationForm"
                       asp-route-locationId="@item.LocationId">Edit</a>

                    <form class="d-inline" asp-controller="Master" asp-action="SetBranchLocationStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="locationId" value="@item.LocationId" />
                        <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                        @if (item.IsActive)
                        {
                            <button type="submit" class="btn btn-warning btn-sm">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success btn-sm">Activate</button>
                        }
                    </form>
                </td>
            </tr>
            sr++;
        }
    </tbody>
</table>
