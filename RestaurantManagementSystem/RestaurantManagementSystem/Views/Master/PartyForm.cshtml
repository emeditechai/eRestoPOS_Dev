@model RestaurantManagementSystem.Models.PartyMaster
@{
    bool isNew  = Model.Id == 0;
    bool isView = ViewBag.IsView == true;
    ViewData["Title"] = isView ? "View Party" : (isNew ? "Add New Party" : "Edit Party");

    var partyTypes = new[] { "Vendor", "Supplier", "Trader" };
}

<div class="container-fluid px-0" style="max-width:850px">

    <!-- Breadcrumb + Header -->
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-action="PartyList" asp-controller="Master" class="text-muted text-decoration-none small">
            <i class="fas fa-handshake me-1"></i>Party Master
        </a>
        <i class="fas fa-chevron-right text-muted" style="font-size:.65rem"></i>
        <span class="small text-dark fw-semibold">@ViewData["Title"]</span>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0 fw-bold">
            @if (isView)
            {
                <i class="fas fa-eye text-secondary me-2"></i>
            }
            else if (isNew)
            {
                <i class="fas fa-plus-circle text-primary me-2"></i>
            }
            else
            {
                <i class="fas fa-edit text-primary me-2"></i>
            }
            @ViewData["Title"]
            @if (isView)
            {
                <span class="badge bg-secondary ms-2" style="font-size:.7rem;vertical-align:middle">View Mode</span>
            }
        </h4>
        <a asp-action="PartyList" asp-controller="Master" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    @if (TempData["ResultMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show py-2">
            @TempData["ResultMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" asp-action="PartyForm" asp-controller="Master">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <fieldset @(isView ? "disabled" : "")>

        <div class="row g-3">

            <!-- ── Left Column ─────────────────────────────── -->
            <div class="col-md-7">

                <!-- Basic Info -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-semibold">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-4">
                                <label asp-for="PartyCode" class="form-label fw-semibold">
                                    Party Code <span class="text-danger">*</span>
                                </label>
                                <input asp-for="PartyCode" class="form-control text-uppercase" maxlength="20"
                                       placeholder="e.g. VND001" />
                                <span asp-validation-for="PartyCode" class="text-danger small"></span>
                                <div class="form-text">Must be unique.</div>
                            </div>
                            <div class="col-sm-8">
                                <label asp-for="PartyName" class="form-label fw-semibold">
                                    Party Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="PartyName" class="form-control" maxlength="200"
                                       placeholder="e.g. ABC Traders Pvt Ltd" />
                                <span asp-validation-for="PartyName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="PartyType" class="form-label fw-semibold">
                                    Party Type <span class="text-danger">*</span>
                                </label>
                                <select asp-for="PartyType" class="form-select">
                                    <option value="">-- Select Type --</option>
                                    @foreach (var t in partyTypes)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                                <span asp-validation-for="PartyType" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                    Phone Number <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone fa-xs"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" maxlength="20"
                                           placeholder="e.g. 9876543210" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold">Email ID</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope fa-xs"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" maxlength="200"
                                           placeholder="e.g. contact@party.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-semibold">
                        <i class="fas fa-map-marker-alt me-2 text-danger"></i>Address Details
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="3" maxlength="500"
                                          placeholder="Full address..."></textarea>
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="PinCode" class="form-label fw-semibold">PIN Code</label>
                                <input asp-for="PinCode" class="form-control" maxlength="10"
                                       placeholder="e.g. 400001" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ── Right Column ─────────────────────────────── -->
            <div class="col-md-5">

                <!-- Credit Settings -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-semibold">
                        <i class="fas fa-credit-card me-2 text-success"></i>Credit Settings
                    </div>
                    <div class="card-body">
                        <!-- Credit Allow Toggle -->
                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsCreditAllow" class="form-check-input" type="checkbox"
                                   role="switch" id="switchCredit" style="width:3em;height:1.5em"
                                   onclick="toggleCreditBalance(this.checked)" />
                            <label class="form-check-label ms-2 fw-semibold" for="switchCredit">
                                <span id="creditLabel" class="@(Model.IsCreditAllow ? "text-success" : "text-secondary")">
                                    @(Model.IsCreditAllow ? "Credit Allowed" : "No Credit")
                                </span>
                            </label>
                        </div>

                        <!-- Allow Balance (enabled only when credit is on) -->
                        <div id="balanceSection">
                            <label asp-for="AllowBalance" class="form-label fw-semibold">
                                Allowed Credit Balance
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">&#8377;</span>
                                <input asp-for="AllowBalance" type="number" step="0.01" min="0"
                                       class="form-control" placeholder="0.00"
                                       id="inputBalance" />
                            </div>
                            <div class="form-text">Maximum credit amount allowed for this party.</div>
                        </div>
                    </div>
                </div>

                <!-- Status -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-semibold">
                        <i class="fas fa-toggle-on me-2 text-success"></i>Status
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox"
                                   role="switch" id="switchActive" style="width:3em;height:1.5em" />
                            <label class="form-check-label ms-2 fw-semibold" for="switchActive">
                                <span id="statusLabel" class="@(Model.IsActive ? "text-success" : "text-secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Send Notification (create only) -->
                @if (isNew)
                {
                    <div class="card border-0 shadow-sm mb-3" id="notificationCard">
                        <div class="card-header bg-light py-2 fw-semibold">
                            <i class="fas fa-bell me-2 text-warning"></i>Email Notification
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input type="checkbox" name="SendNotification" value="true"
                                       class="form-check-input" role="switch"
                                       id="switchNotification" style="width:3em;height:1.5em"
                                       onclick="toggleNotificationHint(this.checked)" />
                                <label class="form-check-label ms-2 fw-semibold" for="switchNotification">
                                    <span id="notifLabel" class="text-secondary">Don't Send Notification</span>
                                </label>
                            </div>
                            <div id="notifHint" class="form-text mt-2" style="display:none;">
                                <i class="fas fa-envelope me-1 text-warning"></i>
                                A welcome email will be sent to the party's email address upon saving.
                            </div>
                        </div>
                    </div>
                }

                <!-- Audit -->
                @if (!isNew)
                {
                    <div class="card border-0 bg-light mb-3">
                        <div class="card-body py-2 px-3 small text-muted">
                            <div><i class="fas fa-clock me-1"></i><strong>Created:</strong> @(Model.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div><i class="fas fa-pen me-1"></i><strong>Updated:</strong> @Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

        </fieldset>

        <!-- Action Buttons -->
        <div class="d-flex gap-2 mt-1">
            @if (isView)
            {
                <a asp-action="PartyForm" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                    <i class="fas fa-edit me-1"></i>Edit Party
                </a>
                <a asp-action="PartyList" asp-controller="Master" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            }
            else
            {
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-1"></i>@(isNew ? "Save Party" : "Update Party")
                </button>
                <a asp-action="PartyList" asp-controller="Master" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>Cancel
                </a>
            }
        </div>
    </form>
</div>

@section Scripts {
<script>
    function toggleCreditBalance(checked) {
        var section = document.getElementById('balanceSection');
        var input   = document.getElementById('inputBalance');
        var label   = document.getElementById('creditLabel');

        section.style.opacity       = checked ? '1'    : '0.4';
        section.style.pointerEvents = checked ? 'auto' : 'none';
        input.disabled              = !checked;
        label.textContent           = checked ? 'Credit Allowed' : 'No Credit';
        label.className             = checked ? 'text-success'   : 'text-secondary';

        if (!checked) input.value = '';
    }

    // Init on page load
    document.addEventListener('DOMContentLoaded', function () {
        toggleCreditBalance(document.getElementById('switchCredit').checked);
    });

    // Status toggle label
    document.getElementById('switchActive')?.addEventListener('change', function () {
        var lbl = document.getElementById('statusLabel');
        lbl.textContent = this.checked ? 'Active'   : 'Inactive';
        lbl.className   = this.checked ? 'text-success' : 'text-secondary';
    });

    function toggleNotificationHint(checked) {
        var lbl  = document.getElementById('notifLabel');
        var hint = document.getElementById('notifHint');
        if (!lbl) return;
        lbl.textContent = checked ? 'Send Notification' : 'Don\'t Send Notification';
        lbl.className   = checked ? 'text-warning fw-bold' : 'text-secondary';
        hint.style.display = checked ? 'block' : 'none';
    }
</script>
}
