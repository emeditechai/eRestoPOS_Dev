@model IEnumerable<RestaurantManagementSystem.Models.Ingredients>
@{
    ViewData["Title"] = "Item Master";
    var categories = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fas fa-boxes-stacked me-2 text-success"></i>Item Master
            </h4>
            <small class="text-muted">Manage inventory ingredients / stock items with UOM mapping</small>
        </div>
        <a asp-action="IngredientsForm" asp-controller="Master" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> Add New Item
        </a>
    </div>

    @if (TempData["ResultMessage"] != null)
    {
        var msg = TempData["ResultMessage"]!.ToString()!;
        var isError = msg.ToLower().Contains("fail") || msg.ToLower().Contains("cannot") || msg.ToLower().Contains("error");
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="fas @(isError ? "fa-exclamation-circle" : "fa-check-circle") me-2"></i>@msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters + Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-2 d-flex align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-muted me-auto">
                <i class="fas fa-list me-1"></i>All Items
                <span class="badge bg-primary ms-1">@Model.Count()</span>
            </span>

            <!-- Category Filter -->
            <select class="form-select form-select-sm" id="filterCategory" style="width:170px;">
                <option value="">All Categories</option>
                @if (categories != null)
                {
                    foreach (var c in categories)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                }
            </select>

            <!-- Status Filter -->
            <select class="form-select form-select-sm" id="filterStatus" style="width:120px;">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblItems" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">Code</th>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Purchase UOM</th>
                            <th>Consumption UOM</th>
                            <th class="text-end">Factor</th>
                            <th class="text-end">Std Cost</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(item.Code))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@item.Code</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.IngredientsName</div>
                                    @if (!string.IsNullOrEmpty(item.DisplayName) && item.DisplayName != item.IngredientsName)
                                    {
                                        <small class="text-muted">@item.DisplayName</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ItemCategory))
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@item.ItemCategory</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PurchaseUOMCode))
                                    {
                                        <span class="fw-bold text-primary">@item.PurchaseUOMCode</span>
                                        <small class="text-muted d-block">@item.PurchaseUOMName</small>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.RecipeUOMCode))
                                    {
                                        <span class="fw-bold text-info">@item.RecipeUOMCode</span>
                                        <small class="text-muted d-block">@item.RecipeUOMName</small>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-end font-monospace small">
                                    @if (item.PurchaseToRecipeFactor.HasValue && item.PurchaseToRecipeFactor != 1)
                                    { @item.PurchaseToRecipeFactor.Value.ToString("G") }
                                    else { <span class="text-muted">1</span> }
                                </td>
                                <td class="text-end">
                                    @if (item.StandardCost.HasValue)
                                    { <span>&#8377; @item.StandardCost.Value.ToString("0.##")</span> }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    { <span class="badge bg-success-subtle text-success">Active</span> }
                                    else
                                    { <span class="badge bg-secondary-subtle text-secondary">Inactive</span> }
                                </td>
                                <td class="text-center pe-3">
                                    <a asp-action="IngredientsForm" asp-controller="Master" asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" asp-action="DeleteIngredient" asp-controller="Master" class="d-inline"
                                          onsubmit="return confirm('Delete @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.IngredientsName))? This cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-box-open fa-3x mb-3 d-block opacity-25"></i>
                <p class="mb-2">No items found.</p>
                <a asp-action="IngredientsForm" asp-controller="Master" class="btn btn-success btn-sm">
                    <i class="fas fa-plus me-1"></i>Add First Item
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        var table = $('#tblItems').DataTable({
            paging: true,
            pageLength: 25,
            searching: true,
            ordering: true,
            order: [[1, 'asc']],
            columnDefs: [{ orderable: false, targets: [8] }],
            language: { search: 'Search:' }
        });

        $('#filterCategory').on('change', function () {
            table.column(2).search(this.value).draw();
        });
        $('#filterStatus').on('change', function () {
            table.column(7).search(this.value).draw();
        });
    });
</script>
}

