@model IEnumerable<RestaurantManagementSystem.Models.BranchMaster>
@{
    ViewData["Title"] = "Branch Master";
}

<h2 class="mb-4">Branch Master</h2>

<a class="btn btn-success mb-3" asp-controller="Master" asp-action="BranchForm">
    <i class="bi bi-plus-circle"></i> Add New
</a>

@if (TempData["ResultMessage"] != null)
{
    <div class="alert alert-info">@TempData["ResultMessage"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Branch Code</th>
            <th>Branch Name</th>
            <th>Location</th>
            <th>Main Branch</th>
            <th>Status</th>
            <th style="width: 280px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BranchCode</td>
                <td>@item.BranchName</td>
                <td>@(string.IsNullOrWhiteSpace(item.BranchLocationName) ? "-" : item.BranchLocationName)</td>
                <td>
                    @if (item.Is_MainBranch)
                    {
                        <span class="badge bg-primary">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark">No</span>
                    }
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Deactive</span>
                    }
                </td>
                <td>
                    <a class="btn btn-info btn-sm" asp-controller="Master" asp-action="BranchForm" asp-route-branchId="@item.BranchId" asp-route-isView="true">View</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Master" asp-action="BranchForm" asp-route-branchId="@item.BranchId">Edit</a>

                    <form class="d-inline" asp-controller="Master" asp-action="SetBranchStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="branchId" value="@item.BranchId" />
                        <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                        @if (item.IsActive)
                        {
                            <button type="submit" class="btn btn-warning btn-sm">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success btn-sm">Activate</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
