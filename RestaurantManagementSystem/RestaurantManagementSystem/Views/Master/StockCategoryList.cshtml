@model IEnumerable<RestaurantManagementSystem.Models.StockItemCategory>
@{
    ViewData["Title"] = "Stock Categories";
}

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fas fa-tags me-2 text-warning"></i>Stock Categories
            </h4>
            <small class="text-muted">Manage item categories used in the Item Master</small>
        </div>
        <span class="badge bg-primary fs-6">@Model.Count() Categories</span>
    </div>

    @if (TempData["ResultMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show py-2" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["ResultMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3">
        <!-- ─── Left: Add / Edit Panel ────────────────────────────────────── -->
        <div class="col-lg-4 col-xl-3">
            <div class="card shadow-sm border-0" id="catFormCard">
                <div class="card-header bg-warning text-dark py-2">
                    <span id="formTitle"><i class="fas fa-plus-circle me-2"></i>Add New Category</span>
                </div>
                <div class="card-body p-3">
                    <form method="post" asp-action="StockCategorySave" asp-controller="Master" id="catForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" id="f_Id" value="0" />
                        <input type="hidden" name="IsActive" id="f_IsActive" value="true" />

                        <div class="mb-2">
                            <label class="form-label form-label-sm fw-semibold">
                                Category Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" name="Name" id="f_Name"
                                   required maxlength="100" placeholder="e.g. Dairy" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label form-label-sm fw-semibold">Description</label>
                            <textarea class="form-control form-control-sm" name="Description" id="f_Desc"
                                      rows="2" maxlength="300" placeholder="Optional description..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label form-label-sm fw-semibold">Display Order</label>
                            <input type="number" class="form-control form-control-sm" name="DisplayOrder" id="f_Order"
                                   min="0" value="0" />
                            <div class="form-text">Lower number appears first in dropdowns.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning btn-sm flex-fill" id="btnSave">
                                <i class="fas fa-save me-1"></i>Save
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetForm()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info card -->
            <div class="card border-0 bg-light mt-3">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        <i class="fas fa-lightbulb text-warning me-1"></i>
                        <strong>Tip:</strong> Categories defined here appear in the
                        <a href="/Master/IngredientsList">Item Master</a> category dropdown.
                        Deactivate instead of deleting to preserve history.
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── Right: Category Table ─────────────────────────────────────── -->
        <div class="col-lg-8 col-xl-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-2 d-flex align-items-center gap-2">
                    <span class="fw-semibold text-muted me-auto"><i class="fas fa-list me-1"></i>All Categories</span>
                    <select class="form-select form-select-sm" id="filterStatus" style="width:120px;">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="card-body p-0">
                    <table id="tblCats" class="table table-sm table-hover mb-0 align-middle" style="width:100%">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-3" style="width:60px">#</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th class="text-center" style="width:80px">Order</th>
                                <th class="text-center" style="width:90px">Status</th>
                                <th class="text-center pe-3" style="width:120px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@cat.Id</td>
                                    <td class="fw-semibold">@cat.Name</td>
                                    <td class="text-muted small">@cat.Description</td>
                                    <td class="text-center">@cat.DisplayOrder</td>
                                    <td class="text-center">
                                        @if (cat.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit"
                                                onclick="editCat(@cat.Id, '@Html.Raw(cat.Name)', '@Html.Raw(cat.Description ?? "")', @cat.DisplayOrder, @(cat.IsActive ? "true" : "false"))">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form method="post" asp-action="StockCategoryToggleActive" asp-controller="Master" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn btn-sm py-0 px-2 @(cat.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(cat.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fas @(cat.IsActive ? "fa-toggle-off" : "fa-toggle-on")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="StockCategoryDelete" asp-controller="Master" class="d-inline"
                                              onsubmit="return confirm('Delete \'@cat.Name\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-tags fa-2x mb-2 d-block"></i>No categories yet. Add the first one using the form.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        var table = $('#tblCats').DataTable({
            paging: true, pageLength: 25, searching: true, ordering: true,
            order: [[3, 'asc'], [1, 'asc']],
            columnDefs: [{ orderable: false, targets: [5] }],
            language: { search: 'Search:' }
        });
        $('#filterStatus').on('change', function () {
            table.column(4).search(this.value).draw();
        });
    });

    function editCat(id, name, desc, order, isActive) {
        document.getElementById('f_Id').value = id;
        document.getElementById('f_Name').value = name;
        document.getElementById('f_Desc').value = desc;
        document.getElementById('f_Order').value = order;
        document.getElementById('f_IsActive').value = isActive ? 'true' : 'false';
        document.getElementById('formTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Category';
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-save me-1"></i>Update';
        document.getElementById('catFormCard').scrollIntoView({ behavior: 'smooth' });
    }

    function resetForm() {
        document.getElementById('catForm').reset();
        document.getElementById('f_Id').value = '0';
        document.getElementById('f_IsActive').value = 'true';
        document.getElementById('formTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Add New Category';
        document.getElementById('btnSave').innerHTML = '<i class="fas fa-save me-1"></i>Save';
    }
</script>
}
