@model PaymentViewModel
@{
    Layout = null; // render standalone (remove site header/navigation)
    ViewData["Title"] = "POS Print";
    var settings = ViewBag.RestaurantSettings as RestaurantManagementSystem.Models.RestaurantSettings ?? new RestaurantManagementSystem.Models.RestaurantSettings { RestaurantName = "Restaurant Management System" };
    var counterDisplay = (ViewBag.PosCounterDisplay as string) ?? string.Empty;
    var mainReceiptItems = (Model.OrderItems ?? new List<OrderItemViewModel>()).Where(item => !item.IsExtraCharge).ToList();
    var extraChargeItems = (Model.OrderItems ?? new List<OrderItemViewModel>()).Where(item => item.IsExtraCharge).ToList();
    var mainReceiptSubtotal = mainReceiptItems.Sum(item => item.Subtotal);
    var totalQty = mainReceiptItems.Sum(item => item.Quantity);

    // POS Paper Size from branch settings
    var posPaperSize = (ViewBag.POSPaperSize as string) ?? "80mm";
    string pageWidth, bodyWidth, pageMargin, screenPreviewWidth;
    string baseFontSize, smallFontSize, tinyFontSize;
    string shopNameFontSize, grandTotalFontSize;
    string colQtyWidth, colPriceWidth, colAmtWidth, totalsAmtWidth;

    switch (posPaperSize)
    {
        case "58mm":
            pageWidth = "58mm";  bodyWidth = "50mm"; pageMargin = "3mm 2mm"; screenPreviewWidth = "220px";
            baseFontSize = "10px"; smallFontSize = "9px"; tinyFontSize = "9px";
            shopNameFontSize = "13px"; grandTotalFontSize = "12px";
            colQtyWidth = "20px"; colPriceWidth = "32px"; colAmtWidth = "36px"; totalsAmtWidth = "46px";
            break;
        case "76mm":
            pageWidth = "76mm";  bodyWidth = "68mm"; pageMargin = "4mm 3mm"; screenPreviewWidth = "290px";
            baseFontSize = "11px"; smallFontSize = "10px"; tinyFontSize = "9px";
            shopNameFontSize = "14px"; grandTotalFontSize = "13px";
            colQtyWidth = "22px"; colPriceWidth = "36px"; colAmtWidth = "40px"; totalsAmtWidth = "50px";
            break;
        default: // 80mm
            pageWidth = "80mm";  bodyWidth = "72mm"; pageMargin = "4mm 3mm"; screenPreviewWidth = "320px";
            baseFontSize = "12px"; smallFontSize = "11px"; tinyFontSize = "10px";
            shopNameFontSize = "15px"; grandTotalFontSize = "14px";
            colQtyWidth = "24px"; colPriceWidth = "38px"; colAmtWidth = "42px"; totalsAmtWidth = "55px";
            break;
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>POS Bill - Order #@Model.OrderNumber</title>
    <style>
        /* ── thermal paper (size set by branch POS paper size setting: @posPaperSize) ── */
        @@page {
            size: @(pageWidth) auto;
            margin: @(pageMargin);
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: @(baseFontSize);
            width: @(bodyWidth);
            max-width: @(bodyWidth);
            margin: 0 auto;
            padding: 0;
            color: #000;
            background: #fff;
            -webkit-print-color-adjust: exact;
        }

        /* ── typography helpers ── */
        .center  { text-align: center; }
        .right   { text-align: right; }
        .bold    { font-weight: bold; }
        .small   { font-size: @(smallFontSize); }
        .tiny    { font-size: @(tinyFontSize); }

        /* ── shop header ── */
        .shop-name {
            font-size: @(shopNameFontSize);
            font-weight: bold;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        /* ── dividers ── */
        .dashed  { border: none; border-top: 1px dashed #000; margin: 5px 0; }
        .solid   { border: none; border-top: 1px solid  #000; margin: 5px 0; }
        .double  { border: none; border-top: 3px double #000; margin: 5px 0; }

        /* ── scissors cut line ── */
        .cut-line {
            position: relative;
            border: none;
            border-top: 2px dashed #000;
            margin: 18px 0;
            overflow: visible;
        }
        .cut-line::before {
            content: '\2702';
            position: absolute;
            top: -10px;
            left: -2px;
            font-size: 16px;
            background: #fff;
            padding: 0 2px;
            line-height: 1;
        }

        /* ── bill meta (Name / Date / Counter etc.) ── */
        .meta-table { width: 100%; font-size: @(smallFontSize); border-collapse: collapse; }
        .meta-table td { padding: 1px 0; vertical-align: top; }
        .meta-table .lbl { font-weight: bold; white-space: nowrap; padding-right: 3px; }
        .meta-table .val { }
        .meta-table .right-col { text-align: right; }

        /* ── item lines ── */
        .item-table { width: 100%; border-collapse: collapse; font-size: @(baseFontSize); }
        .item-table th {
            font-weight: bold;
            padding: 2px 0;
            border-bottom: 1px dashed #000;
        }
        .item-table td { padding: 2px 0; vertical-align: top; }
        .item-table .col-name  { width: auto; }
        .item-table .col-qty   { width: @(colQtyWidth);   text-align: center; white-space: nowrap; }
        .item-table .col-price { width: @(colPriceWidth); text-align: right;  white-space: nowrap; }
        .item-table .col-amt   { width: @(colAmtWidth);   text-align: right;  white-space: nowrap; }

        /* ── totals block ── */
        .totals-table { width: 100%; border-collapse: collapse; font-size: @(baseFontSize); }
        .totals-table td { padding: 2px 0; }
        .totals-table .lbl  { }
        .totals-table .amt  { text-align: right; width: @(totalsAmtWidth); white-space: nowrap; }
        .grand-total td     { font-size: @(grandTotalFontSize); font-weight: bold; padding-top: 4px; }

        /* ── screen preview container (removed in print) ── */
        @@media screen {
            body {
                width: @(screenPreviewWidth);
                max-width: @(screenPreviewWidth);
                margin: 20px auto;
                padding: 10px;
                border: 1px solid #ccc;
                box-shadow: 0 2px 10px rgba(0,0,0,.15);
            }
        }

        @@media print {
            body { margin: 0; padding: 0; border: none; box-shadow: none; }
        }
    </style>
</head>
<body>

    
    @* ── SHOP HEADER ──  *@
    <div class="center">
        <div class="shop-name">@settings.RestaurantName</div>
        @if (!string.IsNullOrWhiteSpace(settings.StreetAddress)) { <div class="tiny">@settings.StreetAddress</div> }
        @if (!string.IsNullOrWhiteSpace(settings.City))          { <div class="tiny">@settings.City @settings.State &mdash; @settings.Pincode</div> }
        @if (!string.IsNullOrWhiteSpace(ViewBag.PrintBranchName as string)) { <div class="tiny">Branch: @ViewBag.PrintBranchName</div> }
        @if (!string.IsNullOrWhiteSpace(settings.PhoneNumber))   { <div class="tiny">Phone: @settings.PhoneNumber</div> }
        @if (!string.IsNullOrWhiteSpace(settings.GSTCode))       { <div class="tiny">GSTIN: @settings.GSTCode</div> }
    </div>

    <hr class="dashed" />

    
    @* ── BILL META ──  *@
    <table class="meta-table">
        <tr>
            <td class="lbl">Name:</td>
            <td colspan="2">
                @if (!string.IsNullOrWhiteSpace(Model.CustomerName))
                { @Model.CustomerName }
                else
                { <text>___________________________</text> }
            </td>
        </tr>
        <tr>
            <td class="lbl">Date:</td>
            <td class="val">@DateTime.Now.ToString("dd/MM/yy")</td>
            <td class="right-col">
                @Model.OrderTypeDisplay:
                @(Model.OrderType == 0
                    ? Model.TableName
                    : (Model.OrderType == 4
                        ? (string.IsNullOrWhiteSpace(Model.RoomNo) ? (Model.RoomId.HasValue ? Model.RoomId.Value.ToString() : "N/A") : Model.RoomNo)
                        : "N/A"))
            </td>
        </tr>
        <tr>
            <td class="lbl">Time:</td>
            <td class="val">@DateTime.Now.ToString("HH:mm")</td>
            <td class="right-col">Cashier: @(Model.Payments.FirstOrDefault()?.ProcessedByName ?? "biller")</td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(counterDisplay))
        {
            <tr>
                <td class="lbl">Counter:</td>
                <td colspan="2">@counterDisplay</td>
            </tr>
        }
        <tr>
            <td class="lbl">Bill No:</td>
            <td colspan="2">@Model.OrderNumber</td>
        </tr>
    </table>

    <hr class="dashed" />

    
    @* ── ITEM LINES ──  *@
    <table class="item-table">
        <thead>
            <tr>
                <th class="col-name">Item</th>
                <th class="col-qty">Qty</th>
                <th class="col-price">Price</th>
                <th class="col-amt">Amt</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in mainReceiptItems)
            {
                <tr>
                    <td class="col-name">@item.MenuItemName</td>
                    <td class="col-qty">@item.Quantity</td>
                    <td class="col-price">&#8377;@item.UnitPrice.ToString("F0")</td>
                    <td class="col-amt">&#8377;@item.Subtotal.ToString("F0")</td>
                </tr>
            }
        </tbody>
    </table>

    <hr class="dashed" />

    
    @* ── TOTALS ──  *@
    @{
        var isBarOrder = ViewBag.IsBarOrder ?? false;
        var taxableSubtotal = Model.Subtotal;
        var displaySubtotal = extraChargeItems.Any() ? mainReceiptSubtotal : taxableSubtotal;
        decimal taxTotal  = 0M;
        decimal gstPercent = 0M;
        try { taxTotal   = Model.TaxAmount;      } catch { taxTotal    = 0M; }
        try { gstPercent = Model.GSTPercentage;  } catch { gstPercent  = 0M; }
        var cgstAmt    = Math.Round(taxTotal / 2, 2);
        var sgstAmt    = Math.Round(taxTotal - cgstAmt, 2);
        var cgstPercent = Math.Round(gstPercent / 2, 2);
        var sgstPercent = Math.Round(gstPercent - cgstPercent, 2);
        var discount   = (Model.DiscountAmount > 0) ? Model.DiscountAmount : 0M;
        var total      = Model.TotalAmount;
        var totalRounded = Math.Round(total, 0, MidpointRounding.AwayFromZero);
        var roundOff   = Math.Round(totalRounded - total, 2, MidpointRounding.AwayFromZero);
        var paid       = Model.PaidAmount;
        var toProcessNow    = Math.Max(0M, totalRounded - paid);
        var toProcessRounded = Math.Round(toProcessNow, 0, MidpointRounding.AwayFromZero);
    }
    <table class="totals-table">
        @if (totalQty > 0)
        {
            <tr>
                <td class="lbl">Total Qty</td>
                <td class="amt">@totalQty</td>
            </tr>
        }
        <tr>
            <td class="lbl">Sub Total</td>
            <td class="amt">&#8377;@displaySubtotal.ToString("F2")</td>
        </tr>
        @if (extraChargeItems.Any())
        {
            @foreach (var item in extraChargeItems)
            {
                <tr>
                    <td class="lbl">@item.MenuItemName</td>
                    <td class="amt">&#8377;@item.Subtotal.ToString("F2")</td>
                </tr>
            }
        }
        @if (Model.IsInclusiveGST && taxTotal > 0)
        {
            <tr>
                <td class="lbl">Taxable Value</td>
                <td class="amt">&#8377;@taxableSubtotal.ToString("F2")</td>
            </tr>
        }
        <tr>
            <td class="lbl">CGST @cgstPercent%</td>
            <td class="amt">&#8377;@cgstAmt.ToString("F2")</td>
        </tr>
        <tr>
            <td class="lbl">SGST @sgstPercent%</td>
            <td class="amt">&#8377;@sgstAmt.ToString("F2")</td>
        </tr>
        @if (discount > 0)
        {
            <tr>
                <td class="lbl">Discount</td>
                <td class="amt">&minus;&#8377;@discount.ToString("F2")</td>
            </tr>
        }
        @if (roundOff != 0)
        {
            <tr>
                <td class="lbl">Round off</td>
                <td class="amt">@roundOff.ToString("+0.00;-0.00;0.00")</td>
            </tr>
        }
    </table>

    <hr class="solid" />

    <table class="totals-table grand-total">
        <tr>
            <td class="lbl">Grand Total</td>
            <td class="amt">&#8377;@totalRounded.ToString("F0")</td>
        </tr>
    </table>

    <div class="tiny" style="margin:3px 0 5px 0; font-style:italic;">
        <span class="bold">In Words:</span> @AmountToWords.Convert(totalRounded)
    </div>

    <hr class="double" />

    @* ── DEBUG block (append ?debug=1) ── *@
    @if (ViewContext.HttpContext.Request.Query["debug"] == "1")
    {
        var preRemDbg   = Model.RemainingAmount;
        var roundedDbg  = Math.Round(preRemDbg, 0, MidpointRounding.AwayFromZero);
        var expectedDbg = Math.Round(roundedDbg - preRemDbg, 2);
        var dbgCounterId      = (ViewBag.PosCounterIdValue is int ci) ? ci : 0;
        var dbgCounterDisplay = (ViewBag.PosCounterDisplay as string) ?? string.Empty;
        <div style="background:#fff7e6;border:1px solid #ffd59e;padding:6px;margin-top:6px;font-size:10px;">
            <strong>DEBUG</strong>
            <div>RemainingAmount: @Model.RemainingAmount</div>
            <div>TotalAmount: @Model.TotalAmount</div>
            <div>PaidAmount: @Model.PaidAmount</div>
            <div>TotalRoundoff (stored): @Model.TotalRoundoff</div>
            <div>ComputedRounded: @roundedDbg</div>
            <div>ExpectedRoundoff: @expectedDbg</div>
            <div>CounterId: @dbgCounterId</div>
            <div>CounterDisplay: @dbgCounterDisplay</div>
        </div>
    }

    
    @* ── UPI QR CODE ──  *@
    @{
        var qrTotal        = Model.TotalAmount;
        var qrTotalRounded = Math.Round(qrTotal, 0, MidpointRounding.AwayFromZero);
        var qrPaid         = Model.PaidAmount;
        var qrOutstanding  = Math.Max(0M, qrTotalRounded - qrPaid);
    }
    @if (Model.UPIEnabled && qrOutstanding > 0.001M && !string.IsNullOrEmpty(Model.UPIQRCodeDataUrl))
    {
        <div class="center" style="margin: 8px 0;">
            <div class="bold" style="font-size:12px; margin-bottom:4px;">Scan to Pay</div>
            <img src="@Model.UPIQRCodeDataUrl" alt="UPI QR Code"
                 style="width:120px; height:120px; display:block; margin:0 auto;" />
            <div class="bold" style="font-size:14px; margin-top:4px;">&#8377;@qrOutstanding.ToString("F2")</div>
            <div class="tiny">Google Pay | PhonePe | Paytm | BHIM</div>
            @if (!string.IsNullOrEmpty(Model.UPIPayeeName))
            {
                <div class="tiny">Payee: @Model.UPIPayeeName</div>
            }
        </div>
        <hr class="dashed" />
    }

    
    @* ── FOOTER ──  *@
    <div class="center tiny" style="margin-top:6px;">
        @if (!string.IsNullOrWhiteSpace(settings.FssaiNo)) { <div>FSSAI Lic No: @settings.FssaiNo</div> }
        <div style="margin-top:4px; font-weight:bold;">Thanks For Visit Again !!</div>
    </div>

    @* ── POS KOT PRINT (if enabled) ── *@
    @{
        var isPosKotRequired = (bool)(ViewBag.IsPOSKOTPrintRequired ?? false);
        var kotItems = ViewBag.KOTItems as List<dynamic>;
        var kotTicketNumber = ViewBag.KOTTicketNumber as string;
    }
    @if (isPosKotRequired && kotItems != null && kotItems.Any())
    {
        @* ── SCISSORS CUT LINE ── *@
        <hr class="cut-line" />

        @* ── KOT HEADER (separate receipt) ── *@
        <div class="center">
            <div class="shop-name">@settings.RestaurantName</div>
            @if (!string.IsNullOrWhiteSpace(ViewBag.PrintBranchName as string)) { <div class="tiny">Branch: @ViewBag.PrintBranchName</div> }
        </div>
        <hr class="dashed" />
        <div class="center bold" style="font-size:15px; letter-spacing:.5px; text-transform:uppercase; margin-top:4px;">
            KOT - Kitchen Order Ticket
        </div>
        @if (!string.IsNullOrWhiteSpace(kotTicketNumber))
        {
            <div class="center bold" style="font-size:13px;">@kotTicketNumber</div>
        }
        <div class="center small" style="margin-bottom:4px;">Order #@Model.OrderNumber</div>
        <div class="center tiny">Date: @DateTime.Now.ToString("dd/MM/yy") &nbsp; Time: @DateTime.Now.ToString("HH:mm")</div>
        <hr class="dashed" />

        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left; border-bottom:1px solid #000; padding:2px 0; font-size:11px;">Item</th>
                    <th style="text-align:center; border-bottom:1px solid #000; padding:2px 0; font-size:11px; width:30px;">Qty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in kotItems)
                {
                    <tr>
                        <td style="padding:2px 0; font-size:12px; border-bottom:1px dashed #bbb;">
                            @item.Name
                            @if (!string.IsNullOrEmpty((string)item.SpecialInstructions))
                            {
                                <div class="tiny" style="color:#555;">@item.SpecialInstructions</div>
                            }
                        </td>
                        <td style="text-align:center; padding:2px 0; font-size:12px; border-bottom:1px dashed #bbb;">@item.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>

        <hr class="dashed" />
        <div class="center tiny bold" style="margin-top:4px;">--- End of KOT ---</div>
    }

    <script>window.onload = function () { window.print(); };</script>
</body>
</html>
