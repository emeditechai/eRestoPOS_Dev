@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Printed</title>
    <style>
        body { margin: 0; background: #0a0a1a; display: flex; align-items: center; justify-content: center; height: 100vh; font-family: sans-serif; }
        .box { text-align: center; color: #fff; }
        .check { font-size: 72px; color: #22c55e; margin-bottom: 16px; }
        .msg { font-size: 22px; font-weight: 700; margin-bottom: 8px; }
        .sub { font-size: 14px; color: #aaa; }
    </style>
</head>
<body>
    <div class="box">
        <div class="check">&#10003;</div>
        <div class="msg">Receipt Printed!</div>
        <div class="sub">Sent to printer. This window will close.</div>
    </div>
    <script>
        setTimeout(function () {
            try { window.close(); } catch { }
        }, 2000);
    </script>
</body>
</html>
