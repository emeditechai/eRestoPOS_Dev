@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiforgeryPrint
@{
    Layout = null;
    var bytesB64   = ViewBag.EscPosBytesB64 as string ?? "";
    var bleOrderId = ViewBag.BleOrderId ?? 0;
    var afToken    = AntiforgeryPrint.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="request-verification-token" content="@afToken" />
    <title>Print Receipt</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: #0f0826;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 24px 20px;
            text-align: center;
            gap: 18px;
        }
        .icon { font-size: 52px; line-height: 1; }
        h1   { font-size: 22px; font-weight: 700; }
        .sub { font-size: 14px; color: #a09abe; line-height: 1.5; }
        .btn-primary {
            background: linear-gradient(135deg, #7c3aed, #4f46e5);
            color: #fff;
            border: none;
            border-radius: 16px;
            font-size: 20px;
            font-weight: 700;
            padding: 20px 48px;
            cursor: pointer;
            width: 100%;
            max-width: 340px;
            box-shadow: 0 8px 24px rgba(124,58,237,0.45);
            touch-action: manipulation;
            user-select: none;
            transition: opacity .2s, transform .15s;
        }
        .btn-primary:active   { transform: scale(0.97); }
        .btn-primary:disabled { opacity: 0.55; cursor: default; transform: none; }
        .btn-secondary {
            background: transparent;
            color: #a09abe;
            border: 1px solid #3b2d6e;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            padding: 12px 32px;
            cursor: pointer;
            width: 100%;
            max-width: 340px;
            touch-action: manipulation;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        .btn-secondary:hover { background: #1e1040; color: #d0c8f5; }
        .btn-retry {
            background: linear-gradient(135deg, #059669, #047857);
            color: #fff;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 700;
            padding: 14px 32px;
            cursor: pointer;
            width: 100%;
            max-width: 340px;
            touch-action: manipulation;
            display: none;
        }
        .btn-retry:disabled { opacity: 0.55; cursor: default; }
        #status       { font-size: 15px; min-height: 22px; color: #22c55e; }
        #status.err   { color: #ef4444; }
        #status.warn  { color: #f59e0b; }
        .close-hint { font-size: 12px; color: #4b5563; }
        .badge {
            display: none;
            font-size: 12px;
            color: #22c55e;
            background: #052e16;
            border: 1px solid #166534;
            border-radius: 8px;
            padding: 5px 14px;
            max-width: 340px;
        }
        .link-btn {
            background: transparent;
            color: #6b7280;
            border: none;
            font-size: 12px;
            cursor: pointer;
            text-decoration: underline;
            padding: 0;
        }
        .no-bt-msg {
            display: none;
            background: #1e0a3c;
            border: 1px solid #3b2d6e;
            border-radius: 12px;
            padding: 16px 20px;
            font-size: 13px;
            color: #a09abe;
            max-width: 340px;
            line-height: 1.7;
        }
        .no-bt-msg strong { color: #d8b4fe; }
    </style>
</head>
<body>
    <div class="icon">&#128268;</div>
    <h1>Print Receipt</h1>
    <p class="sub" id="printSub">Tap the button to print.</p>

    <button id="printBtn" class="btn-primary" onclick="startPrint()">&#128424; Print Receipt</button>

    <div id="status"></div>

    <button id="retryBridgeBtn" class="btn-retry" onclick="retryBridge()">&#8635; Retry Print Bridge</button>

    <div class="no-bt-msg" id="noBtMsg">
        <strong>Web Bluetooth not available.</strong>
        Please open this page in Chrome on Android over HTTPS.
        Safari and Firefox do not support Web Bluetooth.
    </div>

    <div id="defaultPrinterBadge" class="badge">&#10003; BT Printer: <span id="defaultPrinterName"></span></div>

    <a class="btn-secondary" href="/Payment/PrintPOS?orderId=@bleOrderId&amp;htmlOnly=true" target="_blank">&#128196; View Receipt</a>

    <a id="setupPrinterLink" class="btn-secondary" href="/Utility/PrinterSetup"
       style="display:none; background:transparent; color:#7c3aed; border-color:#7c3aed;">
        &#128268; Setup Printer
    </a>

    <button id="changePrinterBtn" class="link-btn" onclick="changePrinter()" style="display:none;">
        &#8635; Change BT Printer
    </button>

    <div class="close-hint">Window closes automatically after printing.</div>

    <script src="/js/printer-manager.js"></script>
    <script>
    (function () {
        'use strict';

        var BLE_BYTES_B64    = '@Html.Raw(bytesB64)';
        var ORDER_ID         = @bleOrderId;

        var printBtn         = document.getElementById('printBtn');
        var retryBridgeBtn   = document.getElementById('retryBridgeBtn');
        var badge            = document.getElementById('defaultPrinterBadge');
        var badgeName        = document.getElementById('defaultPrinterName');
        var setupLink        = document.getElementById('setupPrinterLink');
        var changePrinterBtn = document.getElementById('changePrinterBtn');
        var noBtMsg          = document.getElementById('noBtMsg');
        var statusEl         = document.getElementById('status');
        var printSub         = document.getElementById('printSub');

        var BRIDGE_STATUS = 'http://localhost:9100/status';
        var BRIDGE_PRINT  = 'http://localhost:9100/print';

        // true = bridge alive and confirmed, false = never (we keep retrying)
        var _bridgeReady    = false;
        var _polling        = false;  // background poll running
        var _pollTimer      = null;
        var _heartbeatTimer = null;

        function setStatus(msg, cls) {
            statusEl.textContent = msg;
            statusEl.className   = cls || '';
        }
        function showBadge(name) {
            if (!name) return;
            badgeName.textContent = name;
            badge.style.display   = 'inline-block';
        }
        function setBusy(label) {
            printBtn.disabled    = true;
            printBtn.textContent = label || '\u23f3 Please wait\u2026';
        }
        function setReady() {
            printBtn.disabled    = false;
            printBtn.textContent = '\ud83d\udda8 Print Receipt';
        }

        // ── Bridge helpers ─────────────────────────────────────────────────────
        function pingBridge(timeoutMs) {
            return fetch(BRIDGE_STATUS, { signal: AbortSignal.timeout(timeoutMs || 3000) })
                .then(function (r) { return r.json(); });
        }

        function doBridgePrint() {
            return fetch(BRIDGE_PRINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ data: BLE_BYTES_B64 }),
                signal: AbortSignal.timeout(10000)
            })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (d) {
                if (!d || !d.success) throw new Error(d && d.error ? d.error : 'Print failed');
                return d;
            });
        }

        function afterBridgeSuccess() {
            stopPolling();
            setStatus('Printed successfully! \u2713', 'ok');
            printBtn.disabled    = false;
            printBtn.textContent = '\ud83d\udda8 Print Again';
            printBtn.onclick     = function () { triggerBridgePrint(); };
            retryBridgeBtn.style.display = 'none';
            setTimeout(function () { try { window.close(); } catch (e) {} }, 1800);
        }

        function onBridgeFound(data) {
            _bridgeReady = true;
            stopPolling();
            startHeartbeat();
            retryBridgeBtn.style.display = 'none';
            var name = data.printerName || data.printer_name || '';
            if (name) {
                showBadge(name);
                printSub.textContent = 'Paired with ' + name + ' \u2014 tap to print.';
            } else {
                printSub.textContent = 'Print Bridge ready \u2014 tap to print.';
            }
            setStatus('');
            setReady();
        }

        // ── Heartbeat: keep APK alive (ping every 25s so Android never throttles) ──
        function startHeartbeat() {
            if (_heartbeatTimer) return;
            _heartbeatTimer = setInterval(function () {
                fetch(BRIDGE_STATUS, { signal: AbortSignal.timeout(3000) }).catch(function () {});
            }, 25000);
        }
        function stopHeartbeat() {
            if (_heartbeatTimer) { clearInterval(_heartbeatTimer); _heartbeatTimer = null; }
        }

        // ── Background poll: keep trying until bridge responds ────────────────────
        // Strategy: 800ms → 4s → 8s → 8s → 8s … (forever until page closes)
        // Each failed ping wakes the Android networking stack so the next one usually succeeds.
        function startPolling() {
            if (_polling) return;
            _polling = true;
            var delays = [800, 4000, 8000];   // first three intervals
            var step   = 0;

            function attempt() {
                if (!_polling) return;
                var timeout = delays[step] || 8000;
                step++;

                fetch(BRIDGE_STATUS, { signal: AbortSignal.timeout(timeout) })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!_polling) return;
                    onBridgeFound(data);
                })
                .catch(function () {
                    if (!_polling) return;
                    // Show "waking up" hint after first failure
                    if (step === 2) {
                        printSub.textContent = 'Waking up printer app\u2026';
                        setBusy('\u23f3 Connecting\u2026');
                    }
                    _pollTimer = setTimeout(attempt, 500);
                });
            }
            attempt();
        }

        function stopPolling() {
            _polling = false;
            if (_pollTimer) { clearTimeout(_pollTimer); _pollTimer = null; }
        }

        // ── User taps Print button ────────────────────────────────────────────────
        // NEVER shows BLE picker — only uses bridge.
        function triggerBridgePrint() {
            if (_bridgeReady) {
                // Bridge confirmed — print immediately
                setBusy('\u23f3 Printing\u2026');
                setStatus('Sending to printer\u2026');
                doBridgePrint()
                .then(afterBridgeSuccess)
                .catch(function (err) {
                    // Bridge went away — restart polling
                    _bridgeReady = false;
                    startPolling();
                    setStatus('Print error. Reconnecting\u2026', 'err');
                    setBusy('\u23f3 Connecting\u2026');
                    printSub.textContent = 'Waking up printer app\u2026';
                    retryBridgeBtn.style.display = 'block';
                });
            } else {
                // Bridge not confirmed yet — try once with a generous timeout
                setBusy('\u23f3 Connecting\u2026');
                setStatus('');
                stopPolling();
                fetch(BRIDGE_STATUS, { signal: AbortSignal.timeout(8000) })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    onBridgeFound(data);
                    // Now print
                    setBusy('\u23f3 Printing\u2026');
                    setStatus('Sending to printer\u2026');
                    return doBridgePrint();
                })
                .then(afterBridgeSuccess)
                .catch(function () {
                    // Still not responding — tell user to open the app
                    _bridgeReady = false;
                    startPolling();
                    setBusy('\u23f3 Connecting\u2026');
                    printSub.textContent = 'Open the Printer Bridge app on this device, then it will print automatically.';
                    setStatus('');
                    retryBridgeBtn.style.display = 'block';
                });
            }
        }

        window.startPrint = function () { triggerBridgePrint(); };

        // ── Retry button: explicit user retry ────────────────────────────────────
        window.retryBridge = function () {
            retryBridgeBtn.disabled    = true;
            retryBridgeBtn.textContent = '\u23f3 Connecting\u2026';
            setStatus('');
            stopPolling();
            fetch(BRIDGE_STATUS, { signal: AbortSignal.timeout(8000) })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                onBridgeFound(data);
                retryBridgeBtn.disabled    = false;
                retryBridgeBtn.textContent = '\u8635 Retry Print Bridge';
                setBusy('\u23f3 Printing\u2026');
                setStatus('Sending to printer\u2026');
                return doBridgePrint();
            })
            .then(afterBridgeSuccess)
            .catch(function () {
                retryBridgeBtn.disabled    = false;
                retryBridgeBtn.textContent = '\u8635 Retry Print Bridge';
                printSub.textContent = 'App not responding. Open the Printer Bridge app and try again.';
                setStatus('');
                startPolling();
            });
        };

        // ── Boot ──────────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            setBusy('\u23f3 Connecting\u2026');
            printSub.textContent = 'Connecting to Printer Bridge\u2026';
            // Hide BLE-specific controls — this page uses bridge only
            if (changePrinterBtn) changePrinterBtn.style.display = 'none';
            if (setupLink)        setupLink.style.display        = 'none';
            if (noBtMsg)          noBtMsg.style.display          = 'none';
            startPolling();
        });

    })();
    </script>
</body>
</html>
