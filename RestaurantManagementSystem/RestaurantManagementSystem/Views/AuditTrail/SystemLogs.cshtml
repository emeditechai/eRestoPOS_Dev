@model RestaurantManagementSystem.Models.SystemAuditLogViewModel
@{
    ViewData["Title"] = "System Audit Log";
}

<style>
    .audit-header { background: linear-gradient(135deg, #1a3c5b 0%, #2563a8 100%); }
    .stat-card    { border-radius: 12px; border: none; }
    .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .audit-table th { background: #1a3c5b; color: #fff; font-size: .78rem;
        text-transform: uppercase; letter-spacing: .4px; border: none; }
    .audit-table td { vertical-align: middle; font-size: .87rem; padding: .45rem .6rem; }
    .audit-table tbody tr:hover { background: #f0f7ff; }
    .module-badge { font-size: .72rem; font-weight: 600; padding: 3px 8px; border-radius: 12px; white-space: nowrap; }
    .module-MenuItem     { background: #e0f2fe; color: #0369a1; }
    .module-MenuItemRate { background: #dcfce7; color: #15803d; }
    .module-Ingredient   { background: #dbeafe; color: #1e40af; }
    .module-UOM          { background: #fef3c7; color: #92400e; }
    .module-User         { background: #ede9fe; color: #6d28d9; }
    .module-Branch       { background: #fce7f3; color: #be185d; }
    .action-Create       { background: #dcfce7; color: #15803d; }
    .action-Update       { background: #fef3c7; color: #92400e; }
    .action-Delete       { background: #fee2e2; color: #b91c1c; }
    .action-PasswordChange { background: #ede9fe; color: #6d28d9; }
    .avatar-circle { width: 32px; height: 32px; border-radius: 50%;
        background: linear-gradient(135deg, #1a3c5b 0%, #2563a8 100%);
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: .8rem; }
    .change-val { font-family: 'Courier New', monospace; font-size: .78rem; }
    .filter-bar input, .filter-bar select { font-size: .85rem; }
</style>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="audit-header text-white rounded-3 p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h4 class="mb-1 fw-bold">
                            <i class="fas fa-shield-alt me-2"></i>System Audit Log
                        </h4>
                        <p class="mb-0 opacity-75 small">
                            Track all system changes &mdash; Menu Item Rates, Ingredients, UOM, Users &amp; Branches.
                        </p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("Index")" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-clipboard-list me-1"></i>Order Audit Trail
                        </a>
                        <a href="@Url.Action("Statistics")" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-chart-bar me-1"></i>Statistics
                        </a>
                        <button onclick="exportSystemCSV()" class="btn btn-light btn-sm" title="Export to CSV">
                            <i class="fas fa-file-csv me-1"></i>Export CSV
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        @{
            var total = Model.TotalRecords;
            var todayCount = Model.Records.Count(r => r.ChangedDate.Date == DateTime.Today);
            var moduleGroups = Model.Records.GroupBy(r => r.Module).ToDictionary(g => g.Key, g => g.Count());
        }
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background: #dbeafe;">
                        <i class="fas fa-stream text-primary"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@total</div>
                        <div class="text-muted small">Total Records</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background: #dcfce7;">
                        <i class="fas fa-calendar-day text-success"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success">@todayCount</div>
                        <div class="text-muted small">Today</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background: #ede9fe;">
                        <i class="fas fa-layer-group" style="color: #6d28d9;"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold" style="color: #6d28d9;">@moduleGroups.Count</div>
                        <div class="text-muted small">Active Modules</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background: #fef3c7;">
                        <i class="fas fa-users" style="color: #d97706;"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold" style="color: #d97706;">@Model.Records.Select(r => r.ChangedByName).Distinct().Count()</div>
                        <div class="text-muted small">Unique Users</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-3 border-0">
        <div class="card-body py-2 px-3">
            <form method="get" id="filterForm">
                <div class="d-flex gap-2 flex-wrap align-items-end filter-bar">
                    <div>
                        <label class="form-label small mb-0 fw-semibold">Module</label>
                        <select name="module" class="form-select form-select-sm" style="min-width: 140px;" onchange="this.form.submit()">
                            @foreach (var m in Model.Modules)
                            {
                                if (m.Value == (Model.Module ?? ""))
                                {
                                    <option value="@m.Value" selected="selected">@m.Text</option>
                                }
                                else
                                {
                                    <option value="@m.Value">@m.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-0 fw-semibold">User</label>
                        <select name="userId" class="form-select form-select-sm" style="min-width: 140px;" onchange="this.form.submit()">
                            @foreach (var u in Model.Users)
                            {
                                if (u.Value == (Model.UserId?.ToString() ?? ""))
                                {
                                    <option value="@u.Value" selected="selected">@u.Text</option>
                                }
                                else
                                {
                                    <option value="@u.Value">@u.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-0 fw-semibold">Start Date</label>
                        <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm">
                    </div>
                    <div>
                        <label class="form-label small mb-0 fw-semibold">End Date</label>
                        <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm">
                    </div>
                    <div style="flex: 1; min-width: 180px;">
                        <label class="form-label small mb-0 fw-semibold">Search</label>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search entity, user, values...">
                    </div>
                    <div class="ms-auto d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-search me-1"></i>Apply
                        </button>
                        <a href="@Url.Action("SystemLogs")" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-times me-1"></i>Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold"><i class="fas fa-list me-2"></i>Audit Records (@Model.TotalRecords)</h6>
            <span class="text-muted small">
                Showing @(Model.Records.Count > 0 ? ((Model.CurrentPage - 1) * Model.PageSize + 1).ToString() : "0")
                &ndash; @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords) of @Model.TotalRecords
            </span>
        </div>
        <div class="card-body p-0">
            @if (Model.Records.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 audit-table">
                        <thead>
                            <tr>
                                <th style="width: 130px;">Date / Time</th>
                                <th style="width: 110px;">Module</th>
                                <th style="width: 100px;">Action</th>
                                <th>Entity</th>
                                <th style="width: 120px;">Field</th>
                                <th>Change Details</th>
                                <th style="width: 130px;">Changed By</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Records)
                            {
                                <tr>
                                    <td>
                                        <small class="text-muted d-block">@r.ChangedDate.ToString("dd/MM/yyyy")</small>
                                        <small class="fw-bold">@r.ChangedDate.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <span class="module-badge module-@r.Module">@r.Module</span>
                                    </td>
                                    <td>
                                        <span class="module-badge action-@r.Action">@r.Action</span>
                                    </td>
                                    <td>
                                        @if (r.EntityId.HasValue)
                                        {
                                            <small class="text-muted me-1">#@r.EntityId</small>
                                        }
                                        <span class="fw-semibold">@(r.EntityName ?? "-")</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@(r.FieldName ?? "-")</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(r.OldValue) || !string.IsNullOrEmpty(r.NewValue))
                                        {
                                            <div>
                                                @if (!string.IsNullOrEmpty(r.OldValue))
                                                {
                                                    <small class="d-block text-danger change-val"><del>@r.OldValue</del></small>
                                                }
                                                @if (!string.IsNullOrEmpty(r.NewValue))
                                                {
                                                    <small class="d-block text-success change-val fw-bold">@r.NewValue</small>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle"><i class="fas fa-user"></i></div>
                                            <small>@r.ChangedByName</small>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(r.AdditionalInfo) || !string.IsNullOrEmpty(r.IPAddress))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#sysModal@(r.Id)">
                                                <i class="fas fa-info-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>

                                @if (!string.IsNullOrEmpty(r.AdditionalInfo) || !string.IsNullOrEmpty(r.IPAddress))
                                {
                                    <div class="modal fade" id="sysModal@(r.Id)" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h6 class="modal-title"><i class="fas fa-info-circle me-1"></i>Details</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <dl class="row mb-0">
                                                        <dt class="col-sm-4">Module:</dt>
                                                        <dd class="col-sm-8">@r.Module</dd>
                                                        <dt class="col-sm-4">Action:</dt>
                                                        <dd class="col-sm-8">@r.Action</dd>
                                                        <dt class="col-sm-4">Entity:</dt>
                                                        <dd class="col-sm-8">@(r.EntityName ?? "-") @(r.EntityId.HasValue ? $"(#{r.EntityId})" : "")</dd>
                                                        <dt class="col-sm-4">Changed By:</dt>
                                                        <dd class="col-sm-8">@r.ChangedByName</dd>
                                                        <dt class="col-sm-4">Date:</dt>
                                                        <dd class="col-sm-8">@r.ChangedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>
                                                        @if (!string.IsNullOrEmpty(r.IPAddress))
                                                        {
                                                            <dt class="col-sm-4">IP Address:</dt>
                                                            <dd class="col-sm-8">@r.IPAddress</dd>
                                                        }
                                                        @if (!string.IsNullOrEmpty(r.AdditionalInfo))
                                                        {
                                                            <dt class="col-sm-4">Additional Info:</dt>
                                                            <dd class="col-sm-8"><small class="change-val">@r.AdditionalInfo</small></dd>
                                                        }
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top">
                        <nav>
                            <ul class="pagination mb-0 justify-content-center pagination-sm">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("SystemLogs", new { page = Model.CurrentPage - 1, module = Model.Module, userId = Model.UserId, startDate = Model.StartDate, endDate = Model.EndDate, searchTerm = Model.SearchTerm })">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("SystemLogs", new { page = i, module = Model.Module, userId = Model.UserId, startDate = Model.StartDate, endDate = Model.EndDate, searchTerm = Model.SearchTerm })">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("SystemLogs", new { page = Model.CurrentPage + 1, module = Model.Module, userId = Model.UserId, startDate = Model.StartDate, endDate = Model.EndDate, searchTerm = Model.SearchTerm })">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted">No system audit records found matching your criteria.</p>
                    <p class="text-muted small">Once you edit Menu Item Rates, Ingredients, UOM, Users or Branches, changes will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function exportSystemCSV() {
    const rows = [['Timestamp', 'Module', 'Action', 'Entity ID', 'Entity Name', 'Field', 'Old Value', 'New Value', 'Changed By', 'Additional Info']];
    @foreach (var r in Model.Records)
    {
        <text>
        rows.push([
            '@r.ChangedDate.ToString("yyyy-MM-dd HH:mm:ss")',
            '@r.Module',
            '@r.Action',
            '@(r.EntityId?.ToString() ?? "")',
            '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.EntityName ?? ""))',
            '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.FieldName ?? ""))',
            '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.OldValue ?? ""))',
            '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.NewValue ?? ""))',
            '@r.ChangedByName',
            '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.AdditionalInfo ?? ""))'
        ]);
        </text>
    }
    let csv = rows.map(r => r.map(c => {
        const s = String(c).replace(/"/g, '""');
        return s.includes(',') || s.includes('\n') ? `"${s}"` : s;
    }).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `system_audit_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    toastr.success('System audit log exported to CSV');
}
</script>
}
